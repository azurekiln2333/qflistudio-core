# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
# flutter tool 在包目录里落的状态文件（含 workspace 成员）
.flutter
.flutter_tool_state
.pub-cache/
.pub/
**/build/
**/.dart_tool/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 第三方原生解释器源码：按 apps/qfli_c/native/README.md 的命令 clone 进来，
# 不进版本库（上游在 GitLab，自己 clone 比在这里维护一份副本可靠）。
/apps/qfli_c/native/third_party/picoc/

# HarmonyOS 原生构建产物
/apps/qfli_c/ohos/**/build/
/apps/qfli_c/ohos/**/oh_modules/
/apps/qfli_c/ohos/**/node_modules/
/apps/qfli_c/ohos/**/.hvigor/
/apps/qfli_c/ohos/entry/libs/

# The same generated platform directories exist in every language App.
**/ohos/**/build/
**/ohos/**/oh_modules/
**/ohos/**/node_modules/
**/ohos/**/.hvigor/
**/ohos/entry/libs/

# Native language runtime build output
**/native/build/

# Local AI/editor tool state; project instructions remain tracked in .agents/.trellis.
/.agent/
/.claude/
/.codebuddy/
/.cursor/
/.gemini/
/.qoder/
/.workbuddy-ai/
/.zcode/

# Portable shared project skills are versioned selectively. Ignore all local
# agent state by default; only these platform-neutral Trellis skills are shared.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/trellis-before-dev/
!/.agents/skills/trellis-before-dev/**
!/.agents/skills/trellis-brainstorm/
!/.agents/skills/trellis-brainstorm/**
!/.agents/skills/trellis-break-loop/
!/.agents/skills/trellis-break-loop/**
!/.agents/skills/trellis-channel/
!/.agents/skills/trellis-channel/**
!/.agents/skills/trellis-check/
!/.agents/skills/trellis-check/**
!/.agents/skills/trellis-continue/
!/.agents/skills/trellis-continue/**
!/.agents/skills/trellis-finish-work/
!/.agents/skills/trellis-finish-work/**
!/.agents/skills/trellis-meta/
!/.agents/skills/trellis-meta/**
!/.agents/skills/trellis-session-insight/
!/.agents/skills/trellis-session-insight/**
!/.agents/skills/trellis-spec-bootstrap/
!/.agents/skills/trellis-spec-bootstrap/**
!/.agents/skills/trellis-start/
!/.agents/skills/trellis-start/**
!/.agents/skills/trellis-update-spec/
!/.agents/skills/trellis-update-spec/**
# Portable Codex project configuration only; user-level trust/auth state stays local.
/.codex/*
!/.codex/config.toml
!/.codex/hooks.json
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/trellis-check.toml
!/.codex/agents/trellis-implement.toml
!/.codex/agents/trellis-research.toml
!/.codex/hooks/
/.codex/hooks/*
!/.codex/hooks/inject-subagent-context.py
!/.codex/hooks/inject-workflow-state.py
!/.codex/hooks/session-start.py

# Portable Pi project integration only; session state and local settings remain out.
/.pi/*
!/.pi/settings.json
!/.pi/agents/
/.pi/agents/*
!/.pi/agents/trellis-check.md
!/.pi/agents/trellis-implement.md
!/.pi/agents/trellis-research.md
!/.pi/extensions/
/.pi/extensions/*
!/.pi/extensions/trellis/
/.pi/extensions/trellis/*
!/.pi/extensions/trellis/index.ts
!/.pi/prompts/
/.pi/prompts/*
!/.pi/prompts/trellis-continue.md
!/.pi/prompts/trellis-finish-work.md
!/.pi/prompts/trellis-start.md

# Trellis durable files remain cloneable; omit only generated template identity.
/.dsh/
/.trellis/.template-hashes.json

# Local diagnostic exports and shell inspection fragments
/_*.txt
/tmp_*.txt
/s[1-5].txt
/rc[1-2].txt
/run_chunk.txt
/corelist.txt
/lib_tree.txt
/.dsh_*.txt
/.dsh_tmp/
/.gitstatus.txt
/.gs.txt
/.st.txt

# Trellis/AI-agent working files: task research artifacts (screenshot and
# source snapshots are large and reproducible) and local agent configuration.
# Raw reproducible captures are replaced by adjacent provenance summaries. Their
# original blobs remain in Git history and the verified external snapshot.
/.trellis/tasks/**/research/**/*.stdout
/.trellis/tasks/**/research/**/*.stderr
/.trellis/tasks/**/research/**/report.json
/.trellis/tasks/**/research/**/root-terminal-observation.json

# Alternate platform trees and build/checkpoint source snapshots remain in the
# migration backup for owner review; do not blanket-add them here.
/.trae/
