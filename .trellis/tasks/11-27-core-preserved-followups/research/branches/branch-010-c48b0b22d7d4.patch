+      behavior: HitTestBehavior.opaque,
+      onDoubleTap: () =>
+          setState(() => _agentPaneWidth = Breakpoints.agentPaneWidth),
+      onHorizontalDragUpdate: (details) => setState(() {
+        _agentPaneWidth = (_agentPaneWidth - details.delta.dx).clamp(
+          320.0,
+          720.0,
