diff --git a/lib/harness/remote/remote_harness_host.dart b/lib/harness/remote/remote_harness_host.dart
new file mode 100644
index 0000000000000000000000000000000000000000..6127b9467972c4de0b1b1abc4fd28fe0858a714c
--- /dev/null
+++ b/lib/harness/remote/remote_harness_host.dart
@@ -0,0 +1,413 @@
+// RemoteHarnessHost: one paired computer as a HarnessHub host.
+//
+// This is an adapter, not a second protocol implementation. Every action lands on
+// the module that already owns it (`RemoteController`, `HerdrController`,
+// `CodexThreadView`), so the wire format, request ids, reconnect and replay
+// behaviour, and the "approvals only from an explicit reply" rule are exactly the
+// ones the Remote Computer page uses.
+//
+// Sessions from all three remote surfaces are merged into one list because the
+// Agents surface shows "what runs on that computer", not "which sub-module".
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../../remote_control/models/herdr.dart' as herdr;
+import '../../remote_control/models/protocol.dart' as protocol;
+import '../../remote_control/state/remote_controller.dart' show ConnectionPhase;
+import '../harness_host.dart';
+import 'remote_mapping.dart';
+import 'remote_ports.dart';
+import 'remote_session.dart';
+
+class RemoteHarnessHost implements HarnessHost {
+  RemoteHarnessHost({
+    required RemoteSessionPort remote,
+    RemoteHerdrPort? herdr,
+    RemoteCodexPort? codex,
+    this.refreshInterval = const Duration(seconds: 20),
+  }) : _remote = remote,
+       _herdr = herdr,
+       _codex = codex,
+       _state = ValueNotifier<HarnessHostState>(_stateFor(remote.phase)) {
+    _remote.changes.addListener(_onRemoteChanged);
+    _herdr?.changes.addListener(_onHerdrChanged);
+    _state.value = _stateFor(_remote.phase);
+    _wasOnline = remote.isOnline;
+    if (_wasOnline) unawaited(_loadRemote());
+  }
+
+  /// How often the thread catalog is refreshed while the list is open. Sessions
+  /// themselves arrive as pushes, so this is only for the Codex catalog.
+  final Duration refreshInterval;
+
+  final RemoteSessionPort _remote;
+  final RemoteHerdrPort? _herdr;
+  final RemoteCodexPort? _codex;
+  final ValueNotifier<HarnessHostState> _state;
+  final StreamController<List<HarnessSessionInfo>> _sessions =
+      StreamController<List<HarnessSessionInfo>>.broadcast();
+  final Map<String, RemoteSessionHandle> _sessionHandles =
+      <String, RemoteSessionHandle>{};
+  final Map<String, RemoteHerdrHandle> _herdrHandles =
+      <String, RemoteHerdrHandle>{};
+  final Map<String, RemoteCodexThreadHandle> _codexHandles =
+      <String, RemoteCodexThreadHandle>{};
+  final List<protocol.CodexThread> _codexThreads = <protocol.CodexThread>[];
+
+  List<HarnessSessionInfo> _latest = const <HarnessSessionInfo>[];
+  bool _wasOnline = false;
+  bool _disposed = false;
+  bool _loadingCodex = false;
+  String? _lastError;
+  Timer? _codexTimer;
+
+  @override
+  String get id {
+    // One host per paired computer: the hub registers several, so a constant id
+    // would collide in its map. The pairing id is stable across reconnects.
+    final key = _remote.hostId.trim();
+    return key.isEmpty ? 'remote' : 'remote:$key';
+  }
+
+  @override
+  String get label {
+    final name = _remote.hostLabel;
+    return name.isEmpty ? '远程电脑' : name;
+  }
+
+  @override
+  HarnessHostKind get kind => HarnessHostKind.remote;
+
+  @override
+  ValueListenable<HarnessHostState> get state => _state;
+
+  /// Last failure, already user-facing.
+  String? get lastError => _lastError;
+
+  /// Phase of the underlying pairing, for a host switcher's status dot.
+  ConnectionPhase get phase => _remote.phase;
+
+  /// Snapshot for a UI that mounts after the first push.
+  List<HarnessSessionInfo> get currentSessions => _latest;
+
+  // -------------------------------------------------------------------------
+  // HarnessHost
+  // -------------------------------------------------------------------------
+
+  @override
+  Stream<List<HarnessSessionInfo>> watchSessions() {
+    if (_codexTimer == null && !_disposed) {
+      _codexTimer = Timer.periodic(refreshInterval, (_) {
+        if (_remote.isOnline) unawaited(_loadCodex());
+      });
+    }
+    return Stream.multi((controller) {
+      controller.add(_latest);
+      final subscription = _sessions.stream.listen(
+        controller.add,
+        onError: controller.addError,
+        onDone: controller.close,
+      );
+      controller.onCancel = subscription.cancel;
+    });
+  }
+
+  @override
+  Future<List<HarnessProviderInfo>> providers() async {
+    // Both entries are launchable on the desktop through the existing agent
+    // protocol. Herdr panes are listed as sessions but cannot be started from
+    // here (the wire protocol has no Herdr start verb), so they are not offered.
+    return const <HarnessProviderInfo>[
+      HarnessProviderInfo(
+        id: 'claude',
+        label: 'Claude Code',
+        available: true,
+        executable: 'claude',
+        builtIn: true,
+      ),
+      HarnessProviderInfo(
+        id: 'shell',
+        label: '终端',
+        available: true,
+        builtIn: true,
+      ),
+    ];
+  }
+
+  @override
+  Future<HarnessSessionHandle> open(String sessionId) async {
+    final existing =
+        _sessionHandles[sessionId] ??
+        _herdrHandles[sessionId] ??
+        _codexHandles[sessionId];
+    if (existing != null) return existing;
+
+    if (sessionId.startsWith('session:')) {
+      final rawId = sessionId.substring('session:'.length);
+      final session = _sessionById(rawId);
+      if (session == null) {
+        throw StateError('找不到该会话，可能已在电脑上关闭');
+      }
+      final handle = RemoteSessionHandle(
+        port: _remote,
+        session: session,
+        hostId: id,
+        onDetached: (detached) async {
+          _sessionHandles.remove(sessionId);
+          detached.dispose();
+        },
+      );
+      _sessionHandles[sessionId] = handle;
+      return handle;
+    }
+
+    if (sessionId.startsWith('herdr:')) {
+      final paneId = sessionId.substring('herdr:'.length);
+      final port = _herdr;
+      if (port == null) {
+        throw StateError('当前电脑没有 Herdr 面板');
+      }
+      final agent = _agentByPane(paneId);
+      if (agent == null) {
+        throw StateError('找不到该 Herdr 面板，可能已关闭');
+      }
+      final handle = RemoteHerdrHandle(
+        herdrPort: port,
+        agent: agent,
+        hostId: id,
+        onDetached: (detached) async {
+          _herdrHandles.remove(sessionId);
+          detached.dispose();
+        },
+      );
+      _herdrHandles[sessionId] = handle;
+      return handle;
+    }
+
+    if (sessionId.startsWith('codex:')) {
+      final threadId = sessionId.substring('codex:'.length);
+      final port = _codex;
+      if (port == null) {
+        throw StateError('当前电脑没有 Codex 会话');
+      }
+      final thread = _threadById(threadId);
+      if (thread == null) {
+        throw StateError('找不到该 Codex 会话');
+      }
+      final handle = RemoteCodexThreadHandle(
+        codex: port,
+        view: port.openThread(thread),
+        hostId: id,
+        onDetached: (detached) async {
+          _codexHandles.remove(sessionId);
+          await detached.dispose();
+        },
+      );
+      _codexHandles[sessionId] = handle;
+      return handle;
+    }
+
+    throw StateError('无法识别的会话：$sessionId');
+  }
+
+  @override
+  Future<HarnessSessionHandle> launch(HarnessLaunchRequest request) async {
+    if (!_remote.isOnline) {
+      throw StateError('电脑未连接，无法新建会话');
+    }
+    final protocol.SessionInfo created;
+    switch (request.providerId) {
+      case 'shell':
+        created = await _remote.createTerminal(cwd: request.cwd);
+      case 'claude':
+        created = await _remote.createSession(cwd: request.cwd);
+      default:
+        throw StateError('远程电脑暂不支持启动 ${request.providerId} 会话');
+    }
+    await _remote.refreshSessions();
+    return open('session:${created.id}');
+  }
+
+  @override
+  Future<void> dispose() async {
+    if (_disposed) return;
+    _disposed = true;
+    _codexTimer?.cancel();
+    _codexTimer = null;
+    _remote.changes.removeListener(_onRemoteChanged);
+    _herdr?.changes.removeListener(_onHerdrChanged);
+    final sessionHandles = _sessionHandles.values.toList();
+    _sessionHandles.clear();
+    for (final handle in sessionHandles) {
+      handle.dispose();
+    }
+    final herdrHandles = _herdrHandles.values.toList();
+    _herdrHandles.clear();
+    for (final handle in herdrHandles) {
+      handle.dispose();
+    }
+    final codexHandles = _codexHandles.values.toList();
+    _codexHandles.clear();
+    for (final handle in codexHandles) {
+      await handle.dispose();
+    }
+    await _sessions.close();
+    _state.dispose();
+  }
+
+  // -------------------------------------------------------------------------
+  // State and refresh
+  // -------------------------------------------------------------------------
+
+  void _onRemoteChanged() {
+    if (_disposed) return;
+    _state.value = _stateFor(_remote.phase);
+    final online = _remote.isOnline;
+    if (online && !_wasOnline) {
+      // A fresh connection: the desktop may have restarted, so re-read
+      // everything rather than trusting the pre-disconnect caches.
+      _wasOnline = true;
+      unawaited(_loadRemote());
+    } else if (!online) {
+      _wasOnline = false;
+    }
+    _emit();
+  }
+
+  void _onHerdrChanged() {
+    if (_disposed) return;
+    _syncHerdrHandles();
+    _emit();
+  }
+
+  Future<void> _loadRemote() async {
+    try {
+      await _remote.refreshSessions();
+      final herdrPort = _herdr;
+      if (herdrPort != null && herdrPort.canControl) {
+        await herdrPort.refresh();
+      }
+      await _loadCodex();
+      _lastError = null;
+    } catch (error) {
+      _lastError = '$error';
+    }
+    _emit();
+  }
+
+  /// Codex catalog refresh. Failures are recorded but never block the list: a
+  /// computer without Codex is a normal computer.
+  Future<void> _loadCodex() async {
+    final port = _codex;
+    if (port == null || _disposed || _loadingCodex) return;
+    if (!_remote.isOnline || !port.available) return;
+    _loadingCodex = true;
+    try {
+      final threads = await port.recentThreads();
+      _codexThreads
+        ..clear()
+        ..addAll(threads.take(50));
+      _emit();
+    } catch (error) {
+      _lastError = '$error';
+    } finally {
+      _loadingCodex = false;
+    }
+  }
+
+  void _emit() {
+    final infos = <HarnessSessionInfo>[
+      for (final session in _remote.sessions)
+        remoteSessionInfo(hostId: id, session: session),
+      if (_herdr?.canControl == true)
+        for (final agent in _herdr!.agents)
+          remoteHerdrSessionInfo(hostId: id, agent: agent),
+      for (final thread in _codexThreads)
+        remoteCodexSessionInfo(hostId: id, thread: thread),
+    ];
+    infos.sort(_compareSessions);
+    _latest = List<HarnessSessionInfo>.unmodifiable(infos);
+    _syncHerdrHandles();
+    if (!_sessions.isClosed) _sessions.add(_latest);
+  }
+
+  void _syncHerdrHandles() {
+    if (_herdr == null) return;
+    for (final entry in _herdrHandles.entries.toList()) {
+      final paneId = entry.key.substring('herdr:'.length);
+      final agent = _agentByPane(paneId);
+      if (agent == null) {
+        // The pane is gone; the row keeps its last title and shows as exited.
+        entry.value.markExited();
+      } else {
+        entry.value.update(agent);
+      }
+    }
+  }
+
+  /// Attention first: blocked/done need a human, working does not.
+  static int _compareSessions(HarnessSessionInfo a, HarnessSessionInfo b) {
+    int rank(HarnessSessionStatus status) {
+      switch (status) {
+        case HarnessSessionStatus.blocked:
+          return 0;
+        case HarnessSessionStatus.done:
+          return 1;
+        case HarnessSessionStatus.working:
+          return 2;
+        case HarnessSessionStatus.idle:
+          return 3;
+        case HarnessSessionStatus.unknown:
+          return 4;
+        case HarnessSessionStatus.exited:
+          return 5;
+      }
+    }
+
+    final byRank = rank(a.status).compareTo(rank(b.status));
+    if (byRank != 0) return byRank;
+    final at = a.updatedAt;
+    final bt = b.updatedAt;
+    if (at != null && bt != null && at != bt) return bt.compareTo(at);
+    return a.title.toLowerCase().compareTo(b.title.toLowerCase());
+  }
+
+  protocol.SessionInfo? _sessionById(String id) {
+    for (final session in _remote.sessions) {
+      if (session.id == id) return session;
+    }
+    return null;
+  }
+
+  herdr.HerdrAgent? _agentByPane(String paneId) {
+    final port = _herdr;
+    if (port == null) return null;
+    for (final agent in port.agents) {
+      if (agent.paneId == paneId) return agent;
+    }
+    return null;
+  }
+
+  protocol.CodexThread? _threadById(String id) {
+    for (final thread in _codexThreads) {
+      if (thread.id == id) return thread;
+    }
+    return null;
+  }
+
+  static HarnessHostState _stateFor(ConnectionPhase phase) {
+    switch (phase) {
+      case ConnectionPhase.online:
+        return HarnessHostState.online;
+      case ConnectionPhase.connecting:
+        return HarnessHostState.connecting;
+      case ConnectionPhase.unpaired:
+      case ConnectionPhase.agentOffline:
+      case ConnectionPhase.authFailed:
+      case ConnectionPhase.disconnected:
+        return HarnessHostState.offline;
+    }
+  }
+}
diff --git a/lib/harness/remote/remote_mapping.dart b/lib/harness/remote/remote_mapping.dart
new file mode 100644
index 0000000000000000000000000000000000000000..44ab4e948b256d9ec58c46e98b9e41a05129c3ab
--- /dev/null
+++ b/lib/harness/remote/remote_mapping.dart
@@ -0,0 +1,299 @@
+// Mapping from the remote-control wire types onto the harness vocabulary.
+//
+// Pure functions only: these are the rules a reviewer can check without a
+// socket, and the tests assert them directly. Everything here is read-only
+// interpretation — no wire field is renamed and no request is invented.
+
+import '../../remote_control/models/herdr.dart' as herdr;
+import '../../remote_control/models/protocol.dart' as protocol;
+import '../harness_host.dart';
+
+/// Remote session status → harness status.
+///
+/// `error` is deliberately `unknown`: the session still exists and can accept
+/// another prompt, so `exited` would be false, while `idle` would hide a failure
+/// the user may need to see.
+HarnessSessionStatus remoteSessionStatus(protocol.SessionStatus status) {
+  switch (status) {
+    case protocol.SessionStatus.starting:
+      return HarnessSessionStatus.working;
+    case protocol.SessionStatus.running:
+      return HarnessSessionStatus.working;
+    case protocol.SessionStatus.waiting:
+      return HarnessSessionStatus.blocked;
+    case protocol.SessionStatus.idle:
+      return HarnessSessionStatus.idle;
+    case protocol.SessionStatus.error:
+      return HarnessSessionStatus.unknown;
+    case protocol.SessionStatus.closed:
+      return HarnessSessionStatus.exited;
+  }
+}
+
+/// Herdr agent status → harness status, shared with the local host so both
+/// paths colour a pane the same way.
+HarnessSessionStatus remoteHerdrStatus(herdr.HerdrAgentStatus status) {
+  switch (status) {
+    case herdr.HerdrAgentStatus.idle:
+      return HarnessSessionStatus.idle;
+    case herdr.HerdrAgentStatus.working:
+      return HarnessSessionStatus.working;
+    case herdr.HerdrAgentStatus.blocked:
+      return HarnessSessionStatus.blocked;
+    case herdr.HerdrAgentStatus.done:
+      return HarnessSessionStatus.done;
+    case herdr.HerdrAgentStatus.unknown:
+      return HarnessSessionStatus.unknown;
+  }
+}
+
+/// Codex thread status is a free-form desktop string.
+HarnessSessionStatus remoteCodexStatus(String status) {
+  switch (status.toLowerCase()) {
+    case 'active':
+    case 'running':
+    case 'working':
+    case 'inprogress':
+    case 'in_progress':
+      return HarnessSessionStatus.working;
+    case 'idle':
+    case 'waiting':
+    case 'ready':
+      return HarnessSessionStatus.idle;
+    case 'done':
+    case 'complete':
+    case 'completed':
+    case 'finished':
+      return HarnessSessionStatus.done;
+    case 'blocked':
+    case 'needsattention':
+    case 'needs_attention':
+    case 'approval':
+      return HarnessSessionStatus.blocked;
+    default:
+      return HarnessSessionStatus.unknown;
+  }
+}
+
+/// One remote Claude/terminal session as a hub row.
+///
+/// The id is prefixed so a session and a Codex thread with the same uuid can
+/// never collide inside one host, and so `open()` can route on the prefix alone.
+HarnessSessionInfo remoteSessionInfo({
+  required String hostId,
+  required protocol.SessionInfo session,
+}) {
+  final terminal = session.isTerminal;
+  return HarnessSessionInfo(
+    id: 'session:${session.id}',
+    hostId: hostId,
+    providerId: terminal ? 'shell' : 'claude',
+    title: session.title.isEmpty
+        ? (terminal ? '终端' : 'Claude Code')
+        : session.title,
+    status: remoteSessionStatus(session.status),
+    capabilities: terminal
+        ? const <HarnessCapability>{
+            HarnessCapability.terminal,
+            HarnessCapability.prompt,
+            HarnessCapability.stop,
+          }
+        : const <HarnessCapability>{
+            HarnessCapability.transcript,
+            HarnessCapability.prompt,
+            HarnessCapability.approve,
+            HarnessCapability.stop,
+          },
+    cwd: session.cwd.isEmpty ? null : session.cwd,
+    updatedAt: session.updatedAt,
+    sourceRef: session.id,
+  );
+}
+
+/// One Herdr pane on the paired computer.
+HarnessSessionInfo remoteHerdrSessionInfo({
+  required String hostId,
+  required herdr.HerdrAgent agent,
+}) => HarnessSessionInfo(
+  id: 'herdr:${agent.paneId}',
+  hostId: hostId,
+  providerId: agent.agentKind.isEmpty ? 'herdr' : agent.agentKind,
+  title: agent.terminalTitle.isNotEmpty
+      ? agent.terminalTitle
+      : (agent.name?.isNotEmpty == true ? agent.name! : agent.displayName),
+  status: remoteHerdrStatus(agent.status),
+  capabilities: const <HarnessCapability>{
+    HarnessCapability.terminal,
+    HarnessCapability.prompt,
+    HarnessCapability.stop,
+  },
+  cwd: agent.cwd.isEmpty ? null : agent.cwd,
+  sourceRef: agent.paneId,
+);
+
+/// One Codex thread from the paired computer's catalog.
+HarnessSessionInfo remoteCodexSessionInfo({
+  required String hostId,
+  required protocol.CodexThread thread,
+}) => HarnessSessionInfo(
+  id: 'codex:${thread.id}',
+  hostId: hostId,
+  providerId: 'codex',
+  title: thread.title.isEmpty ? 'Codex' : thread.title,
+  status: remoteCodexStatus(thread.status),
+  capabilities: const <HarnessCapability>{
+    HarnessCapability.transcript,
+    HarnessCapability.prompt,
+    HarnessCapability.approve,
+  },
+  cwd: thread.cwd.isEmpty ? null : thread.cwd,
+  updatedAt: thread.updatedAt,
+  sourceRef: thread.id,
+);
+
+/// One stored session event as a transcript entry, or null when the event is
+/// not conversation (terminal bytes belong to the terminal channel).
+TranscriptEvent? transcriptFromSessionEvent(
+  protocol.SessionEvent event,
+  String sessionId,
+) {
+  final id = '$sessionId:${event.seq}';
+  final at = event.ts;
+  switch (event) {
+    case protocol.UserEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.user,
+        text: event.text,
+        at: at,
+      );
+    case protocol.AssistantEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.assistant,
+        text: event.text,
+        at: at,
+      );
+    case protocol.ThinkingEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.assistant,
+        text: event.text,
+        at: at,
+      );
+    case protocol.ToolUseEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.tool,
+        text: event.summary.isEmpty ? event.name : event.summary,
+        at: at,
+      );
+    case protocol.ToolResultEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.tool,
+        text: event.content,
+        at: at,
+      );
+    case protocol.PermissionRequestEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.tool,
+        text: event.title.isEmpty
+            ? (event.description ?? event.toolName)
+            : event.title,
+        at: at,
+        requestId: event.requestId,
+        options: _permissionOptions(event),
+      );
+    case protocol.PermissionResolvedEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.system,
+        text: '已处理权限请求：${event.decision}',
+        at: at,
+      );
+    case protocol.ResultEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.system,
+        text: event.text,
+        at: at,
+      );
+    case protocol.SystemEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.system,
+        text: event.text,
+        at: at,
+      );
+    case protocol.ErrorEvent():
+      return TranscriptEvent(
+        id: id,
+        role: TranscriptRole.system,
+        text: event.text,
+        at: at,
+      );
+    case protocol.TerminalOutputEvent():
+      return null;
+    case protocol.UnknownEvent():
+      return null;
+  }
+}
+
+/// Options a reply can carry for one permission card.
+///
+/// A question only accepts its listed labels; a plain permission request accepts
+/// the three wire decisions. Approval is never implied — the caller has to send
+/// an explicit [HarnessReply].
+List<String> _permissionOptions(protocol.PermissionRequestEvent event) {
+  final questions = event.questions;
+  if (questions != null && questions.isNotEmpty) {
+    return <String>[
+      for (final question in questions)
+        for (final option in question.options) option.label,
+    ];
+  }
+  return <String>['allow', if (event.canAlwaysAllow) 'allow_always', 'deny'];
+}
+
+/// One Codex transcript item as a harness transcript entry.
+TranscriptEvent codexItemTranscript(
+  protocol.CodexTurn turn,
+  protocol.CodexItem item, {
+  required String threadId,
+}) {
+  final kind = item.kind.toLowerCase();
+  final role = switch (kind) {
+    'user' || 'usermessage' => TranscriptRole.user,
+    'assistant' || 'agentmessage' || 'message' => TranscriptRole.assistant,
+    'reasoning' || 'thinking' => TranscriptRole.assistant,
+    'tool' || 'toolcall' || 'tooluse' || 'command' => TranscriptRole.tool,
+    _ => TranscriptRole.system,
+  };
+  return TranscriptEvent(
+    id: '$threadId:${turn.id}:${item.id}',
+    role: role,
+    text: item.text,
+  );
+}
+
+/// One pending Codex approval as a transcript entry that can be replied to.
+TranscriptEvent codexPendingTranscript(
+  protocol.CodexPendingRequest request, {
+  required String threadId,
+}) {
+  final options = <String>[
+    for (final question in request.questions)
+      for (final option in question.options) option.label,
+  ];
+  return TranscriptEvent(
+    id: '$threadId:request:${request.requestId}',
+    role: TranscriptRole.tool,
+    text: request.title.isEmpty
+        ? (request.description ?? request.kind)
+        : request.title,
+    requestId: request.requestId,
+    options: options.isEmpty ? const <String>['accept', 'deny'] : options,
+  );
+}
diff --git a/lib/harness/remote/remote_ports.dart b/lib/harness/remote/remote_ports.dart
new file mode 100644
index 0000000000000000000000000000000000000000..7c95b14b5643427f1d5eb456832429e90197637e
--- /dev/null
+++ b/lib/harness/remote/remote_ports.dart
@@ -0,0 +1,368 @@
+// Narrow ports over the existing remote-control module.
+//
+// RemoteHarnessHost must not reach into RemoteController's internals, and it
+// must be testable without a socket, a relay or a paired computer. These three
+// interfaces are the whole surface the harness layer uses; the `...Adapter`
+// classes below delegate to the real controllers and hold no logic of their own.
+//
+// Deliberately unchanged by this file: the wire protocol, request ids, reconnect
+// and replay semantics, and the rule that approvals only ever follow an explicit
+// user reply. The adapters forward and nothing else.
+
+import 'package:flutter/foundation.dart';
+
+import '../../remote_control/models/herdr.dart'
+    show HerdrActionReport, HerdrAgent, HerdrOutput, HerdrReadSource;
+import '../../remote_control/models/protocol.dart'
+    show
+        CodexPage,
+        CodexPendingRequest,
+        CodexProject,
+        CodexThread,
+        CodexTranscript,
+        CodexTurn,
+        SessionInfo;
+import '../../remote_control/state/codex_thread_view.dart';
+import '../../remote_control/state/herdr_controller.dart';
+import '../../remote_control/state/remote_controller.dart';
+import '../../remote_control/state/session_view.dart';
+
+/// Everything the harness layer needs from one paired computer's sessions.
+abstract interface class RemoteSessionPort {
+  /// Fires when the connection, the agent or the session list changes.
+  Listenable get changes;
+
+  bool get isOnline;
+
+  ConnectionPhase get phase;
+
+  /// Computer name to show as the host label.
+  String get hostLabel;
+
+  /// Stable pairing id; falls back to the relay host when unnamed.
+  String get hostId;
+
+  List<SessionInfo> get sessions;
+
+  SessionView view(SessionInfo info);
+
+  Future<void> refreshSessions();
+
+  Future<void> subscribe(String id, {required Object owner});
+
+  void unsubscribe(String id, {required Object owner});
+
+  Future<void> send(String id, String text);
+
+  Future<void> respondPermission(
+    String id,
+    String requestId,
+    String decision, {
+    String? message,
+    Map<String, String>? answers,
+  });
+
+  Future<void> terminalInput(String id, String data);
+
+  Future<void> terminalResize(String id, int cols, int rows);
+
+  Future<void> closeSession(String id);
+
+  Future<SessionInfo> createSession({required String cwd, String? prompt});
+
+  Future<SessionInfo> createTerminal({required String cwd});
+}
+
+/// Delegates to the real [RemoteController]; no behaviour is added.
+class RemoteControllerSessionAdapter implements RemoteSessionPort {
+  RemoteControllerSessionAdapter(this.controller);
+
+  final RemoteController controller;
+
+  @override
+  Listenable get changes => controller;
+
+  @override
+  bool get isOnline => controller.isOnline;
+
+  @override
+  ConnectionPhase get phase => controller.phase;
+
+  @override
+  String get hostLabel => controller.agentName;
+
+  @override
+  String get hostId {
+    final pairing = controller.pairing;
+    if (pairing != null && pairing.agentId.isNotEmpty) return pairing.agentId;
+    return controller.agent?.host ?? 'remote';
+  }
+
+  @override
+  List<SessionInfo> get sessions => controller.sessions;
+
+  @override
+  SessionView view(SessionInfo info) => controller.view(info);
+
+  @override
+  Future<void> refreshSessions() => controller.refreshSessions();
+
+  @override
+  Future<void> subscribe(String id, {required Object owner}) =>
+      controller.subscribe(id, owner: owner);
+
+  @override
+  void unsubscribe(String id, {required Object owner}) =>
+      controller.unsubscribe(id, owner: owner);
+
+  @override
+  Future<void> send(String id, String text) => controller.send(id, text);
+
+  @override
+  Future<void> respondPermission(
+    String id,
+    String requestId,
+    String decision, {
+    String? message,
+    Map<String, String>? answers,
+  }) => controller.respondPermission(
+    id,
+    requestId,
+    decision,
+    message: message,
+    answers: answers,
+  );
+
+  @override
+  Future<void> terminalInput(String id, String data) =>
+      controller.terminalInput(id, data);
+
+  @override
+  Future<void> terminalResize(String id, int cols, int rows) =>
+      controller.terminalResize(id, cols, rows);
+
+  @override
+  Future<void> closeSession(String id) => controller.closeSession(id);
+
+  @override
+  Future<SessionInfo> createSession({required String cwd, String? prompt}) =>
+      controller.createSession(cwd: cwd, prompt: prompt);
+
+  @override
+  Future<SessionInfo> createTerminal({required String cwd}) =>
+      controller.createTerminal(cwd: cwd);
+}
+
+/// Herdr panes on the paired computer.
+abstract interface class RemoteHerdrPort {
+  Listenable get changes;
+
+  bool get canControl;
+
+  List<HerdrAgent> get agents;
+
+  /// Last pushed screen text for [paneId]; empty before the first push.
+  String paneText(String paneId);
+
+  Future<void> refresh();
+
+  Future<HerdrOutput> read(String paneId, {HerdrReadSource source, int lines});
+
+  Future<HerdrActionReport> sendText(String paneId, String text);
+
+  Future<HerdrActionReport> sendKeys(String paneId, List<String> keys);
+
+  Future<HerdrActionReport> prompt(String paneId, String text);
+
+  /// Closes a pane (ending the session). Callers confirm first.
+  Future<void> closePane(String paneId);
+}
+
+/// Delegates to the existing [HerdrController].
+class HerdrControllerAdapter implements RemoteHerdrPort {
+  HerdrControllerAdapter({required this.controller, required this.remote});
+
+  final HerdrController controller;
+  final RemoteController remote;
+
+  @override
+  Listenable get changes => controller;
+
+  @override
+  bool get canControl => controller.canControl;
+
+  @override
+  List<HerdrAgent> get agents => controller.agents;
+
+  @override
+  String paneText(String paneId) => controller.paneText(paneId);
+
+  @override
+  Future<void> refresh() => controller.refresh();
+
+  @override
+  Future<HerdrOutput> read(
+    String paneId, {
+    HerdrReadSource source = HerdrReadSource.recent,
+    int lines = 200,
+  }) => controller.read(paneId, source: source, lines: lines);
+
+  @override
+  Future<HerdrActionReport> sendText(String paneId, String text) =>
+      controller.sendText(paneId, text);
+
+  @override
+  Future<HerdrActionReport> sendKeys(String paneId, List<String> keys) =>
+      controller.sendKeys(paneId, keys);
+
+  @override
+  Future<HerdrActionReport> prompt(String paneId, String text) =>
+      controller.prompt(paneId, text);
+
+  @override
+  Future<void> closePane(String paneId) async {
+    await remote.herdrAct(<String, dynamic>{
+      'kind': 'pane_close',
+      'paneId': paneId,
+    });
+  }
+}
+
+/// The desktop Codex catalog and thread transcript.
+abstract interface class RemoteCodexPort {
+  bool get available;
+
+  bool get canControl;
+
+  /// First page of the most recent threads, newest first as the desktop ranks
+  /// them.
+  Future<List<CodexThread>> recentThreads();
+
+  Future<CodexTranscript> read(String threadId, {String? cursor});
+
+  Future<void> send(String threadId, String text, {String? turnId});
+
+  Future<void> respond(
+    String threadId,
+    String requestId,
+    String decision, {
+    Map<String, List<String>>? answers,
+  });
+
+  Future<void> interrupt(String threadId, String turnId);
+
+  Future<CodexPage<CodexProject>> projects({String? cursor});
+
+  /// Opens one thread transcript. Reuses the module's [CodexThreadView] rather
+  /// than re-implementing paging, notices and its polling fallback.
+  RemoteCodexThreadView openThread(CodexThread thread);
+}
+
+/// One Codex thread as the harness layer sees it.
+abstract interface class RemoteCodexThreadView {
+  Listenable get changes;
+
+  CodexThread get thread;
+
+  List<CodexTurn> get turns;
+
+  List<CodexPendingRequest> get pendingRequests;
+
+  String? get error;
+
+  bool get loaded;
+
+  bool get canControl;
+
+  bool get canSend;
+
+  Future<void> load({bool refresh});
+
+  Future<void> dispose();
+}
+
+/// Adapts the real [CodexThreadView].
+class CodexThreadViewAdapter implements RemoteCodexThreadView {
+  CodexThreadViewAdapter(this._view);
+
+  final CodexThreadView _view;
+
+  @override
+  Listenable get changes => _view;
+
+  @override
+  CodexThread get thread => _view.thread;
+
+  @override
+  List<CodexTurn> get turns => List<CodexTurn>.unmodifiable(_view.turns);
+
+  @override
+  List<CodexPendingRequest> get pendingRequests =>
+      List<CodexPendingRequest>.unmodifiable(_view.pendingRequests);
+
+  @override
+  String? get error => _view.error;
+
+  @override
+  bool get loaded => _view.loaded;
+
+  @override
+  bool get canControl => _view.canControl;
+
+  @override
+  bool get canSend => _view.canSend;
+
+  @override
+  Future<void> load({bool refresh = false}) => _view.load(refresh: refresh);
+
+  @override
+  Future<void> dispose() async => _view.dispose();
+}
+
+/// Delegates to the existing [RemoteController] Codex calls.
+class RemoteControllerCodexAdapter implements RemoteCodexPort {
+  RemoteControllerCodexAdapter(this.controller);
+
+  final RemoteController controller;
+
+  @override
+  bool get available => controller.agent?.codex?.available == true;
+
+  @override
+  bool get canControl => controller.agent?.codex?.canControl == true;
+
+  @override
+  Future<List<CodexThread>> recentThreads() async {
+    final page = await controller.codexThreads();
+    return page.items;
+  }
+
+  @override
+  Future<CodexTranscript> read(String threadId, {String? cursor}) =>
+      controller.codexRead(threadId, cursor: cursor);
+
+  @override
+  Future<void> send(String threadId, String text, {String? turnId}) =>
+      controller.codexSend(threadId, text, turnId: turnId);
+
+  @override
+  Future<void> respond(
+    String threadId,
+    String requestId,
+    String decision, {
+    Map<String, List<String>>? answers,
+  }) =>
+      controller.codexRespond(threadId, requestId, decision, answers: answers);
+
+  @override
+  Future<void> interrupt(String threadId, String turnId) =>
+      controller.codexInterrupt(threadId, turnId);
+
+  @override
+  Future<CodexPage<CodexProject>> projects({String? cursor}) =>
+      controller.codexProjects(cursor: cursor);
+
+  @override
+  RemoteCodexThreadView openThread(CodexThread thread) =>
+      CodexThreadViewAdapter(CodexThreadView(controller, thread));
+}
diff --git a/lib/harness/remote/remote_session.dart b/lib/harness/remote/remote_session.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9d23d2373f42dcee0c287d816efa988e6979c615
--- /dev/null
+++ b/lib/harness/remote/remote_session.dart
@@ -0,0 +1,453 @@
+// Open handles for the paired computer.
+//
+// Three kinds share one contract: a Claude/terminal session, a Herdr pane, and a
+// Codex thread. They differ only in which remote controller answers the verb:
+//
+//   * Claude/terminal → RemoteController.send / respondPermission /
+//     terminalInput / closeSession
+//   * Herdr pane      → HerdrController.sendText / sendKeys / prompt, pane_close
+//   * Codex thread    → RemoteController.codexSend / codexRespond
+//
+// Two invariants hold in all three:
+//   * `detach()` releases the view. It never sends `session_close` or closes a
+//     pane, so the session keeps running on the desktop.
+//   * `reply()` is the only path that sends an approval, and an unknown decision
+//     is treated as a refusal — never as consent.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../../remote_control/models/herdr.dart' as herdr;
+import '../../remote_control/models/protocol.dart' as protocol;
+import '../../remote_control/state/session_view.dart';
+import '../harness_host.dart';
+import '../herdr/herdr_terminal.dart';
+import 'remote_mapping.dart';
+import 'remote_ports.dart';
+import 'remote_terminal.dart';
+
+/// A Claude or shell session on the paired computer.
+class RemoteSessionHandle implements HarnessSessionHandle {
+  RemoteSessionHandle({
+    required RemoteSessionPort port,
+    required protocol.SessionInfo session,
+    required String hostId,
+    required Future<void> Function(RemoteSessionHandle handle) onDetached,
+  }) : _port = port,
+       _session = session,
+       _hostId = hostId,
+       _onDetached = onDetached,
+       _owner = Object() {
+    _view = port.view(session);
+    _status = RemoteSessionStatusNotifier(view: _view, initial: session.status);
+    if (session.isTerminal) {
+      _terminal = RemoteTerminalChannel(
+        view: _view,
+        port: port,
+        sessionId: session.id,
+      );
+    } else {
+      _transcript = RemoteTranscriptFeed(
+        view: _view,
+        port: port,
+        sessionId: session.id,
+        owner: _owner,
+      );
+    }
+  }
+
+  final RemoteSessionPort _port;
+  final protocol.SessionInfo _session;
+  final String _hostId;
+  final Future<void> Function(RemoteSessionHandle handle) _onDetached;
+  final Object _owner;
+
+  late final SessionView _view;
+  late final RemoteSessionStatusNotifier _status;
+  RemoteTranscriptFeed? _transcript;
+  RemoteTerminalChannel? _terminal;
+  bool _detached = false;
+  bool _stopped = false;
+
+  @override
+  HarnessSessionInfo get info =>
+      remoteSessionInfo(hostId: _hostId, session: _view.info);
+
+  @override
+  ValueListenable<HarnessSessionStatus> get status => _status;
+
+  @override
+  Stream<TranscriptEvent>? get transcript => _transcript?.stream;
+
+  @override
+  HarnessTerminalChannel? get terminal => _terminal;
+
+  @override
+  Future<void> sendPrompt(String text) async {
+    if (text.trim().isEmpty) return;
+    if (_session.isTerminal) {
+      // A shell has no prompt verb: type the line and press Enter.
+      await _port.terminalInput(_session.id, '${text.trim()}\r');
+      return;
+    }
+    await _port.send(_session.id, text);
+  }
+
+  @override
+  Future<void> reply(HarnessReply reply) async {
+    final request = _pendingRequest(reply.requestId);
+    if (request == null) {
+      throw StateError('该权限请求已失效或已被处理');
+    }
+    if (request.isQuestion) {
+      final answers = <String, String>{};
+      final chosen = reply.choice.trim();
+      for (final question in request.questions!) {
+        final matches = question.options.any(
+          (option) => option.label == chosen,
+        );
+        final answer = matches ? chosen : (reply.text?.trim() ?? '');
+        if (answer.isNotEmpty) answers[question.question] = answer;
+      }
+      if (answers.isEmpty) {
+        throw StateError('请先填写问题答案');
+      }
+      await _port.respondPermission(
+        _session.id,
+        reply.requestId,
+        'allow',
+        answers: answers,
+      );
+      return;
+    }
+    const decisions = <String>{'allow', 'allow_always', 'deny'};
+    // Anything unrecognised is a refusal: failing closed is the only safe
+    // default for an approval.
+    final decision = decisions.contains(reply.choice) ? reply.choice : 'deny';
+    await _port.respondPermission(
+      _session.id,
+      reply.requestId,
+      decision,
+      message: reply.text,
+    );
+  }
+
+  protocol.PermissionRequestEvent? _pendingRequest(String requestId) {
+    for (final event in _view.events.reversed) {
+      if (event is protocol.PermissionRequestEvent &&
+          event.requestId == requestId &&
+          _view.resolutionFor(requestId) == null) {
+        return event;
+      }
+    }
+    return null;
+  }
+
+  /// Releases the view only. The desktop session keeps running.
+  @override
+  Future<void> detach() async {
+    if (_detached) return;
+    _detached = true;
+    await _transcript?.close();
+    await _terminal?.close();
+    _port.unsubscribe(_session.id, owner: _owner);
+    await _onDetached(this);
+  }
+
+  /// Ends the desktop session. Callers confirm first.
+  @override
+  Future<void> stop() async {
+    if (_stopped) return;
+    _stopped = true;
+    await _transcript?.close();
+    await _terminal?.close();
+    await _port.closeSession(_session.id);
+    _status.value = HarnessSessionStatus.exited;
+  }
+
+  void dispose() {
+    if (!_detached) {
+      _detached = true;
+      unawaited(_transcript?.close());
+      unawaited(_terminal?.close());
+      _port.unsubscribe(_session.id, owner: _owner);
+    }
+    _status.dispose();
+  }
+}
+
+/// A Herdr pane on the paired computer.
+class RemoteHerdrHandle implements HarnessSessionHandle {
+  RemoteHerdrHandle({
+    required RemoteHerdrPort herdrPort,
+    required herdr.HerdrAgent agent,
+    required String hostId,
+    required Future<void> Function(RemoteHerdrHandle handle) onDetached,
+  }) : _herdr = herdrPort,
+       _agent = agent,
+       _hostId = hostId,
+       _onDetached = onDetached,
+       _status = ValueNotifier<HarnessSessionStatus>(
+         remoteHerdrStatus(agent.status),
+       ) {
+    _terminal = HerdrSnapshotTerminal(
+      readPane: () async => _herdr.paneText(paneId),
+      sendText: (text) => _herdr.sendText(paneId, text),
+      sendKeys: (keys) => _herdr.sendKeys(paneId, keys),
+      changes: herdrPort.changes,
+    )..start();
+  }
+
+  final RemoteHerdrPort _herdr;
+  final String _hostId;
+  final Future<void> Function(RemoteHerdrHandle handle) _onDetached;
+  final ValueNotifier<HarnessSessionStatus> _status;
+  HerdrSnapshotTerminal? _terminal;
+
+  herdr.HerdrAgent _agent;
+  bool _detached = false;
+  bool _stopped = false;
+
+  String get paneId => _agent.paneId;
+
+  /// Applies a fresher row from the desktop's Herdr push.
+  void update(herdr.HerdrAgent agent) {
+    _agent = agent;
+    _status.value = remoteHerdrStatus(agent.status);
+  }
+
+  /// The pane vanished from the desktop's list (closed elsewhere).
+  void markExited() {
+    _status.value = HarnessSessionStatus.exited;
+  }
+
+  @override
+  HarnessSessionInfo get info =>
+      remoteHerdrSessionInfo(hostId: _hostId, agent: _agent);
+
+  @override
+  ValueListenable<HarnessSessionStatus> get status => _status;
+
+  /// Herdr has no structured transcript on the wire either.
+  @override
+  Stream<TranscriptEvent>? get transcript => null;
+
+  @override
+  HarnessTerminalChannel? get terminal => _terminal;
+
+  @override
+  Future<void> sendPrompt(String text) async {
+    if (text.trim().isEmpty) return;
+    await _herdr.prompt(_agent.paneId, text);
+  }
+
+  @override
+  Future<void> reply(HarnessReply reply) async {
+    throw UnsupportedError('Herdr 面板没有结构化审批，请在终端中直接回答。');
+  }
+
+  @override
+  Future<void> detach() async {
+    if (_detached) return;
+    _detached = true;
+    await _terminal?.close();
+    _terminal = null;
+    await _onDetached(this);
+  }
+
+  @override
+  Future<void> stop() async {
+    if (_stopped) return;
+    _stopped = true;
+    await _terminal?.close();
+    _terminal = null;
+    await _herdr.closePane(_agent.paneId);
+    _status.value = HarnessSessionStatus.exited;
+  }
+
+  void dispose() {
+    if (!_detached) {
+      _detached = true;
+      unawaited(_terminal?.close());
+      _terminal = null;
+    }
+    _status.dispose();
+  }
+}
+
+/// A Codex thread on the paired computer.
+class RemoteCodexThreadHandle implements HarnessSessionHandle {
+  RemoteCodexThreadHandle({
+    required RemoteCodexPort codex,
+    required RemoteCodexThreadView view,
+    required String hostId,
+    required Future<void> Function(RemoteCodexThreadHandle handle) onDetached,
+  }) : _codex = codex,
+       _view = view,
+       _hostId = hostId,
+       _onDetached = onDetached {
+    _status = ValueNotifier<HarnessSessionStatus>(
+      remoteCodexStatus(view.thread.status),
+    );
+    _feed = _CodexTranscriptFeed(view: view);
+    unawaited(_view.load(refresh: true));
+  }
+
+  final RemoteCodexPort _codex;
+  final RemoteCodexThreadView _view;
+  final String _hostId;
+  final Future<void> Function(RemoteCodexThreadHandle handle) _onDetached;
+  late final ValueNotifier<HarnessSessionStatus> _status;
+  late final _CodexTranscriptFeed _feed;
+  bool _detached = false;
+  bool _stopped = false;
+
+  @override
+  HarnessSessionInfo get info =>
+      remoteCodexSessionInfo(hostId: _hostId, thread: _view.thread);
+
+  @override
+  ValueListenable<HarnessSessionStatus> get status => _status;
+
+  @override
+  Stream<TranscriptEvent>? get transcript => _feed.stream;
+
+  @override
+  HarnessTerminalChannel? get terminal => null;
+
+  @override
+  Future<void> sendPrompt(String text) async {
+    if (text.trim().isEmpty) return;
+    final thread = _view.thread;
+    await _codex.send(thread.id, text, turnId: thread.activeTurnId);
+    await _view.load(refresh: true);
+  }
+
+  @override
+  Future<void> reply(HarnessReply reply) async {
+    protocol.CodexPendingRequest? pending;
+    for (final request in _view.pendingRequests) {
+      if (request.requestId == reply.requestId) {
+        pending = request;
+        break;
+      }
+    }
+    if (pending == null) {
+      throw StateError('该审批已失效或已被处理');
+    }
+    final chosen = reply.choice.trim();
+    final isAccept =
+        chosen == 'accept' || chosen == 'allow' || chosen == 'allow_always';
+    final answers = <String, List<String>>{};
+    if (isAccept && pending.questions.isNotEmpty) {
+      for (final question in pending.questions) {
+        final matches = question.options.any(
+          (option) => option.label == chosen,
+        );
+        final answer = matches ? chosen : (reply.text?.trim() ?? '');
+        if (answer.isNotEmpty) answers[question.id] = <String>[answer];
+      }
+    }
+    await _codex.respond(
+      _view.thread.id,
+      reply.requestId,
+      isAccept ? 'accept' : 'deny',
+      answers: answers.isEmpty ? null : answers,
+    );
+    await _view.load(refresh: true);
+  }
+
+  @override
+  Future<void> detach() async {
+    if (_detached) return;
+    _detached = true;
+    await _feed.close();
+    await _onDetached(this);
+  }
+
+  /// A Codex thread is a conversation, not a process: interrupting the active
+  /// turn is the closest safe equivalent of "stop".
+  @override
+  Future<void> stop() async {
+    if (_stopped) return;
+    _stopped = true;
+    final thread = _view.thread;
+    final turnId = thread.activeTurnId;
+    if (turnId != null) {
+      await _codex.interrupt(thread.id, turnId);
+    }
+    await detach();
+  }
+
+  Future<void> dispose() async {
+    if (!_detached) {
+      _detached = true;
+      await _feed.close();
+    }
+    await _view.dispose();
+    _status.dispose();
+  }
+}
+
+/// Emits the Codex transcript as harness entries, including pending approvals.
+class _CodexTranscriptFeed {
+  _CodexTranscriptFeed({required RemoteCodexThreadView view}) : _view = view {
+    _controller = StreamController<TranscriptEvent>.broadcast(
+      onListen: _start,
+      onCancel: _stop,
+    );
+  }
+
+  final RemoteCodexThreadView _view;
+  late final StreamController<TranscriptEvent> _controller;
+  final Set<String> _emitted = <String>{};
+  bool _listening = false;
+  bool _closed = false;
+
+  Stream<TranscriptEvent> get stream => _controller.stream;
+
+  void _start() {
+    if (_closed || _listening) return;
+    _listening = true;
+    _view.changes.addListener(_pump);
+    _pump();
+  }
+
+  void _stop() {
+    if (!_listening) return;
+    _listening = false;
+    _view.changes.removeListener(_pump);
+  }
+
+  void _pump() {
+    if (_closed) return;
+    final thread = _view.thread;
+    for (final turn in _view.turns) {
+      for (final item in turn.items) {
+        final entry = codexItemTranscript(turn, item, threadId: thread.id);
+        if (_emitted.add(entry.id)) _controller.add(entry);
+      }
+    }
+    for (final request in _view.pendingRequests) {
+      final entry = codexPendingTranscript(request, threadId: thread.id);
+      if (_emitted.add(entry.id)) _controller.add(entry);
+    }
+    final error = _view.error;
+    if (error != null && error.isNotEmpty) {
+      final entry = TranscriptEvent(
+        id: '${thread.id}:error:$error',
+        role: TranscriptRole.system,
+        text: error,
+      );
+      if (_emitted.add(entry.id)) _controller.add(entry);
+    }
+  }
+
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    _stop();
+    await _controller.close();
+  }
+}
diff --git a/lib/harness/remote/remote_terminal.dart b/lib/harness/remote/remote_terminal.dart
new file mode 100644
index 0000000000000000000000000000000000000000..5ebf3fb4ab3a16495115933f96f01d3996e97f12
--- /dev/null
+++ b/lib/harness/remote/remote_terminal.dart
@@ -0,0 +1,188 @@
+// Raw terminal and transcript feeds over an open remote session.
+//
+// Both are views: they subscribe to what the screen already receives and never
+// start or stop desktop work. Releasing one (`close`/`detach`) cancels the local
+// listener and releases the route's subscription owner; it sends no
+// `session_close`, so the agent keeps running and reappears on reconnect.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+
+import '../../remote_control/models/protocol.dart' as protocol;
+import '../../remote_control/state/session_view.dart';
+import '../harness_host.dart';
+import 'remote_mapping.dart';
+import 'remote_ports.dart';
+
+/// Replays terminal bytes from a remote PTY session.
+class RemoteTerminalChannel implements HarnessTerminalChannel {
+  RemoteTerminalChannel({
+    required SessionView view,
+    required RemoteSessionPort port,
+    required String sessionId,
+  }) : _view = view,
+       _port = port,
+       _sessionId = sessionId {
+    _view.addListener(_pump);
+    // The backlog may already hold output; replay it so opening the terminal a
+    // second time still shows the screen instead of an empty one.
+    for (final event in _view.events) {
+      if (event is protocol.TerminalOutputEvent) _emit(event.data);
+      _lastSeq = event.seq;
+    }
+  }
+
+  final SessionView _view;
+  final RemoteSessionPort _port;
+  final String _sessionId;
+  final StreamController<Uint8List> _output =
+      StreamController<Uint8List>.broadcast();
+  int _lastSeq = 0;
+  bool _closed = false;
+
+  @override
+  Stream<Uint8List> get output => _output.stream;
+
+  @override
+  void write(Uint8List data) {
+    if (_closed || data.isEmpty) return;
+    // The wire carries exact bytes as a string; malformed sequences are kept
+    // rather than dropped, because a truncated key sequence is still input.
+    unawaited(
+      _port
+          .terminalInput(_sessionId, utf8.decode(data, allowMalformed: true))
+          .catchError((Object _) {}),
+    );
+  }
+
+  @override
+  void resize(int columns, int rows) {
+    if (_closed) return;
+    unawaited(
+      _port.terminalResize(_sessionId, columns, rows).catchError((Object _) {}),
+    );
+  }
+
+  void _pump() {
+    if (_closed) return;
+    for (final event in _view.events) {
+      if (event.seq <= _lastSeq) continue;
+      _lastSeq = event.seq;
+      if (event is protocol.TerminalOutputEvent) _emit(event.data);
+    }
+  }
+
+  void _emit(String data) {
+    if (_closed || data.isEmpty) return;
+    _output.add(Uint8List.fromList(utf8.encode(data)));
+  }
+
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    _view.removeListener(_pump);
+    await _output.close();
+  }
+}
+
+/// Conversation feed for a remote Claude session.
+///
+/// A broadcast controller with lazy subscription: nothing is subscribed on the
+/// desktop until a widget actually listens, and the first listener gets the
+/// existing history followed by live events.
+class RemoteTranscriptFeed {
+  RemoteTranscriptFeed({
+    required SessionView view,
+    required RemoteSessionPort port,
+    required String sessionId,
+    required Object owner,
+  }) : _view = view,
+       _port = port,
+       _sessionId = sessionId,
+       _owner = owner;
+
+  final SessionView _view;
+  final RemoteSessionPort _port;
+  final String _sessionId;
+  final Object _owner;
+
+  late final StreamController<TranscriptEvent> _controller =
+      StreamController<TranscriptEvent>.broadcast(
+        onListen: _start,
+        onCancel: _stop,
+      );
+
+  int _lastSeq = 0;
+  bool _started = false;
+  bool _closed = false;
+
+  Stream<TranscriptEvent> get stream => _controller.stream;
+
+  void _start() {
+    if (_closed || _started) return;
+    _started = true;
+    _view.addListener(_pump);
+    unawaited(
+      _port.subscribe(_sessionId, owner: _owner).catchError((Object _) {}),
+    );
+    _pump();
+  }
+
+  void _stop() {
+    if (!_started) return;
+    _started = false;
+    _view.removeListener(_pump);
+    _port.unsubscribe(_sessionId, owner: _owner);
+  }
+
+  void _pump() {
+    if (_closed) return;
+    for (final event in _view.events) {
+      if (event.seq <= _lastSeq) continue;
+      _lastSeq = event.seq;
+      final entry = transcriptFromSessionEvent(event, _sessionId);
+      if (entry != null) _controller.add(entry);
+    }
+  }
+
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    _stop();
+    await _controller.close();
+  }
+}
+
+/// Live status of one remote session, kept in a [ValueNotifier] as the contract
+/// asks. Listens to the view so a status change repaints only that row.
+class RemoteSessionStatusNotifier extends ValueNotifier<HarnessSessionStatus> {
+  RemoteSessionStatusNotifier({
+    required SessionView view,
+    required protocol.SessionStatus initial,
+  }) : _view = view,
+       super(remoteSessionStatus(initial)) {
+    _view.addListener(_sync);
+  }
+
+  final SessionView _view;
+
+  void _sync() {
+    if (_disposed) return;
+    if (_view.gone) {
+      value = HarnessSessionStatus.exited;
+      return;
+    }
+    value = remoteSessionStatus(_view.info.status);
+  }
+
+  bool _disposed = false;
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _view.removeListener(_sync);
+    super.dispose();
+  }
+}
