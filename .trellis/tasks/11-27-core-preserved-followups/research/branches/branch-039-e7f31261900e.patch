@@ -0,0 +1,758 @@
+// The only place that speaks to the `herdr` CLI.
+//
+// Everything goes through the public command surface (`agent list`, `agent
+// prompt`, `pane read`, ...). HerdrHost never reads Herdr's socket, config or
+// state files: those are private to Herdr, and a version bump may move them.
+//
+// Process creation is injected as [HerdrProcessRunner] so tests assert argv and
+// parse fixtures without spawning anything. `herdr` is never run through a
+// shell: every argument is one argv element, so text that contains spaces,
+// quotes or `;` reaches Herdr literally.
+
+import 'dart:async';
+import 'dart:convert';
+
+import '../harness_host.dart' show HarnessCapability;
+import 'herdr_models.dart';
+
+typedef Json = Map<String, dynamic>;
+
+/// Outcome of one CLI invocation.
+class HerdrProcessResult {
+  const HerdrProcessResult({
+    required this.exitCode,
+    this.stdout = '',
+    this.stderr = '',
+    this.timedOut = false,
+    this.spawnError,
+  });
+
+  final int exitCode;
+  final String stdout;
+  final String stderr;
+  final bool timedOut;
+
+  /// `ENOENT` when the binary vanished between discovery and the call.
+  final String? spawnError;
+
+  bool get succeeded => !timedOut && spawnError == null && exitCode == 0;
+}
+
+/// Starts `herdr` with [argv] and captures its output.
+///
+/// Implementations must not run a shell, must bound captured output and must
+/// kill the child when [timeout] expires.
+typedef HerdrProcessRunner =
+    Future<HerdrProcessResult> Function(
+      List<String> argv, {
+      String? workingDirectory,
+      required Duration timeout,
+    });
+
+/// Whether [path] exists and is executable. Injected so discovery is testable
+/// without touching the real filesystem.
+typedef HerdrPathProbe = bool Function(String path);
+
+/// Lists the subdirectories of [path]; empty when it does not exist.
+typedef HerdrDirectoryLister = List<String> Function(String path);
+
+/// Resolves the Herdr executable, or null when it is not installed.
+///
+/// The optional arguments of the platform implementation are deliberately not
+/// part of the type: a host only says "use the user setting if there is one".
+typedef HerdrExecutableLocator =
+    Future<String?> Function({String? explicitPath});
+
+/// Why a Herdr call failed, so the UI can branch without parsing prose.
+enum HerdrFailure {
+  /// The executable is missing or cannot run.
+  unavailable,
+
+  /// Herdr is installed but its server is not running.
+  serverDown,
+  invalidArgument,
+  notFound,
+  agentBlocked,
+  agentNotReady,
+  promptStalled,
+  timeout,
+  failed,
+}
+
+class HerdrException implements Exception {
+  const HerdrException(this.failure, this.message, {this.herdrCode});
+
+  final HerdrFailure failure;
+
+  /// Chinese, user-facing: the Agents surface shows this verbatim.
+  final String message;
+
+  /// Raw Herdr code (`agent_blocked`, `pane_not_found`, ...) when there is one.
+  final String? herdrCode;
+
+  @override
+  String toString() => message;
+}
+
+/// Typed wrapper over the `herdr` command line.
+class HerdrCli {
+  HerdrCli({
+    required this.executable,
+    required HerdrProcessRunner runner,
+    this.timeout = const Duration(seconds: 30),
+  }) : _runner = runner;
+
+  /// Absolute path, or the bare name when PATH resolution is intended.
+  final String executable;
+  final Duration timeout;
+  final HerdrProcessRunner _runner;
+
+  /// Herdr's own agent kinds. Reused from the remote-control mirror so the two
+  /// layers cannot drift.
+  static const List<String> agentKinds = <String>[
+    'pi',
+    'claude',
+    'codex',
+    'gemini',
+    'cursor',
+    'devin',
+    'agy',
+    'cline',
+    'omp',
+    'mastracode',
+    'opencode',
+    'copilot',
+    'kimi',
+    'kiro',
+    'droid',
+    'amp',
+    'grok',
+    'hermes',
+    'kilo',
+    'qodercli',
+    'qwen',
+    'letta',
+    'maki',
+    'muse',
+  ];
+
+  /// Logical key names accepted by `agent send-keys` / `pane send-keys`.
+  static const List<String> keyNames = <String>[
+    'enter',
+    'esc',
+    'tab',
+    'shift+tab',
+    'backspace',
+    'delete',
+    'up',
+    'down',
+    'left',
+    'right',
+    'home',
+    'end',
+    'pageup',
+    'pagedown',
+    'ctrl+a',
+    'ctrl+b',
+    'ctrl+c',
+    'ctrl+d',
+    'ctrl+e',
+    'ctrl+k',
+    'ctrl+l',
+    'ctrl+n',
+    'ctrl+p',
+    'ctrl+r',
+    'ctrl+u',
+    'ctrl+w',
+  ];
+
+  static final RegExp _paneId = RegExp(r'^w[0-9A-Za-z]+:p[0-9A-Za-z]+$');
+
+  static final RegExp _ctrlKey = RegExp(r'^ctrl\+[a-z]$');
+
+  static bool isPaneId(String value) => _paneId.hasMatch(value);
+
+  // -------------------------------------------------------------------------
+  // Discovery and health
+  // -------------------------------------------------------------------------
+
+  /// `herdr --version` → `0.9.3`, or throws [HerdrFailure.unavailable].
+  Future<String> version() async {
+    final result = await _invoke(const <String>['--version']);
+    if (result.timedOut) {
+      throw const HerdrException(HerdrFailure.timeout, '检查 Herdr 版本超时');
+    }
+    final match = RegExp(
+      r'^herdr\s+(\S+)\s*$',
+      multiLine: true,
+    ).firstMatch(result.stdout);
+    if (!result.succeeded || match == null) {
+      throw HerdrException(
+        HerdrFailure.unavailable,
+        _firstLine(result.stderr).isEmpty
+            ? '无法运行 Herdr（退出码 ${result.exitCode}）'
+            : '无法运行 Herdr：${_firstLine(result.stderr)}',
+      );
+    }
+    return match.group(1)!;
+  }
+
+  /// `herdr status` prints indented `key: value` text, not JSON.
+  Future<HerdrServerStatus> serverStatus() async {
+    final result = await _invoke(const <String>['status']);
+    if (!result.succeeded) {
+      throw HerdrException(
+        HerdrFailure.serverDown,
+        'Herdr 服务不可用：${_firstLine(result.stderr).isEmpty ? '退出码 ${result.exitCode}' : _firstLine(result.stderr)}',
+      );
+    }
+    return _parseStatus(result.stdout);
+  }
+
+  static HerdrServerStatus _parseStatus(String text) {
+    String? clientVersion;
+    int? clientProtocol;
+    String? serverVersion;
+    String? socket;
+    var serverRunning = false;
+    var section = '';
+    for (final rawLine in text.split(RegExp(r'\r?\n'))) {
+      if (rawLine.trim().isEmpty) continue;
+      final indented = RegExp(r'^\s').hasMatch(rawLine);
+      final match = RegExp(
+        r'^\s*([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$',
+      ).firstMatch(rawLine);
+      if (match == null) continue;
+      final key = match.group(1)!.toLowerCase();
+      final value = match.group(2)!.trim();
+      if (!indented && value.isEmpty) {
+        section = key;
+        continue;
+      }
+      if (section == 'client') {
+        if (key == 'version') clientVersion = value;
+        if (key == 'protocol') clientProtocol = int.tryParse(value);
+      } else if (section == 'server') {
+        if (key == 'status') serverRunning = value.toLowerCase() == 'running';
+        if (key == 'version') serverVersion = value;
+        if (key == 'socket') socket = value;
+      }
+    }
+    return HerdrServerStatus(
+      clientVersion: clientVersion,
+      clientProtocol: clientProtocol,
+      serverRunning: serverRunning,
+      serverVersion: serverVersion,
+      socket: socket,
+    );
+  }
+
+  // -------------------------------------------------------------------------
+  // Reads
+  // -------------------------------------------------------------------------
+
+  Future<List<HerdrAgentInfo>> agents() async {
+    final result = await _json(const <String>['agent', 'list']);
+    return _asList(result['agents']).map(HerdrAgentInfo.fromJson).toList();
+  }
+
+  Future<List<HerdrWorkspaceInfo>> workspaces() async {
+    final result = await _json(const <String>['workspace', 'list']);
+    return _asList(
+      result['workspaces'],
+    ).map(HerdrWorkspaceInfo.fromJson).toList();
+  }
+
+  Future<HerdrAgentInfo> agent(String target) async {
+    final result = await _json(<String>[
+      'agent',
+      'get',
+      _requireTarget(target),
+    ]);
+    final raw = result['agent'];
+    if (raw is! Json) {
+      throw const HerdrException(HerdrFailure.failed, 'Herdr 未返回 agent 信息');
+    }
+    return HerdrAgentInfo.fromJson(raw);
+  }
+
+  /// `pane read` prints raw screen text, not JSON.
+  Future<String> readPane(
+    String paneId, {
+    String source = 'recent',
+    int lines = 200,
+    bool ansi = false,
+  }) async {
+    final result = await _invoke(<String>[
+      'pane',
+      'read',
+      _requirePaneId(paneId),
+      '--source',
+      _requireReadSource(source),
+      '--lines',
+      '${lines < 1 ? 1 : lines}',
+      if (ansi) '--ansi',
+    ], timeout: timeout);
+    if (result.timedOut) {
+      throw HerdrException(HerdrFailure.timeout, '读取面板 $paneId 超时');
+    }
+    final raw = result.stdout;
+    // A failed read still prints a JSON error envelope; never show that as
+    // terminal output.
+    final error = _errorEnvelope(raw);
+    if (error != null) {
+      throw _failureFromEnvelope(error);
+    }
+    if (!result.succeeded && raw.trim().isEmpty) {
+      throw HerdrException(
+        HerdrFailure.failed,
+        _firstLine(result.stderr).isEmpty
+            ? '读取面板失败（退出码 ${result.exitCode}）'
+            : _firstLine(result.stderr),
+      );
+    }
+    return raw;
+  }
+
+  // -------------------------------------------------------------------------
+  // Input
+  // -------------------------------------------------------------------------
+
+  /// Submits [text] as a task to the agent in [target].
+  ///
+  /// Never retried by callers: Herdr rejects a blocked agent before writing
+  /// anything, and a stalled submission must be inspected on the desktop.
+  Future<HerdrCommandReport> prompt(
+    String target,
+    String text, {
+    bool wait = false,
+    int? timeoutMs,
+  }) async {
+    final args = <String>['agent', 'prompt', _requireTarget(target), text];
+    var budget = timeout;
+    if (timeoutMs != null) {
+      args.addAll(<String>['--timeout', '$timeoutMs']);
+      budget = Duration(milliseconds: timeoutMs + 10000);
+    }
+    if (wait) {
+      args.add('--wait');
+      if (timeoutMs == null) {
+        args.addAll(<String>['--timeout', '120000']);
+        budget = const Duration(milliseconds: 130000);
+      }
+    }
+    final result = await _json(args, timeout: budget);
+    return HerdrCommandReport.fromResult(result, '已向 $target 发送提示词');
+  }
+
+  /// Types literal text into a pane (terminal semantics, not a prompt).
+  Future<HerdrCommandReport> sendText(String paneId, String text) async {
+    final result = await _json(<String>[
+      'pane',
+      'send-text',
+      _requirePaneId(paneId),
+      text,
+    ], allowEmpty: true);
+    return HerdrCommandReport.fromResult(result, '已写入面板 $paneId');
+  }
+
+  /// Sends logical keys to a pane (pane id) or to a named agent.
+  ///
+  /// The two are different verbs: `agent send-keys` needs an agent, so a shell
+  /// pane — which hosts none — could never receive Enter or an arrow key.
+  Future<HerdrCommandReport> sendKeys(String target, List<String> keys) async {
+    final t = _requireTarget(target);
+    final list = <String>[for (final key in keys) _requireKey(key)];
+    if (list.isEmpty) {
+      throw const HerdrException(HerdrFailure.invalidArgument, '没有要发送的按键');
+    }
+    final argv = isPaneId(t)
+        ? <String>['pane', 'send-keys', t, ...list]
+        : <String>['agent', 'send-keys', t, ...list];
+    final result = await _json(argv, allowEmpty: true);
+    return HerdrCommandReport.fromResult(result, '已发送按键 ${list.join(' ')}');
+  }
+
+  /// Blocks until [target] reaches one of [until] (default: idle/done/blocked).
+  ///
+  /// This is the status-refresh primitive: a long wait instead of tight polling.
+  /// A timeout is normal and reported as [HerdrFailure.timeout] so the caller can
+  /// simply refresh the list and wait again.
+  Future<HerdrCommandReport> wait(
+    String target, {
+    List<HerdrAgentStatus> until = const <HerdrAgentStatus>[],
+    Duration budget = const Duration(seconds: 20),
+  }) async {
+    final args = <String>['agent', 'wait', _requireTarget(target)];
+    for (final status in until) {
+      args.addAll(<String>['--until', status.name]);
+    }
+    args.addAll(<String>['--timeout', '${budget.inMilliseconds}']);
+    final result = await _json(
+      args,
+      timeout: budget + const Duration(seconds: 5),
+    );
+    return HerdrCommandReport.fromResult(result, '$target 已到达等待状态');
+  }
+
+  // -------------------------------------------------------------------------
+  // Lifecycle
+  // -------------------------------------------------------------------------
+
+  /// Creates a workspace and returns its root pane id.
+  Future<String> createWorkspace({
+    required String cwd,
+    String? label,
+    bool focus = false,
+  }) async {
+    final result = await _json(<String>[
+      'workspace',
+      'create',
+      '--cwd',
+      cwd,
+      if (label != null && label.trim().isNotEmpty) ...<String>[
+        '--label',
+        label.trim(),
+      ],
+      focus ? '--focus' : '--no-focus',
+    ], timeout: const Duration(seconds: 60));
+    final pane = result['root_pane'];
+    final paneId = pane is Json ? pane['pane_id'] : null;
+    if (paneId is! String || paneId.isEmpty) {
+      throw const HerdrException(HerdrFailure.failed, 'Herdr 未返回新工作区的面板');
+    }
+    return paneId;
+  }
+
+  /// Starts a supported agent in an existing interactive pane.
+  Future<HerdrAgentInfo> startAgent({
+    required String name,
+    required String kind,
+    required String paneId,
+    List<String> args = const <String>[],
+  }) async {
+    if (!agentKinds.contains(kind)) {
+      throw HerdrException(
+        HerdrFailure.invalidArgument,
+        'Herdr 不支持 $kind 这个 agent',
+      );
+    }
+    final result = await _json(<String>[
+      'agent',
+      'start',
+      _requireAgentName(name),
+      '--kind',
+      kind,
+      '--pane',
+      _requirePaneId(paneId),
+      if (args.isNotEmpty) ...<String>['--', ...args],
+    ], timeout: const Duration(seconds: 320));
+    final raw = result['agent'];
+    if (raw is! Json) {
+      throw const HerdrException(HerdrFailure.failed, 'Herdr 未返回启动后的 agent 信息');
+    }
+    return HerdrAgentInfo.fromJson(raw);
+  }
+
+  /// Closes [paneId]. Ending a session; the caller must have confirmed first.
+  Future<void> closePane(String paneId) async {
+    await _json(<String>['pane', 'close', _requirePaneId(paneId)]);
+  }
+
+  // -------------------------------------------------------------------------
+  // Plumbing
+  // -------------------------------------------------------------------------
+
+  Future<HerdrProcessResult> _invoke(
+    List<String> argv, {
+    Duration? timeout,
+    String? workingDirectory,
+  }) async {
+    final result = await _runner(
+      argv,
+      workingDirectory: workingDirectory,
+      timeout: timeout ?? this.timeout,
+    );
+    if (result.spawnError != null) {
+      throw HerdrException(
+        HerdrFailure.unavailable,
+        result.spawnError == 'ENOENT'
+            ? '找不到 Herdr，请先安装或设置 Herdr 路径'
+            : '无法启动 Herdr：${result.spawnError}',
+      );
+    }
+    return result;
+  }
+
+  Future<Json> _json(
+    List<String> argv, {
+    Duration? timeout,
+    bool allowEmpty = false,
+  }) async {
+    final result = await _invoke(argv, timeout: timeout);
+    if (result.timedOut) {
+      throw HerdrException(HerdrFailure.timeout, 'herdr ${argv.first} 超时');
+    }
+    final text = result.stdout.trim();
+    if (text.isEmpty) {
+      // Void mutations legitimately print nothing on success.
+      if (allowEmpty && result.succeeded) return const <String, dynamic>{};
+      throw HerdrException(
+        HerdrFailure.failed,
+        'Herdr 没有返回内容（${_firstLine(result.stderr).ifEmpty('退出码 ${result.exitCode}')}）',
+      );
+    }
+    final decoded = _tryDecode(text);
+    final error = _errorEnvelope(text);
+    if (error != null) throw _failureFromEnvelope(error);
+    if (decoded == null) {
+      throw HerdrException(
+        HerdrFailure.failed,
+        'Herdr 返回了无法解析的内容：${_firstLine(text)}',
+      );
+    }
+    final parsed = decoded['result'];
+    if (parsed is! Json) {
+      throw const HerdrException(
+        HerdrFailure.failed,
+        'Herdr 返回的内容缺少 result 字段',
+      );
+    }
+    return parsed;
+  }
+
+  HerdrException _failureFromEnvelope(_HerdrErrorEnvelope error) {
+    final code = error.code;
+    switch (code) {
+      case 'pane_not_found':
+        return HerdrException(
+          HerdrFailure.notFound,
+          '面板不存在或已关闭（${error.message}）',
+          herdrCode: code,
+        );
+      case 'agent_not_found':
+        return HerdrException(
+          HerdrFailure.notFound,
+          '找不到该 agent，可能已退出或改名（${error.message}）',
+          herdrCode: code,
+        );
+      case 'agent_blocked':
+        return HerdrException(
+          HerdrFailure.agentBlocked,
+          'agent 正在等待确认或提问，请先在电脑上处理（${error.message}）',
+          herdrCode: code,
+        );
+      case 'agent_not_ready':
+        return HerdrException(
+          HerdrFailure.agentNotReady,
+          'agent 还没准备好接收输入，请稍候再试（${error.message}）',
+          herdrCode: code,
+        );
+      case 'agent_prompt_stalled':
+        return HerdrException(
+          HerdrFailure.promptStalled,
+          '提示已发送但未观察到 agent 开始工作，请到电脑上确认，不要重复发送（${error.message}）',
+          herdrCode: code,
+        );
+      case 'pane_send_failed':
+        return HerdrException(
+          HerdrFailure.failed,
+          '无法向面板写入，请检查当前面板状态和终端内容以确认输入是否已送达；不会自动重发（${error.message}）',
+          herdrCode: code,
+        );
+      case 'connection_closed':
+        return HerdrException(
+          HerdrFailure.failed,
+          '输入连接已断开，无法确认本次输入是否送达；不会自动重发（${error.message}）',
+          herdrCode: code,
+        );
+      case 'timeout':
+        return HerdrException(
+          HerdrFailure.timeout,
+          '等待超时（${error.message}）',
+          herdrCode: code,
+        );
+      default:
+        return HerdrException(
+          HerdrFailure.failed,
+          error.message.isEmpty ? 'Herdr 返回了未知错误' : error.message,
+          herdrCode: code,
+        );
+    }
+  }
+
+  static String _requireTarget(String value) {
+    final trimmed = value.trim();
+    if (trimmed.isEmpty) {
+      throw const HerdrException(HerdrFailure.invalidArgument, '缺少 agent 目标');
+    }
+    // A leading dash would be read as a flag by the CLI, and control characters
+    // break Herdr's own single-line labels.
+    if (trimmed.startsWith('-') ||
+        trimmed.contains(RegExp(r'[\u0000-\u001f]'))) {
+      throw const HerdrException(HerdrFailure.invalidArgument, 'agent 目标不合法');
+    }
+    return trimmed;
+  }
+
+  static String _requireAgentName(String value) {
+    final trimmed = value.trim();
+    if (trimmed.isEmpty ||
+        trimmed.startsWith('-') ||
+        trimmed.contains(RegExp(r'[\u0000-\u001f]'))) {
+      throw const HerdrException(HerdrFailure.invalidArgument, 'agent 名称不合法');
+    }
+    return trimmed;
+  }
+
+  static String _requirePaneId(String value) {
+    if (!isPaneId(value)) {
+      throw HerdrException(HerdrFailure.invalidArgument, '面板 ID 不合法：$value');
+    }
+    return value;
+  }
+
+  static String _requireKey(String key) {
+    if (!keyNames.contains(key) && !_ctrlKey.hasMatch(key)) {
+      throw HerdrException(HerdrFailure.invalidArgument, '不支持的按键：$key');
+    }
+    return key;
+  }
+
+  static String _requireReadSource(String source) {
+    const sources = <String>[
+      'visible',
+      'recent',
+      'recent-unwrapped',
+      'detection',
+    ];
+    if (!sources.contains(source)) {
+      throw HerdrException(HerdrFailure.invalidArgument, '不支持的读取来源：$source');
+    }
+    return source;
+  }
+
+  static List<Json> _asList(Object? value) => <Json>[
+    if (value is List)
+      for (final item in value)
+        if (item is Json) item,
+  ];
+
+  static Json? _tryDecode(String text) {
+    try {
+      final decoded = jsonDecode(text);
+      return decoded is Json ? decoded : null;
+    } on FormatException {
+      return null;
+    }
+  }
+
+  static _HerdrErrorEnvelope? _errorEnvelope(String text) {
+    final trimmed = text.trim();
+    if (!trimmed.startsWith('{') || !trimmed.contains('"error"')) return null;
+    final decoded = _tryDecode(trimmed);
+    if (decoded == null) return null;
+    final error = decoded['error'];
+    if (error is! Json) return null;
+    return _HerdrErrorEnvelope(
+      code: error['code'] is String ? error['code'] as String : null,
+      message: error['message'] is String ? error['message'] as String : '',
+    );
+  }
+
+  static String _firstLine(String text) {
+    for (final line in text.split(RegExp(r'\r?\n'))) {
+      if (line.trim().isNotEmpty) return line.trim();
+    }
+    return '';
+  }
+}
+
+class _HerdrErrorEnvelope {
+  const _HerdrErrorEnvelope({required this.code, required this.message});
+
+  final String? code;
+  final String message;
+}
+
+/// Summary of a completed control action, as far as the harness layer needs it.
+class HerdrCommandReport {
+  const HerdrCommandReport({required this.action, required this.summary});
+
+  factory HerdrCommandReport.fromResult(Json result, String fallback) {
+    final type = result['type'] is String ? result['type'] as String : 'ok';
+    return HerdrCommandReport(action: type, summary: fallback);
+  }
+
+  final String action;
+  final String summary;
+}
+
+extension on String {
+  String ifEmpty(String fallback) => isEmpty ? fallback : this;
+}
+
+/// Provider descriptor for one Herdr agent kind.
+class HerdrProviderSpec {
+  const HerdrProviderSpec({
+    required this.id,
+    required this.label,
+    required this.executable,
+  });
+
+  final String id;
+  final String label;
+
+  /// Canonical executable Herdr launches for this kind.
+  final String executable;
+
+  static const HerdrProviderSpec shell = HerdrProviderSpec(
+    id: 'shell',
+    label: 'Shell',
+    executable: '',
+  );
+
+  static HerdrProviderSpec forKind(String kind) {
+    for (final spec in _specs) {
+      if (spec.id == kind) return spec;
+    }
+    // An unknown-but-supported Herdr kind still gets a truthful entry: its
+    // executable name is the kind itself, which is how Herdr's manifests name
+    // most of them.
+    return HerdrProviderSpec(id: kind, label: kind, executable: kind);
+  }
+
+  static const List<HerdrProviderSpec> _specs = <HerdrProviderSpec>[
+    HerdrProviderSpec(id: 'pi', label: 'Pi', executable: 'pi'),
+    HerdrProviderSpec(id: 'claude', label: 'Claude Code', executable: 'claude'),
+    HerdrProviderSpec(id: 'codex', label: 'Codex', executable: 'codex'),
+    HerdrProviderSpec(id: 'gemini', label: 'Gemini CLI', executable: 'gemini'),
+    HerdrProviderSpec(
+      id: 'cursor',
+      label: 'Cursor',
+      executable: 'cursor-agent',
+    ),
+    HerdrProviderSpec(
+      id: 'opencode',
+      label: 'OpenCode',
+      executable: 'opencode',
+    ),
+    HerdrProviderSpec(id: 'copilot', label: 'Copilot', executable: 'copilot'),
+    HerdrProviderSpec(id: 'qwen', label: 'Qwen Code', executable: 'qwen'),
+    HerdrProviderSpec(id: 'amp', label: 'Amp', executable: 'amp'),
+    HerdrProviderSpec(id: 'cline', label: 'Cline', executable: 'cline'),
+    HerdrProviderSpec(id: 'kimi', label: 'Kimi', executable: 'kimi'),
+    HerdrProviderSpec(id: 'droid', label: 'Droid', executable: 'droid'),
+    HerdrProviderSpec(id: 'grok', label: 'Grok', executable: 'grok'),
+    HerdrProviderSpec(id: 'omp', label: 'omp', executable: 'omp'),
+    HerdrProviderSpec(id: 'devin', label: 'Devin', executable: 'devin'),
+  ];
+
+  /// Capabilities every Herdr session has; kept next to the provider so a UI
+  /// can render the menu without opening a session.
+  static const Set<HarnessCapability> capabilities = <HarnessCapability>{
+    HarnessCapability.terminal,
+    HarnessCapability.prompt,
+    HarnessCapability.stop,
+  };
+}
diff --git a/lib/harness/herdr/herdr_host.dart b/lib/harness/herdr/herdr_host.dart
new file mode 100644
index 0000000000000000000000000000000000000000..5d107578ac9729cf9b221262d77e942a2b909a86
--- /dev/null
+++ b/lib/harness/herdr/herdr_host.dart
@@ -0,0 +1,551 @@
+// HerdrHost: every Herdr agent pane on this computer, as a HarnessHub host.
+//
+// Herdr is a separate local host rather than part of StudioMux because its
+// panes outlive Studio: the user's terminals, their scrollback and their agents
+// all live in Herdr's server. Studio therefore never owns these sessions — it
+// lists them, attaches a view, and can close a pane only after explicit user
+// confirmation.
+//
+// Status refresh is wait-driven, not a tight poll: while any agent is working the
+// loop blocks in `herdr agent wait` (which returns when that agent leaves the
+// working state), and an idle environment only needs a slow safety refresh.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../harness_host.dart';
+import '../pty/harness_pty.dart';
+import 'herdr_cli.dart';
+import 'herdr_models.dart';
+import 'herdr_platform.dart';
+import 'herdr_session.dart';
+import 'herdr_terminal.dart';
+
+/// What the Agents UI shows when Herdr is not installed.
+@immutable
+class HerdrInstallHint {
+  const HerdrInstallHint({
+    required this.title,
+    required this.message,
+    this.url = 'https://herdr.dev',
+    this.resolvedPath,
+  });
+
+  final String title;
+  final String message;
+  final String url;
+
+  /// Path Studio did find, when the executable exists but cannot run.
+  final String? resolvedPath;
+}
+
+class HerdrHost implements HarnessHost {
+  HerdrHost({
+    String? executablePath,
+    HerdrCli? cli,
+    HerdrCliRunner? runner,
+    HarnessPtyFactory? ptyFactory,
+    HerdrExecutableLocator? locator,
+    this.idleRefresh = const Duration(seconds: 30),
+    this.waitBudget = const Duration(seconds: 20),
+    this.attachTakeover = false,
+  }) : _executablePath = executablePath,
+       _cli = cli,
+       _runner = cli == null ? (runner ?? HerdrCliRunner()) : null,
+       _ownsRunner = cli == null && runner == null,
+       _ptyFactory = ptyFactory,
+       _locator = locator ?? locateHerdrExecutable;
+
+  /// Safety refresh while nothing is working. Long on purpose; a change in an
+  /// agent's state wakes the loop far sooner through `agent wait`.
+  final Duration idleRefresh;
+
+  /// How long one `agent wait` blocks before the loop re-reads the list.
+  final Duration waitBudget;
+
+  /// Pass `--takeover` to `agent attach`. Off by default: Studio must not steal
+  /// the pane from the user's own Herdr client.
+  final bool attachTakeover;
+
+  final String? _executablePath;
+  HerdrCli? _cli;
+  final HerdrCliRunner? _runner;
+  final bool _ownsRunner;
+  final HarnessPtyFactory? _ptyFactory;
+  final HerdrExecutableLocator _locator;
+
+  final ValueNotifier<HarnessHostState> _state =
+      ValueNotifier<HarnessHostState>(HarnessHostState.offline);
+  final StreamController<List<HarnessSessionInfo>> _sessions =
+      StreamController<List<HarnessSessionInfo>>.broadcast();
+  final Map<String, HerdrAgentInfo> _agents = <String, HerdrAgentInfo>{};
+  final Map<String, HerdrSessionHandle> _handles =
+      <String, HerdrSessionHandle>{};
+  List<HarnessSessionInfo> _latest = const <HarnessSessionInfo>[];
+  List<HarnessProviderInfo>? _providers;
+
+  Future<HerdrCli?>? _initializing;
+  Future<void>? _loop;
+  Future<void>? _refreshing;
+  Completer<void>? _wake;
+  bool _disposed = false;
+  String? _lastError;
+  String? _version;
+  HerdrServerStatus? _serverStatus;
+  HerdrInstallHint? _installHint;
+  final Map<String, String> _workspaceLabels = <String, String>{};
+
+  @override
+  String get id => 'herdr';
+
+  @override
+  String get label => 'Herdr';
+
+  @override
+  HarnessHostKind get kind => HarnessHostKind.local;
+
+  @override
+  ValueListenable<HarnessHostState> get state => _state;
+
+  /// Install guidance for the UI; null once Herdr works.
+  HerdrInstallHint? get installHint => _installHint;
+
+  /// Last failure, already user-facing.
+  String? get lastError => _lastError;
+
+  /// Herdr version found during detection.
+  String? get version => _version;
+
+  /// `herdr status` snapshot from detection.
+  HerdrServerStatus? get serverStatus => _serverStatus;
+
+  /// Current session list, for a UI that mounts after the first refresh.
+  List<HarnessSessionInfo> get currentSessions => _latest;
+
+  // -------------------------------------------------------------------------
+  // HarnessHost
+  // -------------------------------------------------------------------------
+
+  @override
+  Stream<List<HarnessSessionInfo>> watchSessions() {
+    unawaited(_ensureLoop());
+    return Stream.multi((controller) {
+      controller.add(_latest);
+      final subscription = _sessions.stream.listen(
+        controller.add,
+        onError: controller.addError,
+        onDone: controller.close,
+      );
+      controller.onCancel = subscription.cancel;
+    });
+  }
+
+  @override
+  Future<List<HarnessProviderInfo>> providers() async {
+    final cli = await _ensureInitialized();
+    if (cli == null) return const <HarnessProviderInfo>[];
+    final cached = _providers;
+    if (cached != null) return cached;
+    // Only agent kinds: HerdrHost lists the panes Herdr reports as agents, so a
+    // bare shell pane would be invisible in the list and a "new terminal" entry
+    // would create a session nobody can see. `shell` is therefore not offered.
+    final list = <HarnessProviderInfo>[
+      for (final kind in HerdrCli.agentKinds)
+        () {
+          final spec = HerdrProviderSpec.forKind(kind);
+          return HarnessProviderInfo(
+            id: spec.id,
+            label: spec.label,
+            available: executableOnPath(spec.executable),
+            executable: spec.executable,
+            builtIn: true,
+          );
+        }(),
+    ];
+    _providers = List<HarnessProviderInfo>.unmodifiable(list);
+    return _providers!;
+  }
+
+  @override
+  Future<HarnessSessionHandle> open(String sessionId) async {
+    final cli = await _ensureInitialized();
+    if (cli == null) {
+      throw const HerdrException(
+        HerdrFailure.unavailable,
+        '这台电脑没有安装 Herdr，无法打开该会话。',
+      );
+    }
+    final cached = _handles[sessionId];
+    if (cached != null) return cached;
+
+    var agent = _agents[sessionId];
+    if (agent == null) {
+      // The list may be stale (a pane opened after the last refresh).
+      await refreshNow();
+      agent = _agents[sessionId];
+    }
+    if (agent == null) {
+      throw const HerdrException(HerdrFailure.notFound, '找不到该 Herdr 面板，可能已关闭。');
+    }
+    final terminal = await _createTerminal(agent);
+    final handle = HerdrSessionHandle(
+      cli: cli,
+      agent: agent,
+      terminal: terminal,
+      hostId: id,
+      onChanged: refreshNow,
+      onDetached: (detached) async {
+        if (identical(_handles[sessionId], detached)) {
+          _handles.remove(sessionId);
+          detached.dispose();
+        }
+      },
+    );
+    _handles[sessionId] = handle;
+    return handle;
+  }
+
+  @override
+  Future<HarnessSessionHandle> launch(HarnessLaunchRequest request) async {
+    final cli = await _ensureInitialized();
+    if (cli == null) {
+      throw const HerdrException(
+        HerdrFailure.unavailable,
+        '这台电脑没有安装 Herdr，无法新建会话。',
+      );
+    }
+    if (request.providerId == 'shell') {
+      // HerdrHost lists agents, and `agent list` never shows a bare shell pane:
+      // a workspace created here would silently vanish from the list. Say so
+      // instead of returning a session that disappears on the next refresh.
+      throw const HerdrException(
+        HerdrFailure.invalidArgument,
+        'Herdr 只管理 agent 面板，普通终端请在“本机”主机里新建。',
+      );
+    }
+    final title = request.title?.trim();
+    final label = (title == null || title.isEmpty) ? null : title;
+    // A Herdr session needs a workspace to live in; `--no-focus` keeps the
+    // user's current pane focused while Studio prepares the new one.
+    final paneId = await cli.createWorkspace(
+      cwd: request.cwd,
+      label: label,
+      focus: false,
+    );
+    final started = await cli.startAgent(
+      name: _agentNameFor(request.providerId, label),
+      kind: request.providerId,
+      paneId: paneId,
+      args: request.args,
+    );
+    // Refresh first so the host cache is current, then keep the freshly started
+    // agent even if the list push has not arrived yet.
+    await refreshNow();
+    _agents[started.paneId] = started;
+    _emit();
+    return open(started.paneId);
+  }
+
+  @override
+  Future<void> dispose() async {
+    if (_disposed) return;
+    _disposed = true;
+    _wake?.complete();
+    final handles = _handles.values.toList();
+    _handles.clear();
+    for (final handle in handles) {
+      handle.dispose();
+    }
+    await _sessions.close();
+    _state.dispose();
+    if (_ownsRunner) await _runner?.dispose();
+  }
+
+  // -------------------------------------------------------------------------
+  // Detection
+  // -------------------------------------------------------------------------
+
+  Future<HerdrCli?> _ensureInitialized() {
+    final cli = _cli;
+    if (cli != null) return Future<HerdrCli?>.value(cli);
+    return _initializing ??= _initialize();
+  }
+
+  Future<HerdrCli?> _initialize() async {
+    final executable = await _locator(explicitPath: _executablePath);
+    if (executable == null) {
+      _installHint = const HerdrInstallHint(
+        title: '未安装 Herdr',
+        message:
+            '没有找到 herdr。安装后重启 Studio 即可在这里管理 Herdr 工作区、面板和 agent；'
+            '不安装也能用 Studio 自带的会话管理。',
+      );
+      _state.value = HarnessHostState.unsupported;
+      return null;
+    }
+    final runner = _runner;
+    final cli = _cli = HerdrCli(executable: executable, runner: runner!.call);
+    try {
+      _version = await cli.version();
+      final status = await cli.serverStatus();
+      _serverStatus = status;
+      if (!status.serverRunning) {
+        _lastError = 'Herdr 服务未运行。请在电脑上打开一次 Herdr，或在终端运行 herdr server。';
+        _state.value = HarnessHostState.offline;
+        _installHint = HerdrInstallHint(
+          title: 'Herdr 服务未运行',
+          message: _lastError!,
+          resolvedPath: executable,
+        );
+        return cli;
+      }
+      _installHint = null;
+      _state.value = HarnessHostState.online;
+      return cli;
+    } on HerdrException catch (error) {
+      _lastError = error.message;
+      _installHint = HerdrInstallHint(
+        title: 'Herdr 无法使用',
+        message: error.message,
+        resolvedPath: executable,
+      );
+      _state.value = error.failure == HerdrFailure.unavailable
+          ? HarnessHostState.unsupported
+          : HarnessHostState.offline;
+      return cli;
+    }
+  }
+
+  // -------------------------------------------------------------------------
+  // Refresh loop
+  // -------------------------------------------------------------------------
+
+  Future<void> _ensureLoop() {
+    return _loop ??= _runLoop();
+  }
+
+  /// Wakes the loop immediately (pull-to-refresh, after an action).
+  Future<void> refreshNow() async {
+    if (_disposed) return;
+    await _ensureInitialized();
+    final wake = _wake;
+    if (wake != null && !wake.isCompleted) {
+      wake.complete();
+    }
+    await _refresh();
+  }
+
+  Future<void> _runLoop() async {
+    while (!_disposed) {
+      await _refresh();
+      if (_disposed) return;
+      final busy = <HerdrAgentInfo>[
+        for (final agent in _agents.values)
+          if (agent.status == HerdrAgentStatus.working) agent,
+      ];
+      if (busy.isEmpty) {
+        await _sleep(idleRefresh);
+      } else {
+        await _waitForBusy(busy);
+      }
+    }
+  }
+
+  /// Blocks until one busy agent leaves `working` (or the budget expires).
+  ///
+  /// `Future.any` is right here: any pane finishing means the list is stale, and
+  /// the next loop iteration re-reads everything anyway.
+  Future<void> _waitForBusy(List<HerdrAgentInfo> busy) async {
+    final cli = _cli;
+    if (cli == null) {
+      await _sleep(idleRefresh);
+      return;
+    }
+    final waits = <Future<void>>[
+      for (final agent in busy) _waitQuietly(cli, agent),
+    ];
+    if (waits.isEmpty) return;
+    await Future.any<void>(waits);
+  }
+
+  /// One long wait that must never break the loop: a timeout, a closed pane or a
+  /// transient CLI failure all mean "refresh and try again".
+  Future<void> _waitQuietly(HerdrCli cli, HerdrAgentInfo agent) async {
+    try {
+      await cli.wait(
+        agent.target,
+        until: const <HerdrAgentStatus>[
+          HerdrAgentStatus.idle,
+          HerdrAgentStatus.done,
+          HerdrAgentStatus.blocked,
+          HerdrAgentStatus.unknown,
+        ],
+        budget: waitBudget,
+      );
+    } on HerdrException {
+      // Expected: the budget expired, or the pane went away.
+    }
+  }
+
+  Future<void> _sleep(Duration duration) async {
+    if (_disposed) return;
+    final wake = _wake = Completer<void>();
+    await Future.any<void>(<Future<void>>[
+      Future<void>.delayed(duration),
+      wake.future,
+    ]);
+    if (identical(_wake, wake)) _wake = null;
+  }
+
+  Future<void> _refresh() {
+    // A user-triggered refresh can land while the loop is already reading; share
+    // the in-flight read instead of spawning a second `agent list`.
+    return _refreshing ??= _refreshOnce().whenComplete(() {
+      _refreshing = null;
+    });
+  }
+
+  Future<void> _refreshOnce() async {
+    final cli = await _ensureInitialized();
+    if (cli == null || _disposed) return;
+    try {
+      final agents = await cli.agents();
+      final workspaces = await _safeWorkspaces(cli);
+      _agents
+        ..clear()
+        ..addEntries(
+          agents.map(
+            (agent) => MapEntry<String, HerdrAgentInfo>(agent.paneId, agent),
+          ),
+        );
+      _workspaceLabels
+        ..clear()
+        ..addEntries(
+          workspaces.map(
+            (workspace) => MapEntry<String, String>(
+              workspace.workspaceId,
+              workspace.label,
+            ),
+          ),
+        );
+      _lastError = null;
+      if (_state.value != HarnessHostState.online) {
+        _state.value = HarnessHostState.online;
+        _installHint = null;
+      }
+      _emit();
+    } on HerdrException catch (error) {
+      _lastError = error.message;
+      if (error.failure == HerdrFailure.unavailable) {
+        _state.value = HarnessHostState.unsupported;
+      } else if (error.failure == HerdrFailure.serverDown) {
+        _state.value = HarnessHostState.offline;
+      } else {
+        _state.value = HarnessHostState.offline;
+      }
+    }
+  }
+
+  /// Workspace labels are decoration: a failure must not hide the agents.
+  Future<List<HerdrWorkspaceInfo>> _safeWorkspaces(HerdrCli cli) async {
+    try {
+      return await cli.workspaces();
+    } on HerdrException {
+      return const <HerdrWorkspaceInfo>[];
+    }
+  }
+
+  void _emit() {
+    final infos = <HarnessSessionInfo>[
+      for (final agent in _agents.values) agent.toSessionInfo(hostId: id),
+    ];
+    infos.sort(_compareSessions);
+    _latest = List<HarnessSessionInfo>.unmodifiable(infos);
+    for (final entry in _handles.entries.toList()) {
+      final agent = _agents[entry.key];
+      if (agent == null) {
+        entry.value.markExited();
+      } else {
+        entry.value.update(agent);
+      }
+    }
+    if (!_sessions.isClosed) _sessions.add(_latest);
+  }
+
+  /// Attention first, then most recently completed: `blocked`/`done` are the
+  /// two states that need the user; `working` needs nothing.
+  static int _compareSessions(HarnessSessionInfo a, HarnessSessionInfo b) {
+    int rank(HarnessSessionStatus status) {
+      switch (status) {
+        case HarnessSessionStatus.blocked:
+          return 0;
+        case HarnessSessionStatus.done:
+          return 1;
+        case HarnessSessionStatus.working:
+          return 2;
+        case HarnessSessionStatus.idle:
+          return 3;
+        case HarnessSessionStatus.unknown:
+          return 4;
+        case HarnessSessionStatus.exited:
+          return 5;
+      }
+    }
+
+    final byRank = rank(a.status).compareTo(rank(b.status));
+    if (byRank != 0) return byRank;
+    return a.title.toLowerCase().compareTo(b.title.toLowerCase());
+  }
+
+  // -------------------------------------------------------------------------
+  // Terminal creation
+  // -------------------------------------------------------------------------
+
+  Future<HerdrTerminal> _createTerminal(HerdrAgentInfo agent) async {
+    final cli = _cli!;
+    final factory = _ptyFactory;
+    if (factory != null) {
+      try {
+        return await HerdrPtyTerminal.start(
+          factory: factory,
+          argv: <String>[
+            cli.executable,
+            'agent',
+            'attach',
+            agent.target,
+            if (attachTakeover) '--takeover',
+          ],
+          workingDirectory: agent.cwd,
+        );
+      } on HarnessPtyException catch (error) {
+        // A PTY failure must not make the session unopenable: the snapshot
+        // fallback still shows the pane and can type into it.
+        _lastError = error.message;
+      }
+    }
+    return HerdrSnapshotTerminal(
+      readPane: () => cli.readPane(agent.paneId),
+      sendText: (text) => cli.sendText(agent.paneId, text),
+      sendKeys: (keys) => cli.sendKeys(agent.target, keys),
+      onError: (error) {
+        _lastError = error is HerdrException ? error.message : '$error';
+      },
+    )..start();
+  }
+
+  /// A short, Herdr-legal agent name. Herdr labels are single-line and are also
+  /// used as prompt targets, so control characters and dashes-out-front go away.
+  static String _agentNameFor(String providerId, String? label) {
+    final base = (label == null || label.trim().isEmpty)
+        ? providerId
+        : label.trim();
+    final cleaned = base
+        .replaceAll(RegExp(r'[\u0000-\u001f]'), ' ')
+        .replaceAll(RegExp(r'[^A-Za-z0-9._\u4e00-\u9fff-]+'), '-')
+        .replaceAll(RegExp(r'-{2,}'), '-')
+        .replaceAll(RegExp(r'^-+|-+$'), '');
+    final name = cleaned.isEmpty ? providerId : cleaned;
+    return name.length <= 40 ? name : name.substring(0, 40);
+  }
+}
diff --git a/lib/harness/herdr/herdr_input.dart b/lib/harness/herdr/herdr_input.dart
new file mode 100644
index 0000000000000000000000000000000000000000..eb58cdb986c89d89a19234d524f1b908c763f8af
--- /dev/null
+++ b/lib/harness/herdr/herdr_input.dart
@@ -0,0 +1,197 @@
+// Turns terminal input bytes into Herdr input operations.
+//
+// A Herdr pane is driven through two different CLI verbs: literal text goes to
+// `pane send-text`, and keys go to `pane send-keys` by name. Raw terminal input
+// from the key bar or a hardware keyboard is a byte string, so something has to
+// decide which bytes are text and which are keys — this file, in one place, so
+// the local host and the remote host cannot disagree.
+//
+// Unknown escape sequences are dropped instead of forwarded as text: sending
+// `ESC [ 1 5 ~` literally into a shell would type garbage, whereas dropping it
+// only loses a key Herdr never advertised.
+
+import 'dart:convert';
+import 'dart:typed_data';
+
+/// One thing to do with a chunk of terminal input.
+sealed class HerdrInputOp {
+  const HerdrInputOp();
+}
+
+/// Type this text literally.
+final class HerdrSendTextOp extends HerdrInputOp {
+  const HerdrSendTextOp(this.text);
+
+  final String text;
+}
+
+/// Press these logical keys, in order.
+final class HerdrSendKeysOp extends HerdrInputOp {
+  const HerdrSendKeysOp(this.keys);
+
+  final List<String> keys;
+}
+
+/// Converts raw terminal bytes into [HerdrInputOp]s.
+class HerdrInputTranslator {
+  const HerdrInputTranslator();
+
+  /// Translates [data]. Never returns empty ops for printable input, and merges
+  /// consecutive printable characters into a single text op so typing a word is
+  /// one `pane send-text` call instead of one per character.
+  List<HerdrInputOp> translate(Uint8List data) =>
+      translateText(utf8.decode(data, allowMalformed: true));
+
+  /// Same as [translate] for already-decoded input (xterm hands out strings).
+  List<HerdrInputOp> translateText(String data) {
+    final ops = <HerdrInputOp>[];
+    final text = StringBuffer();
+    var i = 0;
+
+    void flushText() {
+      if (text.isEmpty) return;
+      ops.add(HerdrSendTextOp(text.toString()));
+      text.clear();
+    }
+
+    void addKey(String key) {
+      flushText();
+      ops.add(HerdrSendKeysOp(<String>[key]));
+    }
+
+    while (i < data.length) {
+      final code = data.codeUnitAt(i);
+      if (code == 0x1b) {
+        final parsed = _parseEscape(data, i);
+        if (parsed == null) {
+          // Lone ESC (or an unknown sequence ending here): Escape key.
+          addKey('esc');
+          i += 1;
+          continue;
+        }
+        if (parsed.key != null) {
+          addKey(parsed.key!);
+        }
+        // A recognised-but-unmapped sequence is consumed and dropped.
+        i = parsed.next;
+        continue;
+      }
+      if (code == 0x0d || code == 0x0a) {
+        addKey('enter');
+        i += 1;
+        continue;
+      }
+      if (code == 0x09) {
+        addKey('tab');
+        i += 1;
+        continue;
+      }
+      if (code == 0x7f || code == 0x08) {
+        addKey('backspace');
+        i += 1;
+        continue;
+      }
+      if (code >= 0x01 && code <= 0x1a) {
+        // Ctrl-A..Ctrl-Z, except the special cases handled above.
+        addKey('ctrl+${String.fromCharCode(0x60 + code)}');
+        i += 1;
+        continue;
+      }
+      text.writeCharCode(code);
+      i += 1;
+    }
+    flushText();
+    return ops;
+  }
+
+  /// Parses one escape sequence starting at [start].
+  ///
+  /// Returns null when this is a bare ESC, so the caller reports Escape.
+  _Escape? _parseEscape(String data, int start) {
+    if (start + 1 >= data.length) return null;
+    final next = data.codeUnitAt(start + 1);
+    // SS3: ESC O A..D (application cursor mode).
+    if (next == 0x4f) {
+      if (start + 2 >= data.length) return null;
+      final finalByte = data.codeUnitAt(start + 2);
+      return _Escape(_arrowFor(finalByte), start + 3);
+    }
+    if (next != 0x5b) {
+      // ESC followed by a printable char is Alt+key; Herdr has no Alt verb.
+      return _Escape(null, start + 2);
+    }
+    // CSI: ESC [ params final.
+    var i = start + 2;
+    final params = StringBuffer();
+    while (i < data.length) {
+      final code = data.codeUnitAt(i);
+      if (code >= 0x40 && code <= 0x7e) {
+        final key = _keyForCsi(params.toString(), String.fromCharCode(code));
+        return _Escape(key, i + 1);
+      }
+      params.writeCharCode(code);
+      i += 1;
+    }
+    return _Escape(null, i);
+  }
+
+  static String? _arrowFor(int finalByte) {
+    switch (finalByte) {
+      case 0x41:
+        return 'up';
+      case 0x42:
+        return 'down';
+      case 0x43:
+        return 'right';
+      case 0x44:
+        return 'left';
+      case 0x48:
+        return 'home';
+      case 0x46:
+        return 'end';
+      default:
+        return null;
+    }
+  }
+
+  static String? _keyForCsi(String params, String finalByte) {
+    if (finalByte == 'A') return 'up';
+    if (finalByte == 'B') return 'down';
+    if (finalByte == 'C') return 'right';
+    if (finalByte == 'D') return 'left';
+    if (finalByte == 'H') return 'home';
+    if (finalByte == 'F') return 'end';
+    if (finalByte == 'Z') return 'shift+tab';
+    if (finalByte == '~') {
+      switch (params) {
+        case '1':
+        case '7':
+          return 'home';
+        case '2':
+          return null; // Insert: Herdr has no key name for it.
+        case '3':
+          return 'delete';
+        case '4':
+        case '8':
+          return 'end';
+        case '5':
+          return 'pageup';
+        case '6':
+          return 'pagedown';
+        default:
+          return null;
+      }
+    }
+    return null;
+  }
+}
+
+class _Escape {
+  const _Escape(this.key, this.next);
+
+  /// Key name, or null when the sequence is recognised but unmapped.
+  final String? key;
+
+  /// Index just past the sequence.
+  final int next;
+}
diff --git a/lib/harness/herdr/herdr_models.dart b/lib/harness/herdr/herdr_models.dart
new file mode 100644
index 0000000000000000000000000000000000000000..00b2b01b8c2050a0b8108293976dfa4e39162aec
--- /dev/null
+++ b/lib/harness/herdr/herdr_models.dart
@@ -0,0 +1,220 @@
+// Typed mirror of the `herdr agent list` / `workspace list` JSON that HerdrHost
+// reads. Field names are the ones herdr 0.9.x actually prints (snake_case, and
+// nullable where the schema says nullable) so a rename on Herdr's side breaks a
+// parsing test instead of shipping as an empty label.
+//
+// Deliberately no `agent_session` here: that object carries the agent's private
+// session-log path, and HerdrHost has no business holding it. Log reading
+// belongs to the local host's readers.
+
+import 'package:flutter/foundation.dart';
+
+import '../harness_host.dart';
+
+/// Lifecycle as Herdr reports it. `idle` and `done` both accept input.
+enum HerdrAgentStatus { idle, working, blocked, done, unknown }
+
+/// Unknown statuses degrade to [HerdrAgentStatus.unknown] so a newer Herdr
+/// never makes an older Studio throw.
+HerdrAgentStatus parseHerdrAgentStatus(Object? value) {
+  for (final status in HerdrAgentStatus.values) {
+    if (status.name == value) return status;
+  }
+  return HerdrAgentStatus.unknown;
+}
+
+/// Herdr status → harness status.
+///
+/// `idle` and `done` are both "ready for input", but they are not the same
+/// thing to a user: `done` means the last turn finished and nobody has looked
+/// at it yet, while `idle` means the agent is simply waiting. Keeping them
+/// apart lets the Agents list show a completion badge.
+HarnessSessionStatus harnessStatusFor(HerdrAgentStatus status) {
+  switch (status) {
+    case HerdrAgentStatus.idle:
+      return HarnessSessionStatus.idle;
+    case HerdrAgentStatus.working:
+      return HarnessSessionStatus.working;
+    case HerdrAgentStatus.blocked:
+      return HarnessSessionStatus.blocked;
+    case HerdrAgentStatus.done:
+      return HarnessSessionStatus.done;
+    case HerdrAgentStatus.unknown:
+      return HarnessSessionStatus.unknown;
+  }
+}
+
+/// One agent pane as returned by `herdr agent list`.
+@immutable
+class HerdrAgentInfo {
+  const HerdrAgentInfo({
+    required this.paneId,
+    required this.workspaceId,
+    required this.tabId,
+    required this.agentKind,
+    required this.status,
+    required this.focused,
+    this.cwd,
+    this.name,
+    this.title,
+    this.interactiveReady,
+    this.completionSeq,
+    this.stateChangeSeq,
+    this.revision,
+    this.launchPending = false,
+  });
+
+  factory HerdrAgentInfo.fromJson(Map<String, dynamic> json) => HerdrAgentInfo(
+    paneId: _str(json['pane_id']) ?? '',
+    workspaceId: _str(json['workspace_id']) ?? '',
+    tabId: _str(json['tab_id']) ?? '',
+    agentKind: _str(json['agent']) ?? _str(json['display_agent']) ?? '',
+    status: parseHerdrAgentStatus(json['agent_status']),
+    focused: json['focused'] == true,
+    cwd: _str(json['cwd']),
+    name: _str(json['name']),
+    title:
+        _str(json['terminal_title_stripped']) ??
+        _str(json['terminal_title']) ??
+        _str(json['title']),
+    interactiveReady: json['interactive_ready'] == true,
+    completionSeq: _int(json['completion_seq']),
+    stateChangeSeq: _int(json['state_change_seq']),
+    revision: _int(json['revision']),
+    launchPending: json['launch_pending'] == true,
+  );
+
+  final String paneId;
+  final String workspaceId;
+  final String tabId;
+
+  /// Agent label Herdr detected in the pane (`claude`, `codex`, `pi`, ...).
+  final String agentKind;
+  final HerdrAgentStatus status;
+  final bool focused;
+  final String? cwd;
+
+  /// User-assigned pane name; also the preferred prompt target.
+  final String? name;
+
+  /// Stripped terminal title, e.g. `执行 A D 盘独立构建 | analysis`.
+  final String? title;
+  final bool? interactiveReady;
+  final int? completionSeq;
+  final int? stateChangeSeq;
+  final int? revision;
+  final bool launchPending;
+
+  /// `agent prompt` / `send-keys` target: the pane name when the user gave one,
+  /// otherwise the pane id. A bare kind label is never a legal target.
+  String get target => (name != null && name!.isNotEmpty) ? name! : paneId;
+
+  /// Harness provider id used for grouping: the detected agent kind, or the
+  /// host's shell when the pane hosts no agent.
+  String get providerId => agentKind.isEmpty ? 'shell' : agentKind;
+
+  /// Session title: terminal title, then the pane name, then a readable id.
+  String get displayTitle {
+    final titleText = title;
+    if (titleText != null && titleText.isNotEmpty) return titleText;
+    final nameText = name;
+    if (nameText != null && nameText.isNotEmpty) return nameText;
+    return agentKind.isEmpty ? paneId : '$agentKind · $paneId';
+  }
+
+  /// A Herdr pane can be typed into, prompted, and its pane closed. There is no
+  /// structured transcript and no approval API: approvals happen in the pane.
+  static const Set<HarnessCapability> capabilities = <HarnessCapability>{
+    HarnessCapability.terminal,
+    HarnessCapability.prompt,
+    HarnessCapability.stop,
+  };
+
+  HarnessSessionInfo toSessionInfo({required String hostId}) =>
+      HarnessSessionInfo(
+        id: paneId,
+        hostId: hostId,
+        providerId: providerId,
+        title: displayTitle,
+        status: harnessStatusFor(status),
+        capabilities: capabilities,
+        cwd: cwd,
+        sourceRef: paneId,
+      );
+
+  HerdrAgentInfo copyWith({HerdrAgentStatus? status}) => HerdrAgentInfo(
+    paneId: paneId,
+    workspaceId: workspaceId,
+    tabId: tabId,
+    agentKind: agentKind,
+    status: status ?? this.status,
+    focused: focused,
+    cwd: cwd,
+    name: name,
+    title: title,
+    interactiveReady: interactiveReady,
+    completionSeq: completionSeq,
+    stateChangeSeq: stateChangeSeq,
+    revision: revision,
+    launchPending: launchPending,
+  );
+}
+
+/// One workspace as returned by `herdr workspace list`.
+@immutable
+class HerdrWorkspaceInfo {
+  const HerdrWorkspaceInfo({
+    required this.workspaceId,
+    required this.label,
+    required this.number,
+    required this.focused,
+    required this.status,
+    required this.paneCount,
+    required this.tabCount,
+  });
+
+  factory HerdrWorkspaceInfo.fromJson(Map<String, dynamic> json) =>
+      HerdrWorkspaceInfo(
+        workspaceId: _str(json['workspace_id']) ?? '',
+        label: _str(json['label']) ?? '',
+        number: _int(json['number']) ?? 0,
+        focused: json['focused'] == true,
+        status: parseHerdrAgentStatus(json['agent_status']),
+        paneCount: _int(json['pane_count']) ?? 0,
+        tabCount: _int(json['tab_count']) ?? 0,
+      );
+
+  final String workspaceId;
+  final String label;
+  final int number;
+  final bool focused;
+  final HerdrAgentStatus status;
+  final int paneCount;
+  final int tabCount;
+
+  /// Workspace label with a stable fallback, for grouping headers.
+  String get displayLabel => label.isEmpty ? workspaceId : label;
+}
+
+/// Result of `herdr status`: a two-section `key: value` text dump, not JSON.
+@immutable
+class HerdrServerStatus {
+  const HerdrServerStatus({
+    this.clientVersion,
+    this.clientProtocol,
+    this.serverRunning = false,
+    this.serverVersion,
+    this.socket,
+  });
+
+  final String? clientVersion;
+  final int? clientProtocol;
+  final bool serverRunning;
+  final String? serverVersion;
+  final String? socket;
+}
+
+/// Nullable-safe string field: Herdr prints `null` for absent texts.
+String? _str(Object? value) => value is String ? value : null;
+
+int? _int(Object? value) => value is num ? value.toInt() : null;
