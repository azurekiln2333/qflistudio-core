+// Web build: no processes and no filesystem, so Herdr cannot exist here.
+//
+// Signatures must match `herdr_platform_io.dart` exactly; both are selected by
+// `herdr_platform.dart`.
+
+import 'herdr_cli.dart';
+
+/// No `dart:io`, so nothing can be launched.
+Future<String?> locateHerdrExecutable({
+  String? explicitPath,
+  Map<String, String>? environment,
+  HerdrPathProbe? isExecutable,
+  HerdrDirectoryLister? listDirectory,
+  bool? isWindows,
+  bool? isMacOS,
+}) async => null;
+
+/// No PATH to inspect.
+bool executableOnPath(
+  String name, {
+  Map<String, String>? environment,
+  HerdrPathProbe? isExecutable,
+  HerdrDirectoryLister? listDirectory,
+  bool? isWindows,
+  bool? isMacOS,
+}) => false;
+
+/// A runner that reports the platform limitation on every call.
+class HerdrCliRunner {
+  HerdrCliRunner();
+
+  Future<HerdrProcessResult> call(
+    List<String> argv, {
+    String? workingDirectory,
+    required Duration timeout,
+  }) async => const HerdrProcessResult(exitCode: -1, spawnError: 'ENOENT');
+
+  Future<void> dispose() async {}
+}
diff --git a/lib/harness/herdr/herdr_session.dart b/lib/harness/herdr/herdr_session.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a87ade9fe7c584700d8afca3825285dc3a3fdf05
--- /dev/null
+++ b/lib/harness/herdr/herdr_session.dart
@@ -0,0 +1,120 @@
+// One open Herdr pane view.
+//
+// The handle is the only object the Agents UI holds. It owns the raw terminal
+// (attach PTY or snapshot fallback) and translates the contract verbs onto herdr
+// commands. It never approves anything: Herdr has no approval API, so an agent
+// waiting on a dialog is answered in the pane itself and the session shows up as
+// `blocked`.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../harness_host.dart';
+import 'herdr_cli.dart';
+import 'herdr_models.dart';
+import 'herdr_terminal.dart';
+
+class HerdrSessionHandle implements HarnessSessionHandle {
+  HerdrSessionHandle({
+    required HerdrCli cli,
+    required HerdrAgentInfo agent,
+    required HerdrTerminal terminal,
+    required Future<void> Function() onChanged,
+    required Future<void> Function(HerdrSessionHandle handle) onDetached,
+    this.hostId = 'herdr',
+  }) : _cli = cli,
+       _agent = agent,
+       _terminal = terminal,
+       _onChanged = onChanged,
+       _onDetached = onDetached,
+       _status = ValueNotifier<HarnessSessionStatus>(
+         harnessStatusFor(agent.status),
+       );
+
+  final HerdrCli _cli;
+  final HerdrTerminal _terminal;
+  final Future<void> Function() _onChanged;
+  final Future<void> Function(HerdrSessionHandle handle) _onDetached;
+  final ValueNotifier<HarnessSessionStatus> _status;
+
+  /// Host id stamped into [HarnessSessionInfo].
+  final String hostId;
+
+  HerdrAgentInfo _agent;
+  HarnessSessionInfo? _info;
+  bool _detached = false;
+  bool _stopped = false;
+
+  HerdrAgentInfo get agent => _agent;
+
+  @override
+  HarnessSessionInfo get info => _info ??= _agent.toSessionInfo(hostId: hostId);
+
+  @override
+  ValueListenable<HarnessSessionStatus> get status => _status;
+
+  /// Herdr has no structured transcript; the terminal is the transcript.
+  @override
+  Stream<TranscriptEvent>? get transcript => null;
+
+  @override
+  HarnessTerminalChannel? get terminal => _detached ? null : _terminal;
+
+  /// Applies a fresher row from `herdr agent list`.
+  void update(HerdrAgentInfo agent) {
+    _agent = agent;
+    _info = agent.toSessionInfo(hostId: hostId);
+    _status.value = harnessStatusFor(agent.status);
+  }
+
+  /// Marks the pane as gone (closed outside Studio).
+  void markExited() {
+    _status.value = HarnessSessionStatus.exited;
+  }
+
+  @override
+  Future<void> sendPrompt(String text) async {
+    if (text.trim().isEmpty) return;
+    // A rejected submission (blocked agent) is reported, never retried: Herdr
+    // may already have written part of the input.
+    await _cli.prompt(_agent.target, text);
+    unawaited(_onChanged());
+  }
+
+  @override
+  Future<void> reply(HarnessReply reply) async {
+    // Approvals are not representable here. Answering with keys would guess
+    // which dialog is on screen, which is exactly how a wrong choice gets
+    // applied silently.
+    throw UnsupportedError('Herdr 会话没有结构化审批，请在终端中直接回答。');
+  }
+
+  /// Releases the view only: the pane and its agent keep running.
+  @override
+  Future<void> detach() async {
+    if (_detached) return;
+    _detached = true;
+    await _terminal.close();
+    await _onDetached(this);
+  }
+
+  /// Ends the session by closing its pane. Callers confirm first.
+  @override
+  Future<void> stop() async {
+    if (_stopped) return;
+    _stopped = true;
+    await _terminal.close();
+    await _cli.closePane(_agent.paneId);
+    _status.value = HarnessSessionStatus.exited;
+    unawaited(_onChanged());
+  }
+
+  void dispose() {
+    if (!_detached) {
+      _detached = true;
+      unawaited(_terminal.close());
+    }
+    _status.dispose();
+  }
+}
diff --git a/lib/harness/herdr/herdr_terminal.dart b/lib/harness/herdr/herdr_terminal.dart
new file mode 100644
index 0000000000000000000000000000000000000000..b6f16c9fca63dabd963c754cd15207978416badf
--- /dev/null
+++ b/lib/harness/herdr/herdr_terminal.dart
@@ -0,0 +1,254 @@
+// The raw terminal behind a Herdr session.
+//
+// Two implementations share one interface:
+//
+//   * [HerdrPtyTerminal] runs `herdr agent attach <target>` inside a real PTY.
+//     That is the live view: bytes flow continuously, input reaches the pane
+//     with no round trip through a snapshot, and closing it only detaches —
+//     the pane and its agent keep running.
+//   * [HerdrSnapshotTerminal] is the fallback for builds without a PTY layer.
+//     It replays `pane read` snapshots and turns typed bytes into
+//     `pane send-text` / `pane send-keys` calls.
+//
+// Both feed the same contract type, so the Agents terminal tab does not care
+// which one is underneath. Neither implementation stops the session: `close()`
+// releases the view only, matching `HarnessSessionHandle.detach()`.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter/foundation.dart' show Listenable;
+
+import '../../remote_control/models/herdr.dart' show HerdrPaneSnapshot;
+import '../harness_host.dart' show HarnessTerminalChannel;
+import '../pty/harness_pty.dart';
+import 'herdr_input.dart';
+
+/// A Herdr terminal plus an explicit release step.
+abstract interface class HerdrTerminal implements HarnessTerminalChannel {
+  /// Releases this view. The pane keeps running.
+  Future<void> close();
+
+  /// Last known geometry, for snapshot replay fallbacks.
+  int get columns;
+  int get rows;
+}
+
+/// Live terminal through `herdr agent attach` in a PTY.
+class HerdrPtyTerminal implements HerdrTerminal {
+  HerdrPtyTerminal._(this._pty, this._output, this._columns, this._rows);
+
+  /// Starts the attach client. [argv] is the full command, including the Herdr
+  /// executable, so the caller owns path resolution.
+  static Future<HerdrPtyTerminal> start({
+    required HarnessPtyFactory factory,
+    required List<String> argv,
+    String? workingDirectory,
+    int columns = 100,
+    int rows = 30,
+  }) async {
+    final pty = await factory.start(
+      argv: argv,
+      workingDirectory: workingDirectory,
+      columns: columns,
+      rows: rows,
+    );
+    final output = StreamController<Uint8List>.broadcast();
+    final terminal = HerdrPtyTerminal._(pty, output, columns, rows);
+    terminal._listen();
+    return terminal;
+  }
+
+  final HarnessPty _pty;
+  final StreamController<Uint8List> _output;
+  StreamSubscription<Uint8List>? _subscription;
+  bool _closed = false;
+
+  void _listen() {
+    _subscription = _pty.output.listen(
+      (data) {
+        if (!_closed) _output.add(data);
+      },
+      onError: (Object _) {},
+      onDone: () {
+        if (!_closed) unawaited(_output.close());
+      },
+    );
+  }
+
+  int? get pid => _pty.pid;
+
+  @override
+  Stream<Uint8List> get output => _output.stream;
+
+  @override
+  void write(Uint8List data) {
+    if (_closed) return;
+    _pty.write(data);
+  }
+
+  @override
+  void resize(int columns, int rows) {
+    if (_closed) return;
+    _pty.resize(columns, rows);
+    _columns = columns;
+    _rows = rows;
+  }
+
+  int _columns;
+  int _rows;
+
+  @override
+  int get columns => _columns;
+
+  @override
+  int get rows => _rows;
+
+  /// Detaches: kills the attach client only. The pane keeps running.
+  @override
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    await _subscription?.cancel();
+    _subscription = null;
+    await _pty.kill();
+    await _output.close();
+  }
+}
+
+/// Snapshot-backed terminal for builds without a PTY.
+///
+/// Herdr has no incremental output stream on the CLI: `pane read` returns the
+/// screen. Replaying the whole screen when it changes is therefore correct
+/// rather than lossy — and the replay is normalised by [HerdrPaneSnapshot],
+/// which is the same code the remote Herdr view uses, so line endings and grid
+/// padding behave identically.
+class HerdrSnapshotTerminal implements HerdrTerminal {
+  HerdrSnapshotTerminal({
+    required Future<String> Function() readPane,
+    required Future<void> Function(String text) sendText,
+    required Future<void> Function(List<String> keys) sendKeys,
+    this.interval = const Duration(milliseconds: 1500),
+    this.translator = const HerdrInputTranslator(),
+    this.onError,
+    this.changes,
+    int columns = 100,
+    int rows = 30,
+  }) : _readPane = readPane,
+       _sendText = sendText,
+       _sendKeys = sendKeys,
+       _columns = columns,
+       _rows = rows;
+
+  /// How often the screen is re-read while the view is open.
+  ///
+  /// One CLI call per interval per open pane, and none while reading. The live
+  /// path is the PTY attach; this is the fallback, so "slow" is the right
+  /// trade-off against a tight poll loop.
+  final Duration interval;
+  final HerdrInputTranslator translator;
+
+  /// Reports input failures so the UI can show them instead of dropping keys.
+  final void Function(Object error)? onError;
+
+  /// Optional change source (a controller push, not a poll). When given, a
+  /// change repaints immediately instead of waiting for [interval].
+  final Listenable? changes;
+
+  final Future<String> Function() _readPane;
+  final Future<void> Function(String text) _sendText;
+  final Future<void> Function(List<String> keys) _sendKeys;
+
+  final StreamController<Uint8List> _output =
+      StreamController<Uint8List>.broadcast();
+  Timer? _timer;
+  String? _last;
+  bool _reading = false;
+  bool _closed = false;
+  int _columns;
+  int _rows;
+
+  void start() {
+    if (_closed || _timer != null) return;
+    _timer = Timer.periodic(interval, (_) => unawaited(_pump()));
+    changes?.addListener(_onChanges);
+    unawaited(_pump());
+  }
+
+  void _onChanges() => unawaited(_pump());
+
+  @override
+  Stream<Uint8List> get output => _output.stream;
+
+  @override
+  int get columns => _columns;
+
+  @override
+  int get rows => _rows;
+
+  @override
+  void write(Uint8List data) {
+    if (_closed) return;
+    unawaited(_dispatch(translator.translate(data)));
+  }
+
+  @override
+  void resize(int columns, int rows) {
+    _columns = columns;
+    _rows = rows;
+  }
+
+  @override
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    changes?.removeListener(_onChanges);
+    _timer?.cancel();
+    _timer = null;
+    await _output.close();
+  }
+
+  Future<void> _pump() async {
+    if (_closed || _reading) return;
+    _reading = true;
+    try {
+      final text = await _readPane();
+      if (_closed || text == _last) return;
+      _last = text;
+      final snapshot = HerdrPaneSnapshot.fromText(
+        text,
+        fallbackColumns: _columns,
+      );
+      // Clear then replay: a snapshot is a screen, not a stream, so anything
+      // else would stack old and new screens.
+      _emit('\u001b[2J\u001b[H');
+      _emit(snapshot.replayText);
+    } catch (_) {
+      // A transient read failure keeps the last screen; the next tick retries.
+    } finally {
+      _reading = false;
+    }
+  }
+
+  void _emit(String text) {
+    if (_closed) return;
+    _output.add(Uint8List.fromList(utf8.encode(text)));
+  }
+
+  Future<void> _dispatch(List<HerdrInputOp> ops) async {
+    for (final op in ops) {
+      if (_closed) return;
+      try {
+        switch (op) {
+          case HerdrSendTextOp():
+            await _sendText(op.text);
+          case HerdrSendKeysOp():
+            await _sendKeys(op.keys);
+        }
+      } catch (error) {
+        onError?.call(error);
+      }
+    }
+  }
+}
diff --git a/lib/harness/pty/harness_pty.dart b/lib/harness/pty/harness_pty.dart
new file mode 100644
index 0000000000000000000000000000000000000000..092660f25b7e732e3cc3c1704a382ce0d2c84477
--- /dev/null
+++ b/lib/harness/pty/harness_pty.dart
@@ -0,0 +1,59 @@
+// Pseudo-terminal seam shared by harness hosts.
+//
+// A harness host that has to run an interactive program (`herdr agent attach`,
+// an agent CLI, a login shell) needs a real PTY: a pipe pair has no terminal
+// semantics, so full-screen clients either refuse to start or render garbage.
+// Core has no PTY implementation of its own; StudioMux (the local host) owns
+// the ConPTY / forkpty layer. Hosts depend on this interface instead of on that
+// implementation, so the platform code stays in one place and tests can inject
+// a structural fake.
+//
+// Bytes are terminal output, never line-split, and `write` is raw input: no
+// trimming, no appended newline, no key reinterpretation.
+
+import 'dart:async';
+import 'dart:typed_data';
+
+/// One running pseudo-terminal.
+abstract interface class HarnessPty {
+  /// Operating-system process id once the child has started.
+  int? get pid;
+
+  /// Raw terminal output. Never line-split.
+  Stream<Uint8List> get output;
+
+  /// Completes with the child's exit code.
+  Future<int> get exitCode;
+
+  /// Writes raw bytes to the child's terminal.
+  void write(Uint8List data);
+
+  /// Applies a new terminal geometry.
+  void resize(int columns, int rows);
+
+  /// Ends the child and releases the PTY. Idempotent.
+  Future<void> kill();
+}
+
+/// Starts a process attached to a new pseudo-terminal.
+abstract interface class HarnessPtyFactory {
+  Future<HarnessPty> start({
+    required List<String> argv,
+
+    /// Working directory for the child; null means "where Studio runs".
+    String? workingDirectory,
+    Map<String, String>? environment,
+    int columns,
+    int rows,
+  });
+}
+
+/// The PTY could not be created (no platform support, spawn failure).
+class HarnessPtyException implements Exception {
+  const HarnessPtyException(this.message);
+
+  final String message;
+
+  @override
+  String toString() => message;
+}
