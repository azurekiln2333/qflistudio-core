+    File(p.join(root.path, 'README.md')).writeAsStringSync('# demo\n');
+    final relay = _FakeRelay()..chatReplies.add(_textReply('好的'));
+    final controller = VibeCodingController(
+      api: ApiClient(transport: relay.client),
