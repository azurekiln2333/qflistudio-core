diff --git a/lib/harness/studio/studio_agent_host.dart b/lib/harness/studio/studio_agent_host.dart
new file mode 100644
index 0000000000000000000000000000000000000000..3d448fd3f1362448bf8f4c2244a5bbe85a27a542
--- /dev/null
+++ b/lib/harness/studio/studio_agent_host.dart
@@ -0,0 +1,382 @@
+/// Studio 内置 Agent 的主机实现：把现有 Vibe 会话映射到 Harness Hub 契约。
+///
+/// 只包装 [AgentRuntime] 与会话存储，不改控制器的行为。会话列表按项目过滤，
+/// 标题、状态与更新时间都来自会话元数据与运行时的活动状态。
+library;
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../../session/agent_session.dart';
+import '../../vibe_coding/vibe_agent_facade.dart';
+import '../harness_host.dart';
+
+/// 主机与 provider 的固定标识。
+const String kStudioHostId = 'studio';
+const String kStudioProviderId = 'studio';
+
+/// 内置 Agent 出现在 Hub 列表里的名称。
+const String kStudioHostLabel = '内置 Agent';
+
+/// 一次视图最多保留多少条转录事件。
+const int kStudioTranscriptBacklog = 200;
+
+/// 内置 Agent 主机。
+///
+/// 只有 [watchSessions]、[open] 与 [launch] 会读会话存储；[dispose] 只释放
+/// 本主机的监听与流，不会停止任何会话。
+class StudioAgentHost implements HarnessHost {
+  StudioAgentHost({
+    required AgentRuntime runtime,
+    required this.projectId,
+    required this.projectRoot,
+    this.label = kStudioHostLabel,
+  }) : _runtime = runtime {
+    _sessions.addListener(_onChanged);
+    _runtime.liveChanges.addListener(_onChanged);
+  }
+
+  final AgentRuntime _runtime;
+
+  /// 会话所属项目。
+  final String projectId;
+
+  /// 项目根目录，作为会话的工作目录。
+  final String projectRoot;
+
+  @override
+  final String label;
+
+  final ValueNotifier<HarnessHostState> _state = ValueNotifier(
+    HarnessHostState.online,
+  );
+
+  /// 已打开的视图，用于随主机一起释放监听。
+  final Set<StudioSessionHandle> _handles = {};
+
+  final Set<MultiStreamController<List<HarnessSessionInfo>>> _watchers = {};
+
+  bool _disposed = false;
+
+  AgentSessionStore get _sessions => _runtime.sessions;
+
+  @override
+  String get id => kStudioHostId;
+
+  @override
+  HarnessHostKind get kind => HarnessHostKind.studio;
+
+  @override
+  ValueListenable<HarnessHostState> get state => _state;
+
+  @override
+  Stream<List<HarnessSessionInfo>> watchSessions() {
+    return Stream<List<HarnessSessionInfo>>.multi((controller) {
+      if (_disposed) {
+        controller.close();
+        return;
+      }
+      _watchers.add(controller);
+      controller.onCancel = () {
+        _watchers.remove(controller);
+      };
+      controller.add(snapshot());
+    });
+  }
+
+  /// 当前会话列表；界面刷新时也可直接调用。
+  List<HarnessSessionInfo> snapshot() {
+    if (_disposed) return const [];
+    return [
+      for (final meta in _sessions.sessionsOf(projectId))
+        HarnessSessionInfo(
+          id: meta.id,
+          hostId: id,
+          providerId: kStudioProviderId,
+          title: meta.title,
+          status: _statusOf(meta.id),
+          capabilities: _capabilities,
+          cwd: projectRoot,
+          updatedAt: meta.updatedAt,
+          sourceRef: meta.id,
+        ),
+    ];
+  }
+
+  /// 内置会话没有原始终端，只有对话、输入、确认与停止。
+  static const Set<HarnessCapability> _capabilities = {
+    HarnessCapability.transcript,
+    HarnessCapability.prompt,
+    HarnessCapability.approve,
+    HarnessCapability.stop,
+  };
+
+  @override
+  Future<List<HarnessProviderInfo>> providers() async => const [
+    HarnessProviderInfo(
+      id: kStudioProviderId,
+      label: kStudioHostLabel,
+      available: true,
+    ),
+  ];
+
+  @override
+  Future<HarnessSessionHandle> open(String sessionId) async {
+    if (_disposed) throw StateError('StudioAgentHost has been disposed');
+    final facade = await _runtime.open(projectId, sessionId);
+    final handle = StudioSessionHandle(
+      host: this,
+      runtime: _runtime,
+      projectRoot: projectRoot,
+      facade: facade,
+      info: () => _infoFor(sessionId),
+    );
+    _handles.add(handle);
+    return handle;
+  }
+
+  @override
+  Future<HarnessSessionHandle> launch(HarnessLaunchRequest request) async {
+    if (_disposed) throw StateError('StudioAgentHost has been disposed');
+    if (request.providerId != kStudioProviderId) {
+      throw ArgumentError.value(
+        request.providerId,
+        'providerId',
+        '内置主机只启动内置 Agent',
+      );
+    }
+    final meta = await _sessions.create(projectId, title: request.title);
+    return open(meta.id);
+  }
+
+  @override
+  Future<void> dispose() async {
+    if (_disposed) return;
+    _disposed = true;
+    _sessions.removeListener(_onChanged);
+    _runtime.liveChanges.removeListener(_onChanged);
+    for (final handle in _handles.toList()) {
+      await handle.detach();
+    }
+    _handles.clear();
+    for (final controller in _watchers.toList()) {
+      controller.close();
+    }
+    _watchers.clear();
+    _state.dispose();
+  }
+
+  HarnessSessionInfo _infoFor(String sessionId) {
+    final meta = _sessions.metaOf(sessionId);
+    return HarnessSessionInfo(
+      id: sessionId,
+      hostId: id,
+      providerId: kStudioProviderId,
+      title: meta?.title ?? AgentSessionStore.defaultTitle,
+      status: _statusOf(sessionId),
+      capabilities: _capabilities,
+      cwd: projectRoot,
+      updatedAt: meta?.updatedAt,
+      sourceRef: sessionId,
+    );
+  }
+
+  /// 运行时活动状态到契约状态。
+  HarnessSessionStatus _statusOf(String sessionId) =>
+      switch (_runtime.statusOf(sessionId)) {
+        AgentLiveStatus.running ||
+        AgentLiveStatus.queued => HarnessSessionStatus.working,
+        AgentLiveStatus.awaitingApproval => HarnessSessionStatus.blocked,
+        AgentLiveStatus.finishedUnread => HarnessSessionStatus.done,
+        // 失败未读既不是完成也不是在跑，按未知上报，不粉饰。
+        AgentLiveStatus.failed => HarnessSessionStatus.unknown,
+        AgentLiveStatus.idle => HarnessSessionStatus.idle,
+      };
+
+  void _onChanged() {
+    if (_disposed) return;
+    final list = snapshot();
+    for (final controller in _watchers.toList()) {
+      controller.add(list);
+    }
+  }
+
+  void _release(StudioSessionHandle handle) => _handles.remove(handle);
+}
+
+/// 一个内置 Agent 会话的视图。
+///
+/// [detach] 只释放本视图，会话继续运行；[stop] 结束本轮运行。
+class StudioSessionHandle implements HarnessSessionHandle {
+  StudioSessionHandle({
+    required StudioAgentHost host,
+    required AgentRuntime runtime,
+    required this.projectRoot,
+    required AgentFacade facade,
+    required HarnessSessionInfo Function() info,
+  }) : _host = host,
+       _runtime = runtime,
+       _facade = facade,
+       _infoOf = info,
+       _status = ValueNotifier(_mapStatus(runtime.statusOf(facade.sessionId))) {
+    _facade.addListener(_onFacadeChanged);
+    for (final message in _facade.messages) {
+      _remember(_eventOf(message));
+    }
+    _approvalKey = _pendingApprovalKey();
+  }
+
+  final StudioAgentHost _host;
+  final AgentRuntime _runtime;
+  final AgentFacade _facade;
+  final HarnessSessionInfo Function() _infoOf;
+  final String projectRoot;
+
+  final ValueNotifier<HarnessSessionStatus> _status;
+  final List<TranscriptEvent> _events = [];
+
+  /// 已发布消息的当前文本，用于在同一条消息被改写时重新发布。
+  final Map<String, String> _lastText = {};
+  final Set<MultiStreamController<TranscriptEvent>> _listeners = {};
+
+  /// 已经发布过的确认请求键，避免同一次确认重复出现。
+  String? _approvalKey;
+
+  bool _detached = false;
+
+  /// 当前转录快照；新监听者先收到历史，再收后续消息。
+  List<TranscriptEvent> get _backlog => List.unmodifiable(_events);
+
+  @override
+  HarnessSessionInfo get info => _infoOf();
+
+  @override
+  ValueListenable<HarnessSessionStatus> get status => _status;
+
+  @override
+  Stream<TranscriptEvent>? get transcript {
+    if (_detached) return null;
+    return Stream<TranscriptEvent>.multi((controller) {
+      for (final event in _backlog) {
+        controller.add(event);
+      }
+      _listeners.add(controller);
+      controller.onCancel = () {
+        _listeners.remove(controller);
+      };
+    });
+  }
+
+  @override
+  HarnessTerminalChannel? get terminal => null;
+
+  @override
+  Future<void> sendPrompt(String text) async {
+    final prompt = text.trim();
+    if (prompt.isEmpty) return;
+    await _facade.send(prompt, permission: _facade.permission);
+  }
+
+  @override
+  Future<void> reply(HarnessReply reply) async {
+    if (_facade.pendingApproval == null) return;
+    final choice = reply.choice.trim().toLowerCase();
+    final allow = choice == 'allow' || choice == 'yes' || choice == 'approve';
+    _facade.resolveApproval(allow);
+    _approvalKey = null;
+  }
+
+  @override
+  Future<void> detach() async {
+    if (_detached) return;
+    _detached = true;
+    _facade.removeListener(_onFacadeChanged);
+    for (final controller in _listeners.toList()) {
+      controller.close();
+    }
+    _listeners.clear();
+    _host._release(this);
+  }
+
+  @override
+  Future<void> stop() async {
+    await _facade.cancel();
+  }
+
+  /// 快照的是当前转录，包括打开前已有的消息；之后的消息实时追加。
+  void _onFacadeChanged() {
+    if (_detached) return;
+    _status.value = _mapStatus(_runtime.statusOf(_facade.sessionId));
+    for (final message in _facade.messages) {
+      final event = _eventOf(message);
+      if (_lastText[event.id] == event.text) continue;
+      _publish(event);
+    }
+    final key = _pendingApprovalKey();
+    if (key != null && key != _approvalKey) {
+      _approvalKey = key;
+      final approval = _facade.pendingApproval!;
+      _publish(
+        TranscriptEvent(
+          id: 'approval:$key',
+          role: TranscriptRole.system,
+          text: '需要确认写入 ${approval.path}\n${approval.summary}',
+          requestId: key,
+          options: const ['allow', 'deny'],
+        ),
+      );
+    } else if (key == null) {
+      _approvalKey = null;
+    }
+  }
+
+  String? _pendingApprovalKey() {
+    final approval = _facade.pendingApproval;
+    if (approval == null) return null;
+    return '${approval.path}|${approval.summary}';
+  }
+
+  /// 记下打开前已经存在的消息，供之后接入的监听者补发。
+  void _remember(TranscriptEvent event) {
+    _lastText[event.id] = event.text;
+    _events.add(event);
+  }
+
+  void _publish(TranscriptEvent event) {
+    _lastText[event.id] = event.text;
+    _events.removeWhere((entry) => entry.id == event.id);
+    _events.add(event);
+    if (_events.length > kStudioTranscriptBacklog) {
+      final dropped = _events.take(_events.length - kStudioTranscriptBacklog);
+      for (final event in dropped) {
+        _lastText.remove(event.id);
+      }
+      _events.removeRange(0, _events.length - kStudioTranscriptBacklog);
+    }
+    for (final controller in _listeners.toList()) {
+      controller.add(event);
+    }
+  }
+
+  static TranscriptEvent _eventOf(AgentMessageView message) => TranscriptEvent(
+    id: message.id,
+    role: switch (message.role) {
+      'user' => TranscriptRole.user,
+      'tool' => TranscriptRole.tool,
+      'reasoning' => TranscriptRole.system,
+      _ => TranscriptRole.assistant,
+    },
+    text: message.text,
+  );
+
+  static HarnessSessionStatus _mapStatus(AgentLiveStatus status) =>
+      switch (status) {
+        AgentLiveStatus.running ||
+        AgentLiveStatus.queued => HarnessSessionStatus.working,
+        AgentLiveStatus.awaitingApproval => HarnessSessionStatus.blocked,
+        AgentLiveStatus.finishedUnread => HarnessSessionStatus.done,
+        AgentLiveStatus.failed => HarnessSessionStatus.unknown,
+        AgentLiveStatus.idle => HarnessSessionStatus.idle,
+      };
+}
diff --git a/lib/trellis/trellis_commands.dart b/lib/trellis/trellis_commands.dart
new file mode 100644
index 0000000000000000000000000000000000000000..51ff3aac726a48ae6bb7a7e8313e72845b6886a2
--- /dev/null
+++ b/lib/trellis/trellis_commands.dart
@@ -0,0 +1,179 @@
+/// Trellis 斜杠命令：把 `/trellis:continue`、`/trellis:finish-work`
+/// 展开成同名技能或项目里的命令文件。
+///
+/// 解析顺序：可见技能 → 项目命令文件 → 内置说明。任何一步取到的内容都按
+/// [kTrellisCommandMaxChars] 截断，命令本身不执行任何脚本。
+library;
+
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+import '../vibe_coding/vibe_skills.dart';
+
+/// 展开后的指令上限（字符）。
+const int kTrellisCommandMaxChars = 8 * 1024;
+
+/// 一条 Trellis 斜杠命令。
+class TrellisSlashCommand {
+  const TrellisSlashCommand({
+    required this.name,
+    required this.skillNames,
+    required this.projectPaths,
+    required this.instructions,
+  });
+
+  /// 用户输入的命令名，例如 `/trellis:continue`。
+  final String name;
+
+  /// 同义技能名；按顺序取第一个可见的。
+  final List<String> skillNames;
+
+  /// 项目内的命令文件，相对项目根；按顺序取第一个存在的。
+  final List<String> projectPaths;
+
+  /// 都找不到时使用的内置说明。
+  final String instructions;
+}
+
+/// 支持的命令。
+const List<TrellisSlashCommand> kTrellisSlashCommands = [
+  TrellisSlashCommand(
+    name: '/trellis:continue',
+    skillNames: ['trellis-continue', 'trellis:continue'],
+    projectPaths: [
+      '.pi/prompts/trellis-continue.md',
+      '.claude/commands/trellis/continue.md',
+    ],
+    instructions: _continueInstructions,
+  ),
+  TrellisSlashCommand(
+    name: '/trellis:finish-work',
+    skillNames: ['trellis-finish-work', 'trellis:finish-work'],
+    projectPaths: [
+      '.pi/prompts/trellis-finish-work.md',
+      '.claude/commands/trellis/finish-work.md',
+    ],
+    instructions: _finishInstructions,
+  ),
+];
+
+const String _continueInstructions = '''
+继续当前 Trellis 任务，按阶段接着做：
+
+1. 读 `.trellis/workflow.md` 的阶段索引。
+2. 读当前任务的 `task.json`，按 `status` 与产物决定步骤：
+   - `planning` 且没有 `prd.md`：回到 1.1 写需求。
+   - `planning` 且复杂任务缺 `design.md` 或 `implement.md`：补齐设计。
+   - `planning` 且产物齐全：请用户确认后再开始实现。
+   - `in_progress` 且未开工：进入 2.1 实现。
+   - `in_progress` 且已实现未检查：进入 2.2 质量检查。
+   - `completed`：进入归档流程。
+3. 只读当前步骤需要的规范与任务文件。
+4. 不要代替用户批准实现，也不要跳过检查。''';
+
+const String _finishInstructions = '''
+收尾当前 Trellis 任务：
+
+1. 先确认本轮代码已经提交；未提交时提示用户回到 3.4。
+2. 归档当前任务：`python ./.trellis/scripts/task.py archive <任务名>`。
+3. 记录会话日志：`python ./.trellis/scripts/add_session.py`。
+4. 不要在这里提交代码，也不要改写别人的工作树。
+5. 命令失败时如实报告，不编造执行结果。''';
+
+/// 找出输入开头的 Trellis 命令；不是命令时返回 null。
+TrellisSlashCommand? matchTrellisSlashCommand(String input) {
+  final trimmed = input.trimLeft();
+  for (final command in kTrellisSlashCommands) {
+    if (!trimmed.startsWith(command.name)) continue;
+    final rest = trimmed.substring(command.name.length);
+    if (rest.isEmpty || rest.startsWith(RegExp(r'\s'))) return command;
+  }
+  return null;
+}
+
+/// 命令之后的附加说明；没有时返回空串。
+String trellisCommandArguments(TrellisSlashCommand command, String input) {
+  final trimmed = input.trimLeft();
+  if (!trimmed.startsWith(command.name)) return '';
+  return trimmed.substring(command.name.length).trim();
+}
+
+/// 展开 Trellis 斜杠命令；不是命令或不是 Trellis 项目时返回 null。
+///
+/// [skills] 是当前会话可见的技能；同名技能优先，正文按需读盘。
+Future<String?> routeTrellisSlashCommand(
+  String input, {
+  required String projectRoot,
+  required List<VibeSkill> skills,
+  int maxChars = kTrellisCommandMaxChars,
+}) async {
+  final command = matchTrellisSlashCommand(input);
+  if (command == null) return null;
+  if (!Directory(p.join(projectRoot, '.trellis')).existsSync()) return null;
+  final extra = trellisCommandArguments(command, input);
+  final body =
+      await _skillBody(command, skills) ??
+      _projectFile(command, projectRoot) ??
+      command.instructions;
+  final buffer = StringBuffer(command.name);
+  if (extra.isNotEmpty) buffer.write('：$extra');
+  buffer
+    ..writeln()
+    ..writeln()
+    ..write(body.trim());
+  return clampTrellisCommand(buffer.toString(), maxChars);
+}
+
+/// 按字符上限截断展开结果。
+String clampTrellisCommand(
+  String text, [
+  int maxChars = kTrellisCommandMaxChars,
+]) {
+  if (text.length <= maxChars) return text;
+  return '${text.substring(0, maxChars)}\n\n（命令内容已截断）';
+}
+
+Future<String?> _skillBody(
+  TrellisSlashCommand command,
+  List<VibeSkill> skills,
+) async {
+  for (final name in command.skillNames) {
+    for (final skill in skills) {
+      if (skill.name != name) continue;
+      final body = await skill.resolveBody();
+      if (body.trim().isNotEmpty) return body;
+    }
+  }
+  return null;
+}
+
+String? _projectFile(TrellisSlashCommand command, String projectRoot) {
+  for (final relative in command.projectPaths) {
+    final file = File(p.joinAll([projectRoot, ...relative.split('/')]));
+    if (FileSystemEntity.typeSync(file.path, followLinks: false) !=
+        FileSystemEntityType.file) {
+      continue;
+    }
+    try {
+      final limit = kTrellisCommandMaxChars * 2;
+      final text = file.lengthSync() <= limit
+          ? file.readAsStringSync()
+          : _readHead(file, limit);
+      if (text.trim().isNotEmpty) return text;
+    } on FileSystemException {
+      continue;
+    }
+  }
+  return null;
+}
+
+String _readHead(File file, int maxBytes) {
+  final handle = file.openSync();
+  try {
+    return utf8.decode(handle.readSync(maxBytes), allowMalformed: true);
+  } finally {
+    handle.closeSync();
+  }
+}
diff --git a/lib/trellis/trellis_context.dart b/lib/trellis/trellis_context.dart
new file mode 100644
index 0000000000000000000000000000000000000000..31e5b21c0f0cdaa0fbf7611a604ac4895b6939ce
--- /dev/null
+++ b/lib/trellis/trellis_context.dart
@@ -0,0 +1,214 @@
+/// Trellis 会话上下文：把项目状态压成一段精简文本，注入会话开头。
+///
+/// 桌面版可以先调用 `python ./.trellis/scripts/get_context.py` 取官方上下文，
+/// 失败或超时再回退到 [TrellisProject] 的 Dart 解析。两条路径都只读文件。
+library;
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import '../services/process_supervisor.dart';
+import 'trellis_project.dart';
+
+/// 注入的系统提示上下文上限（字符）。
+const int kTrellisContextMaxChars = 1600;
+
+/// 上下文里最多列多少个活跃任务。
+const int kTrellisContextMaxTasks = 8;
+
+/// 单条任务标题的字符上限。
+const int kTrellisContextMaxTaskTitleChars = 40;
+
+/// 脚本上下文的字符上限。
+const int kTrellisScriptContextMaxChars = 4000;
+
+/// 能提供 Trellis 上下文的代理上下文来源。
+///
+/// 控制器只在来源实现本接口时注入，测试里的假上下文不受影响。
+abstract interface class VibeTrellisContextSource {
+  /// 会话开头要注入的精简上下文；不是 Trellis 项目时返回空串。
+  Future<String> trellisContext();
+}
+
+/// 生成精简上下文；不是 Trellis 项目时调用方拿到空串。
+String buildTrellisContext(
+  TrellisProject project, {
+  int maxTasks = kTrellisContextMaxTasks,
+  int maxChars = kTrellisContextMaxChars,
+}) {
+  final buffer = StringBuffer()
+    ..writeln('### Trellis 项目上下文')
+    ..writeln(
+      '本项目使用 Trellis。改代码前先用 read_file 读 '
+      '${TrellisProject.workflowPath}。',
+    );
+  if (project.developer.isNotEmpty) {
+    buffer.writeln('开发者：${project.developer}');
+  }
+  final current = project.currentTask;
+  if (current == null) {
+    buffer.writeln('当前任务：未确定');
+  } else {
+    final step = current.phase.step.isEmpty ? '' : '，下一步 ${current.phase.step}';
+    buffer.writeln(
+      '当前任务：${current.dirName}（${current.status}，'
+      '${current.phase.label}$step）',
+    );
+    buffer.writeln(
+      '  标题：${_clip(current.title, kTrellisContextMaxTaskTitleChars * 2)}',
+    );
+    final docs = [
+      for (final doc in current.docs) doc.exists ? doc.name : '${doc.name}（缺）',
+    ];
+    if (docs.isNotEmpty) buffer.writeln('  产物：${docs.join('、')}');
+    buffer.writeln('  任务目录：${current.relativePath}');
+  }
+  final active = project.activeTasks;
+  if (active.isNotEmpty) {
+    final shown = active.take(maxTasks).toList();
+    final more = shown.length < active.length ? '，列出前 ${shown.length} 个' : '';
+    buffer.writeln('活跃任务（共 ${active.length} 个$more）：');
+    for (final task in shown) {
+      buffer.writeln(
+        '- ${task.dirName}：'
+        '${_clip(task.title, kTrellisContextMaxTaskTitleChars)}'
+        '（${task.status}）',
+      );
+    }
+  }
+  if (project.specIndexes.isNotEmpty) {
+    final indexes = [
+      for (final index in project.specIndexes) index.relativePath,
+    ];
+    buffer.writeln('规范索引：${indexes.join('、')}');
+  }
+  buffer.writeln('只按当前改动读取对应的规范与任务文件，不要一次加载全部。');
+  return clampTrellisContext(buffer.toString(), maxChars);
+}
+
+/// 按字符上限截断上下文，尽量停在整行。
+String clampTrellisContext(
+  String text, [
+  int maxChars = kTrellisContextMaxChars,
+]) {
+  if (text.length <= maxChars) return text;
+  const mark = '（Trellis 上下文已截断）';
+  final room = maxChars - mark.length - 1;
+  if (room <= 0) return mark;
+  final cut = text.substring(0, room);
+  final newline = cut.lastIndexOf('\n');
+  final body = newline > room ~/ 2 ? cut.substring(0, newline) : cut;
+  return '$body\n$mark';
+}
+
+/// 载入一次会话上下文。
+///
+/// [preferPython] 只应在桌面版打开；移动端与网页直接走 Dart 解析。
+class TrellisContextLoader {
+  const TrellisContextLoader({
+    this.preferPython = false,
+    this.pythonExecutable = 'python',
+    this.timeout = const Duration(seconds: 8),
+  });
+
+  final bool preferPython;
+  final String pythonExecutable;
+
+  /// 调用脚本的总时限；超时后杀掉进程并回退。
+  final Duration timeout;
+
+  /// 取上下文；项目不是 Trellis 时返回空串。
+  Future<String> load(String projectRoot) async {
+    if (!TrellisProject.hasWorkflow(projectRoot)) return '';
+    if (preferPython) {
+      final text = await _runScript(projectRoot);
+      if (text != null && text.trim().isNotEmpty) {
+        return compactScriptContext(text);
+      }
+    }
+    final project = await TrellisProject.load(projectRoot);
+    if (project == null) return '';
+    return buildTrellisContext(project);
+  }
+
+  /// 运行官方脚本；任何失败都返回 null，不打断会话。
+  Future<String?> _runScript(String projectRoot) async {
+    final script = File(
+      '$projectRoot${Platform.pathSeparator}.trellis'
+      '${Platform.pathSeparator}scripts'
+      '${Platform.pathSeparator}get_context.py',
+    );
+    if (!script.existsSync()) return null;
+    final supervisor = ProcessSupervisor();
+    try {
+      final process = await supervisor.start(pythonExecutable, [
+        script.path,
+      ], workingDirectory: projectRoot);
+      final stdoutText = process.stdout
+          .transform(const Utf8Decoder(allowMalformed: true))
+          .join();
+      final stderrDrained = process.stderr.drain<void>();
+      final exit = process.exitCode;
+      final completed = await Future.any<Object?>([
+        stdoutText,
+        Future<Object?>.delayed(timeout, () => null),
+      ]);
+      if (completed is! String) {
+        await process.cancel();
+        return null;
+      }
+      final code = await exit;
+      await stderrDrained;
+      if (code != 0) return null;
+      return completed;
+    } on Object {
+      return null;
+    } finally {
+      await supervisor.dispose();
+    }
+  }
+}
+
+/// 压缩脚本输出：去掉横幅、截短改动清单、限制总长度。
+String compactScriptContext(
+  String text, {
+  int maxChars = kTrellisScriptContextMaxChars,
+}) {
+  final out = <String>[];
+  var inChanges = false;
+  var changeLines = 0;
+  for (final raw in const LineSplitter().convert(text)) {
+    final line = raw.trimRight();
+    final trimmed = line.trim();
+    if (trimmed.startsWith('=====')) continue;
+    if (trimmed == 'SESSION CONTEXT') continue;
+    if (trimmed == 'Changes:') {
+      inChanges = true;
+      changeLines = 0;
+      out.add(line);
+      continue;
+    }
+    if (inChanges) {
+      if (trimmed.isEmpty) {
+        inChanges = false;
+        out.add(line);
+        continue;
+      }
+      changeLines++;
+      if (changeLines <= 5) {
+        out.add(line);
+      } else if (changeLines == 6) {
+        out.add('…（其余改动未列出）');
+      }
+      continue;
+    }
+    out.add(line);
+  }
+  return clampTrellisContext(out.join('\n').trim(), maxChars);
+}
+
+String _clip(String value, int maxChars) {
+  final flat = value.replaceAll(RegExp(r'\s+'), ' ').trim();
+  return flat.length <= maxChars ? flat : '${flat.substring(0, maxChars)}…';
+}
diff --git a/lib/trellis/trellis_panel.dart b/lib/trellis/trellis_panel.dart
new file mode 100644
index 0000000000000000000000000000000000000000..c5062a860d07058a001da4323f421c845d9f16b2
--- /dev/null
+++ b/lib/trellis/trellis_panel.dart
@@ -0,0 +1,91 @@
+/// Trellis 任务面板的数据模型。
+///
+/// 面板只读：显示当前任务、阶段、产物链接与活跃任务。界面直接渲染本模型，
+/// 打开产物走宿主提供的回调，模型自身不碰文件系统。
+library;
+
+import 'trellis_project.dart';
+
+/// 面板里的一行任务。
+class TrellisPanelTask {
+  const TrellisPanelTask({required this.task, this.indent = 0});
+
+  final TrellisTask task;
+
+  /// 子任务的缩进层级。
+  final int indent;
+}
+
+/// 任务面板快照。
+class TrellisTaskPanel {
+  const TrellisTaskPanel({
+    required this.developer,
+    required this.currentTask,
+    required this.activeTasks,
+    required this.myTasks,
+    required this.specIndexes,
+    required this.workflowPath,
+  });
+
+  /// `.trellis/.developer` 里的名字；没有时为空串。
+  final String developer;
+
+  /// 当前任务；未确定时为 null。
+  final TrellisTask? currentTask;
+
+  /// 活跃任务，父任务在前，子任务缩进跟随。
+  final List<TrellisPanelTask> activeTasks;
+
+  /// 分给当前开发者的活跃任务。
+  final List<TrellisTask> myTasks;
+
+  /// 有 `index.md` 的规范层。
+  final List<TrellisSpecIndex> specIndexes;
+
+  /// 工作流文件路径（相对项目根）。
+  final String workflowPath;
+
+  /// 没有任何可显示内容。
+  bool get isEmpty => currentTask == null && activeTasks.isEmpty;
+}
+
+/// 由项目状态生成面板；不是 Trellis 项目时返回 null。
+TrellisTaskPanel? buildTrellisTaskPanel(TrellisProject project) {
+  final active = project.activeTasks;
+  final byName = {for (final task in active) task.dirName: task};
+  final children = <String>{};
+  for (final task in active) {
+    for (final child in task.children) {
+      if (byName.containsKey(child)) children.add(child);
+    }
+  }
+  final rows = <TrellisPanelTask>[];
+  void append(String name, int indent) {
+    final task = byName[name];
+    if (task == null) return;
+    rows.add(TrellisPanelTask(task: task, indent: indent));
+    for (final child in task.children) {
+      append(child, indent + 1);
+    }
+  }
+
+  for (final task in active) {
+    if (children.contains(task.dirName)) continue;
+    append(task.dirName, 0);
+  }
+  // 父任务不在活跃集合里时，孤儿子任务照样显示。
+  for (final task in active) {
+    if (rows.any((row) => row.task.dirName == task.dirName)) continue;
+    rows.add(TrellisPanelTask(task: task));
+  }
+  return TrellisTaskPanel(
+    developer: project.developer,
+    currentTask: project.currentTask,
+    activeTasks: rows,
+    myTasks: project.developer.isEmpty
+        ? const []
+        : project.activeTasksOf(project.developer),
+    specIndexes: project.specIndexes,
+    workflowPath: TrellisProject.workflowPath,
+  );
+}
diff --git a/lib/trellis/trellis_project.dart b/lib/trellis/trellis_project.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a69259284a273787e61a85580d4bb2599a6ce540
--- /dev/null
+++ b/lib/trellis/trellis_project.dart
@@ -0,0 +1,457 @@
+/// Trellis 项目读取：只读 `.trellis` 下的普通文件，不跟随符号链接。
+///
+/// 识别条件是项目根目录存在普通 `.trellis` 目录，且其中有一份非空的
+/// `workflow.md`。任务、开发者与规范索引都由本文件直接解析，不执行脚本。
+/// 桌面版可另用 `python ./.trellis/scripts/get_context.py` 取上下文，失败时
+/// 回退到这里的结果。
+library;
+
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+/// 任务所处的工作流阶段。
+///
+/// 阶段编号对应 `.trellis/workflow.md` 的 Phase 1/2/3。
+enum TrellisTaskPhase {
+  planning('阶段 1 Plan', '1.1'),
+  executing('阶段 2 Execute', '2.1'),
+  finishing('阶段 3 Finish', '3.3'),
+  archived('已归档', ''),
+  unknown('未知阶段', '');
+
+  const TrellisTaskPhase(this.label, this.step);
+
+  /// 可直接显示的阶段名。
+  final String label;
+
+  /// 该阶段的建议起始步骤；空串表示没有步骤。
+  final String step;
+}
+
+/// 任务目录里的一份产物文档。
+class TrellisTaskDoc {
+  const TrellisTaskDoc({
+    required this.name,
+    required this.relativePath,
+    required this.exists,
+  });
+
+  /// 文件名，例如 `prd.md`。
+  final String name;
+
+  /// 相对项目根的路径。
+  final String relativePath;
+
+  final bool exists;
+}
+
+/// 一个 Trellis 任务的只读视图，来自 `task.json`。
+class TrellisTask {
+  const TrellisTask({
+    required this.dirName,
+    required this.id,
+    required this.title,
+    required this.description,
+    required this.status,
+    required this.docs,
+    this.priority,
+    this.assignee,
+    this.creator,
+    this.parent,
+    this.children = const [],
+    this.createdAt,
+    this.completedAt,
+  });
+
+  /// 任务目录名，例如 `11-22-harness-hub`。
+  final String dirName;
+
+  /// `task.json` 的 `id`。
+  final String id;
+
+  final String title;
+  final String description;
+
+  /// 原始状态：`planning`、`in_progress`、`completed` 等。
+  final String status;
+
+  /// prd、design、implement 三份产物及其存在性。
+  final List<TrellisTaskDoc> docs;
+
+  final String? priority;
+  final String? assignee;
+  final String? creator;
+
+  /// 父任务名；没有父任务时为 null。
+  final String? parent;
+
+  /// 子任务名。
+  final List<String> children;
+
+  final DateTime? createdAt;
+  final DateTime? completedAt;
+
+  /// 任务目录，相对项目根。
+  String get relativePath => '.trellis/tasks/$dirName';
+
+  /// 是否还需要跟进。已归档、已完成、已取消的任务都不算活跃。
+  bool get isActive =>
+      !const {'completed', 'done', 'archived', 'cancelled'}.contains(status);
+
+  /// 当前阶段的显示信息。
+  TrellisTaskPhase get phase => switch (status) {
+    'planning' => TrellisTaskPhase.planning,
+    'in_progress' => TrellisTaskPhase.executing,
+    'completed' || 'done' => TrellisTaskPhase.finishing,
+    'archived' => TrellisTaskPhase.archived,
+    _ => TrellisTaskPhase.unknown,
+  };
+
+  /// 有内容的产物名。
+  List<String> get existingDocs => [
+    for (final doc in docs)
+      if (doc.exists) doc.name,
+  ];
+}
+
+/// `.trellis/spec/<层>/index.md` 的只读视图。
+class TrellisSpecIndex {
+  const TrellisSpecIndex({required this.layer, required this.relativePath});
+
+  /// 层名，例如 `frontend`、`backend`。
+  final String layer;
+
+  /// 相对项目根的路径。
+  final String relativePath;
+}
+
+/// 一个已识别的 Trellis 项目。
+class TrellisProject {
+  const TrellisProject({
+    required this.root,
+    required this.developer,
+    required this.tasks,
+    required this.currentTask,
+    required this.specIndexes,
+  });
+
+  /// 项目根目录的绝对路径。
+  final String root;
+
+  /// `.trellis/.developer` 里的名字；没有时为空串。
+  final String developer;
+
+  /// `.trellis/tasks/*/task.json` 解析出的全部任务，按目录名排序。
+  final List<TrellisTask> tasks;
+
+  /// 当前任务；无法确定时为 null。
+  final TrellisTask? currentTask;
+
+  /// 存在 `index.md` 的规范层。
+  final List<TrellisSpecIndex> specIndexes;
+
+  /// 工作流文件的相对路径。
+  static const String workflowPath = '.trellis/workflow.md';
+
+  /// 任务文件的字节上限；超过上限的任务跳过。
+  static const int maxTaskJsonBytes = 64 * 1024;
+
+  /// 需要跟进的任务。
+  List<TrellisTask> get activeTasks => [
+    for (final task in tasks)
+      if (task.isActive) task,
+  ];
+
+  /// 分配给 [developer] 的活跃任务。
+  List<TrellisTask> activeTasksOf(String developer) => [
+    for (final task in activeTasks)
+      if (task.assignee == developer) task,
+  ];
+
+  /// 按任务目录名查找。
+  TrellisTask? taskNamed(String dirName) {
+    for (final task in tasks) {
+      if (task.dirName == dirName) return task;
+    }
+    return null;
+  }
+
+  /// 判断项目根下是否有可用的 Trellis 工作流。
+  ///
+  /// `.trellis` 或 `workflow.md` 是链接时视为不可用，与规则加载保持一致。
+  static bool hasWorkflow(String projectRoot) {
+    final directory = p.join(projectRoot, '.trellis');
+    final workflow = File(p.join(directory, 'workflow.md'));
+    try {
+      if (FileSystemEntity.typeSync(directory, followLinks: false) !=
+          FileSystemEntityType.directory) {
+        return false;
+      }
+      if (FileSystemEntity.typeSync(workflow.path, followLinks: false) !=
+          FileSystemEntityType.file) {
+        return false;
+      }
+      return readTextHead(workflow, 4 * 1024).trim().isNotEmpty;
+    } on FileSystemException {
+      return false;
+    }
+  }
+
+  /// 解析项目；没有可用工作流时返回 null。
+  ///
+  /// [currentTaskName] 可显式指定当前任务目录名；为 null 时读
+  /// `.trellis/.runtime/sessions/` 里最近一次记录的指针。
+  static Future<TrellisProject?> load(
+    String projectRoot, {
+    String? currentTaskName,
+  }) async {
+    if (!hasWorkflow(projectRoot)) return null;
+    final developer = await _readDeveloper(projectRoot);
+    final tasks = await _readTasks(projectRoot);
+    final specIndexes = await _readSpecIndexes(projectRoot);
+    final resolvedName =
+        currentTaskName ?? await _readRuntimeTaskName(projectRoot);
+    TrellisTask? current;
+    for (final task in tasks) {
+      if (task.dirName == resolvedName) {
+        current = task;
+        break;
+      }
+    }
+    return TrellisProject(
+      root: projectRoot,
+      developer: developer,
+      tasks: tasks,
+      currentTask: current,
+      specIndexes: specIndexes,
+    );
+  }
+
+  static Future<String> _readDeveloper(String projectRoot) async {
+    final file = File(p.join(projectRoot, '.trellis', '.developer'));
+    if (FileSystemEntity.typeSync(file.path, followLinks: false) !=
+        FileSystemEntityType.file) {
+      return '';
+    }
+    final String text;
+    try {
+      text = readTextHead(file, 4 * 1024);
+    } on FileSystemException {
+      return '';
+    }
+    for (final line in const LineSplitter().convert(text)) {
+      final trimmed = line.trim();
+      if (!trimmed.startsWith('name=')) continue;
+      final name = trimmed.substring(5).trim();
+      if (name.isNotEmpty) return name;
+    }
+    return '';
+  }
+
+  /// 读任务目录；单个任务坏了只跳过它。
+  static Future<List<TrellisTask>> _readTasks(String projectRoot) async {
+    final dir = p.join(projectRoot, '.trellis', 'tasks');
+    if (FileSystemEntity.typeSync(dir, followLinks: false) !=
+        FileSystemEntityType.directory) {
+      return const [];
+    }
+    final List<FileSystemEntity> entries;
+    try {
+      entries = await Directory(dir).list(followLinks: false).toList();
+    } on FileSystemException {
+      return const [];
+    }
+    entries.sort((a, b) => a.path.compareTo(b.path));
+    final tasks = <TrellisTask>[];
+    for (final entry in entries) {
+      if (entry is! Directory) continue;
+      final dirName = p.basename(entry.path);
+      final file = File(p.join(entry.path, 'task.json'));
+      if (FileSystemEntity.typeSync(file.path, followLinks: false) !=
+          FileSystemEntityType.file) {
+        continue;
+      }
+      final task = _taskFromFile(projectRoot, dirName, file);
+      if (task != null) tasks.add(task);
+    }
+    return tasks;
+  }
+
+  static TrellisTask? _taskFromFile(
+    String projectRoot,
+    String dirName,
+    File file,
+  ) {
+    final String text;
+    try {
+      text = readTextHead(file, maxTaskJsonBytes);
+    } on FileSystemException {
+      return null;
+    }
+    final Object? decoded;
+    try {
+      decoded = jsonDecode(text);
+    } on FormatException {
+      return null;
+    }
+    if (decoded is! Map) return null;
+    final title = _string(decoded['title']) ?? _string(decoded['name']);
+    if (title == null || title.isEmpty) return null;
+    final base = '.trellis/tasks/$dirName';
+    final docs = [
+      for (final name in kVibeTrellisTaskDocs)
+        TrellisTaskDoc(
+          name: name,
+          relativePath: '$base/$name',
+          exists:
+              FileSystemEntity.typeSync(
+                p.joinAll([projectRoot, ...'$base/$name'.split('/')]),
+                followLinks: false,
+              ) ==
+              FileSystemEntityType.file,
+        ),
+    ];
+    return TrellisTask(
+      dirName: dirName,
+      id: _string(decoded['id']) ?? dirName,
+      title: title,
+      description: _string(decoded['description']) ?? '',
+      status: _string(decoded['status']) ?? 'unknown',
+      docs: docs,
+      priority: _string(decoded['priority']),
+      assignee: _string(decoded['assignee']),
+      creator: _string(decoded['creator']),
+      parent: _string(decoded['parent']),
+      children: _stringList(decoded['children']),
+      createdAt: _date(decoded['createdAt']),
+      completedAt: _date(decoded['completedAt']),
+    );
+  }
+
+  static Future<List<TrellisSpecIndex>> _readSpecIndexes(
+    String projectRoot,
+  ) async {
+    final dir = p.join(projectRoot, '.trellis', 'spec');
+    if (FileSystemEntity.typeSync(dir, followLinks: false) !=
+        FileSystemEntityType.directory) {
+      return const [];
+    }
+    final List<FileSystemEntity> entries;
+    try {
+      entries = await Directory(dir).list(followLinks: false).toList();
+    } on FileSystemException {
+      return const [];
+    }
+    entries.sort((a, b) => a.path.compareTo(b.path));
+    final indexes = <TrellisSpecIndex>[];
+    for (final entry in entries) {
+      if (entry is! Directory) continue;
+      final layer = p.basename(entry.path);
+      final relative = '.trellis/spec/$layer/index.md';
+      final file = File(p.joinAll([projectRoot, ...relative.split('/')]));
+      if (FileSystemEntity.typeSync(file.path, followLinks: false) !=
+          FileSystemEntityType.file) {
+        continue;
+      }
+      indexes.add(TrellisSpecIndex(layer: layer, relativePath: relative));
+    }
+    return indexes;
+  }
+
+  /// 读最近的会话指针，取其中的当前任务目录名。
+  ///
+  /// 指针只含平台名、时间与任务路径，不含任何凭据。读不到时返回 null。
+  static Future<String?> _readRuntimeTaskName(String projectRoot) async {
+    final dir = p.join(projectRoot, '.trellis', '.runtime', 'sessions');
+    if (FileSystemEntity.typeSync(dir, followLinks: false) !=
+        FileSystemEntityType.directory) {
+      return null;
+    }
+    final List<FileSystemEntity> entries;
+    try {
+      entries = await Directory(dir).list(followLinks: false).toList();
+    } on FileSystemException {
+      return null;
+    }
+    String? bestName;
+    DateTime? bestSeen;
+    for (final entry in entries) {
+      if (entry is! File || !entry.path.endsWith('.json')) continue;
+      final String text;
+      try {
+        text = readTextHead(entry, 16 * 1024);
+      } on FileSystemException {
+        continue;
+      }
+      final Object? decoded;
+      try {
+        decoded = jsonDecode(text);
+      } on FormatException {
+        continue;
+      }
+      if (decoded is! Map) continue;
+      final name = taskNameOfRef(_string(decoded['current_task']));
+      if (name == null) continue;
+      final seen = _date(decoded['last_seen_at']);
+      if (bestName == null ||
+          (seen != null && (bestSeen == null || seen.isAfter(bestSeen)))) {
+        bestName = name;
+        bestSeen = seen;
+      }
+    }
+    return bestName;
+  }
+}
+
+/// 任务产物文件名，按阅读顺序。
+const List<String> kVibeTrellisTaskDocs = [
+  'prd.md',
+  'design.md',
+  'implement.md',
+];
+
+/// 把 `.trellis/tasks/<name>` 这样的引用换成任务目录名。
+String? taskNameOfRef(String? ref) {
+  if (ref == null) return null;
+  final normalized = ref.trim().replaceAll('\\', '/');
+  if (normalized.isEmpty) return null;
+  final segments = normalized.split('/').where((s) => s.isNotEmpty).toList();
+  if (segments.isEmpty) return null;
+  final last = segments.last;
+  return last.isEmpty ? null : last;
+}
+
+/// 只读文件开头 [maxBytes] 字节，按 UTF-8 宽松解码。
+///
+/// 读不到时抛 [FileSystemException]，由调用方决定跳过。
+String readTextHead(File file, int maxBytes) {
+  final length = file.lengthSync();
+  if (length <= maxBytes) return file.readAsStringSync();
+  final handle = file.openSync();
+  try {
+    return utf8.decode(handle.readSync(maxBytes), allowMalformed: true);
+  } finally {
+    handle.closeSync();
+  }
+}
+
+String? _string(Object? value) {
+  if (value is! String) return null;
+  final trimmed = value.trim();
+  return trimmed.isEmpty ? null : trimmed;
+}
+
+List<String> _stringList(Object? value) {
+  if (value is! List) return const [];
+  return [
+    for (final entry in value)
+      if (entry is String && entry.trim().isNotEmpty) entry.trim(),
+  ];
+}
+
+DateTime? _date(Object? value) {
+  if (value is! String) return null;
+  return DateTime.tryParse(value.trim());
+}
