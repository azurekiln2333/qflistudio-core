+void main() {
+  group('detection', () {
+    test('requires a normal, nonempty workflow file', () {
+      final root = Directory.systemTemp.createTempSync('trellis-detect-');
+      addTearDown(() {
+        if (root.existsSync()) root.deleteSync(recursive: true);
+      });
