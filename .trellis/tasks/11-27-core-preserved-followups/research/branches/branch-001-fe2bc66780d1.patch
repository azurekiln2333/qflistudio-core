+      expect(project!.activeTasks.map((task) => task.dirName), [
+        '11-22-child',
+        '11-22-harness-hub',
+      ]);
+      expect(project.activeTasksOf('lichengyu').map((task) => task.dirName), [
+        '11-22-child',
+        '11-22-harness-hub',
