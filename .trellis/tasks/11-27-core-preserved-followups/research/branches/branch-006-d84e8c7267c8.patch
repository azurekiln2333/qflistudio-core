+    SavedWorkspace? workspace,
+  }) async {
+    tester.view.physicalSize = const Size(900, 700);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    addTearDown(() async {
+      await tester.pumpWidget(const SizedBox.shrink());
+      var drained = false;
+      Future.wait([
+        ProjectHistory.load(first.path),
+        ProjectHistory.load(second.path),
+        store.refresh(),
+        workspaces.settle(),
+      ]).then((_) => drained = true);
+      await _waitFor(tester, () => drained);
+      editor.dispose();
+      settings.dispose();
+      shell.dispose();
+      store.dispose();
+      workspaces.dispose();
+      await tester.runAsync(() => root.delete(recursive: true));
+    });
+    shell.activateFiles(editor);
+    shell.showFiles();
+    await tester.pumpWidget(
+      MaterialApp(
+        theme: WorkbenchTheme.from(
+          ThemeData(colorSchemeSeed: Colors.indigo, brightness: brightness),
+          formFactor: formFactor,
+        ),
+        home: Scaffold(
+          body: Align(
+            alignment: Alignment.topLeft,
+            child: SizedBox(
+              width: width,
+              height: 180,
+              child: LargeScreenScope(
+                controller: shell,
+                formFactor: formFactor,
+                child: WorkbenchExplorer(
+                  controller: shell,
+                  projectName: first.name,
+                  projects: const Text('Projects fixture'),
+                  files: FileExplorer(
+                    largeScreen: true,
+                    project: first,
+                    editor: editor,
+                    store: store,
+                    settings: settings,
+                    workspace: workspace,
+                    workspaceMembers: workspace == null
+                        ? const []
+                        : [first, second],
+                    workspaceStore: workspaces,
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+    await _waitFor(tester, () => find.text('first.dart').evaluate().isNotEmpty);
+    await tester.pumpAndSettle();
+  }
+}
+
+Future<void> _waitFor(WidgetTester tester, bool Function() ready) async {
+  for (var attempt = 0; attempt < 100 && !ready(); attempt++) {
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 5)),
+    );
+    await tester.pump();
+  }
+  expect(ready(), isTrue, reason: 'Explorer IO did not finish');
+}
