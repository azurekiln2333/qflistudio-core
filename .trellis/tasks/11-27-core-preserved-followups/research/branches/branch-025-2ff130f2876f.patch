+import 'package:qfli_studio_core/widgets/tool_widgets.dart';
+import 'package:qfli_studio_core/widgets/tools_browser.dart';
+
+void main() {
+  testWidgets(
+    'R22/V10 workbench reflows cards without changing phone preferences',
+    (tester) async {
+      final store = ToolStateStore(backend: LocalMemoryBackend());
+      final shell = LargeScreenController();
+      await store.setDensity(ToolCardDensity.compact);
+      await store.setCardColumns(2);
+      tester.view.devicePixelRatio = 1;
+      addTearDown(tester.view.reset);
+      addTearDown(() async {
+        await tester.pumpWidget(const SizedBox.shrink());
+        await store.settled();
+        store.dispose();
+        shell.dispose();
+      });
+      Widget browser() => ToolsBrowser(
+        state: store,
+        isMainApp: false,
+        sections: [
+          ToolsBrowserSection(
+            title: 'Grid fixtures',
+            icon: Icons.build,
+            entries: [
+              for (var i = 0; i < 6; i++)
+                ToolsBrowserEntry(
+                  id: 'fixture-$i',
+                  icon: Icons.code,
+                  title: 'Tool $i',
+                  subtitle: 'Fixture',
+                  description: 'Offline fixture',
+                  onTap: () {},
+                ),
+            ],
+          ),
+        ],
+      );
+      Future<void> mount(double width, {required bool workbench}) async {
+        tester.view.physicalSize = Size(width, 1200);
+        await tester.pumpWidget(
+          MaterialApp(
+            home: Scaffold(
+              body: workbench
+                  ? LargeScreenScope(controller: shell, child: browser())
+                  : browser(),
+            ),
+          ),
+        );
+        await tester.pump();
+      }
+
+      for (final width in [1200.0, 950.0, 620.0]) {
+        await mount(width, workbench: true);
+        final first = tester.getRect(find.widgetWithText(ToolCard, 'Tool 0'));
