diff --git a/lib/harness/hub/harness_hosts.dart b/lib/harness/hub/harness_hosts.dart
new file mode 100644
index 0000000000000000000000000000000000000000..b72b061fb280ab72022b6b7e9ec818f56de6890f
--- /dev/null
+++ b/lib/harness/hub/harness_hosts.dart
@@ -0,0 +1,92 @@
+// hub 的主机装配点。
+//
+// 本任务把界面和 hub 建在同一分支上，四类主机由并行任务提供：
+//   * StudioAgentHost（内置 Agent，studio）
+//   * LocalHarnessHost（本机 PTY 与日志，local）
+//   * HerdrHost（Herdr 窗格，local）
+//   * RemoteHarnessHost（已绑定电脑，remote）
+// 它们分别位于 lib/harness/{local,herdr,remote,studio}/，本文件不直接引用，
+// 这样 Pi-C 分支可以先合并而不带上别人的实现。集成时用
+// [HarnessHosts.registerDefault] 注册一个工厂即可，编辑器页无需再改。
+
+import '../harness_host.dart';
+import '../../services/app_paths.dart';
+import 'harness_hub.dart';
+
+/// 装配主机时能从编辑器页拿到的依赖。
+///
+/// 只放各家主机真正需要的东西：登录态、项目仓库、设置、当前项目根。
+class HubHostContext {
+  const HubHostContext({
+    required this.auth,
+    required this.projectStore,
+    required this.settings,
+    required this.projectRoot,
+  });
+
+  final Object auth;
+  final Object projectStore;
+  final Object settings;
+
+  /// 当前打开项目的绝对路径，可作为新会话的默认工作目录。
+  final String projectRoot;
+}
+
+/// 返回主机列表的工厂。返回顺序就是界面上的顺序。
+typedef HarnessHostsFactory =
+    List<HarnessHost> Function(HubHostContext context);
+
+/// 主机工厂注册表。
+///
+/// 没有注册时 hub 是空的：Agents 面板仍可打开，只显示「暂无可用主机」，
+/// 内置 Agent 的原生会话列表照常工作。
+abstract final class HarnessHosts {
+  static HarnessHostsFactory? _default;
+  static HarnessHostsFactory? _override;
+
+  /// 集成方注册真实主机。后注册的覆盖先注册的。
+  static void registerDefault(HarnessHostsFactory factory) {
+    _default = factory;
+  }
+
+  /// 测试和预览注入假主机，优先于 [registerDefault]。
+  static void overrideForTesting(HarnessHostsFactory? factory) {
+    _override = factory;
+  }
+
+  /// 是否有任何工厂可用；界面据此决定要不要显示主机选择器。
+  static bool get hasFactory => _override != null || _default != null;
+
+  static List<HarnessHost> build(HubHostContext context) {
+    final factory = _override ?? _default;
+    if (factory == null) return const <HarnessHost>[];
+    try {
+      return factory(context);
+    } on Object {
+      // 某台主机的构造失败不应该连带让整个 Agents 面板打不开。
+      return const <HarnessHost>[];
+    }
+  }
+}
+
+/// 编辑器页用的便捷构造：装配主机并交给 hub。
+///
+/// 手机端只保留已绑定电脑和内置 Agent，与 [HarnessHub.hostVisibleOnPlatform]
+/// 一致；[desktop] 只在测试里覆盖平台判定。
+HarnessHub harnessHubFor({
+  required Object auth,
+  required Object store,
+  required Object settings,
+  required String projectRoot,
+  bool? desktop,
+}) {
+  final hosts = HarnessHosts.build(
+    HubHostContext(
+      auth: auth,
+      projectStore: store,
+      settings: settings,
+      projectRoot: projectRoot,
+    ),
+  );
+  return HarnessHub(hosts: hosts, desktop: desktop ?? AppPaths.isDesktop);
+}
diff --git a/lib/harness/hub/harness_hub.dart b/lib/harness/hub/harness_hub.dart
new file mode 100644
index 0000000000000000000000000000000000000000..ca111c2261fd3cd4d3db7086b84d5433d903f21f
--- /dev/null
+++ b/lib/harness/hub/harness_hub.dart
@@ -0,0 +1,447 @@
+// Harness Hub：把每台能跑 harness 的电脑抽象成一份主机列表，界面只读这里。
+//
+// 契约在 `lib/harness/harness_host.dart`，本文件不改它。主机由外部注入：
+// 编辑器页按平台策略组出来，测试和预览用假主机，见 harness_hosts.dart。
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../harness_host.dart';
+
+/// 主机可选能力：装不上或平台不支持时给界面的一句说明。
+///
+/// 契约里没有安装提示字段，所以用这个可选接口传，避免改动共享契约。
+abstract class HarnessHostHint {
+  /// 例如「未检测到 Herdr，请先安装」。
+  String? get installHint;
+}
+
+/// 一个主机里同一 provider 的会话。
+@immutable
+class HubProviderGroup {
+  const HubProviderGroup({
+    required this.providerId,
+    required this.label,
+    required this.sessions,
+  });
+
+  final String providerId;
+
+  /// 界面上显示的 provider 名称；没有 provider 信息时退回 id。
+  final String label;
+  final List<HarnessSessionInfo> sessions;
+}
+
+/// 玩家可读的 provider 名称：先查 [labels]，再退回 id。
+String hubProviderLabel(String providerId, Map<String, String> labels) {
+  final label = labels[providerId];
+  if (label != null && label.trim().isNotEmpty) return label;
+  return providerId;
+}
+
+/// 按 provider 分组，组内按更新时间倒序，组间按名称排序。
+///
+/// 纯函数，方便列表和测试共用同一套顺序。
+List<HubProviderGroup> groupSessionsByProvider(
+  List<HarnessSessionInfo> sessions, {
+  Map<String, String> labels = const <String, String>{},
+}) {
+  final grouped = <String, List<HarnessSessionInfo>>{};
+  for (final session in sessions) {
+    grouped
+        .putIfAbsent(session.providerId, () => <HarnessSessionInfo>[])
+        .add(session);
+  }
+  final groups = <HubProviderGroup>[
+    for (final entry in grouped.entries)
+      HubProviderGroup(
+        providerId: entry.key,
+        label: hubProviderLabel(entry.key, labels),
+        sessions: [...entry.value]
+          ..sort((a, b) {
+            final at = a.updatedAt;
+            final bt = b.updatedAt;
+            if (at == null && bt == null) return a.title.compareTo(b.title);
+            if (at == null) return 1;
+            if (bt == null) return -1;
+            return bt.compareTo(at);
+          }),
+      ),
+  ];
+  groups.sort((a, b) => a.label.toLowerCase().compareTo(b.label.toLowerCase()));
+  return groups;
+}
+
+/// hub 层拒绝请求时抛出的错误：主机不存在、会话已被别处移除等。
+class HarnessHubException implements Exception {
+  const HarnessHubException(this.message);
+
+  final String message;
+
+  @override
+  String toString() => message;
+}
+
+/// 主机池、当前主机与合并后的会话列表。
+///
+/// 界面只依赖这里和契约类型：
+///
+/// * [hosts] 已按平台策略过滤，手机端只有已绑定电脑和内置 Agent；
+/// * [currentSessions] 是当前主机的会话，[groupsOf] 已按 provider 分好组；
+/// * [activeSession] 是正在看的会话，[activeHandle] 是它打开的视图，
+///   关闭视图时调用 [closeActiveSession] 释放，不结束会话。
+class HarnessHub extends ChangeNotifier {
+  HarnessHub({
+    required List<HarnessHost> hosts,
+    required bool desktop,
+    String? initialHostId,
+  }) : _desktop = desktop,
+       _hosts = List<HarnessHost>.unmodifiable(
+         hosts.where(
+           (host) => hostVisibleOnPlatform(host.kind, desktop: desktop),
+         ),
+       ) {
+    for (final host in _hosts) {
+      _states[host.id] = host.state.value;
+      void onState() => _onHostState(host);
+      _stateListeners[host.id] = onState;
+      host.state.addListener(onState);
+      _listen(host);
+    }
+    _currentHostId = _pickInitialHost(initialHostId);
+  }
+
+  /// 平台策略：桌面版能用本机和 Herdr，手机端只能用已绑定电脑和内置 Agent。
+  ///
+  /// 手机上没有 PTY，也没有本机 Herdr，所以这两类主机不上列表，
+  /// 而不是上一个点了会失败的空壳。
+  static bool hostVisibleOnPlatform(
+    HarnessHostKind kind, {
+    required bool desktop,
+  }) {
+    if (desktop) return true;
+    return kind == HarnessHostKind.remote || kind == HarnessHostKind.studio;
+  }
+
+  final bool _desktop;
+  final List<HarnessHost> _hosts;
+  final Map<String, HarnessHostState> _states = <String, HarnessHostState>{};
+  final Map<String, VoidCallback> _stateListeners = <String, VoidCallback>{};
+  final Map<String, List<HarnessSessionInfo>> _sessions =
+      <String, List<HarnessSessionInfo>>{};
+  final Map<String, StreamSubscription<List<HarnessSessionInfo>>> _subs =
+      <String, StreamSubscription<List<HarnessSessionInfo>>>{};
+  final Map<String, List<HarnessProviderInfo>> _providers =
+      <String, List<HarnessProviderInfo>>{};
+  final Map<String, Object> _sessionErrors = <String, Object>{};
+
+  String? _currentHostId;
+  HarnessSessionInfo? _activeSession;
+  HarnessSessionHandle? _activeHandle;
+  bool _opening = false;
+  bool _disposed = false;
+
+  /// 平台是否按桌面版处理，测试可注入。
+  bool get isDesktop => _desktop;
+
+  /// 已按平台过滤的主机，顺序即界面顺序。
+  List<HarnessHost> get hosts => _hosts;
+
+  HarnessHost? hostById(String id) {
+    for (final host in _hosts) {
+      if (host.id == id) return host;
+    }
+    return null;
+  }
+
+  /// 当前主机；没有任何可用主机时为 null。
+  HarnessHost? get currentHost =>
+      _currentHostId == null ? null : hostById(_currentHostId!);
+
+  String? get currentHostId => _currentHostId;
+
+  /// 切换主机。切换会先释放当前会话视图（只释放视图，不结束会话）。
+  void selectHost(String id) {
+    if (_disposed || id == _currentHostId) return;
+    if (hostById(id) == null) return;
+    unawaited(closeActiveSession());
+    _currentHostId = id;
+    notifyListeners();
+  }
+
+  /// 主机状态；没有该主机时按 unsupported 处理，界面不会因为缺一项就崩。
+  HarnessHostState stateOf(String hostId) =>
+      _states[hostId] ?? HarnessHostState.unsupported;
+
+  /// 主机状态的监听句柄，供选择器画在线点。
+  ValueListenable<HarnessHostState> stateListenableOf(String hostId) {
+    final host = hostById(hostId);
+    return host?.state ?? _missingState;
+  }
+
+  /// 没有该主机时共用的只读占位，避免每帧新建一个 notifier。
+  static final ValueNotifier<HarnessHostState> _missingState =
+      ValueNotifier<HarnessHostState>(HarnessHostState.unsupported);
+
+  /// 主机自带的安装/修复说明；没有时为 null。
+  String? hintOf(String hostId) {
+    final host = hostById(hostId);
+    if (host is HarnessHostHint) return (host as HarnessHostHint).installHint;
+    return null;
+  }
+
+  /// 该主机最近一次会话列表读取失败的原因。
+  Object? sessionErrorOf(String hostId) => _sessionErrors[hostId];
+
+  /// 某台主机的会话，顺序沿用主机给的顺序。
+  List<HarnessSessionInfo> sessionsOf(String hostId) =>
+      List<HarnessSessionInfo>.unmodifiable(
+        _sessions[hostId] ?? const <HarnessSessionInfo>[],
+      );
+
+  /// 当前主机的会话。
+  List<HarnessSessionInfo> get currentSessions {
+    final host = currentHost;
+    return host == null ? const <HarnessSessionInfo>[] : sessionsOf(host.id);
+  }
+
+  /// 所有主机的会话合并，带主机 id，界面据此区分来源。
+  List<HarnessSessionInfo> get allSessions => <HarnessSessionInfo>[
+    for (final host in _hosts) ...sessionsOf(host.id),
+  ];
+
+  /// 某台主机按 provider 分好的组。
+  List<HubProviderGroup> groupsOf(String hostId) => groupSessionsByProvider(
+    sessionsOf(hostId),
+    labels: providerLabelsOf(hostId),
+  );
+
+  /// 当前主机的分组。
+  List<HubProviderGroup> get currentGroups {
+    final host = currentHost;
+    return host == null ? const <HubProviderGroup>[] : groupsOf(host.id);
+  }
+
+  /// 已知的 provider 名称，未读取过时为空。
+  Map<String, String> providerLabelsOf(String hostId) {
+    final list = _providers[hostId];
+    if (list == null) return const <String, String>{};
+    return <String, String>{
+      for (final provider in list) provider.id: provider.label,
+    };
+  }
+
+  /// 读取某台主机能启动的 harness，并缓存名称。
+  ///
+  /// 读不到时返回空列表，不抛给界面：启动菜单为空只需要提示一句。
+  Future<List<HarnessProviderInfo>> providersOf(
+    String hostId, {
+    bool refresh = false,
+  }) async {
+    final cached = _providers[hostId];
+    if (cached != null && !refresh) return cached;
+    final host = hostById(hostId);
+    if (host == null) return const <HarnessProviderInfo>[];
+    try {
+      final providers = await host.providers();
+      if (_disposed) return providers;
+      _providers[hostId] = List<HarnessProviderInfo>.unmodifiable(providers);
+      notifyListeners();
+      return _providers[hostId]!;
+    } on Object {
+      if (_disposed) return const <HarnessProviderInfo>[];
+      _providers[hostId] = const <HarnessProviderInfo>[];
+      notifyListeners();
+      return _providers[hostId]!;
+    }
+  }
+
+  /// 当前主机的“新建会话”菜单项。
+  Future<List<HarnessProviderInfo>> launchMenu() async {
+    final host = currentHost;
+    if (host == null) return const <HarnessProviderInfo>[];
+    return providersOf(host.id);
+  }
+
+  /// 正在看的会话；没有打开会话时为 null。
+  HarnessSessionInfo? get activeSession => _activeSession;
+
+  /// 正在看的会话视图；为 null 表示还没打开。
+  HarnessSessionHandle? get activeHandle => _activeHandle;
+
+  /// 会话列表是否已至少收到一次。
+  bool get hasLoadedSessions => _sessions.isNotEmpty;
+
+  /// 选中并打开一个会话。
+  ///
+  /// 同一个会话重复调用返回同一个视图；换会话会先释放旧的视图。
+  Future<HarnessSessionHandle> openSession(
+    HarnessSessionInfo info, {
+    String? hostId,
+  }) async {
+    final targetHostId = hostId ?? info.hostId;
+    final host = hostById(targetHostId);
+    if (host == null) {
+      throw HarnessHubException('找不到主机 ${info.hostId}，请刷新后重试');
+    }
+    final existing = _activeHandle;
+    if (_activeSession?.id == info.id &&
+        _activeSession?.hostId == info.hostId &&
+        existing != null) {
+      return existing;
+    }
+    if (_opening) {
+      throw const HarnessHubException('上一个会话还没打开，请稍后再试');
+    }
+    _opening = true;
+    try {
+      await closeActiveSession();
+      final handle = await host.open(info.id);
+      if (_disposed) {
+        await handle.detach();
+        return handle;
+      }
+      _activeSession = handle.info;
+      _activeHandle = handle;
+      if (_currentHostId != targetHostId) _currentHostId = targetHostId;
+      notifyListeners();
+      return handle;
+    } finally {
+      _opening = false;
+    }
+  }
+
+  /// 在当前主机上启动一个 harness，并把它设为正在看的会话。
+  Future<HarnessSessionHandle> launch(
+    HarnessLaunchRequest request, {
+    String? hostId,
+  }) async {
+    final host = hostById(hostId ?? _currentHostId ?? '');
+    if (host == null) {
+      throw const HarnessHubException('当前没有可用的主机');
+    }
+    if (_opening) {
+      throw const HarnessHubException('上一个会话还没打开，请稍后再试');
+    }
+    _opening = true;
+    try {
+      await closeActiveSession();
+      final handle = await host.launch(request);
+      if (_disposed) {
+        await handle.detach();
+        return handle;
+      }
+      _activeSession = handle.info;
+      _activeHandle = handle;
+      notifyListeners();
+      return handle;
+    } finally {
+      _opening = false;
+    }
+  }
+
+  /// 只释放当前会话视图。会话照常在主机上跑，再次打开就重新接上。
+  Future<void> closeActiveSession() async {
+    final handle = _activeHandle;
+    _activeHandle = null;
+    _activeSession = null;
+    if (!_disposed) notifyListeners();
+    if (handle != null) {
+      try {
+        await handle.detach();
+      } on Object {
+        // 释放视图失败不该挡住界面退出；会话本身仍在主机上。
+      }
+    }
+  }
+
+  /// 重新订阅所有主机的会话列表，并丢弃 provider 缓存。
+  ///
+  /// 主机离线时订阅可能只是空表，用户点「刷新」就再要一次。
+  Future<void> refresh() async {
+    if (_disposed) return;
+    _providers.clear();
+    for (final host in _hosts) {
+      await _subs.remove(host.id)?.cancel();
+      _listen(host);
+      unawaited(
+        host.providers().then<void>((providers) {
+          if (_disposed) return;
+          _providers[host.id] = List<HarnessProviderInfo>.unmodifiable(
+            providers,
+          );
+          notifyListeners();
+        }, onError: (Object _) {}),
+      );
+    }
+    notifyListeners();
+  }
+
+  void _listen(HarnessHost host) {
+    _sessionErrors.remove(host.id);
+    _subs[host.id] = host.watchSessions().listen(
+      (sessions) {
+        if (_disposed) return;
+        _sessions[host.id] = List<HarnessSessionInfo>.unmodifiable(sessions);
+        _sessionErrors.remove(host.id);
+        // 正在看的会话被主机移除（自己退出或被删掉）：只摘掉视图，
+        // 不再对它发任何请求。
+        final active = _activeSession;
+        if (active != null &&
+            active.hostId == host.id &&
+            !sessions.any((session) => session.id == active.id)) {
+          unawaited(closeActiveSession());
+        }
+        notifyListeners();
+      },
+      onError: (Object error) {
+        if (_disposed) return;
+        _sessionErrors[host.id] = error;
+        notifyListeners();
+      },
+    );
+  }
+
+  void _onHostState(HarnessHost host) {
+    if (_disposed) return;
+    final state = host.state.value;
+    if (_states[host.id] == state) return;
+    _states[host.id] = state;
+    notifyListeners();
+  }
+
+  String? _pickInitialHost(String? initialHostId) {
+    if (initialHostId != null && hostById(initialHostId) != null) {
+      return initialHostId;
+    }
+    if (_hosts.isEmpty) return null;
+    // 桌面版默认停在「本机」，手机端默认停在第一台已绑定电脑。
+    for (final host in _hosts) {
+      if (host.kind == HarnessHostKind.local && _desktop) return host.id;
+    }
+    for (final host in _hosts) {
+      if (host.kind == HarnessHostKind.remote) return host.id;
+    }
+    return _hosts.first.id;
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    for (final entry in _subs.entries) {
+      unawaited(entry.value.cancel());
+    }
+    _subs.clear();
+    for (final host in _hosts) {
+      final listener = _stateListeners.remove(host.id);
+      if (listener != null) host.state.removeListener(listener);
+      unawaited(host.dispose());
+    }
+    final handle = _activeHandle;
+    _activeHandle = null;
+    _activeSession = null;
+    if (handle != null) unawaited(handle.detach());
+    super.dispose();
+  }
+}
diff --git a/lib/harness/ui/agents_entry.dart b/lib/harness/ui/agents_entry.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a632c30175a891074f89fd0afae22c011907ca44
--- /dev/null
+++ b/lib/harness/ui/agents_entry.dart
@@ -0,0 +1,62 @@
+// 旧「远程电脑」入口的落点：编辑器页的 Agents 面板。
+//
+// 远程会话管理已经并入 Agents 面板，独立首页只剩配对设置（设备与远程）。
+// 工具页的旧卡片改为调用这里：挑一个本地项目，打开编辑器，并让页面首帧就
+// 落在 Agents 面板上。没有项目时给出说明，而不是推一个空页面。
+
+import 'package:flutter/material.dart';
+
+import '../../editor/retained_editor_host.dart';
+import '../../store/auth_store.dart';
+import '../../store/project_store.dart';
+import '../../store/settings_store.dart';
+import '../../models/project.dart';
+
+/// 打开 Agents 面板。
+///
+/// [project] 为空时用项目仓库里最近的一个本地项目；一个都没有时提示先建项目。
+Future<void> openAgentsSurface(
+  BuildContext context, {
+  required AuthStore auth,
+  required ProjectStore store,
+  required SettingsStore settings,
+  Project? project,
+}) async {
+  final target = project ?? _pickLocalProject(store);
+  if (target == null) {
+    if (!context.mounted) return;
+    await showDialog<void>(
+      context: context,
+      builder: (dialogContext) => AlertDialog(
+        title: const Text('先打开一个项目'),
+        content: const Text(
+          'Agents 面板在编辑器里。新建或打开一个项目后，'
+          '右侧的 Agent 面板就能看到本机、Herdr 和已绑定电脑的会话。',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(dialogContext).pop(),
+            child: const Text('知道了'),
+          ),
+        ],
+      ),
+    );
+    return;
+  }
+  await openEditorPage(
+    context,
+    project: target,
+    auth: auth,
+    store: store,
+    settings: settings,
+    revealAgentPane: true,
+  );
+}
+
+/// 最近更新的本地项目。云端项目没有本地目录，不拿来当工作目录。
+Project? _pickLocalProject(ProjectStore store) {
+  final locals = store.projects.where((project) => !project.isCloud).toList();
+  if (locals.isEmpty) return null;
+  locals.sort((a, b) => b.createdAt.compareTo(a.createdAt));
+  return locals.first;
+}
diff --git a/lib/harness/ui/hub_agents_surface.dart b/lib/harness/ui/hub_agents_surface.dart
new file mode 100644
index 0000000000000000000000000000000000000000..6043714e53df8479876fea60907af27900c63c48
--- /dev/null
+++ b/lib/harness/ui/hub_agents_surface.dart
@@ -0,0 +1,273 @@
+// Agents 面板的 hub 部分：顶部主机条 + 会话视图，嵌在编辑器页原有面板里。
+//
+// 内置 Agent 的原生对话面板作为 [studioPane] 传入：当前主机是内置 Agent 或
+// 没有可用主机时原样显示，外部主机的会话则在这里换成 [HubSessionView]。
+// 不新开页面，也不另起一套应用外壳。
+
+import 'package:flutter/material.dart';
+
+import '../harness_host.dart';
+import '../hub/harness_hub.dart';
+import 'hub_host_switcher.dart';
+import 'hub_session_list.dart';
+import 'hub_session_view.dart';
+
+/// Agents 面板上方的 hub 容器。
+class HubAgentsSurface extends StatelessWidget {
+  const HubAgentsSurface({
+    super.key,
+    required this.hub,
+    required this.studioPane,
+    required this.projectRoot,
+    this.onAddComputer,
+    this.compact = false,
+  });
+
+  final HarnessHub hub;
+
+  /// 内置 Agent 的对话面板，保持原有行为。
+  final Widget studioPane;
+
+  /// 新会话的默认工作目录。
+  final String projectRoot;
+
+  /// 打开设备与远程（配对）。为空时不显示添加入口。
+  final VoidCallback? onAddComputer;
+
+  /// 手机端：会话视图带返回键和终端按键栏。
+  final bool compact;
+
+  @override
+  Widget build(BuildContext context) {
+    return AnimatedBuilder(
+      animation: hub,
+      builder: (context, _) {
+        final host = hub.currentHost;
+        final active = hub.activeSession;
+        final showsHubSession =
+            active != null &&
+            host != null &&
+            host.kind != HarnessHostKind.studio;
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            if (host != null)
+              _HostHeader(
+                hub: hub,
+                host: host,
+                onAddComputer: onAddComputer,
+                compact: compact,
+                projectRoot: projectRoot,
+              ),
+            Expanded(
+              child: showsHubSession
+                  ? HubSessionView(
+                      key: ValueKey('hub-view-${active.hostId}-${active.id}'),
+                      hub: hub,
+                      session: active,
+                      compact: compact,
+                    )
+                  : host == null || host.kind == HarnessHostKind.studio
+                  ? studioPane
+                  : _HostEmptyState(
+                      hub: hub,
+                      host: host,
+                      projectRoot: projectRoot,
+                    ),
+            ),
+          ],
+        );
+      },
+    );
+  }
+}
+
+/// 主机条：选择器、连接状态说明、新建会话和刷新。
+class _HostHeader extends StatelessWidget {
+  const _HostHeader({
+    required this.hub,
+    required this.host,
+    required this.onAddComputer,
+    required this.compact,
+    required this.projectRoot,
+  });
+
+  final HarnessHub hub;
+  final HarnessHost host;
+  final VoidCallback? onAddComputer;
+  final bool compact;
+  final String projectRoot;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final state = hub.stateOf(host.id);
+    final hint = hub.hintOf(host.id);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        _SwitcherRow(
+          hub: hub,
+          host: host,
+          onAddComputer: onAddComputer,
+          compact: compact,
+          projectRoot: projectRoot,
+        ),
+        if (hint != null && hint.isNotEmpty)
+          Container(
+            key: const ValueKey('hub-host-hint'),
+            width: double.infinity,
+            padding: const EdgeInsets.fromLTRB(12, 4, 12, 4),
+            color: scheme.tertiaryContainer.withValues(alpha: 0.35),
+            child: Text(
+              hint,
+              style: theme.textTheme.labelSmall?.copyWith(
+                color: scheme.onTertiaryContainer,
+              ),
+            ),
+          )
+        else if (state == HarnessHostState.offline ||
+            state == HarnessHostState.connecting)
+          Container(
+            width: double.infinity,
+            padding: const EdgeInsets.fromLTRB(12, 4, 12, 4),
+            color: scheme.surfaceContainerHighest,
+            child: Text(
+              state == HarnessHostState.connecting
+                  ? '正在连接…'
+                  : '电脑未连接，恢复后会话会自动同步。',
+              style: theme.textTheme.labelSmall?.copyWith(
+                color: scheme.onSurfaceVariant,
+              ),
+            ),
+          ),
+      ],
+    );
+  }
+}
+
+class _SwitcherRow extends StatelessWidget {
+  const _SwitcherRow({
+    required this.hub,
+    required this.host,
+    required this.onAddComputer,
+    required this.compact,
+    required this.projectRoot,
+  });
+
+  final HarnessHub hub;
+  final HarnessHost host;
+  final VoidCallback? onAddComputer;
+  final bool compact;
+  final String projectRoot;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return Row(
+      children: [
+        Expanded(
+          child: _HostChips(
+            hub: hub,
+            onAddComputer: onAddComputer,
+            compact: compact,
+          ),
+        ),
+        IconButton(
+          key: const ValueKey('hub-sessions-refresh'),
+          tooltip: '刷新会话',
+          iconSize: 18,
+          padding: EdgeInsets.zero,
+          constraints: const BoxConstraints.tightFor(width: 36, height: 36),
+          onPressed: hub.refresh,
+          icon: const Icon(Icons.refresh),
+        ),
+        SizedBox(width: 2),
+        Container(width: 1, height: 20, color: scheme.outlineVariant),
+        SizedBox(width: 2),
+        HubNewSessionButton(hub: hub, cwd: projectRoot, dense: true),
+      ],
+    );
+  }
+}
+
+/// 主机选择条：直接复用 [HubHostSwitcher]，这里只是一个不滚动的窄容器。
+class _HostChips extends StatelessWidget {
+  const _HostChips({
+    required this.hub,
+    required this.onAddComputer,
+    required this.compact,
+  });
+
+  final HarnessHub hub;
+  final VoidCallback? onAddComputer;
+  final bool compact;
+
+  @override
+  Widget build(BuildContext context) =>
+      HubHostSwitcher(hub: hub, onAddComputer: onAddComputer, dense: compact);
+}
+
+/// 当前主机没有会话时的说明与启动入口。
+class _HostEmptyState extends StatelessWidget {
+  const _HostEmptyState({
+    required this.hub,
+    required this.host,
+    required this.projectRoot,
+  });
+
+  final HarnessHub hub;
+  final HarnessHost host;
+  final String projectRoot;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final state = hub.stateOf(host.id);
+    final unsupported = state == HarnessHostState.unsupported;
+    final hasSessions = hub.sessionsOf(host.id).isNotEmpty;
+    return Center(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(
+              unsupported ? Icons.link_off : Icons.dns_outlined,
+              size: 32,
+              color: unsupported ? scheme.error : scheme.outline,
+            ),
+            const SizedBox(height: 8),
+            Text(
+              unsupported
+                  ? '${host.label} 暂不可用'
+                  : hasSessions
+                  ? '选择一个会话'
+                  : '${host.label} 还没有会话',
+              style: theme.textTheme.titleSmall,
+              textAlign: TextAlign.center,
+            ),
+            const SizedBox(height: 4),
+            Text(
+              unsupported
+                  ? (hub.hintOf(host.id) ?? '检查这台电脑上是否已安装对应程序。')
+                  : hasSessions
+                  ? '从左侧会话列表选一个，或新建会话。'
+                  : '从右上角的新建会话启动一个 harness，或先刷新。',
+              textAlign: TextAlign.center,
+              style: theme.textTheme.bodySmall?.copyWith(
+                color: scheme.onSurfaceVariant,
+              ),
+            ),
+            if (!unsupported) ...[
+              const SizedBox(height: 12),
+              HubNewSessionButton(hub: hub, cwd: projectRoot),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/harness/ui/hub_chat_view.dart b/lib/harness/ui/hub_chat_view.dart
new file mode 100644
index 0000000000000000000000000000000000000000..dd6522c49d313f5194f7638ef7b496ece3444104
--- /dev/null
+++ b/lib/harness/ui/hub_chat_view.dart
@@ -0,0 +1,413 @@
+// 会话的「对话」标签：结构化对话记录、审批/提问回复和输入卡片。
+//
+// 消息气泡复用 Studio 的 ChatMessageTile，输入卡片复用 ComposerState 的
+// 草稿状态；权限和模型选择器属于内置 Agent 的模型范围，hub 会话没有对应
+// 契约字段，所以这里只保留发送与停止。
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../../chat/chat_transcript.dart';
+import '../../chat/composer_state.dart';
+import '../../vibe_coding/vibe_agent_facade.dart' show AgentMessageView;
+import '../harness_host.dart';
+
+/// 对话记录上限：超过这个条数只保留最近部分，界面不会被长会话拖慢。
+const int kHubTranscriptLimit = 400;
+
+/// 契约的会话角色换成 ChatMessageTile 认的角色名。
+String hubRoleName(TranscriptRole role) => switch (role) {
+  TranscriptRole.user => 'user',
+  TranscriptRole.assistant => 'assistant',
+  TranscriptRole.tool => 'tool',
+  // 系统提示按助手正文渲染：它同样是给用户看的正文，不是工具调用。
+  TranscriptRole.system => 'assistant',
+};
+
+/// 一个 hub 会话的对话视图。
+class HubChatView extends StatefulWidget {
+  const HubChatView({
+    super.key,
+    required this.handle,
+    this.emptyTitle = '还没有对话记录',
+    this.emptyHint = '在下面的输入框里描述要它做什么。',
+  });
+
+  final HarnessSessionHandle handle;
+  final String emptyTitle;
+  final String emptyHint;
+
+  @override
+  State<HubChatView> createState() => _HubChatViewState();
+}
+
+class _HubChatViewState extends State<HubChatView> {
+  final List<TranscriptEvent> _events = <TranscriptEvent>[];
+  final Set<String> _answered = <String>{};
+  final ScrollController _scroll = ScrollController();
+  late final ComposerState _composer = ComposerState();
+  StreamSubscription<TranscriptEvent>? _sub;
+  bool _sending = false;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _bind();
+  }
+
+  void _bind() {
+    unawaited(_sub?.cancel());
+    final stream = widget.handle.transcript;
+    if (stream == null) return;
+    _sub = stream.listen(
+      (event) {
+        if (!mounted) return;
+        setState(() {
+          _events.add(event);
+          if (_events.length > kHubTranscriptLimit) {
+            _events.removeRange(0, _events.length - kHubTranscriptLimit);
+          }
+        });
+        _scrollToEnd();
+      },
+      onError: (Object error) {
+        if (mounted) setState(() => _error = '对话记录中断：$error');
+      },
+    );
+  }
+
+  void _scrollToEnd() {
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!_scroll.hasClients) return;
+      _scroll.jumpTo(_scroll.position.maxScrollExtent);
+    });
+  }
+
+  Future<bool> _send(String text, List<String> attachments) async {
+    final body = text.trim();
+    if (body.isEmpty || _sending) return false;
+    setState(() {
+      _sending = true;
+      _error = null;
+    });
+    try {
+      await widget.handle.sendPrompt(body);
+      _composer.clearInput();
+      return true;
+    } on Object catch (error) {
+      if (mounted) setState(() => _error = '这一条没有发出去：$error');
+      return false;
+    } finally {
+      if (mounted) setState(() => _sending = false);
+    }
+  }
+
+  Future<void> _reply(TranscriptEvent event, String choice) async {
+    final requestId = event.requestId;
+    if (requestId == null || _answered.contains(requestId)) return;
+    setState(() => _answered.add(requestId));
+    try {
+      await widget.handle.reply(
+        HarnessReply(requestId: requestId, choice: choice),
+      );
+    } on Object catch (error) {
+      if (!mounted) return;
+      setState(() {
+        _answered.remove(requestId);
+        _error = '回复没有送出去：$error';
+      });
+    }
+  }
+
+  @override
+  void dispose() {
+    unawaited(_sub?.cancel());
+    _scroll.dispose();
+    _composer.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      children: [
+        if (_error != null)
+          MaterialBanner(
+            content: Text(_error!),
+            actions: [
+              TextButton(
+                onPressed: () => setState(() => _error = null),
+                child: const Text('知道了'),
+              ),
+            ],
+          ),
+        Expanded(
+          child: _events.isEmpty
+              ? _empty(context)
+              : ListView.builder(
+                  key: const ValueKey('hub-chat-list'),
+                  controller: _scroll,
+                  padding: const EdgeInsets.fromLTRB(8, 8, 8, 8),
+                  itemCount: _events.length,
+                  itemBuilder: (context, index) {
+                    final event = _events[index];
+                    return Column(
+                      crossAxisAlignment: CrossAxisAlignment.stretch,
+                      children: [
+                        ChatMessageTile(
+                          message: AgentMessageView(
+                            id: event.id,
+                            role: hubRoleName(event.role),
+                            text: event.text,
+                          ),
+                        ),
+                        if (event.requestId != null &&
+                            !_answered.contains(event.requestId))
+                          HubRequestCard(
+                            event: event,
+                            onReply: (choice) => _reply(event, choice),
+                          ),
+                      ],
+                    );
+                  },
+                ),
+        ),
+        HubComposer(
+          state: _composer,
+          onSend: _send,
+          sending: _sending,
+          onStop: () => widget.handle.stop(),
+          enabled: true,
+        ),
+      ],
+    );
+  }
+
+  Widget _empty(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    return Center(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(Icons.forum_outlined, size: 30, color: scheme.outline),
+            const SizedBox(height: 8),
+            Text(widget.emptyTitle, style: theme.textTheme.titleSmall),
+            const SizedBox(height: 4),
+            Text(
+              widget.emptyHint,
+              textAlign: TextAlign.center,
+              style: theme.textTheme.bodySmall?.copyWith(
+                color: scheme.onSurfaceVariant,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// 审批或提问卡片：每个选项一个按钮，点了就把 requestId 和选择回给主机。
+class HubRequestCard extends StatelessWidget {
+  const HubRequestCard({super.key, required this.event, required this.onReply});
+
+  final TranscriptEvent event;
+  final ValueChanged<String> onReply;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final options = event.options;
+    return Container(
+      key: ValueKey('hub-request-${event.requestId}'),
+      margin: const EdgeInsets.only(bottom: 10),
+      padding: const EdgeInsets.all(12),
+      decoration: BoxDecoration(
+        color: scheme.tertiaryContainer.withValues(alpha: 0.35),
+        borderRadius: BorderRadius.circular(12),
+        border: Border.all(color: scheme.tertiary.withValues(alpha: 0.4)),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            children: [
+              Icon(Icons.shield_outlined, size: 16, color: scheme.tertiary),
+              const SizedBox(width: 6),
+              Text(
+                '需要你确认或回答',
+                style: theme.textTheme.labelLarge?.copyWith(
+                  color: scheme.onTertiaryContainer,
+                ),
+              ),
+            ],
+          ),
+          const SizedBox(height: 6),
+          Text(event.text, style: theme.textTheme.bodySmall),
+          if (options.isNotEmpty) ...[
+            const SizedBox(height: 8),
+            Wrap(
+              spacing: 8,
+              runSpacing: 6,
+              children: [
+                for (final option in options)
+                  FilledButton.tonal(
+                    key: ValueKey(
+                      'hub-request-option-${event.requestId}-$option',
+                    ),
+                    onPressed: () => onReply(option),
+                    child: Text(option),
+                  ),
+              ],
+            ),
+          ],
+        ],
+      ),
+    );
+  }
+}
+
+/// hub 会话的输入卡片。
+///
+/// 外观与 Studio 的输入卡片一致（同一套圆角、描边和间距），但不含权限与
+/// 模型选择器：那两项描述的是内置 Agent 的模型，外部 harness 没有这些字段。
+class HubComposer extends StatefulWidget {
+  const HubComposer({
+    super.key,
+    required this.state,
+    required this.onSend,
+    this.onStop,
+    this.sending = false,
+    this.enabled = true,
+    this.hintText = '给这个会话发一条消息…',
+  });
+
+  final ComposerState state;
+  final Future<bool> Function(String text, List<String> attachments) onSend;
+  final VoidCallback? onStop;
+  final bool sending;
+  final bool enabled;
+  final String hintText;
+
+  @override
+  State<HubComposer> createState() => _HubComposerState();
+}
+
+class _HubComposerState extends State<HubComposer> {
+  final TextEditingController _input = TextEditingController();
+  final FocusNode _focus = FocusNode();
+
+  @override
+  void initState() {
+    super.initState();
+    _input.text = widget.state.text;
+    widget.state.addListener(_onStateChanged);
+  }
+
+  @override
+  void didUpdateWidget(HubComposer oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!identical(oldWidget.state, widget.state)) {
+      oldWidget.state.removeListener(_onStateChanged);
+      widget.state.addListener(_onStateChanged);
+      _input.text = widget.state.text;
+    }
+  }
+
+  void _onStateChanged() {
+    if (!mounted) return;
+    if (_input.text != widget.state.text) _input.text = widget.state.text;
+    setState(() {});
+  }
+
+  void _onChanged(String value) {
+    widget.state.text = value;
+  }
+
+  Future<void> _submit() async {
+    if (widget.sending) return;
+    final text = _input.text.trim();
+    if (text.isEmpty) return;
+    final ok = await widget.onSend(text, const <String>[]);
+    if (ok && mounted) _focus.requestFocus();
+  }
+
+  @override
+  void dispose() {
+    widget.state.removeListener(_onStateChanged);
+    _input.dispose();
+    _focus.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final canSend = _input.text.trim().isNotEmpty && widget.enabled;
+    return SafeArea(
+      top: false,
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(8, 6, 8, 8),
+        child: Container(
+          decoration: BoxDecoration(
+            color: scheme.surfaceContainerHigh,
+            borderRadius: BorderRadius.circular(16),
+            border: Border.all(color: scheme.outlineVariant),
+          ),
+          padding: const EdgeInsets.fromLTRB(10, 8, 8, 6),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              TextField(
+                key: const ValueKey('hub-composer-input'),
+                controller: _input,
+                focusNode: _focus,
+                enabled: widget.enabled,
+                minLines: 1,
+                maxLines: 5,
+                textInputAction: TextInputAction.newline,
+                decoration: InputDecoration(
+                  hintText: widget.hintText,
+                  border: InputBorder.none,
+                  isCollapsed: true,
+                  contentPadding: const EdgeInsets.symmetric(vertical: 6),
+                ),
+                onChanged: _onChanged,
+              ),
+              const SizedBox(height: 4),
+              Row(
+                children: [
+                  const Spacer(),
+                  SizedBox(
+                    width: 36,
+                    height: 36,
+                    child: widget.sending
+                        ? IconButton.filled(
+                            key: const ValueKey('hub-composer-stop'),
+                            tooltip: '停止',
+                            onPressed: widget.onStop,
+                            icon: const Icon(Icons.stop, size: 20),
+                          )
+                        : IconButton.filled(
+                            key: const ValueKey('hub-composer-send'),
+                            tooltip: '发送',
+                            onPressed: canSend ? _submit : null,
+                            icon: const Icon(Icons.arrow_upward, size: 20),
+                          ),
+                  ),
+                ],
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/harness/ui/hub_host_switcher.dart b/lib/harness/ui/hub_host_switcher.dart
new file mode 100644
index 0000000000000000000000000000000000000000..8eb2563bd9cef593ef8eb7936906c709b57a2471
--- /dev/null
+++ b/lib/harness/ui/hub_host_switcher.dart
@@ -0,0 +1,230 @@
+// 主机切换器：本机、Herdr、已绑定电脑（带在线点）、添加电脑。
+//
+// 只画 hub 里已按平台过滤过的主机；手机端因此不会出现本机和 Herdr。
+
+import 'package:flutter/material.dart';
+
+import '../harness_host.dart';
+import '../hub/harness_hub.dart';
+
+/// 顶部主机条。选中项高亮，不可用的主机仍可见但带说明。
+class HubHostSwitcher extends StatelessWidget {
+  const HubHostSwitcher({
+    super.key,
+    required this.hub,
+    this.onAddComputer,
+    this.dense = false,
+  });
+
+  final HarnessHub hub;
+
+  /// 打开设备与远程（配对）。为空时不显示添加入口。
+  final VoidCallback? onAddComputer;
+
+  /// 窄屏会话视图里用更紧的高度。
+  final bool dense;
+
+  @override
+  Widget build(BuildContext context) {
+    return AnimatedBuilder(
+      animation: hub,
+      builder: (context, _) {
+        final hosts = hub.hosts;
+        if (hosts.isEmpty && onAddComputer == null) {
+          return const SizedBox.shrink();
+        }
+        final scheme = Theme.of(context).colorScheme;
+        return Container(
+          key: const ValueKey('hub-host-switcher'),
+          decoration: BoxDecoration(
+            color: scheme.surfaceContainerLow,
+            border: Border(bottom: BorderSide(color: scheme.outlineVariant)),
+          ),
+          child: SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            padding: EdgeInsets.symmetric(
+              horizontal: 8,
+              vertical: dense ? 4 : 6,
+            ),
+            child: Row(
+              children: [
+                for (final host in hosts) ...[
+                  _HostChip(
+                    key: ValueKey('hub-host-${host.id}'),
+                    label: host.label,
+                    icon: _iconFor(host.kind),
+                    selected: host.id == hub.currentHostId,
+                    state: hub.stateOf(host.id),
+                    hint: hub.hintOf(host.id),
+                    dense: dense,
+                    onTap: () => hub.selectHost(host.id),
+                  ),
+                  const SizedBox(width: 6),
+                ],
+                if (onAddComputer != null)
+                  _AddComputerChip(dense: dense, onTap: onAddComputer!),
+              ],
+            ),
+          ),
+        );
+      },
+    );
+  }
+
+  static IconData _iconFor(HarnessHostKind kind) => switch (kind) {
+    HarnessHostKind.local => Icons.computer_outlined,
+    HarnessHostKind.remote => Icons.devices_other_outlined,
+    HarnessHostKind.studio => Icons.smart_toy_outlined,
+  };
+}
+
+/// 主机状态的在线点：在线实心，连接中半亮，离线空心，不支持画叉。
+class HubHostOnlineDot extends StatelessWidget {
+  const HubHostOnlineDot({super.key, required this.state, this.size = 8});
+
+  final HarnessHostState state;
+  final double size;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    final color = switch (state) {
+      HarnessHostState.online => const Color(0xFF2E7D32),
+      HarnessHostState.connecting => scheme.tertiary,
+      HarnessHostState.offline => scheme.outline,
+      HarnessHostState.unsupported => scheme.error,
+    };
+    return Container(
+      key: ValueKey('hub-host-dot-${state.name}'),
+      width: size,
+      height: size,
+      decoration: BoxDecoration(
+        shape: BoxShape.circle,
+        color: state == HarnessHostState.offline
+            ? Colors.transparent
+            : color.withValues(alpha: 0.85),
+        border: Border.all(color: color, width: 1.2),
+      ),
+    );
+  }
+}
+
+class _HostChip extends StatelessWidget {
+  const _HostChip({
+    super.key,
+    required this.label,
+    required this.icon,
+    required this.selected,
+    required this.state,
+    required this.hint,
+    required this.dense,
+    required this.onTap,
+  });
+
+  final String label;
+  final IconData icon;
+  final bool selected;
+  final HarnessHostState state;
+  final String? hint;
+  final bool dense;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final content = InkWell(
+      onTap: onTap,
+      borderRadius: BorderRadius.circular(999),
+      child: Container(
+        padding: EdgeInsets.symmetric(
+          horizontal: dense ? 8 : 10,
+          vertical: dense ? 4 : 6,
+        ),
+        decoration: BoxDecoration(
+          color: selected
+              ? scheme.secondaryContainer
+              : scheme.surfaceContainerHighest.withValues(alpha: 0.5),
+          borderRadius: BorderRadius.circular(999),
+          border: Border.all(
+            color: selected ? scheme.primary : scheme.outlineVariant,
+          ),
+        ),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(
+              icon,
+              size: dense ? 14 : 16,
+              color: selected
+                  ? scheme.onSecondaryContainer
+                  : scheme.onSurfaceVariant,
+            ),
+            const SizedBox(width: 6),
+            Text(
+              label,
+              style:
+                  (dense
+                          ? theme.textTheme.labelMedium
+                          : theme.textTheme.labelLarge)
+                      ?.copyWith(
+                        color: selected
+                            ? scheme.onSecondaryContainer
+                            : scheme.onSurfaceVariant,
+                      ),
+            ),
+            const SizedBox(width: 6),
+            HubHostOnlineDot(state: state),
+          ],
+        ),
+      ),
+    );
+    final text = hint?.trim();
+    if (text == null || text.isEmpty) return content;
+    // 不支持或未安装：把说明挂在悬浮提示上，不额外占一行。
+    return Tooltip(message: text, child: content);
+  }
+}
+
+class _AddComputerChip extends StatelessWidget {
+  const _AddComputerChip({required this.dense, required this.onTap});
+
+  final bool dense;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    return InkWell(
+      key: const ValueKey('hub-add-computer'),
+      onTap: onTap,
+      borderRadius: BorderRadius.circular(999),
+      child: Container(
+        padding: EdgeInsets.symmetric(
+          horizontal: dense ? 8 : 10,
+          vertical: dense ? 4 : 6,
+        ),
+        decoration: BoxDecoration(
+          borderRadius: BorderRadius.circular(999),
+          border: Border.all(color: scheme.outlineVariant),
+        ),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(Icons.add_link, size: dense ? 14 : 16, color: scheme.primary),
+            const SizedBox(width: 4),
+            Text(
+              '添加电脑',
+              style:
+                  (dense
+                          ? theme.textTheme.labelMedium
+                          : theme.textTheme.labelLarge)
+                      ?.copyWith(color: scheme.primary),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/harness/ui/hub_session_list.dart b/lib/harness/ui/hub_session_list.dart
