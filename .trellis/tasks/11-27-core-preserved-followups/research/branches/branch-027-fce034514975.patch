+
+  testWidgets('session list groups by provider and shows status and cwd', (
+    tester,
+  ) async {
+    final hub = buildHub();
+    await tester.pumpWidget(
+      _wrap(
+        SingleChildScrollView(
+          child: HubSessionGroups(hub: hub, hostId: 'local'),
+        ),
+      ),
