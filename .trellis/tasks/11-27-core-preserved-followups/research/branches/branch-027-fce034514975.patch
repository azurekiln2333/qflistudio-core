+++ b/lib/harness/ui/hub_status.dart
@@ -0,0 +1,95 @@
+// Agents 面板里会话状态的统一说法与配色。
+//
+// 契约的 HarnessSessionStatus 只有一个来源，列表、会话视图和测试都从这里取
+// 文案，避免三处各写一套。
+
+import 'package:flutter/material.dart';
+
+import '../harness_host.dart';
+
+/// 状态的中文说法。
+String harnessStatusLabel(HarnessSessionStatus status) => switch (status) {
+  HarnessSessionStatus.working => '运行中',
+  HarnessSessionStatus.idle => '空闲',
+  HarnessSessionStatus.done => '已完成',
+  HarnessSessionStatus.blocked => '待确认',
+  HarnessSessionStatus.exited => '已结束',
+  HarnessSessionStatus.unknown => '未知',
+};
+
+/// 状态色。与 Studio 会话列表的语义一致：运行中强调色、待确认第三色、
+/// 失败/结束用错误色、其余用弱化文字色。
+Color harnessStatusColor(ColorScheme scheme, HarnessSessionStatus status) =>
+    switch (status) {
+      HarnessSessionStatus.working => scheme.primary,
+      HarnessSessionStatus.blocked => scheme.tertiary,
+      HarnessSessionStatus.exited => scheme.error,
+      HarnessSessionStatus.done => scheme.primary,
+      HarnessSessionStatus.idle => scheme.onSurfaceVariant,
+      HarnessSessionStatus.unknown => scheme.onSurfaceVariant,
+    };
+
+/// 一行状态标签：运行中转圈，其余用文字胶囊。
+class HarnessStatusChip extends StatelessWidget {
+  const HarnessStatusChip({
+    super.key,
+    required this.status,
+    this.dense = false,
+  });
+
+  final HarnessSessionStatus status;
+
+  /// 列表行里的紧凑版本：只占一行高度。
+  final bool dense;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final color = harnessStatusColor(scheme, status);
+    final label = harnessStatusLabel(status);
+    final spinner = status == HarnessSessionStatus.working;
+    return Container(
+      key: ValueKey('harness-status-${status.name}'),
+      padding: EdgeInsets.symmetric(
+        horizontal: dense ? 6 : 8,
+        vertical: dense ? 1 : 2,
+      ),
+      decoration: BoxDecoration(
+        color: color.withValues(alpha: 0.12),
+        borderRadius: BorderRadius.circular(999),
+        border: Border.all(color: color.withValues(alpha: 0.35)),
+      ),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          if (spinner) ...[
+            SizedBox.square(
+              dimension: dense ? 8 : 10,
+              child: CircularProgressIndicator(strokeWidth: 1.6, color: color),
+            ),
+            SizedBox(width: dense ? 4 : 6),
+          ],
+          Text(
+            label,
+            style:
+                (dense
+                        ? theme.textTheme.labelSmall
+                        : theme.textTheme.labelMedium)
+                    ?.copyWith(color: color),
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+/// 相对时间：刚打开会话时给「刚刚」，更早给日期。
+String harnessRelativeTime(DateTime time) {
+  final delta = DateTime.now().difference(time);
+  if (delta.inMinutes < 1) return '刚刚';
+  if (delta.inHours < 1) return '${delta.inMinutes} 分钟前';
+  if (delta.inDays < 1) return '${delta.inHours} 小时前';
+  String two(int value) => value.toString().padLeft(2, '0');
+  return '${time.year}-${two(time.month)}-${two(time.day)}';
+}
diff --git a/lib/harness/ui/hub_terminal_key_bar.dart b/lib/harness/ui/hub_terminal_key_bar.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2f163ca24b9b9937ee4a5efdb243a8a9ca5d410a
--- /dev/null
+++ b/lib/harness/ui/hub_terminal_key_bar.dart
@@ -0,0 +1,115 @@
+// 手机端终端按键栏：Esc、Tab、Ctrl、Alt、方向键和粘贴。
+//
+// 从远程电脑模块（lib/remote_control/widgets/remote_terminal_pane.dart）的
+// 底部按键行移植，并补上 Ctrl/Alt 两个修饰键开关：手机键盘没有它们，
+// 而 tmux、vim 和 shell 行编辑都离不开。
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:xterm/xterm.dart';
+
+/// 按键栏。修饰键是粘滞开关：打开后一直生效，再点一次关闭。
+///
+/// [onKey] 收到的是逻辑键和当前修饰键状态，由调用方交给 xterm 的
+/// `Terminal.keyInput`。
+class HubTerminalKeyBar extends StatefulWidget {
+  const HubTerminalKeyBar({
+    super.key,
+    required this.onKey,
+    required this.onPaste,
+    this.enabled = true,
+  });
+
+  final void Function(TerminalKey key, {required bool ctrl, required bool alt})
+  onKey;
+
+  /// 粘贴文本。按键栏自己从剪贴板取内容。
+  final void Function(String text) onPaste;
+
+  final bool enabled;
+
+  @override
+  State<HubTerminalKeyBar> createState() => _HubTerminalKeyBarState();
+}
+
+class _HubTerminalKeyBarState extends State<HubTerminalKeyBar> {
+  bool _ctrl = false;
+  bool _alt = false;
+
+  void _key(TerminalKey key) {
+    if (!widget.enabled) return;
+    widget.onKey(key, ctrl: _ctrl, alt: _alt);
+  }
+
+  Future<void> _paste() async {
+    if (!widget.enabled) return;
+    final data = await Clipboard.getData(Clipboard.kTextPlain);
+    final text = data?.text;
+    if (text == null || text.isEmpty) return;
+    widget.onPaste(text);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return SafeArea(
+      top: false,
+      child: Container(
+        key: const ValueKey('hub-terminal-key-bar'),
+        decoration: BoxDecoration(
+          color: scheme.surfaceContainerLow,
+          border: Border(top: BorderSide(color: scheme.outlineVariant)),
+        ),
+        child: SingleChildScrollView(
+          scrollDirection: Axis.horizontal,
+          padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
+          child: Row(
+            children: [
+              _button('Esc', () => _key(TerminalKey.escape), key: 'esc'),
+              _button('Tab', () => _key(TerminalKey.tab), key: 'tab'),
+              _button(
+                'Ctrl',
+                () => setState(() => _ctrl = !_ctrl),
+                key: 'ctrl',
+                active: _ctrl,
+              ),
+              _button(
+                'Alt',
+                () => setState(() => _alt = !_alt),
+                key: 'alt',
+                active: _alt,
+              ),
+              _button('←', () => _key(TerminalKey.arrowLeft), key: 'left'),
+              _button('↑', () => _key(TerminalKey.arrowUp), key: 'up'),
+              _button('↓', () => _key(TerminalKey.arrowDown), key: 'down'),
+              _button('→', () => _key(TerminalKey.arrowRight), key: 'right'),
+              _button('粘贴', _paste, key: 'paste'),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _button(
+    String label,
+    VoidCallback onTap, {
+    required String key,
+    bool active = false,
+  }) {
+    final scheme = Theme.of(context).colorScheme;
+    return TextButton(
+      key: ValueKey('hub-key-$key'),
+      onPressed: widget.enabled ? onTap : null,
+      style: TextButton.styleFrom(
+        minimumSize: const Size(44, 36),
+        padding: const EdgeInsets.symmetric(horizontal: 8),
+        foregroundColor: active ? scheme.primary : scheme.onSurfaceVariant,
+        backgroundColor: active
+            ? scheme.primary.withValues(alpha: 0.12)
+            : Colors.transparent,
+      ),
+      child: Text(label),
+    );
+  }
+}
diff --git a/lib/harness/ui/hub_terminal_view.dart b/lib/harness/ui/hub_terminal_view.dart
new file mode 100644
index 0000000000000000000000000000000000000000..0eeb74c3c730a46f3111d5e6a4e1b7ce31b1e3f0
--- /dev/null
+++ b/lib/harness/ui/hub_terminal_view.dart
@@ -0,0 +1,165 @@
+// 会话的终端标签：把 hub 的原始字节通道接到 xterm。
+//
+// 渲染与输入层沿用远程电脑迁入的那一套（vendor/xterm + RemoteTheme 的
+// 终端样式），远端与 Herdr 会话因此和手机端远程终端看起来一样。
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:xterm/xterm.dart';
+
+import '../../remote_control/theme/remote_theme.dart';
+import '../harness_host.dart';
+import 'hub_terminal_key_bar.dart';
+
+/// 把解码出来的文本交给终端，并在流结束时报告一次。
+class _TerminalSink implements Sink<String> {
+  _TerminalSink({required this.onText, required this.onDone});
+
+  final void Function(String text) onText;
+  final VoidCallback onDone;
+
+  @override
+  void add(String data) => onText(data);
+
+  @override
+  void close() => onDone();
+}
+
+/// 一个 hub 会话的终端视图。
+///
+/// 通道由 [HarnessSessionHandle.terminal] 提供，本组件只负责字节与 xterm 之间
+/// 的搬运，不自己起进程。
+class HubTerminalView extends StatefulWidget {
+  const HubTerminalView({
+    super.key,
+    required this.channel,
+    this.compact = false,
+    this.onClosed,
+  });
+
+  final HarnessTerminalChannel channel;
+
+  /// 手机端：底部显示按键栏。
+  final bool compact;
+
+  /// 通道结束时的回调（主机报告会话退出）。
+  final VoidCallback? onClosed;
+
+  @override
+  State<HubTerminalView> createState() => _HubTerminalViewState();
+}
+
+class _HubTerminalViewState extends State<HubTerminalView> {
+  /// 滚动回看行数上限：终端输出可能很长，界面只保留最近的一段。
+  static const int _maxLines = 5000;
+
+  late final Terminal _terminal = Terminal(maxLines: _maxLines);
+  StreamSubscription<String>? _output;
+  StreamSubscription<Uint8List>? _raw;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _terminal.onOutput = _write;
+    _terminal.onResize = _resize;
+    _bind(widget.channel);
+  }
+
+  void _bind(HarnessTerminalChannel channel) {
+    unawaited(_output?.cancel());
+    unawaited(_raw?.cancel());
+    // 自己拼 UTF-8：被拆在两个数据块里的多字节字符也要能完整解出来，
+    // 所以用带状态的 chunked 解码器而不是每块单独 convert。
+    final decoder = const Utf8Decoder(allowMalformed: true)
+        .startChunkedConversion(
+          _TerminalSink(
+            onText: (text) {
+              if (mounted) _terminal.write(text);
+            },
+            onDone: () => widget.onClosed?.call(),
+          ),
+        );
+    _raw = channel.output.listen(
+      (bytes) {
+        try {
+          decoder.add(bytes);
+        } on Object catch (error) {
+          if (!mounted) return;
+          setState(() => _error = '终端输出中断：$error');
+        }
+      },
+      onError: (Object error) {
+        if (!mounted) return;
+        setState(() => _error = '终端输出中断：$error');
+        widget.onClosed?.call();
+      },
+      onDone: () {
+        decoder.close();
+      },
+      cancelOnError: false,
+    );
+  }
+
+  void _write(String data) {
+    try {
+      widget.channel.write(utf8.encode(data));
+      if (_error != null && mounted) setState(() => _error = null);
+    } on Object catch (error) {
+      if (mounted) setState(() => _error = '输入没有送出去：$error');
+    }
+  }
+
+  void _resize(int columns, int rows, int pixelWidth, int pixelHeight) {
+    try {
+      widget.channel.resize(columns, rows);
+    } on Object {
+      // 通道已经关闭时忽略尺寸变化：界面重建不该把错误顶到用户脸上。
+    }
+  }
+
+  @override
+  void dispose() {
+    unawaited(_raw?.cancel());
+    unawaited(_output?.cancel());
+    _raw = null;
+    _output = null;
+    if (_terminal.onOutput == _write) _terminal.onOutput = null;
+    if (_terminal.onResize == _resize) _terminal.onResize = null;
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return Column(
+      children: [
+        if (_error != null)
+          Container(
+            width: double.infinity,
+            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+            color: scheme.secondaryContainer,
+            child: Text(_error!),
+          ),
+        Expanded(
+          child: TerminalView(
+            _terminal,
+            key: ObjectKey(_terminal),
+            deleteDetection: true,
+            textStyle: RemoteTheme.terminalStyle(fontSize: 13),
+            padding: const EdgeInsets.all(8),
+          ),
+        ),
+        if (widget.compact)
+          HubTerminalKeyBar(
+            onKey: (key, {required ctrl, required alt}) =>
+                _terminal.keyInput(key, ctrl: ctrl, alt: alt),
+            onPaste: _terminal.paste,
+          ),
+      ],
+    );
+  }
+}
diff --git a/lib/pages/devices_remote_page.dart b/lib/pages/devices_remote_page.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2f595a11cef83e34208b69cf17f10135a23bdad2
--- /dev/null
+++ b/lib/pages/devices_remote_page.dart
@@ -0,0 +1,407 @@
+// 设置页的「设备与远程」：配对、查看已绑定电脑、撤销配对。
+//
+// 旧版把配对和会话管理放在独立的“远程电脑”首页（RemoteComputerPage）。
+// 会话已经并入编辑器页的 Agents 面板，配对与撤销搬到这里；远程电脑模块的
+// 内部实现（RemoteStore / RemoteController / 协议）保持不变，其它主机仍可
+// 直接使用。
+//
+// 所有权与 RemoteComputerPage 一致：外部注入的 controller/store 由调用方
+// 释放，本页只释放自己创建的那一个。
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../remote_control/pages/pair_screen.dart';
+import '../remote_control/remote_computer_page.dart';
+import '../remote_control/state/remote_controller.dart';
+import '../remote_control/state/remote_store.dart';
+import '../store/auth_store.dart';
+import '../widgets/settings_section.dart';
+
+/// 打开「设备与远程」。
+Future<void> openDevicesRemotePage(
+  BuildContext context, {
+  AuthStore? auth,
+  RemoteController? controller,
+}) {
+  return Navigator.of(context).push(
+    MaterialPageRoute<void>(
+      builder: (_) => DevicesRemotePage(auth: auth, controller: controller),
+    ),
+  );
+}
+
+class DevicesRemotePage extends StatefulWidget {
+  const DevicesRemotePage({super.key, this.auth, this.store, this.controller});
+
+  /// 当前登录账号。为空时账号分组只说明本机状态。
+  final AuthStore? auth;
+
+  /// 预打开的存储；测试注入内存实现。
+  final RemoteStore? store;
+
+  /// 预构造的控制器；给出时本页不释放它。
+  final RemoteController? controller;
+
+  @override
+  State<DevicesRemotePage> createState() => _DevicesRemotePageState();
+}
+
+class _DevicesRemotePageState extends State<DevicesRemotePage> {
+  RemoteController? _controller;
+  RemoteStore? _store;
+  bool _ownsController = false;
+  Object? _bootError;
+  bool _booting = true;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_boot());
+  }
+
+  Future<void> _boot() async {
+    if (!RemoteComputerPage.isSupported) {
+      if (mounted) setState(() => _booting = false);
+      return;
+    }
+    try {
+      final provided = widget.controller;
+      if (provided != null) {
+        _controller = provided;
+        _store = widget.store;
+        _ownsController = false;
+      } else {
+        final store = widget.store ?? await RemoteStore.open();
+        _store = store;
+        _controller = RemoteController(store: store)..connect();
+        _ownsController = true;
+      }
+    } on Object catch (error) {
+      _bootError = error;
+    }
+    if (mounted) setState(() => _booting = false);
+  }
+
+  @override
+  void dispose() {
+    if (_ownsController) _controller?.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('设备与远程')),
+      body: ListenableBuilder(
+        listenable: Listenable.merge([?_controller, ?widget.auth]),
+        builder: (context, _) {
+          final controller = _controller;
+          final pairing = controller?.pairing;
+          return ListView(
+            padding: const EdgeInsets.fromLTRB(16, 12, 16, 32),
+            children: [
+              if (!RemoteComputerPage.isSupported)
+                const _UnsupportedNotice()
+              else if (_booting)
+                const Padding(
+                  padding: EdgeInsets.symmetric(vertical: 24),
+                  child: Center(child: CircularProgressIndicator()),
+                )
+              else if (_bootError != null)
+                _BootFailure(error: _bootError!)
+              else ...[
+                SettingsSection(
+                  title: '已绑定电脑',
+                  children: [
+                    if (pairing == null)
+                      const ListTile(
+                        leading: Icon(Icons.link_off),
+                        title: Text('还没有绑定电脑'),
+                        subtitle: Text('在电脑上启动伴侣程序，用配对码把手机连上它。'),
+                      )
+                    else
+                      ListTile(
+                        key: const ValueKey('devices-paired-computer'),
+                        leading: _OnlineDot(
+                          online: controller?.isOnline ?? false,
+                        ),
+                        title: Text(controller?.agentName ?? '我的电脑'),
+                        subtitle: Text(
+                          '${pairing.relayUrl} · ${pairing.agentId}',
+                          maxLines: 1,
+                          overflow: TextOverflow.ellipsis,
+                        ),
+                        trailing: TextButton(
+                          key: const ValueKey('devices-revoke'),
+                          onPressed: () => _revoke(controller!),
+                          child: const Text('撤销'),
+                        ),
+                      ),
+                    ListTile(
+                      key: const ValueKey('devices-add-computer'),
+                      leading: const Icon(Icons.add_link),
+                      title: const Text('添加电脑'),
+                      subtitle: Text(
+                        pairing == null
+                            ? '用配对码或配对链接连接一台电脑'
+                            : '换绑另一台电脑（会先解除当前配对）',
+                      ),
+                      trailing: const Icon(Icons.chevron_right),
+                      onTap: () => _addComputer(controller!),
+                    ),
+                  ],
+                ),
+                SettingsSection(
+                  title: '账号',
+                  children: [
+                    ListTile(
+                      key: const ValueKey('devices-account'),
+                      leading: const Icon(Icons.account_circle_outlined),
+                      title: Text(_accountTitle(widget.auth)),
+                      subtitle: Text(_accountSubtitle(widget.auth)),
+                    ),
+                  ],
+                ),
+                Padding(
+                  padding: const EdgeInsets.fromLTRB(4, 8, 4, 0),
+                  child: Text(
+                    '会话列表在编辑器页的 Agents 面板里：本机、Herdr 和已绑定电脑都在同一处，'
+                    '关闭会话视图不会结束电脑上的会话。',
+                    style: Theme.of(context).textTheme.bodySmall?.copyWith(
+                      color: Theme.of(context).colorScheme.onSurfaceVariant,
+                    ),
+                  ),
+                ),
+              ],
+            ],
+          );
+        },
+      ),
+    );
+  }
+
+  static String _accountTitle(AuthStore? auth) {
+    if (auth == null) return '未接入账号';
+    return auth.isLoggedIn ? '已登录' : '未登录';
+  }
+
+  static String _accountSubtitle(AuthStore? auth) {
+    if (auth == null) {
+      return '当前产品不提供账号，配对信息只保存在这台设备上。';
+    }
+    if (!auth.isLoggedIn) {
+      return '登录后可以把配对状态同步到账号；未登录时配对只保存在本机。';
+    }
+    return '配对信息与账号分开保存，撤销配对不会退出登录。';
+  }
+
+  /// 撤销配对：先确认，再清掉本机保存的密钥。
+  Future<void> _revoke(RemoteController controller) async {
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (dialogContext) => AlertDialog(
+        key: const ValueKey('devices-revoke-dialog'),
+        scrollable: true,
+        title: const Text('撤销这台电脑的配对'),
+        content: const Text(
+          '撤销后这台设备不再能连接该电脑，密钥会从本机删除。'
+          '电脑上的会话不受影响，重新配对即可再次连接。',
+        ),
+        actions: [
+          TextButton(
+            key: const ValueKey('devices-revoke-cancel'),
+            onPressed: () => Navigator.of(dialogContext).pop(false),
+            child: const Text('取消'),
+          ),
+          FilledButton(
+            key: const ValueKey('devices-revoke-confirm'),
+            style: FilledButton.styleFrom(
+              backgroundColor: Theme.of(context).colorScheme.error,
+              foregroundColor: Theme.of(context).colorScheme.onError,
+            ),
+            onPressed: () => Navigator.of(dialogContext).pop(true),
+            child: const Text('撤销'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true) return;
+    await controller.unpair();
+    if (!mounted) return;
+    ScaffoldMessenger.maybeOf(
+      context,
+    )?.showSnackBar(const SnackBar(content: Text('已撤销配对')));
+  }
+
+  /// 添加电脑：复用远程模块原有的配对页，配对成功后回到本页。
+  Future<void> _addComputer(RemoteController controller) async {
+    final pair = controller.pairing;
+    if (pair != null) {
+      final replace = await showDialog<bool>(
+        context: context,
+        builder: (dialogContext) => AlertDialog(
+          title: const Text('换绑另一台电脑'),
+          content: const Text('当前已绑定一台电脑。继续会先解除现有配对，再进入配对流程。'),
+          actions: [
+            TextButton(
+              onPressed: () => Navigator.of(dialogContext).pop(false),
+              child: const Text('取消'),
+            ),
+            FilledButton(
+              onPressed: () => Navigator.of(dialogContext).pop(true),
+              child: const Text('继续'),
+            ),
+          ],
+        ),
+      );
+      if (replace != true) return;
+      await controller.unpair();
+      if (!mounted) return;
+    }
+    await Navigator.of(context).push(
+      MaterialPageRoute<void>(
+        builder: (_) => _PairRoute(
+          controller: controller,
+          initialRelay: _store?.lastRelayUrl,
+        ),
+      ),
+    );
+  }
+}
+
+/// 单独的配对路由：配对成功后自己退出，回到设备列表。
+class _PairRoute extends StatefulWidget {
+  const _PairRoute({required this.controller, this.initialRelay});
+
+  final RemoteController controller;
+  final String? initialRelay;
+
+  @override
+  State<_PairRoute> createState() => _PairRouteState();
+}
+
+class _PairRouteState extends State<_PairRoute> {
+  bool _paired = false;
+
+  @override
+  void initState() {
+    super.initState();
+    widget.controller.addListener(_onChanged);
+  }
+
+  @override
+  void dispose() {
+    widget.controller.removeListener(_onChanged);
+    super.dispose();
+  }
+
+  void _onChanged() {
+    if (_paired) return;
+    if (widget.controller.pairing == null) return;
+    _paired = true;
+    // 配对完成立刻退回设备列表：配对页本身没有“完成”按钮。
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!mounted) return;
+      Navigator.of(context).pop();
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('添加电脑')),
+      body: ListenableBuilder(
+        listenable: widget.controller,
+        builder: (context, _) => PairScreen(
+          controller: widget.controller,
+          initialRelay: widget.initialRelay,
+          onExit: () => Navigator.of(context).maybePop(),
+        ),
+      ),
+    );
+  }
+}
+
+class _OnlineDot extends StatelessWidget {
+  const _OnlineDot({required this.online});
+
+  final bool online;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return SizedBox.square(
+      dimension: 32,
+      child: Center(
+        child: Container(
+          key: ValueKey(online ? 'devices-dot-online' : 'devices-dot-offline'),
+          width: 10,
+          height: 10,
+          decoration: BoxDecoration(
+            shape: BoxShape.circle,
+            color: online ? const Color(0xFF2E7D32) : scheme.outline,
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _UnsupportedNotice extends StatelessWidget {
+  const _UnsupportedNotice();
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 24),
+      child: Column(
+        children: [
+          Icon(Icons.devices_other_rounded, size: 40, color: scheme.outline),
+          const SizedBox(height: 12),
+          Text('当前平台不支持远程电脑', style: theme.textTheme.titleMedium),
+          const SizedBox(height: 8),
+          Text(
+            '远程电脑需要原生应用提供的 WebSocket 连接与本地私有存储，'
+            '浏览器版两者都没有实现。',
+            textAlign: TextAlign.center,
+            style: theme.textTheme.bodySmall?.copyWith(
+              color: scheme.onSurfaceVariant,
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+class _BootFailure extends StatelessWidget {
+  const _BootFailure({required this.error});
+
+  final Object error;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    return Padding(
+      padding: const EdgeInsets.all(16),
+      child: Column(
+        children: [
+          Icon(Icons.sd_card_alert_outlined, color: scheme.error, size: 36),
+          const SizedBox(height: 8),
+          Text('无法读取本机的配对信息', style: theme.textTheme.titleSmall),
+          const SizedBox(height: 6),
+          SelectableText(
+            '$error',
+            style: theme.textTheme.bodySmall?.copyWith(color: scheme.error),
+            textAlign: TextAlign.center,
+          ),
+        ],
+      ),
+    );
+  }
+}
