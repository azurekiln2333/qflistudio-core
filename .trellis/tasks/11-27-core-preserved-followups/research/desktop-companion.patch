--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_session.dart
@@ -0,0 +1,326 @@
+// Ownership of the local companion process and its shared link.
+//
+// Reported problem this file fixes: the page controller used to own the process,
+// so `controller.dispose()` → `channel.close()` → `process.cancel()` killed the
+// sidecar and every managed Claude/Codex session it was running. A phone
+// connected to that machine then dropped mid-task just because the desktop user
+// closed the page.
+//
+// Ownership is now split three ways:
+//
+//   * **session scope** ([DesktopCompanionSession]) owns the process and the one
+//     shared connection. It is created once per app run and disposed with the
+//     app (or by an explicit 停止), which is the only place a process is
+//     cancelled. That is what keeps the process from becoming an orphan.
+//   * **the page** ([DesktopCompanionController]) holds a *handle* on the
+//     session. Leaving the page detaches the handle only; sessions keep running.
+//   * **ProcessSupervisor** remains the single canceller, reached through the
+//     session, never through the page.
+//
+// `DesktopCompanionSession.attach()` returns a [DesktopCompanionChannel] whose
+// `close()` is a detach, not a shutdown. That keeps the page's existing
+// controller contract unchanged.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import 'desktop_companion_channel.dart';
+import 'desktop_companion_link_io.dart';
+import 'desktop_companion_locator.dart';
+import 'desktop_companion_platform.dart';
+
+/// Shared companion connection plus the process that serves it.
+class DesktopCompanionSession {
+  DesktopCompanionSession({
+    required this.location,
+    NativeDesktopCompanionLink? link,
+  }) : _link = link ?? NativeDesktopCompanionLink();
+
+  /// The discovered bundle this session drives.
+  final DesktopCompanionLocation location;
+
+  /// Explicit attach credentials chosen by the user.
+  ///
+  /// On macOS the app sandbox cannot read the companion's real-home attach file
+  /// (`~/Library/Application Support/...` is outside the container), so the page
+  /// asks the user to pick that file with `file_selector` and passes its parsed
+  /// contents here. Windows/Linux never need this: their attach file is
+  /// readable automatically.
+  DesktopCompanionAttachPoint? selectedAttachPoint;
+
+  /// Whether the page must ask the user for the attach file.
+  ///
+  /// True when the companion cannot be spawned and no attach point was selected
+  /// yet. Attaching without a token is never attempted.
+  bool get needsUserSelectedAttach =>
+      !location.canSpawn && selectedAttachPoint == null;
+
+  /// Records the point parsed from a user-selected file.
+  ///
+  /// Replacing the point closes the current channel so the next [attach] uses
+  /// the new credentials instead of silently reusing the old socket.
+  Future<void> useAttachPoint(DesktopCompanionAttachPoint point) async {
+    if (_disposed) return;
+    await _channel?.close();
+    _channel = null;
+    selectedAttachPoint = point;
+  }
+
+  final NativeDesktopCompanionLink _link;
+
+  DesktopCompanionChannel? _channel;
+  SpawnedDesktopCompanion? _spawned;
+  Future<DesktopCompanionChannel>? _connecting;
+  bool _disposed = false;
+
+  /// Bumped by [stop]; a connection that resolves after that belongs to a dead
+  /// generation and is torn down instead of being kept.
+  int _generation = 0;
+
+  /// Set when the session started its own process (Windows/Linux). A macOS
+  /// attach has no process here; the user owns that companion and must stop it
+  /// themselves, which the page states explicitly.
+  bool get spawnedByApp => _spawned != null;
+
+  bool get isDisposed => _disposed;
+
+  /// Opens the shared channel once; later callers reuse it.
+  ///
+  /// A channel whose link has already gone away is dropped first: caching it
+  /// would make every retry return the same dead socket and never reconnect.
+  Future<DesktopCompanionChannel> attach() {
+    if (_disposed) {
+      return Future<DesktopCompanionChannel>.error(
+        StateError('companion 会话已停止'),
+      );
+    }
+    final existing = _channel;
+    if (existing != null) {
+      final alive = _alive.contains(existing);
+      if (alive) return Future<DesktopCompanionChannel>.value(existing);
+      _channel = null;
+    }
+    final pending = _connecting;
+    if (pending != null) return pending;
+    return _connecting = _connect();
+  }
+
+  /// Channels whose `closed` future has not completed yet.
+  final Set<DesktopCompanionChannel> _alive = <DesktopCompanionChannel>{};
+
+  void _track(DesktopCompanionChannel channel) {
+    _alive.add(channel);
+    unawaited(
+      channel.closed.whenComplete(() {
+        _alive.remove(channel);
+        if (identical(_channel, channel)) _channel = null;
+      }),
+    );
+  }
+
+  Future<DesktopCompanionChannel> _connect() async {
+    try {
+      final generation = _generation;
+      // A dead channel may have left its child behind (crashed or lost socket).
+      // Stop it before spawning again so the old handle cannot be overwritten and
+      // leak a process nobody can reach.
+      //
+      // The handle is cleared only after the cancel returned: if it throws
+      // (a hung `cancel` timing out), `_spawned` still refers to that process so
+      // the next retry can try again instead of losing ownership for good.
+      final previous = _spawned;
+      if (previous != null) {
+        try {
+          await previous.stop();
+        } on Object {
+          if (identical(_spawned, previous)) {
+            // Keep the handle: still owned, still cancellable, retry allowed.
+            throw StateError('上一个 companion 进程未能停止。请稍后重试。');
+          }
+          rethrow;
+        }
+        if (identical(_spawned, previous)) _spawned = null;
+      }
+      if (location.canSpawn) {
+        // Re-check the fence right before spawning: `stop()` may have run while
+        // the previous process was being cancelled, and starting a new child
+        // after that would leave an ownerless companion behind.
+        if (_disposed || generation != _generation) {
+          throw StateError('companion 会话已停止');
+        }
+        final value = await _link.spawnAndOwn(location);
+        if (generation != _generation || _disposed) {
+          // `stop()` ran while the child was starting: cancel it here so the
+          // late completion cannot retain an orphan companion.
+          await value.channel.close();
+          await value.spawned.stop();
+          throw StateError('companion 会话已停止');
+        }
+        _spawned = value.spawned;
+        _channel = value.channel;
+        _track(value.channel);
+        return value.channel;
+      }
+      // Sandboxed platform: attach to the companion the user launched.
+      final attachPoint = selectedAttachPoint ?? readAttachPoint(location);
+      if (attachPoint == null) {
+        throw StateError(
+          '尚未选择本机 companion 的凭据文件。请先启动 QFLI 远程 companion，'
+          '然后选择它写出的 sidecar.json。',
+        );
+      }
+      final channel = await _link.attach(attachPoint);
+      if (generation != _generation || _disposed) {
+        await channel.close();
+        throw StateError('companion 会话已停止');
+      }
+      _channel = channel;
+      _track(channel);
+      return channel;
+    } finally {
+      // Always clear the in-flight slot: a failed attempt must stay retryable,
+      // and `attach()` guards on `_disposed` separately.
+      _connecting = null;
+    }
+  }
+
+  /// Stops the companion this app started. Attach-based companions are left
+  /// running; their owner is the user's own process.
+  Future<void> stop() async {
+    _disposed = true;
+    // Invalidate in-flight connections before awaiting them: a spawn that is
+    // already executing must not be retained once it completes.
+    _generation += 1;
+    final pending = _connecting;
+    _connecting = null;
+    final spawned = _spawned;
+    _spawned = null;
+    final channel = _channel;
+    _channel = null;
+    _alive.removeWhere((entry) => identical(entry, channel));
+    await channel?.close();
+    // Wait for the in-flight attempt to observe the new generation and clean up
+    // its own child; never leave a half-started process behind.
+    if (pending != null) {
+      await pending.then<void>((_) {}, onError: (Object _) {});
+    }
+    // An attempt that completed between the reads above may have stored a child
+    // *after* `spawned` was taken. Collect it now, so the fence cannot leak it.
+    final late = _spawned;
+    _spawned = null;
+    await late?.stop();
+    await spawned?.stop();
+  }
+
+  /// App shutdown: same as [stop], kept as a separate name at call sites.
+  Future<void> dispose() => stop();
+}
+
+/// Reads `{port, token}` from the companion's published attach file.
+///
+/// Lifecycle contract with the companion: the file exists only while that
+/// companion runs. It removes the file on shutdown — ownership-checked, so a
+/// newer instance's file is never deleted — which means a *present* file whose
+/// connection fails points at a process that died without cleaning up (SIGKILL,
+/// power loss) rather than at a machine that never had a companion. The page
+/// treats that as a retryable failure and, on macOS, offers to pick it again.
+///
+/// Returns null when the file is missing, unreadable or incomplete. A file
+/// without a token is rejected on purpose: the port alone is not an identity.
+DesktopCompanionAttachPoint? readAttachPoint(
+  DesktopCompanionLocation location,
+) {
+  final path = location.attachFile;
+  if (path == null) return null;
+  final raw = readDesktopCompanionFile(path);
+  if (raw == null) return null;
+  return DesktopCompanionAttachPoint.tryParse(raw, source: path);
+}
+
+/// Handle the page holds. Closing it detaches; it never stops the process.
+class _DetachableCompanionChannel implements DesktopCompanionChannel {
+  _DetachableCompanionChannel(this._session);
+
+  final DesktopCompanionSession _session;
+  DesktopCompanionChannel? _inner;
+  final StreamController<Map<String, dynamic>> _frames =
+      StreamController<Map<String, dynamic>>.broadcast();
+  StreamSubscription<Map<String, dynamic>>? _subscription;
+  final Completer<void> _closed = Completer<void>();
+  bool _detached = false;
+
+  Future<DesktopCompanionChannel> _ensure() async {
+    final channel = _inner ??= await _session.attach();
+    if (_subscription == null) {
+      _subscription = channel.frames.listen(
+        (frame) {
+          if (!_frames.isClosed) _frames.add(frame);
+        },
+        onError: (Object error, StackTrace stack) {
+          if (!_frames.isClosed) _frames.addError(error, stack);
+        },
+        onDone: _finish,
+      );
+      unawaited(channel.closed.then((_) => _finish()));
+    }
+    return channel;
+  }
+
+  void _finish() {
+    if (_detached) return;
+    _detached = true;
+    if (!_frames.isClosed) unawaited(_frames.close());
+    if (!_closed.isCompleted) _closed.complete();
+  }
+
+  @override
+  Stream<Map<String, dynamic>> get frames => _frames.stream;
+
+  @override
+  void send(Map<String, dynamic> frame) {
+    final inner = _inner;
+    // A request before the shared channel is ready is dropped rather than
+    // queued: the controller re-requests state after connecting.
+    if (inner != null && !_detached) inner.send(frame);
+  }
+
+  @override
+  Future<void> get closed => _closed.future;
+
+  /// Starts forwarding. Awaited by the session before the page sees `ready`.
+  Future<void> begin() => _ensure().then((_) {});
+
+  @override
+  Future<void> close() async {
+    _detached = true;
+    // Detach only: the shared connection and the process stay alive so phone
+    // sessions survive the desktop page closing.
+    await _subscription?.cancel();
+    _subscription = null;
+    _inner = null;
+    if (!_frames.isClosed) await _frames.close();
+    if (!_closed.isCompleted) _closed.complete();
+  }
+}
+
+/// Creates a page handle on a session scope.
+///
+/// The page must call `close()` on the returned channel when it goes away; that
+/// only detaches. Stopping the companion is [DesktopCompanionSession.stop].
+Future<DesktopCompanionChannel> attachDesktopCompanion(
+  DesktopCompanionSession session,
+) async {
+  final handle = _DetachableCompanionChannel(session);
+  await handle.begin();
+  return handle;
+}
