+++ b/lib/remote_control/desktop/desktop_companion_platform_io.dart
@@ -0,0 +1,54 @@
+// Real environment for desktop companion discovery.
+//
+// Selected by `desktop_companion_platform.dart` on platforms with `dart:io`.
+// Everything here is a thin, honest probe: it reports what the filesystem
+// actually contains and never fabricates a bundle path. Directory names come
+// from the process environment; no credential is read.
+
+import 'dart:io';
+
+import 'package:path_provider/path_provider.dart';
+
+import 'desktop_companion_locator.dart';
+
+/// Builds a [DesktopCompanionEnvironment] for this machine.
+///
+/// [supportDirectory] is the app-private directory (`path_provider`); it is
+/// resolved lazily because it needs the plugin channel, and a missing channel
+/// must degrade to "no per-user location" rather than failing the page.
+Future<DesktopCompanionEnvironment> currentDesktopCompanionEnvironment() async {
+  String? support;
+  try {
+    support = (await getApplicationSupportDirectory()).path;
+  } on Object {
+    support = null;
+  }
+  return DesktopCompanionEnvironment(
+    operatingSystem: Platform.operatingSystem,
+    environment: Platform.environment,
+    executablePath: Platform.resolvedExecutable,
+    supportDirectory: support,
+    isFile: (String path) => File(path).existsSync(),
+    isDirectory: (String path) => Directory(path).existsSync(),
+    readFile: (String path) {
+      try {
+        return File(path).readAsStringSync();
+      } on Object {
+        return null;
+      }
+    },
+  );
+}
+
+/// Reads the attach file the companion publishes.
+///
+/// Only the `{port, token}` document is read; nothing else on disk is touched,
+/// and the token is never logged. Exported through
+/// `desktop_companion_platform.dart` so shared code needs no `dart:io`.
+String? readDesktopCompanionFile(String path) {
+  try {
+    return File(path).readAsStringSync();
+  } on Object {
+    return null;
+  }
+}
