+// Platform selection for companion discovery.
+//
+// `dart:io` never reaches a browser build: the stub is resolved instead, so the
+// desktop page compiles on web and the host's `isSupported` gate still decides
+// whether the entry is shown at all.
+
+export 'desktop_companion_platform_stub.dart'
+    if (dart.library.io) 'desktop_companion_platform_io.dart';
