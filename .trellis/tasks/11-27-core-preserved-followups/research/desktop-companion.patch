diff --git a/test/remote_control/desktop/desktop_companion_controller_test.dart b/test/remote_control/desktop/desktop_companion_controller_test.dart
new file mode 100644
--- /dev/null
+++ b/test/remote_control/desktop/desktop_companion_controller_test.dart
@@ -0,0 +1,288 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:qfli_studio_core/remote_control/desktop/desktop_companion_channel.dart';
+import 'package:qfli_studio_core/remote_control/desktop/desktop_companion_controller.dart';
+import 'package:qfli_studio_core/remote_control/desktop/desktop_companion_locator.dart';
+
+DesktopCompanionResolution _found() => const DesktopCompanionResolution.found(
+  DesktopCompanionLocation(
+    agentDirectory: '/opt/qflistudio/companion',
+    nodeExecutable: '/opt/qflistudio/companion/node/bin/node',
+    manifest: <String, dynamic>{
+      'os': 'linux',
+      'arch': 'x64',
+      'agent_version': '1.0.0',
+    },
+    origin: DesktopCompanionOrigin.installedMachine,
+  ),
+);
+
+void main() {
+  late FakeDesktopCompanionChannel channel;
+  late DesktopCompanionController controller;
+
+  setUp(() {
+    channel = FakeDesktopCompanionChannel();
+    controller = DesktopCompanionController(
+      connect: () async => channel,
+      resolution: _found(),
+    );
+  });
+
+  tearDown(() => controller.dispose());
+
+  test('connects and asks for the state the page needs', () async {
+    await controller.start();
+
+    expect(controller.status, DesktopCompanionStatus.ready);
+    expect(
+      channel.sent.map((frame) => frame['type']),
+      containsAll(<String>['discover', 'pair_code']),
+    );
+  });
+
+  test('shows the pairing code, link and countdown from the companion', () async {
+    await controller.start();
+    final expiresAt = DateTime.now()
+        .add(const Duration(minutes: 5))
+        .millisecondsSinceEpoch;
+    channel.emit(<String, dynamic>{
+      'type': 'pair_code',
+      'display': 'ABCD-1234',
+      'uri':
+          'cloudterminal://pair?relay=ws%3A%2F%2F127.0.0.1%3A8787%2Fws&code=ABCD1234&v=1',
+      'expiresAt': expiresAt,
+    });
+
+    expect(controller.pairing!.code, 'ABCD-1234');
+    expect(controller.pairing!.uri, contains('cloudterminal://pair?'));
+    expect(controller.pairing!.isExpired, isFalse);
+  });
+
+  test(
+    'an expired code is reported as expired, not refreshed silently',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'pair_code',
+        'display': 'ABCD-1234',
+        'uri': 'cloudterminal://pair?code=ABCD1234&v=1',
+        'expiresAt': DateTime.now()
+            .subtract(const Duration(seconds: 1))
+            .millisecondsSinceEpoch,
+      });
+
+      expect(controller.isPairingExpired, isTrue);
+    },
+  );
+
+  test(
+    'paired client count stays unknown when the relay cannot report it',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'snapshot',
+        'pairingsSinceStart': 2,
+        'pairedClients': null,
+      });
+
+      // Not 0, not 2: the relay owns the authoritative count.
+      expect(controller.pairedClients, isNull);
+    },
+  );
+
+  test('relay offline is surfaced instead of an empty address', () async {
+    await controller.start();
+    channel.emit(<String, dynamic>{'type': 'snapshot', 'relayOnline': false});
+
+    expect(controller.relayOnline, isFalse);
+    expect(controller.relayUrl, isNull);
+  });
+
+  test('lists the sessions discovery returned', () async {
+    await controller.start();
+    channel.emit(<String, dynamic>{
+      'type': 'discovered',
+      'sessions': <Map<String, dynamic>>[
+        {
+          'id': 'pane-1',
+          'kind': 'herdr',
+          'title': 'api',
+          'origin': 'pane',
+          'canOpen': true,
+          'canAcceptInput': false,
+        },
+        {
+          'id': 'thread-9',
+          'kind': 'codex',
+          'title': 'refactor',
+          'origin': 'thread',
+          'canOpen': true,
+          'canAcceptInput': true,
+        },
+      ],
+      'bound': <String>['pane-1'],
+    });
+
+    expect(controller.sessions, hasLength(2));
+    expect(controller.sessions.first.bound, isTrue);
+    expect(controller.sessions.last.canAcceptInput, isTrue);
+  });
+
+  test(
+    'an empty discovery result stays empty rather than inventing sessions',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'discovered',
+        'sessions': <Object>[],
+        'bound': <String>[],
+      });
+
+      expect(controller.hasSessions, isFalse);
+    },
+  );
+
+  test(
+    'opening a session sends its kind and origin so the right provider is used',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'discovered',
+        'sessions': <Map<String, dynamic>>[
+          {
+            'id': 'thread-9',
+            'kind': 'codex',
+            'title': 'refactor',
+            'origin': 'thread',
+            'canOpen': true,
+          },
+        ],
+        'bound': <String>[],
+      });
+
+      controller.openSession('thread-9');
+
+      final open = channel.sent.lastWhere(
+        (frame) => frame['type'] == 'open_session',
+      );
+      expect(open['id'], 'thread-9');
+      expect(open['kind'], 'codex');
+      expect(open['origin'], 'thread');
+    },
+  );
+
+  test(
+    'stream_event output reaches the page under the sidecar sessionId field',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'discovered',
+        'sessions': <Map<String, dynamic>>[
+          {
+            'id': 'thread-9',
+            'kind': 'codex',
+            'title': 'refactor',
+            'origin': 'thread',
+            'canOpen': true,
+          },
+        ],
+        'bound': <String>[],
+      });
+      controller.openSession('thread-9');
+
+      // The sidecar broadcasts `{type:'stream_event', kind, sessionId, eventKind, text}`.
+      channel.emit(<String, dynamic>{
+        'type': 'stream_event',
+        'kind': 'codex',
+        'sessionId': 'thread-9',
+        'eventKind': 'snapshot',
+        'text': 'first turn',
+        'seq': 4,
+      });
+
+      expect(controller.openSessionLines.map((line) => line.text), <String>[
+        'first turn',
+      ]);
+
+      channel.emit(<String, dynamic>{
+        'type': 'stream_event',
+        'kind': 'codex',
+        'sessionId': 'thread-9',
+        'eventKind': 'stdout',
+        'text': 'second turn',
+        'seq': 5,
+      });
+      expect(controller.openSessionLines.map((line) => line.text), <String>[
+        'first turn',
+        'second turn',
+      ]);
+    },
+  );
+
+  test(
+    'read-only sessions refuse input instead of sending a doomed request',
+    () async {
+      await controller.start();
+      channel.emit(<String, dynamic>{
+        'type': 'discovered',
+        'sessions': <Map<String, dynamic>>[
+          {
+            'id': 'pane-1',
+            'kind': 'herdr',
+            'title': 'api',
+            'origin': 'pane',
+            'canOpen': true,
+            'canAcceptInput': false,
+          },
+        ],
+        'bound': <String>[],
+      });
+      controller.openSession('pane-1');
+      final before = channel.sent.length;
+
+      controller.sendInput('ls');
+
+      expect(channel.sent.length, before);
+    },
+  );
+
+  test('a dropped link becomes a retryable stopped state', () async {
+    await controller.start();
+    await channel.dropConnection();
+    await Future<void>.delayed(Duration.zero);
+
+    expect(controller.status, DesktopCompanionStatus.stopped);
+  });
+
+  test(
+    'a missing companion reports the guided problem instead of connecting',
+    () async {
+      final missing = DesktopCompanionController(
+        connect: () async => throw StateError('should not connect'),
+        resolution: const DesktopCompanionResolution.missing(
+          problem: '未找到本机 companion',
+          searched: <String>['/opt/qflistudio/companion'],
+        ),
+      );
+      addTearDown(missing.dispose);
+
+      await missing.start();
+
+      expect(missing.status, DesktopCompanionStatus.notInstalled);
+      expect(missing.lastError, contains('未找到'));
+    },
+  );
+
+  test('a failed start keeps the message for the page to show', () async {
+    final failing = DesktopCompanionController(
+      connect: () async => throw StateError('未找到 Node 运行时'),
+      resolution: _found(),
+    );
+    addTearDown(failing.dispose);
+
+    await failing.start();
+
+    expect(failing.status, DesktopCompanionStatus.failed);
+    expect(failing.lastError, '未找到 Node 运行时');
+  });
+}
diff --git a/test/remote_control/desktop/desktop_companion_locator_test.dart b/test/remote_control/desktop/desktop_companion_locator_test.dart
new file mode 100644
--- /dev/null
+++ b/test/remote_control/desktop/desktop_companion_locator_test.dart
@@ -0,0 +1,336 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:qfli_studio_core/remote_control/desktop/desktop_companion_locator.dart';
+
+/// A fake machine: a set of files, a set of directories, and an environment.
+class _FakeMachine {
+  _FakeMachine({
+    required this.os,
+    required this.executablePath,
+    Map<String, String>? environment,
+  }) : environment = environment ?? <String, String>{};
+
+  final String os;
+  final String executablePath;
+  final Map<String, String> environment;
+  final Set<String> files = <String>{};
+  final Set<String> directories = <String>{};
+  final Map<String, String> contents = <String, String>{};
+
+  void addCompanion(
+    String directory, {
+    String? manifest,
+    String node = 'node/bin/node',
+  }) {
+    directories.add(directory);
+    final separator = os == 'windows' ? r'\' : '/';
+    final manifestPath = '$directory${separator}companion.json';
+    files.add(manifestPath);
+    files.add('$directory${separator}package.json');
+    files.add('$directory${separator}src${separator}agent${separator}main.ts');
+    files.add('$directory${separator}node$separator$node');
+    contents[manifestPath] =
+        manifest ??
+        '{"os":"$os","arch":"x64","agent_version":"1.2.3","node_version":"24.14.1"}';
+  }
+
+  DesktopCompanionEnvironment env({String? supportDirectory}) =>
+      DesktopCompanionEnvironment(
+        operatingSystem: os,
+        environment: environment,
+        executablePath: executablePath,
+        supportDirectory: supportDirectory,
+        isFile: files.contains,
+        isDirectory: directories.contains,
+        readFile: (String path) => contents[path],
+      );
+}
+
+void main() {
+  group('macOS', () {
+    test('finds the sibling app next to /Applications/QFLIStudio.app', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Applications/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+      machine.addCompanion(
+        '/Applications/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+
+      final resolution = resolveDesktopCompanion(machine.env());
+
+      expect(resolution.isFound, isTrue);
+      expect(
+        resolution.location!.agentDirectory,
+        '/Applications/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+    });
+
+    test('finds the sibling of a per-user ~/Applications install', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Users/lin/Applications/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+      machine.addCompanion(
+        '/Users/lin/Applications/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+
+      final resolution = resolveDesktopCompanion(machine.env());
+
+      expect(resolution.isFound, isTrue);
+      expect(
+        resolution.location!.agentDirectory,
+        '/Users/lin/Applications/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+    });
+
+    test('resolves a nested install without dropping a directory level', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Volumes/Build/Apps/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+      machine.addCompanion(
+        '/Volumes/Build/Apps/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+
+      final resolution = resolveDesktopCompanion(machine.env());
+
+      expect(resolution.isFound, isTrue);
+      expect(
+        resolution.location!.agentDirectory,
+        '/Volumes/Build/Apps/QFLI Remote Companion.app/Contents/Resources/companion',
+      );
+    });
+
+    test('accepts a companion staged inside Studio\'s own bundle', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Applications/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+      machine.addCompanion(
+        '/Applications/QFLIStudio.app/Contents/Resources/companion',
+      );
+
+      final resolution = resolveDesktopCompanion(machine.env());
+
+      expect(resolution.isFound, isTrue);
+      expect(
+        resolution.location!.agentDirectory,
+        '/Applications/QFLIStudio.app/Contents/Resources/companion',
+      );
+    });
+
+    test('a sandboxed manifest is attach-only, with the shared attach file', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Applications/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+      machine.addCompanion(
+        '/Applications/QFLI Remote Companion.app/Contents/Resources/companion',
+        manifest:
+            '{"os":"macos","arch":"arm64","sandboxed":true,"attach":{"port_file":"sidecar.json"}}',
+      );
+
+      final location = resolveDesktopCompanion(machine.env()).location!;
+
+      expect(location.canSpawn, isFalse);
+      // The launcher writes here; Studio only reads. Both sides must agree or
+      // macOS could never attach.
+      expect(
+        location.attachFile,
+        '/Users/lin/Library/Application Support/QFLIStudio/companion/sidecar.json',
+      );
+    });
+
+    test('reports a guided missing state and lists what it looked in', () {
+      final machine = _FakeMachine(
+        os: 'macos',
+        executablePath:
+            '/Applications/QFLIStudio.app/Contents/MacOS/qflistudio',
+        environment: {'HOME': '/Users/lin'},
+      );
+
+      final resolution = resolveDesktopCompanion(machine.env());
+
+      expect(resolution.isFound, isFalse);
+      expect(resolution.searched, isNotEmpty);
+      expect(resolution.problem, contains('QFLI 远程 companion'));
+    });
+  });
+
+  group('Windows', () {
+    test('prefers the per-user install before Program Files', () {
+      final machine = _FakeMachine(
+        os: 'windows',
+        executablePath: r'C:\Users\lin\AppData\Local\QFLIStudio\qflistudio.exe',
+        environment: {
+          'LOCALAPPDATA': r'C:\Users\lin\AppData\Local',
+          'APPDATA': r'C:\Users\lin\AppData\Roaming',
+          'ProgramFiles': r'C:\Program Files',
+        },
+      );
+      machine.addCompanion(
+        r'C:\Users\lin\AppData\Local\QFLIStudio\companion',
+        node: r'node\node.exe',
+      );
+      machine.addCompanion(
+        r'C:\Program Files\QFLIStudio\companion',
+        node: r'node\node.exe',
+      );
+
+      final location = resolveDesktopCompanion(machine.env()).location!;
+
+      expect(
+        location.agentDirectory,
+        r'C:\Users\lin\AppData\Local\QFLIStudio\companion',
+      );
+      expect(
+        location.nodeExecutable,
+        r'C:\Users\lin\AppData\Local\QFLIStudio\companion\node\node.exe',
+      );
+      expect(location.canSpawn, isTrue);
+      expect(
+        location.attachFile,
+        r'C:\Users\lin\AppData\Roaming\QFLIStudio\companion\sidecar.json',
+      );
+    });
+
+    test('falls back to Program Files when the user copy is absent', () {
+      final machine = _FakeMachine(
+        os: 'windows',
+        executablePath: r'C:\Program Files\QFLIStudio\qflistudio.exe',
+        environment: {
+          'LOCALAPPDATA': r'C:\Users\lin\AppData\Local',
+          'APPDATA': r'C:\Users\lin\AppData\Roaming',
+          'ProgramFiles': r'C:\Program Files',
+        },
+      );
+      machine.addCompanion(
+        r'C:\Program Files\QFLIStudio\companion',
+        node: r'node\node.exe',
+      );
+
+      expect(
+        resolveDesktopCompanion(machine.env()).location!.agentDirectory,
+        r'C:\Program Files\QFLIStudio\companion',
+      );
+    });
+  });
+
+  group('Linux', () {
+    test(
+      'finds the /opt install and uses XDG_CONFIG_HOME for the attach file',
+      () {
+        final machine = _FakeMachine(
+          os: 'linux',
+          executablePath: '/usr/bin/qflistudio',
+          environment: {
+            'HOME': '/home/lin',
+            'XDG_CONFIG_HOME': '/home/lin/.config',
+          },
+        );
+        machine.addCompanion('/opt/qflistudio/companion');
+
+        final location = resolveDesktopCompanion(machine.env()).location!;
+
+        expect(location.agentDirectory, '/opt/qflistudio/companion');
+        expect(
+          location.attachFile,
+          '/home/lin/.config/QFLIStudio/companion/sidecar.json',
+        );
+      },
+    );
+
+    test('honours QFLI_COMPANION_DIR before any installed path', () {
+      final machine = _FakeMachine(
