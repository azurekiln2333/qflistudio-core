+// Browser fallback for the native companion link.
+//
+// There is no loopback socket in a web build, so every entry point reports the
+// capability as unsupported. `DesktopCompanionLinkSurface.isSupported` lets the
+// page explain that instead of showing a retry loop.
+
+import 'desktop_companion_channel.dart';
+import 'desktop_companion_locator.dart';
+
+/// Reports the platform capability for a browser build.
+abstract final class DesktopCompanionLinkSurface {
+  static bool get isSupported => false;
+}
+
+/// Always fails: a browser cannot spawn or attach to a companion.
+class NativeDesktopCompanionLink {
+  NativeDesktopCompanionLink({Object? supervisor});
+
+  Future<DesktopCompanionChannel> spawn(
+    DesktopCompanionLocation location,
+  ) async {
+    throw StateError('浏览器版不支持本机 companion。');
+  }
+
+  Future<DesktopCompanionChannel> attach(
+    DesktopCompanionAttachPoint attachPoint,
+  ) async {
+    throw StateError('浏览器版不支持本机 companion。');
+  }
+}
diff --git a/lib/remote_control/desktop/desktop_companion_locator.dart b/lib/remote_control/desktop/desktop_companion_locator.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_locator.dart
@@ -0,0 +1,499 @@
+// Locating the desktop companion (Node agent) inside an installed Studio.
+//
+// The companion is shipped *outside* the Flutter bundle, not inside it:
+//
+//   Windows  C:\Program Files\QFLIStudio\companion\   (installer copies the
+//            portable `qfli-companion-<ver>-windows-<arch>` directory there)
+//   Linux    /opt/qflistudio/companion/               (deb/tar.gz layout)
+//   macOS    "QFLI Remote Companion.app/Contents/Resources/companion/" next to
+//            QFLIStudio.app, or ~/Library/Application Support/QFLIStudio/companion/
+//
+// Discovery is deliberately *not* "walk up until a source checkout appears":
+// a released app must work on a machine that never had the repository. The
+// search order below is therefore:
+//
+//   1. an explicit override directory (`QFLI_COMPANION_DIR`), used by packaged
+//      installers and by developers;
+//   2. the installed locations for this OS, in the order the installer writes
+//      them (per-user before machine-wide);
+//   3. a source checkout *only* when running from one (a `companion.json` with a
+//      `source_checkout` marker), and only as the last resort.
+//
+// Every candidate must contain a `companion.json` manifest, `package.json` and
+// `src/agent/main.ts`. A directory that merely looks plausible is rejected, so
+// the page can honestly say "companion not installed" instead of failing later
+// with a Node error.
+
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+
+/// Where a companion bundle lives and which Node runtime to use.
+@immutable
+class DesktopCompanionLocation {
+  const DesktopCompanionLocation({
+    required this.agentDirectory,
+    required this.nodeExecutable,
+    required this.manifest,
+    required this.origin,
+    this.attachFile,
+  });
+
+  /// Directory that contains `package.json`, `src/agent/main.ts` and `node/`.
+  final String agentDirectory;
+
+  /// Absolute path to the Node binary, or null when the bundle has none.
+  final String? nodeExecutable;
+
+  /// Parsed `companion.json`.
+  final Map<String, dynamic> manifest;
+
+  /// How this location was found, for the page's diagnostics line.
+  final DesktopCompanionOrigin origin;
+
+  /// Where the companion publishes `{port, token}` when it runs detached.
+  final String? attachFile;
+
+  /// Target OS recorded in the manifest (`windows` / `macos` / `linux`).
+  String get targetOs => _string(manifest['os']);
+
+  /// Target architecture recorded in the manifest (`x64` / `arm64`).
+  String get targetArch => _string(manifest['arch']);
+
+  /// Version of the bundled agent.
+  String get agentVersion => _string(manifest['agent_version']);
+
+  /// Bundled Node version, for the diagnostics line only.
+  String get nodeVersion => _string(manifest['node_version']);
+
+  /// Whether the app may spawn this companion itself.
+  ///
+  /// `false` on macOS: the app sandbox forbids starting the bundled Node
+  /// binary, so the page attaches to a companion the user launched instead.
+  bool get canSpawn => manifest['sandboxed'] != true;
+
+  /// Short, user-facing description of where this came from.
+  String get originLabel => switch (origin) {
+    DesktopCompanionOrigin.override => '安装包指定目录',
+    DesktopCompanionOrigin.installedPerUser => '用户安装目录',
+    DesktopCompanionOrigin.installedMachine => '系统安装目录',
+    DesktopCompanionOrigin.sourceCheckout => '开发目录',
+  };
+
+  static String _string(Object? value) => value is String ? value : '';
+}
+
+/// Provenance of a discovered companion, shown in the page's diagnostics.
+enum DesktopCompanionOrigin {
+  override,
+  installedPerUser,
+  installedMachine,
+  sourceCheckout,
+}
+
+/// A companion the user started detached, plus the credential to attach with.
+///
+/// The port alone is never accepted as identity: the companion requires this
+/// token as the first frame, so a stale or guessed port cannot drive the agent.
+@immutable
+class DesktopCompanionAttachPoint {
+  const DesktopCompanionAttachPoint({
+    required this.port,
+    required this.token,
+    this.source,
+  });
+
+  final int port;
+  final String token;
+
+  /// File the pair was read from, for the page's diagnostics line.
+  final String? source;
+
+  /// Parses the `{port, token}` document the companion publishes.
+  ///
+  /// Returns null when the document is absent, unreadable or incomplete. A
+  /// document without a token is rejected on purpose: attaching with only a
+  /// port would let any local process drive the agent.
+  static DesktopCompanionAttachPoint? tryParse(String? raw, {String? source}) {
+    if (raw == null || raw.trim().isEmpty) return null;
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) return null;
+      final port = decoded['port'];
+      final token = decoded['token'];
+      if (port is! num || token is! String || token.isEmpty) return null;
+      final value = port.toInt();
+      if (value < 1 || value > 65535) return null;
+      return DesktopCompanionAttachPoint(
+        port: value,
+        token: token,
+        source: source,
+      );
+    } on FormatException {
+      return null;
+    }
+  }
+}
+
+/// Environment overrides read by [resolveDesktopCompanion].
+///
+/// Injected instead of reading `Platform.environment` directly so unit tests do
+/// not depend on the machine they run on. Values are directory names only; no
+/// credential is ever read here.
+@immutable
+class DesktopCompanionEnvironment {
+  const DesktopCompanionEnvironment({
+    required this.operatingSystem,
+    required this.environment,
+    required this.executablePath,
+    required this.supportDirectory,
+    required this.isFile,
+    required this.isDirectory,
+    required this.readFile,
+  });
+
+  /// `Platform.operatingSystem` (`windows`, `macos`, `linux`).
+  final String operatingSystem;
+
+  /// Process environment. Only path-like variables are consulted.
+  final Map<String, String> environment;
+
+  /// Absolute path of the running executable (`Platform.resolvedExecutable`).
+  final String executablePath;
+
+  /// Per-user writable directory for this app (`~/Library/Application Support`
+  /// equivalent). Null when the platform plugin is unavailable.
+  final String? supportDirectory;
+
+  /// Filesystem probes and reader, injected so tests run on any OS and so this
+  /// file never needs `dart:io` (it is reachable from a web build).
+  final bool Function(String path) isFile;
+  final bool Function(String path) isDirectory;
+  final String? Function(String path) readFile;
+
+  String? operator [](String key) {
+    final value = environment[key];
+    return value == null || value.trim().isEmpty ? null : value.trim();
+  }
+}
+
+/// Result of discovery: either a usable location or a reason it was not found.
+@immutable
+class DesktopCompanionResolution {
+  const DesktopCompanionResolution.found(this.location)
+    : problem = null,
+      searched = const <String>[];
+
+  const DesktopCompanionResolution.missing({
+    required this.problem,
+    required this.searched,
+  }) : location = null;
+
+  final DesktopCompanionLocation? location;
+
+  /// Actionable message when [location] is null.
+  final String? problem;
+
+  /// Directories that were inspected, for the page's "looked in" list.
+  final List<String> searched;
+
+  bool get isFound => location != null;
+}
+
+/// Marker key an installer or developer can add to `companion.json` to declare
+/// that the bundle came from a source checkout.
+const String sourceCheckoutMarker = 'source_checkout';
+
+/// Discovers the companion for the current machine.
+///
+/// [extraCandidates] lets a host (or a test) add locations ahead of the
+/// installed ones, for example a bundle unpacked next to a portable build.
+DesktopCompanionResolution resolveDesktopCompanion(
+  DesktopCompanionEnvironment env, {
+  List<String> extraCandidates = const <String>[],
+}) {
+  final searched = <String>[];
+  final candidates = <_Candidate>[
+    for (final path in extraCandidates)
+      _Candidate(path, DesktopCompanionOrigin.installedPerUser),
+    ..._candidateDirectories(env),
+  ];
+
+  final separator = env.operatingSystem == 'windows' ? '\\' : '/';
+
+  for (final candidate in candidates) {
+    final directory = _normalize(candidate.path.trim(), separator);
+    if (directory.isEmpty) continue;
+    if (searched.contains(directory)) continue;
+    searched.add(directory);
+    final location = _inspect(env, directory, candidate.origin, separator);
+    if (location != null) return DesktopCompanionResolution.found(location);
+  }
+
+  final fromSource = searched.firstWhere(
+    (path) => env.isDirectory(path),
+    orElse: () => searched.isEmpty ? '' : searched.first,
+  );
+  return DesktopCompanionResolution.missing(
+    searched: List<String>.unmodifiable(searched),
+    problem: env.operatingSystem == 'macos'
+        ? '未找到本机 companion。请启动随 Studio 安装的 QFLI 远程 companion，'
+              '再回到本页点击「连接本机 companion」。'
+        : '未找到本机 companion（$fromSource）。请重新安装 Studio，'
+              '或运行安装目录下的 companion 启动脚本。',
+  );
+}
+
+/// Ordered directories to inspect, most specific first.
+Iterable<_Candidate> _candidateDirectories(
+  DesktopCompanionEnvironment env,
+) sync* {
+  final override = env['QFLI_COMPANION_DIR'];
+  if (override != null) {
+    yield _Candidate(override, DesktopCompanionOrigin.override);
+  }
+
+  final support = env.supportDirectory;
+  switch (env.operatingSystem) {
+    case 'windows':
+      // Per-user install (portable zip) first, then the machine-wide installer.
+      final localAppData = env['LOCALAPPDATA'];
+      final programFiles = env['ProgramFiles'] ?? r'C:\Program Files';
+      final programFilesX86 = env['ProgramFiles(x86)'];
+      if (localAppData != null) {
+        yield _Candidate(
+          '$localAppData\\QFLIStudio\\companion',
+          DesktopCompanionOrigin.installedPerUser,
+        );
+        yield _Candidate(
+          '$localAppData\\Programs\\QFLIStudio\\companion',
+          DesktopCompanionOrigin.installedPerUser,
+        );
+      }
+      yield _Candidate(
+        '$programFiles\\QFLIStudio\\companion',
+        DesktopCompanionOrigin.installedMachine,
+      );
+      if (programFilesX86 != null) {
+        yield _Candidate(
+          '$programFilesX86\\QFLIStudio\\companion',
+          DesktopCompanionOrigin.installedMachine,
+        );
+      }
+      // A portable build keeps the companion beside the executable.
+      yield _Candidate(
+        '${_parentOf(env.executablePath)}\\companion',
+        DesktopCompanionOrigin.installedPerUser,
+      );
+    case 'macos':
+      // `Platform.resolvedExecutable` is
+      //   <install>/QFLIStudio.app/Contents/MacOS/qflistudio
+      // The companion is a sibling bundle, so the location is derived from the
+      // bundle root's parent, never by counting parents off the executable:
+      // counting is what put a `~/Applications` install at `/Users/me` and lost
+      // one directory level.
+      final appBundle = _macOsBundleRoot(env.executablePath);
+      if (appBundle != null) {
+        final installDir = _parentOf(appBundle);
+        yield _Candidate(
+          '$installDir/QFLI Remote Companion.app/Contents/Resources/companion',
+          DesktopCompanionOrigin.installedMachine,
+        );
+        // A companion staged inside Studio's own bundle (portable/CI layout).
+        yield _Candidate(
+          '$appBundle/Contents/Resources/companion',
+          DesktopCompanionOrigin.installedMachine,
+        );
+      }
+      if (support != null) {
+        yield _Candidate(
+          '$support/companion',
+          DesktopCompanionOrigin.installedPerUser,
+        );
+      }
+    case 'linux':
+      if (support != null) {
+        yield _Candidate(
+          '$support/companion',
+          DesktopCompanionOrigin.installedPerUser,
+        );
+      }
+      yield _Candidate(
+        '/opt/qflistudio/companion',
+        DesktopCompanionOrigin.installedMachine,
+      );
+      yield _Candidate(
+        '/usr/lib/qflistudio/companion',
+        DesktopCompanionOrigin.installedMachine,
+      );
+      yield _Candidate(
+        '${_parentOf(env.executablePath)}/companion',
+        DesktopCompanionOrigin.installedMachine,
+      );
+  }
+
+  // Source checkout, only when the running app itself sits inside one. This
+  // keeps `flutter run` usable for developers without making it a requirement
+  // for installed builds.
+  for (final root in _sourceRoots(env)) {
+    yield _Candidate(root, DesktopCompanionOrigin.sourceCheckout);
+  }
+}
+
+/// Source-checkout candidate roots derived from the executable location.
+Iterable<String> _sourceRoots(DesktopCompanionEnvironment env) sync* {
+  final separator = env.operatingSystem == 'windows' ? '\\' : '/';
+  var directory = _parentOf(env.executablePath);
+  for (var depth = 0; depth < 6; depth++) {
+    if (env.isFile('$directory${separator}pubspec.yaml') &&
+        env.isDirectory(
+          '$directory${separator}companion${separator}remote_agent',
+        )) {
+      yield '$directory${separator}companion${separator}remote_agent';
+      return;
+    }
+    final parent = _parentOf(directory);
+    if (parent == directory) return;
+    directory = parent;
+  }
+}
+
+DesktopCompanionLocation? _inspect(
+  DesktopCompanionEnvironment env,
+  String directory,
+  DesktopCompanionOrigin origin,
+  String separator,
+) {
+  if (!env.isDirectory(directory)) return null;
+  final manifestPath = '$directory${separator}companion.json';
+  final packagePath = '$directory${separator}package.json';
+  final entryPath =
+      '$directory${separator}src${separator}agent${separator}main.ts';
+  // A source checkout has no manifest; only accept it when it declares itself.
+  if (!env.isFile(manifestPath) ||
+      !env.isFile(packagePath) ||
+      !env.isFile(entryPath)) {
+    return null;
+  }
+  final manifest = _readManifest(env, manifestPath);
+  if (manifest == null) return null;
+  final declaredSource = manifest[sourceCheckoutMarker] == true;
+  if (origin == DesktopCompanionOrigin.sourceCheckout && !declaredSource) {
+    return null;
+  }
+
+  final nodeCandidate = <String>[
+    if (env.operatingSystem == 'windows') ...[
+      '$directory${separator}node${separator}node.exe',
+      '$directory${separator}node${separator}node',
+    ] else ...[
+      '$directory${separator}node${separator}bin${separator}node',
+      '$directory${separator}node${separator}node',
+    ],
+  ].firstWhere(env.isFile, orElse: () => '');
+
+  final attachFile = _attachFile(env, manifest, separator);
+  return DesktopCompanionLocation(
+    agentDirectory: directory,
+    nodeExecutable: nodeCandidate.isEmpty ? null : nodeCandidate,
+    manifest: Map<String, dynamic>.unmodifiable(manifest),
+    origin: origin,
+    attachFile: attachFile,
+  );
+}
+
+/// Where the companion publishes `{port, token}` for a detached launch.
+///
+/// Must match what `start.sh` / `start.cmd` in the bundle write, and must be a
+/// directory the sandboxed Studio app is allowed to read. Both launchers use
+/// one location per OS:
+///
+///   Windows  %APPDATA%\QFLIStudio\companion\sidecar.json
+///   macOS    ~/Library/Application Support/QFLIStudio/companion/sidecar.json
+///   Linux    ${XDG_CONFIG_HOME:-~/.config}/QFLIStudio/companion/sidecar.json
+String? _attachFile(
+  DesktopCompanionEnvironment env,
+  Map<String, dynamic> manifest,
+  String separator,
+) {
+  final attach = manifest['attach'];
+  final fileName = attach is Map && attach['port_file'] is String
+      ? attach['port_file'] as String
+      : 'sidecar.json';
+  switch (env.operatingSystem) {
+    case 'windows':
+      final appData = env['APPDATA'];
+      if (appData == null) return null;
+      return '$appData${separator}QFLIStudio${separator}companion$separator$fileName';
+    case 'macos':
+      // Shared, non-sandboxed location: the companion is a normal app, so it
+      // can write ~/Library/Application Support while Studio only reads it.
+      final home = env['HOME'];
+      if (home == null) return null;
+      return '$home/Library/Application Support/QFLIStudio/companion/$fileName';
+    default:
+      final configHome =
+          env['XDG_CONFIG_HOME'] ??
+          (env['HOME'] == null ? null : '${env['HOME']}/.config');
+      if (configHome == null) return null;
+      return '$configHome${separator}QFLIStudio${separator}companion$separator$fileName';
+  }
+}
+
+Map<String, dynamic>? _readManifest(
+  DesktopCompanionEnvironment env,
+  String path,
+) {
+  final raw = env.readFile(path);
+  if (raw == null) return null;
+  try {
+    final decoded = jsonDecode(raw);
+    return decoded is Map<String, dynamic> ? decoded : null;
+  } on FormatException {
+    return null;
+  }
+}
+
+String _normalize(String path, String separator) {
+  var value = path.trim();
+  if (value.isEmpty) return '';
+  while (value.length > 1 && value.endsWith(separator)) {
+    value = value.substring(0, value.length - 1);
+  }
+  return value;
+}
+
+String _parentOf(String path) {
+  final index = path.lastIndexOf(RegExp(r'[\\/]'));
+  if (index <= 0) return path;
+  return path.substring(0, index);
+}
+
+/// The `.app` directory containing [executablePath], or null when the path is
+/// not inside a bundle.
+///
+/// This is a search for the nearest `.app` ancestor instead of a fixed number of
+/// `_parentOf` calls, so a bundle at any depth — `/Applications`,
+/// `~/Applications`, `/Volumes/X/Applications` — resolves its sibling at the
+/// right level. [resolveDesktopCompanion] appends the sibling bundle name.
+String? _macOsBundleRoot(String executablePath) {
+  var directory = _parentOf(executablePath);
+  for (var depth = 0; depth < 8; depth++) {
+    if (directory.isEmpty ||
+        directory == '/' ||
+        directory == _parentOf(directory)) {
+      return null;
+    }
+    if (directory.endsWith('.app')) return directory;
+    directory = _parentOf(directory);
+  }
+  return null;
+}
+
+@immutable
+class _Candidate {
+  const _Candidate(this.path, this.origin);
+
+  final String path;
+  final DesktopCompanionOrigin origin;
+}
