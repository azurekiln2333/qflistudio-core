diff --git a/lib/remote_control/desktop/desktop_companion_channel.dart b/lib/remote_control/desktop/desktop_companion_channel.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_channel.dart
@@ -0,0 +1,150 @@
+// Transport boundary for the local companion (sidecar) link.
+//
+// The desktop page talks to the Node companion over a loopback, line-delimited
+// JSON socket. Keeping the transport behind this interface means:
+//
+//   * `desktop_companion_controller.dart` stays free of `dart:io` and is unit
+//     testable with a fake that pipes frames in both directions;
+//   * the browser build (and the tests) never open a socket, so the module does
+//     not regress `RemoteComputerPage.isSupported`-style platform gating;
+//   * attaching to an already-running companion and spawning a new one differ
+//     only in how the channel is obtained, not in the protocol.
+//
+// The wire contract is the companion's existing sidecar protocol (see
+// `companion/remote_agent/src/agent/sidecar.ts`): newline-delimited JSON frames,
+// plus one optional first request `{"type":"auth","token":"..."}` when the
+// companion published a per-run attach token.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+
+/// One bidirectional link to a companion process.
+abstract class DesktopCompanionChannel {
+  /// Frames pushed by the companion: `snapshot`, `pair_code`, `event`,
+  /// `herdr_*`, `codex_*`, `error`, …
+  Stream<Map<String, dynamic>> get frames;
+
+  /// Sends one request frame. Never throws when the link is already gone; the
+  /// caller observes disconnection through [frames] and [closed].
+  void send(Map<String, dynamic> frame);
+
+  /// Completes when the link can no longer be used.
+  Future<void> get closed;
+
+  /// Releases the socket and any child process. Idempotent.
+  Future<void> close();
+}
+
+/// Decodes newline-delimited JSON without losing a frame split across reads.
+///
+/// The companion writes one frame per line; a `dart:io` socket read can end
+/// mid-line, so the partial tail is buffered until its newline arrives.
+class CompanionFrameDecoder {
+  String _buffer = '';
+
+  /// Returns every complete frame in [chunk]; partial input is retained.
+  List<Map<String, dynamic>> add(String chunk) {
+    _buffer += chunk;
+    final frames = <Map<String, dynamic>>[];
+    var index = _buffer.indexOf('\n');
+    while (index >= 0) {
+      final line = _buffer.substring(0, index).trim();
+      _buffer = _buffer.substring(index + 1);
+      if (line.isNotEmpty) {
+        final decoded = decodeFrame(line);
+        if (decoded != null) frames.add(decoded);
+      }
+      index = _buffer.indexOf('\n');
+    }
+    return frames;
+  }
+
+  /// Parses one JSON object line. Non-objects and malformed lines yield null:
+  /// a stray log line from the child must not kill the session.
+  static Map<String, dynamic>? decodeFrame(String line) {
+    final text = line.trim();
+    if (!text.startsWith('{')) return null;
+    try {
+      final decoded = jsonDecode(text);
+      if (decoded is Map<String, dynamic>) return decoded;
+      if (decoded is Map) return decoded.cast<String, dynamic>();
+    } on FormatException {
+      return null;
+    }
+    return null;
+  }
+
+  /// Encodes one request frame, including its trailing newline.
+  static String encodeFrame(Map<String, dynamic> frame) =>
+      '${jsonEncode(frame)}\n';
+}
+
+/// In-memory channel used by tests and by the unsupported-platform preview.
+///
+/// It records what the page sent and lets a test push frames back, so the
+/// controller logic (pairing timeout, offline state, session discovery) is
+/// covered without a process or a socket.
+class FakeDesktopCompanionChannel implements DesktopCompanionChannel {
+  FakeDesktopCompanionChannel({this.attachToken});
+
+  /// Token the fake accepts in its first `auth` frame, when attaching.
+  final String? attachToken;
+
+  final StreamController<Map<String, dynamic>> _frames =
+      StreamController<Map<String, dynamic>>.broadcast();
+  final Completer<void> _closed = Completer<void>();
+
+  /// Every frame the page sent, in order.
+  final List<Map<String, dynamic>> sent = <Map<String, dynamic>>[];
+
+  bool _authed = true;
+  bool _closedFlag = false;
+
+  /// Whether the first frame must be a valid `auth`.
+  bool get expectsAuth => attachToken != null;
+
+  @override
+  Stream<Map<String, dynamic>> get frames => _frames.stream;
+
+  @override
+  Future<void> get closed => _closed.future;
+
+  @override
+  void send(Map<String, dynamic> frame) {
+    if (_closedFlag) return;
+    sent.add(Map<String, dynamic>.of(frame));
+    if (expectsAuth && !_authed) {
+      if (frame['type'] == 'auth' && frame['token'] == attachToken) {
+        _authed = true;
+      }
+      return;
+    }
+  }
+
+  /// Pushes a frame as if the companion had written it.
+  void emit(Map<String, dynamic> frame) {
+    if (!_closedFlag) _frames.add(frame);
+  }
+
+  /// Simulates the companion going away (crash, user closed the window).
+  Future<void> dropConnection() async {
+    if (_closedFlag) return;
+    _closedFlag = true;
+    _frames.close();
+    _closed.complete();
+  }
+
+  @override
+  Future<void> close() async {
+    if (_closedFlag) return;
+    _closedFlag = true;
+    await _frames.close();
+    if (!_closed.isCompleted) _closed.complete();
+  }
+
+  /// Whether the page successfully authenticated against [attachToken].
+  @visibleForTesting
+  bool get authenticated => _authed;
+}
diff --git a/lib/remote_control/desktop/desktop_companion_controller.dart b/lib/remote_control/desktop/desktop_companion_controller.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_controller.dart
@@ -0,0 +1,514 @@
+// State for the desktop "本机配对" page.
+//
+// This controller talks to the local companion (the Node sidecar) and reports
+// only what the companion actually returned. Two things it never does:
+//
+//   * it never invents sessions, tools or counts. An empty list means the
+//     companion said there is nothing, and the page shows a creation entry
+//     instead of pretending a session exists;
+//   * it never treats `bindings` (this run's bound streams) as the list of
+//     sessions on the machine. Existing Herdr workspaces, Claude history and
+//     Codex threads are discovered through the agent's own protocol kinds
+//     (`herdr_workspaces`, `list_history`, `codex_threads`) via the sidecar's
+//     `discover` request; `bindings` only decorates the ones already open here.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import 'desktop_companion_channel.dart';
+import 'desktop_companion_locator.dart';
+
+/// One discovered session the user can open.
+@immutable
+class DesktopDiscoveredSession {
+  const DesktopDiscoveredSession({
+    required this.id,
+    required this.kind,
+    required this.title,
+    this.subtitle,
+    this.lastUsed,
+    this.bound = false,
+    this.origin,
+    this.canOpen = true,
+    this.canAcceptInput = false,
+  });
+
+  /// Stable identifier inside its kind (Claude history id, Herdr pane id,
+  /// Codex thread id).
+  final String id;
+
+  /// `claude` | `herdr` | `codex`.
+  final String kind;
+
+  final String title;
+  final String? subtitle;
+  final DateTime? lastUsed;
+
+  /// True when this run already holds a stream for it.
+  final bool bound;
+
+  /// `live` / `history` / `pane`, mirroring the companion's own naming.
+  final String? origin;
+
+  /// False for entries that are listed but cannot be opened (for example a
+  /// Codex thread the local CLI cannot resume).
+  final bool canOpen;
+
+  /// True when the companion can deliver input to this session. Read-only
+  /// sources (polled Herdr panes, SDK history) report false, and the page hides
+  /// the composer instead of offering an action that would fail.
+  final bool canAcceptInput;
+
+  /// Human label for the kind badge.
+  String get kindLabel => switch (kind) {
+    'claude' => 'Claude Code',
+    'herdr' => 'Herdr',
+    'codex' => 'Codex',
+    _ => kind,
+  };
+}
+
+/// One line of output attached to an opened session.
+@immutable
+class DesktopSessionLine {
+  const DesktopSessionLine({required this.text, required this.seq});
+
+  final String text;
+  final int seq;
+}
+
+/// Pairing state as the companion reported it.
+@immutable
+class DesktopPairingInfo {
+  const DesktopPairingInfo({
+    required this.code,
+    required this.uri,
+    required this.expiresAt,
+  });
+
+  /// Short code, already formatted as `XXXX-XXXX` by the companion.
+  final String code;
+
+  /// `cloudterminal://pair?relay=…&code=…&v=1`; copyable and scannable.
+  final String uri;
+
+  final DateTime expiresAt;
+
+  Duration get remaining => expiresAt.difference(DateTime.now());
+
+  bool get isExpired => remaining.isNegative;
+}
+
+/// Coarse lifecycle of the local companion link.
+enum DesktopCompanionStatus {
+  /// Discovery has not finished yet.
+  probing,
+
+  /// No companion bundle was found on this machine.
+  notInstalled,
+
+  /// The platform cannot host a companion (browser build).
+  unsupported,
+
+  /// Starting or attaching in progress.
+  starting,
+
+  /// Connected; pairing code and sessions are available.
+  ready,
+
+  /// The companion link dropped; the page offers a retry.
+  stopped,
+
+  /// Starting failed; [DesktopCompanionController.lastError] says why.
+  failed,
+}
+
+/// Hands the controller a channel when the page starts.
+///
+/// Injected so tests can run the whole state machine against
+/// [FakeDesktopCompanionChannel] without a process or a socket.
+typedef DesktopCompanionConnector = Future<DesktopCompanionChannel> Function();
+
+/// Drives the desktop companion page.
+class DesktopCompanionController extends ChangeNotifier {
+  DesktopCompanionController({
+    required this.connect,
+    DesktopCompanionResolution? resolution,
+  }) : _resolution = resolution;
+
+  /// Opens the companion link (spawn or attach). Called on start and on retry.
+  final DesktopCompanionConnector connect;
+
+  final DesktopCompanionResolution? _resolution;
+  DesktopCompanionStatus _status = DesktopCompanionStatus.probing;
+  DesktopCompanionChannel? _channel;
+  StreamSubscription<Map<String, dynamic>>? _subscription;
+  String? _lastError;
+  bool _disposed = false;
+
+  DesktopPairingInfo? _pairing;
+  bool _relayOnline = false;
+  String? _relayUrl;
+  String? _connectionMode;
+  int _retries = 0;
+  int? _pairedClients;
+
+  final List<DesktopDiscoveredSession> _sessions = <DesktopDiscoveredSession>[];
+  final Map<String, List<DesktopSessionLine>> _sessionLines =
+      <String, List<DesktopSessionLine>>{};
+  final List<String> _toolProbes = <String>[];
+  String? _openSessionId;
+  int _lastSeq = 0;
+
+  // --- read-only state exposed to the page --------------------------------
+
+  DesktopCompanionStatus get status => _status;
+
+  DesktopCompanionResolution? get resolution => _resolution;
+
+  /// The companion this page is using, once discovery succeeded.
+  DesktopCompanionLocation? get location => _resolution?.location;
+
+  String? get lastError => _lastError;
+
+  DesktopPairingInfo? get pairing => _pairing;
+
+  bool get relayOnline => _relayOnline;
+
+  /// Relay or LAN address the phone must use, as reported by the companion.
+  String? get relayUrl => _relayUrl;
+
+  /// `local` (LAN relay in-process) or `remote` (public relay).
+  String? get connectionMode => _connectionMode;
+
+  int get retries => _retries;
+
+  /// Authoritative connected-client count from the relay, or null when the
+  /// companion cannot know it. Never a fabricated zero.
+  int? get pairedClients => _pairedClients;
+
+  List<DesktopDiscoveredSession> get sessions =>
+      List<DesktopDiscoveredSession>.unmodifiable(_sessions);
+
+  bool get hasSessions => _sessions.isNotEmpty;
+
+  List<String> get toolProbes => List<String>.unmodifiable(_toolProbes);
+
+  String? get openSessionId => _openSessionId;
+
+  List<DesktopSessionLine> get openSessionLines => _openSessionId == null
+      ? const <DesktopSessionLine>[]
+      : List<DesktopSessionLine>.unmodifiable(
+          _sessionLines[_openSessionId!] ?? const <DesktopSessionLine>[],
+        );
+
+  /// True when the pairing code exists but its window has passed.
+  bool get isPairingExpired => _pairing?.isExpired ?? false;
+
+  /// Whether the page can offer the "spawn" button (installed bundle that the
+  /// app is allowed to start). A sandboxed macOS build attaches instead.
+  bool get canSpawn => location?.canSpawn ?? false;
+
+  // --- lifecycle ----------------------------------------------------------
+
+  /// Resolves discovery, then connects. Safe to call once per page mount.
+  Future<void> start() async {
+    if (_status == DesktopCompanionStatus.starting ||
+        _status == DesktopCompanionStatus.ready) {
+      return;
+    }
+    _status = DesktopCompanionStatus.probing;
+    _lastError = null;
+    _notify();
+
+    final resolution = _resolution;
+    if (resolution != null && !resolution.isFound) {
+      _applyMissing(resolution);
+      return;
+    }
+    await _openChannel();
+  }
+
+  /// Retries a dropped or failed link without recreating the page.
+  Future<void> retry() async {
+    await _closeChannel();
+    await _openChannel();
+  }
+
+  Future<void> _openChannel() async {
+    _status = DesktopCompanionStatus.starting;
+    _notify();
+    try {
+      final channel = await connect();
+      if (_disposed) {
+        await channel.close();
+        return;
+      }
+      _channel = channel;
+      _subscription = channel.frames.listen(_onFrame, onError: _onChannelError);
+      unawaited(channel.closed.then((_) => _onChannelClosed()));
+      _status = DesktopCompanionStatus.ready;
+      _lastError = null;
+      // Ask for the state the page needs. The companion answers with a
+      // snapshot, a pairing code and the discovered session list.
+      _send(<String, dynamic>{'type': 'discover'});
+      _send(<String, dynamic>{'type': 'pair_code'});
+      _notify();
+    } on Object catch (error) {
+      _status = DesktopCompanionStatus.failed;
+      _lastError = _message(error);
+      _notify();
+    }
+  }
+
+  /// New one-time code (the companion invalidates the previous one).
+  void requestPairCode() {
+    _pairing = null;
+    _send(<String, dynamic>{'type': 'pair_code'});
+    _notify();
+  }
+
+  /// Re-runs session discovery and tool probing.
+  void refreshSessions() {
+    _send(<String, dynamic>{'type': 'discover'});
+    _send(<String, dynamic>{'type': 'tool_probe'});
+  }
+
+  /// Opens a discovered session: binds it through the source that produced it
+  /// and streams its output.
+  ///
+  /// The sidecar resolves Herdr panes through the pane poller, SDK Claude
+  /// history through the history loader and Codex threads through the app-server
+  /// resume path, so `open_session` must carry the same fields discovery
+  /// returned (`kind`, `origin`); `tool_bind` alone only knows the old
+  /// `listReadOnly()` sources and would reject Codex and SDK history.
+  void openSession(String id) {
+    final session = _sessions.where((s) => s.id == id).firstOrNull;
+    if (session == null || !session.canOpen) return;
+    _openSessionId = id;
+    _sessionLines.putIfAbsent(id, () => <DesktopSessionLine>[]);
+    _send(<String, dynamic>{
+      'type': 'open_session',
+      'id': id,
+      'kind': session.kind,
+      'origin': session.origin,
+      'canAcceptInput': session.canAcceptInput,
+    });
+    _notify();
+  }
+
+  /// Leaves the detail view without closing the desktop session itself.
+  void closeSessionView() {
+    _openSessionId = null;
+    _notify();
+  }
+
+  /// Sends input to the open session, when the companion marked it writable.
+  void sendInput(String text) {
+    final id = _openSessionId;
+    if (id == null || text.isEmpty) return;
+    final session = _sessions.where((s) => s.id == id).firstOrNull;
+    if (session != null && !session.canAcceptInput) return;
+    _send(<String, dynamic>{'type': 'input', 'id': id, 'text': text});
+  }
+
+  /// Dismisses the inline error banner without touching the link.
+  void clearError() {
+    _lastError = null;
+    _notify();
+  }
+
+  void _onFrame(Map<String, dynamic> frame) {
+    if (_disposed) return;
+    switch (frame['type']) {
+      case 'snapshot':
+        _applySnapshot(frame);
+      case 'pair_code':
+        final display = frame['display'];
+        final uri = frame['uri'];
+        final expiresAt = frame['expiresAt'];
+        if (display is String && uri is String && expiresAt is num) {
+          _pairing = DesktopPairingInfo(
+            code: display,
+            uri: uri,
+            expiresAt: DateTime.fromMillisecondsSinceEpoch(expiresAt.toInt()),
+          );
+        }
+        _notify();
+      case 'discovered':
+        _applyDiscovered(frame);
+      case 'tool_probe':
+        final tools = frame['tools'];
+        if (tools is List) {
+          _toolProbes
+            ..clear()
+            ..addAll(tools.whereType<Map>().map((tool) => '${tool['kind']}'));
+        }
+        _notify();
+      // Wire contract, shared with the sidecar and the phone protocol:
+      // `{type:'stream_event', kind, sessionId, eventKind, text, done?, seq}`.
+      // The previous draft invented `session_event` with an `id` field, so
+      // output never reached this page. `sessionId` is the existing name on
+      // `StreamEventPayload` and is what the sidecar already emits.
+      case 'stream_event':
+        _applyStreamEvent(frame);
+      case 'session_opened':
+        final id = frame['id'];
+        if (id is String) {
+          _sessionLines.putIfAbsent(id, () => <DesktopSessionLine>[]);
+          _notify();
+        }
+      case 'error':
+        _lastError = frame['message'] is String
+            ? frame['message'] as String
+            : '未知错误';
+        // A failed open must not keep the detail view spinning: drop the
+        // "reading…" placeholder and let the banner explain what happened.
+        _notify();
+      default:
+        // Unknown kinds are ignored on purpose: a newer companion must not
+        // break an older desktop build.
+        break;
+    }
+  }
+
+  void _applySnapshot(Map<String, dynamic> frame) {
+    _relayOnline = frame['relayOnline'] == true;
+    _relayUrl = frame['relayUrl'] is String
+        ? frame['relayUrl'] as String
+        : _relayUrl;
+    _connectionMode = frame['connectionMode'] is String
+        ? frame['connectionMode'] as String
+        : _connectionMode;
+    _retries = frame['retries'] is num
+        ? (frame['retries'] as num).toInt()
+        : _retries;
+    // The relay owns this number; `null` means "unknown", which the page shows
+    // as 未知 instead of a confident zero.
+    _pairedClients = frame['pairedClients'] is num
+        ? (frame['pairedClients'] as num).toInt()
+        : null;
+    final seq = frame['seq'];
+    if (seq is num) _lastSeq = seq.toInt();
+    _notify();
+  }
+
+  void _applyDiscovered(Map<String, dynamic> frame) {
+    final entries = frame['sessions'];
+    final discovered = <DesktopDiscoveredSession>[];
+    if (entries is List) {
+      for (final entry in entries) {
+        if (entry is! Map) continue;
+        final id = entry['id'];
+        final kind = entry['kind'];
+        if (id is! String || id.isEmpty || kind is! String) continue;
+        final lastUsed = entry['lastUsed'];
+        discovered.add(
+          DesktopDiscoveredSession(
+            id: id,
+            kind: kind,
+            title:
+                entry['title'] is String &&
+                    (entry['title'] as String).isNotEmpty
+                ? entry['title'] as String
+                : '未命名会话',
+            subtitle: entry['subtitle'] is String
+                ? entry['subtitle'] as String
+                : null,
+            lastUsed: lastUsed is num
+                ? DateTime.fromMillisecondsSinceEpoch(lastUsed.toInt())
+                : null,
+            bound: entry['bound'] == true,
+            origin: entry['origin'] is String
+                ? entry['origin'] as String
+                : null,
+            canOpen: entry['canOpen'] != false,
+            canAcceptInput: entry['canAcceptInput'] == true,
+          ),
+        );
+      }
+    }
+    _sessions
+      ..clear()
+      ..addAll(discovered);
+    _notify();
+  }
+
+  void _applyStreamEvent(Map<String, dynamic> frame) {
+    // `sessionId` is the sidecar's field; accept `id` only as a compatibility
+    // alias for an older build, so a staged companion does not go silent.
+    final id = frame['sessionId'] ?? frame['id'];
+    final text = frame['text'];
+    if (id is! String || text is! String) return;
+    final seq = frame['seq'] is num
+        ? (frame['seq'] as num).toInt()
+        : ++_lastSeq;
+    final lines = _sessionLines.putIfAbsent(id, () => <DesktopSessionLine>[]);
+    // `eventKind: 'snapshot'` replaces the buffer (initial read / polled screen);
+    // `stdout`/`stderr`/`turns` append.
+    if (frame['eventKind'] == 'snapshot' && frame['append'] != true) {
+      lines.clear();
+    }
+    lines.add(DesktopSessionLine(text: text, seq: seq));
+    // Bound the buffer so a chatty session cannot grow without limit.
+    const maxLines = 2000;
+    if (lines.length > maxLines) lines.removeRange(0, lines.length - maxLines);
+    _notify();
+  }
+
+  void _onChannelError(Object error) {
+    _lastError = _message(error);
+    _status = DesktopCompanionStatus.failed;
+    _notify();
+  }
+
+  void _onChannelClosed() {
+    if (_disposed) return;
+    if (_status == DesktopCompanionStatus.ready ||
+        _status == DesktopCompanionStatus.starting) {
+      _status = DesktopCompanionStatus.stopped;
+      _lastError ??= '本机 companion 连接已断开。';
+      _notify();
+    }
+  }
+
+  void _applyMissing(DesktopCompanionResolution resolution) {
+    _status = resolution.location == null && _unsupportedPlatform
+        ? DesktopCompanionStatus.unsupported
+        : DesktopCompanionStatus.notInstalled;
+    _lastError = resolution.problem;
+    _notify();
+  }
+
+  bool get _unsupportedPlatform =>
+      location == null && (_resolution?.searched.isEmpty ?? false);
+
+  void _send(Map<String, dynamic> frame) => _channel?.send(frame);
+
+  Future<void> _closeChannel() async {
+    await _subscription?.cancel();
+    _subscription = null;
+    final channel = _channel;
+    _channel = null;
+    await channel?.close();
+  }
+
+  static String _message(Object error) {
+    final text = error.toString();
+    return text.startsWith('Bad state: ')
+        ? text.substring('Bad state: '.length)
+        : text;
+  }
+
+  void _notify() {
+    if (!_disposed) notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    unawaited(_closeChannel());
+    super.dispose();
+  }
+}
diff --git a/lib/remote_control/desktop/desktop_companion_entry.dart b/lib/remote_control/desktop/desktop_companion_entry.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_entry.dart
@@ -0,0 +1,255 @@
+// App-scoped ownership for the local companion, plus the entry widget Studio's
+// tools tab can render.
+//
+// Two constraints shaped this file:
+//
+//   * `StudioProfile.toolsTabBuilder` has no `BuildContext`, so the tools tab
+//     cannot look up an `InheritedWidget` to find a session. A small process-wide
+//     registry is used instead, and it is the only place a session is created.
+//   * The session must outlive the page. Closing 本机配对 therefore detaches a
+//     handle; the registry keeps the process (and every phone session it serves)
+//     alive until the user stops it explicitly or the app shuts down.
+
+import 'dart:async';
+// `AppExitResponse` lives in `dart:ui`; `material.dart` does not re-export it.
+import 'dart:ui' show AppExitResponse;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import 'desktop_companion_locator.dart';
+import 'desktop_companion_platform.dart';
+import 'desktop_companion_session.dart';
+import 'desktop_remote_page.dart';
+
+/// One companion session per discovered bundle, for the life of the process.
+class DesktopCompanionRegistry {
+  DesktopCompanionRegistry._();
+
+  static final DesktopCompanionRegistry instance = DesktopCompanionRegistry._();
+
+  final Map<String, DesktopCompanionSession> _sessions =
+      <String, DesktopCompanionSession>{};
+  bool _observing = false;
+
+  /// Returns the session for [location], creating it on first use.
+  DesktopCompanionSession ensure(DesktopCompanionLocation location) {
+    _observeLifecycle();
+    final key = '${location.agentDirectory}\u0000${location.attachFile ?? ''}';
+    return _sessions.putIfAbsent(
+      key,
+      () => DesktopCompanionSession(location: location),
+    );
+  }
+
+  /// Sessions currently held. Exposed for diagnostics and tests.
+  Iterable<DesktopCompanionSession> get sessions => _sessions.values;
+
+  /// Stops everything this app started.
+  ///
+  /// Each session is stopped independently: one process that refuses to exit
+  /// must not prevent the others from being cancelled, or the app would leave
+  /// several orphans instead of one. The first failure is rethrown afterwards.
+  Future<void> stopAll() async {
+    final all = _sessions.values.toList(growable: false);
+    _sessions.clear();
+    Object? failure;
+    for (final session in all) {
+      try {
+        await session.stop();
+      } on Object catch (error) {
+        failure ??= error;
+      }
+    }
+    if (failure != null) throw failure;
+  }
+
+  /// Stops a single session, for an explicit "停止 companion" action.
+  Future<void> stop(DesktopCompanionSession session) async {
+    _sessions.removeWhere((_, value) => identical(value, session));
+    await session.stop();
+  }
+
+  /// App shutdown is the one path that must cancel the spawned process.
+  ///
+  /// The registry installs one observer for both signals, so a Node child cannot
+  /// survive the window as an orphan whichever way the app closes.
+  void _observeLifecycle() {
+    if (_observing) return;
+    _observing = true;
+    WidgetsBinding.instance.addObserver(
+      _DesktopCompanionLifecycleObserver(this),
+    );
+  }
+}
+
+class _DesktopCompanionLifecycleObserver with WidgetsBindingObserver {
+  _DesktopCompanionLifecycleObserver(this._registry);
+
+  final DesktopCompanionRegistry _registry;
+
+  /// Normal desktop exit: the engine reports `detached` before teardown. The
+  /// spawned Node child is cancelled here so it cannot outlive the window.
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.detached) {
+      unawaited(_registry.stopAll().catchError((Object _) {}));
+    }
+  }
+
+  /// Close-window path. Returning only after the children exited is what makes
+  /// this the supported cleanup hook rather than a fire-and-forget hint.
+  @override
+  Future<AppExitResponse> didRequestAppExit() async {
+    try {
+      await _registry.stopAll();
+    } on Object {
+      // Exiting must still proceed: report through the registry's diagnostics
+      // rather than blocking the app on a stuck process.
+    }
+    return AppExitResponse.exit;
+  }
+}
+
+/// Whether this build can show the local pairing entry.
+///
+/// Same gate as [RemoteComputerPage.isSupported]-style checks: a browser has no
+/// local process and no loopback socket.
+bool get isLocalCompanionSupported {
+  if (kIsWeb) return false;
+  return switch (defaultTargetPlatform) {
+    TargetPlatform.windows ||
+    TargetPlatform.macOS ||
+    TargetPlatform.linux => true,
+    _ => false,
+  };
+}
+
+/// Tools-tab entry: resolves the companion, then shows the pairing page.
+///
+/// Resolution is asynchronous (it probes the filesystem), so this widget owns
+/// the loading and missing states; the page itself only deals with a found
+/// bundle.
+class DesktopCompanionEntryPage extends StatefulWidget {
+  const DesktopCompanionEntryPage({super.key, this.environment});
+
+  /// Test seam: a fake machine description.
+  final Future<DesktopCompanionEnvironment>? environment;
+
+  @override
+  State<DesktopCompanionEntryPage> createState() =>
+      _DesktopCompanionEntryPageState();
+}
+
+class _DesktopCompanionEntryPageState extends State<DesktopCompanionEntryPage> {
+  DesktopCompanionResolution? _resolution;
+  DesktopCompanionSession? _session;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_resolve());
+  }
+
+  Future<void> _resolve() async {
+    try {
+      final env =
+          await (widget.environment ?? currentDesktopCompanionEnvironment());
+      final resolution = resolveDesktopCompanion(env);
+      if (!mounted) return;
+      setState(() {
+        _resolution = resolution;
+        final location = resolution.location;
+        _session = location == null
+            ? null
+            : DesktopCompanionRegistry.instance.ensure(location);
+      });
+    } on Object catch (error) {
+      if (!mounted) return;
+      setState(() => _error = error.toString());
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final session = _session;
+    final resolution = _resolution;
+    if (_error != null) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('本机配对')),
+        body: Center(
+          child: Padding(
+            padding: const EdgeInsets.all(24),
+            child: Text('无法检查本机 companion：$_error'),
+          ),
+        ),
+      );
+    }
+    if (resolution == null) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('本机配对')),
+        body: const Center(child: CircularProgressIndicator()),
+      );
+    }
+    final location = resolution.location;
+    if (location == null || session == null) {
+      // Discovery finished and found nothing: show the install/launch guidance.
+      // Returning a spinner here (the previous behaviour) hid the only message
+      // that tells the user what to do next.
+      return _MissingCompanionPage(resolution: resolution, onRetry: _resolve);
+    }
+    return DesktopRemotePage(session: session, resolution: resolution);
+  }
+}
+
+/// The "companion not installed" state, with the searched paths and a retry.
+class _MissingCompanionPage extends StatelessWidget {
+  const _MissingCompanionPage({
+    required this.resolution,
+    required this.onRetry,
+  });
+
+  final DesktopCompanionResolution resolution;
+  final Future<void> Function() onRetry;
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('本机配对')),
+      body: ListView(
+        padding: const EdgeInsets.all(24),
+        children: [
+          Icon(
+            Icons.extension_off,
+            size: 48,
+            color: Theme.of(context).colorScheme.error,
+          ),
+          const SizedBox(height: 16),
+          Text(
+            '未找到本机 companion',
+            style: Theme.of(context).textTheme.titleLarge,
+          ),
+          const SizedBox(height: 8),
+          Text(resolution.problem ?? '请重新安装 Studio，或手动启动安装目录下的 companion。'),
+          const SizedBox(height: 16),
+          FilledButton.icon(
+            onPressed: () => onRetry(),
+            icon: const Icon(Icons.refresh),
+            label: const Text('重新检测'),
+          ),
+          if (resolution.searched.isNotEmpty) ...[
+            const SizedBox(height: 16),
+            ExpansionTile(
+              title: const Text('已查找的位置'),
+              children: [
+                for (final path in resolution.searched)
+                  ListTile(dense: true, title: SelectableText(path)),
+              ],
+            ),
+          ],
+        ],
+      ),
+    );
+  }
+}
