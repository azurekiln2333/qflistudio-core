+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Row(
+              children: [
+                Expanded(
+                  child: Text(
+                    '本机已有会话',
+                    style: Theme.of(context).textTheme.titleMedium,
+                  ),
+                ),
+                TextButton.icon(
+                  onPressed: _controller.refreshSessions,
+                  icon: const Icon(Icons.refresh, size: 18),
+                  label: const Text('重新扫描'),
+                ),
+              ],
+            ),
+            const SizedBox(height: 4),
+            Text(
+              '来自 Herdr、Claude Code 与 Codex 的真实记录；只显示本机已存在的会话。',
+              style: Theme.of(context).textTheme.bodySmall,
+            ),
+            const SizedBox(height: 12),
+            if (sessions.isEmpty)
+              _emptySessions(context)
+            else
+              for (final session in sessions) _sessionTile(context, session),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _emptySessions(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        const Text('没有找到已有会话。'),
+        const SizedBox(height: 8),
+        Wrap(
+          spacing: 8,
+          children: [
+            FilledButton.tonalIcon(
+              onPressed: () =>
+                  _showMessage('请在 Claude Code 或 Herdr 中新建会话，完成后回到本页刷新。'),
+              icon: const Icon(Icons.add),
+              label: const Text('新建 Claude 会话'),
+            ),
+            OutlinedButton.icon(
+              onPressed: () => _showMessage('Herdr 会话请在 Herdr 中创建后回到本页刷新。'),
+              icon: const Icon(Icons.terminal),
+              label: const Text('在 Herdr 中创建'),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
+
+  Widget _sessionTile(BuildContext context, DesktopDiscoveredSession session) {
+    final open = _controller.openSessionId == session.id;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        ListTile(
+          dense: true,
+          leading: Icon(switch (session.kind) {
+            'herdr' => Icons.terminal,
+            'codex' => Icons.smart_toy_outlined,
+            _ => Icons.chat_bubble_outline,
+          }),
+          title: Text(session.title),
+          subtitle: Text(
+            [
+              session.kindLabel,
+              if (session.origin != null) _originLabel(session.origin!),
+              if (session.subtitle != null) session.subtitle!,
+              if (session.bound) '本次已连接',
+            ].join(' · '),
+          ),
+          trailing: session.canOpen
+              ? TextButton(
+                  onPressed: open
+                      ? _controller.closeSessionView
+                      : () => _controller.openSession(session.id),
+                  child: Text(open ? '收起' : '查看'),
+                )
+              : const Tooltip(message: '本机无法打开此会话', child: Text('不可用')),
+        ),
+        if (open) _sessionOutput(context),
+      ],
+    );
+  }
+
+  String _originLabel(String origin) => switch (origin) {
+    'pane' => '实时屏幕',
+    'history' => '历史记录',
+    'thread' => 'Codex 会话',
+    _ => origin,
+  };
+
+  Widget _sessionOutput(BuildContext context) {
+    final lines = _controller.openSessionLines;
+    return Container(
+      margin: const EdgeInsets.only(left: 16, right: 16, bottom: 12),
+      padding: const EdgeInsets.all(12),
+      constraints: const BoxConstraints(maxHeight: 260),
+      decoration: BoxDecoration(
+        color: Theme.of(context).colorScheme.surfaceContainerHighest,
+        borderRadius: BorderRadius.circular(8),
+      ),
+      child: lines.isEmpty
+          ? const Text('正在读取会话内容…')
+          : ListView(
+              shrinkWrap: true,
+              children: [
+                for (final line in lines)
+                  SelectableText(
+                    line.text,
+                    style: const TextStyle(
+                      fontFamily: 'monospace',
+                      fontSize: 12,
+                    ),
+                  ),
+              ],
+            ),
+    );
+  }
+}
