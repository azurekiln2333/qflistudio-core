+// Browser fallback for desktop companion discovery.
+//
+// A web build has no filesystem and no local companion, so discovery reports a
+// truthful "unsupported" state instead of an empty search list that would look
+// like a missing installation.
+
+import 'desktop_companion_locator.dart';
+
+/// A browser cannot host a local companion.
+Future<DesktopCompanionEnvironment> currentDesktopCompanionEnvironment() async {
+  return const DesktopCompanionEnvironment(
+    operatingSystem: 'web',
+    environment: <String, String>{},
+    executablePath: '',
+    supportDirectory: null,
+    isFile: _never,
+    isDirectory: _never,
+    readFile: _noContent,
+  );
+}
+
+bool _never(String path) => false;
+
+String? _noContent(String path) => null;
+
+/// A browser cannot read the companion's attach file.
+String? readDesktopCompanionFile(String path) => null;
