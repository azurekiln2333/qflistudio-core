diff --git a/lib/remote_control/desktop/desktop_companion_link_io.dart b/lib/remote_control/desktop/desktop_companion_link_io.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/desktop/desktop_companion_link_io.dart
@@ -0,0 +1,303 @@
+// Native companion link: spawns or attaches to the Node sidecar over loopback.
+//
+// Selected by `desktop_companion_link.dart` on platforms with `dart:io`; the
+// browser resolves the stub instead, so nothing here is reachable from a web
+// build.
+//
+// Two attachment modes, both loopback-only:
+//
+//   * **spawn** — the app starts `node src/agent/main.ts --sidecar --port-file
+//     <app temp file>` itself, waits for `{"type":"listening","port":N}` on
+//     stdout, then reads `{port, token}` from that file before connecting. The
+//     token is never printed: stdout is inherited by logs and CI output. Used on
+//     Windows and Linux, where the installer carries the companion.
+//   * **attach** — the app reads `{port, token}` from the companion's published
+//     attach file and connects to `127.0.0.1:<port>`, sending
+//     `{"type":"auth","token":"..."}` first. Used on macOS, where the app
+//     sandbox forbids spawning the bundled Node binary.
+//
+// The port is never treated as an identity: every attach path presents the
+// token, and the companion drops unauthenticated sockets.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+// `ProcessSupervisor` lives in `lib/services`, two levels up from this file.
+import '../../services/process_supervisor.dart';
+
+import 'desktop_companion_channel.dart';
+import 'desktop_companion_locator.dart';
+
+/// A running companion the app started, kept alive across page visits.
+class SpawnedDesktopCompanion {
+  SpawnedDesktopCompanion({
+    required ManagedProcess process,
+    required this.port,
+    required this.token,
+    this.scratchDirectory,
+  }) : _process = process;
+
+  final ManagedProcess _process;
+  final int port;
+  final String token;
+
+  /// Per-run directory holding the attach file; removed with the process.
+  final String? scratchDirectory;
+
+  /// Cancels the child and removes its attach document. Only the session scope
+  /// calls this.
+  Future<void> stop() async {
+    try {
+      await _process.cancel();
+    } finally {
+      final directory = scratchDirectory;
+      if (directory != null) {
+        await Directory(directory)
+            .delete(recursive: true)
+            .catchError((Object _) => Directory(directory));
+      }
+    }
+  }
+}
+
+/// Starts the companion and returns the channel that owns it.
+class SpawnResult {
+  const SpawnResult({required this.channel, required this.spawned});
+
+  final DesktopCompanionChannel channel;
+  final SpawnedDesktopCompanion spawned;
+}
+
+/// Spawns or attaches, returning a channel ready for the controller.
+class NativeDesktopCompanionLink {
+  NativeDesktopCompanionLink({ProcessSupervisor? supervisor})
+    : _supervisor = supervisor ?? ProcessSupervisor();
+
+  final ProcessSupervisor _supervisor;
+
+  /// Starts the companion and returns both the channel and the owned process.
+  ///
+  /// The caller (the session scope, never the page) is responsible for the
+  /// returned [SpawnResult.spawned] lifetime; keeping it separate means a page
+  /// cannot cancel a process by closing its socket.
+  Future<SpawnResult> spawnAndOwn(
+    DesktopCompanionLocation location, {
+    Duration readyTimeout = const Duration(seconds: 20),
+  }) async {
+    final executable = location.nodeExecutable;
+    if (executable == null) {
+      throw StateError('未找到 Node 运行时，无法启动本机 companion。');
+    }
+
+    // Per-run private directory for the attach document. `systemTemp` is
+    // per-user on all three platforms; the directory is 0700 and the file 0600
+    // (written by the companion), and both are removed when the session stops.
+    final scratch = await Directory.systemTemp.createTemp('qfli-companion-');
+    final portFile = '${scratch.path}${Platform.pathSeparator}sidecar.json';
+
+    final process = await _supervisor
+        .start(
+          executable,
+          <String>['src/agent/main.ts', '--sidecar', '--port-file', portFile],
+          workingDirectory: location.agentDirectory,
+          // Inherit the parent environment so a packaged Node and the user's tool
+          // paths (Herdr/Claude/Codex) resolve exactly as they would in a shell.
+          includeParentEnvironment: true,
+          runInShell: false,
+        )
+        .catchError((Object error) async {
+          await scratch
+              .delete(recursive: true)
+              .catchError((Object _) => scratch);
+          throw error;
+        });
+
+    final ready = Completer<Map<String, dynamic>>();
+    final decoder = CompanionFrameDecoder();
+    final subscription = process.stdout
+        .transform(utf8.decoder)
+        .listen(
+          (chunk) {
+            for (final frame in decoder.add(chunk)) {
+              if (!ready.isCompleted &&
+                  frame['type'] == 'listening' &&
+                  frame['port'] is num) {
+                ready.complete(frame);
+              }
+            }
+          },
+          onError: (Object error) {
+            if (!ready.isCompleted) ready.completeError(error);
+          },
+          onDone: () {
+            if (!ready.isCompleted) {
+              ready.completeError(StateError('本机 companion 未启动：后台服务已退出。'));
+            }
+          },
+        );
+
+    Map<String, dynamic> listening;
+    try {
+      listening = await ready.future.timeout(
+        readyTimeout,
+        onTimeout: () {
+          unawaited(subscription.cancel());
+          unawaited(process.cancel());
+          throw StateError('本机 companion 未在 ${readyTimeout.inSeconds} 秒内就绪。');
+        },
+      );
+    } catch (_) {
+      await subscription.cancel();
+      await process.cancel();
+      rethrow;
+    }
+    unawaited(subscription.cancel());
+
+    final port = (listening['port'] as num).toInt();
+    // The token comes from the 0600 file the companion wrote, not from stdout.
+    final token =
+        DesktopCompanionAttachPoint.tryParse(
+          await _readFile(portFile),
+          source: portFile,
+        )?.token ??
+        '';
+    if (token.isEmpty) {
+      await process.cancel();
+      await scratch.delete(recursive: true).catchError((Object _) => scratch);
+      throw StateError('本机 companion 未写出连接凭据，已停止该进程。');
+    }
+    // The socket connect is outside the ready block on purpose: a failure here
+    // (token rejected, port gone) must not leave the child running. Whichever
+    // path throws, the process this call started is cancelled before rethrow.
+    final DesktopCompanionChannel channel;
+    try {
+      channel = await _connectSocket(port, token: token);
+    } on Object {
+      await process.cancel();
+      await scratch.delete(recursive: true).catchError((Object _) => scratch);
+      rethrow;
+    }
+    return SpawnResult(
+      channel: channel,
+      spawned: SpawnedDesktopCompanion(
+        process: process,
+        port: port,
+        token: token,
+        scratchDirectory: scratch.path,
+      ),
+    );
+  }
+
+  /// Reads the companion's attach document.
+  ///
+  /// The companion writes it asynchronously right after announcing its port, so
+  /// a short retry avoids a startup race without weakening the token check.
+  Future<String?> _readFile(String path) async {
+    for (var attempt = 0; attempt < 20; attempt++) {
+      try {
+        return await File(path).readAsString();
+      } on FileSystemException {
+        await Future<void>.delayed(const Duration(milliseconds: 50));
+      }
+    }
+    return null;
+  }
+
+  /// Starts the companion and returns only its channel.
+  ///
+  /// Deprecated for page use: the returned channel does not own the process, so
+  /// nothing can stop it. Prefer [spawnAndOwn] with a session scope.
+  Future<DesktopCompanionChannel> spawn(
+    DesktopCompanionLocation location, {
+    Duration readyTimeout = const Duration(seconds: 20),
+  }) async {
+    final result = await spawnAndOwn(location, readyTimeout: readyTimeout);
+    return result.channel;
+  }
+
+  /// Attaches to a companion started outside this app.
+  Future<DesktopCompanionChannel> attach(
+    DesktopCompanionAttachPoint attachPoint,
+  ) async {
+    return _connectSocket(attachPoint.port, token: attachPoint.token);
+  }
+
+  Future<DesktopCompanionChannel> _connectSocket(
+    int port, {
+    required String token,
+  }) async {
+    final socket = await Socket.connect(
+      InternetAddress.loopbackIPv4,
+      port,
+      timeout: const Duration(seconds: 5),
+    );
+    final channel = _SocketDesktopCompanionChannel(socket: socket);
+    // The companion requires the credential as the very first frame; there is
+    // no request that succeeds before it.
+    if (token.isNotEmpty) {
+      channel.send(<String, dynamic>{'type': 'auth', 'token': token});
+    }
+    return channel;
+  }
+}
+
+/// Loopback socket channel.
+///
+/// It never owns a process: closing it closes the socket only, so a page leaving
+/// the screen cannot kill the sessions a phone is using.
+class _SocketDesktopCompanionChannel implements DesktopCompanionChannel {
+  _SocketDesktopCompanionChannel({required Socket socket}) : _socket = socket {
+    _subscription = _socket
+        .cast<List<int>>()
+        .transform(utf8.decoder)
+        .listen(
+          (chunk) {
+            for (final frame in _decoder.add(chunk)) {
+              if (!_frames.isClosed) _frames.add(frame);
+            }
+          },
+          onError: _fail,
+          onDone: _fail,
+          cancelOnError: false,
+        );
+  }
+
+  final Socket _socket;
+  final CompanionFrameDecoder _decoder = CompanionFrameDecoder();
+  final StreamController<Map<String, dynamic>> _frames =
+      StreamController<Map<String, dynamic>>.broadcast();
+  final Completer<void> _closed = Completer<void>();
+  late final StreamSubscription<String> _subscription;
+  bool _done = false;
+
+  @override
+  Stream<Map<String, dynamic>> get frames => _frames.stream;
+
+  @override
+  Future<void> get closed => _closed.future;
+
+  @override
+  void send(Map<String, dynamic> frame) {
+    if (_done) return;
+    try {
+      _socket.write(CompanionFrameDecoder.encodeFrame(frame));
+    } on Object {
+      _fail();
+    }
+  }
+
+  void _fail([Object? _]) {
+    if (_done) return;
+    _done = true;
+    unawaited(_subscription.cancel());
+    if (!_frames.isClosed) unawaited(_frames.close());
+    if (!_closed.isCompleted) _closed.complete();
+  }
+
+  @override
+  Future<void> close() async {
+    _fail();
+    await _socket.close().catchError((Object _) {});
+  }
+}
