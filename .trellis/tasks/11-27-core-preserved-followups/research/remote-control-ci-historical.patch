+#!/usr/bin/env python3
+"""Structural checks for the migrated remote-control module.
+
+Local use is allowed because this is static inspection, not a test run:
+
+    python tool/ci/check_remote_control.py          # check the package
+    python tool/ci/check_remote_control.py --list   # print every check
+
+Exit code 1 means at least one invariant broke, and each failure names the
+file it read. The cloud workflow runs the same script before `flutter analyze`,
+so a local pass and a pipeline pass assert the same facts.
+
+The checks are deliberately mechanical. They prove *structure*, not behaviour:
+they cannot tell you that a pairing code works. Behaviour is covered by
+`test/remote_control/` and by the runtime checks documented in the phase report.
+
+Standard library only, Python 3.8+.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import re
+import sys
+from pathlib import Path
+from typing import List, Tuple
+
+ROOT = Path(__file__).resolve().parents[2]
+
+# Source revision the module was migrated from. Recorded in the module README,
+# `lib/remote_control/remote_computer_page.dart` and `vendor/xterm/PROVENANCE.md`.
+SOURCE_HEAD = "49b2aac781858929a19307faeb808b83f8154410"
+
+MODULE_DIR = ROOT / "lib" / "remote_control"
+MODULE_ENTRY = MODULE_DIR / "remote_computer_page.dart"
+MODULE_README = MODULE_DIR / "README.md"
+
+# Layers the design keeps from the source package.
+REQUIRED_MODULE_FILES = (
+    "models/herdr.dart",
+    "models/pairing_uri.dart",
+    "models/protocol.dart",
+    "pages/codex_screen.dart",
+    "pages/herdr_screen.dart",
+    "pages/herdr_terminal_screen.dart",
+    "pages/home_screen.dart",
+    "pages/pair_screen.dart",
+    "pages/session_screen.dart",
+    "remote_computer_page.dart",
+    "state/codex_catalog.dart",
+    "state/codex_thread_view.dart",
+    "state/herdr_controller.dart",
+    "state/remote_controller.dart",
+    "state/remote_store.dart",
+    "state/remote_store_backend.dart",
+    "state/remote_store_backend_io.dart",
+    "state/remote_store_backend_stub.dart",
+    "state/session_view.dart",
+    "theme/remote_theme.dart",
+    "transport/relay_connector.dart",
+    "transport/relay_socket.dart",
+    "transport/relay_socket_io.dart",
+    "transport/relay_socket_stub.dart",
+    "widgets/remote_terminal_pane.dart",
+)
+
+REQUIRED_TEST_FILES = (
+    "test/remote_control/codex_test.dart",
+    "test/remote_control/herdr_direct_input_test.dart",
+    "test/remote_control/herdr_test.dart",
+    "test/remote_control/pairing_uri_test.dart",
+    "test/remote_control/remote_controller_test.dart",
+    "test/remote_control/terminal_test.dart",
+    "test/support/codex_fixture.dart",
+    "test/support/fake_relay.dart",
+    "test/support/remote_control_app.dart",
+)
+
+# Byte-for-byte copies of the source fixtures. A changed byte means the ported
+# Herdr assertions no longer describe the recorded terminal output.
+FIXTURE_MD5 = {
+    "test/fixtures/herdr_pS_visible_ansi.txt": "e82f26e9cdb098f521bf9fe19f0585ae",
+    "test/fixtures/herdr_pZ_visible_ansi.txt": "d960095ed7067cdc06dd6ffbc9359fe7",
+    "test/fixtures/herdr_wrap_proof.txt": "a07a81e4bba0535d3214cb15228126e7",
+}
+
+# Substrings that would make *production* code depend on the original
+# CloudTerminal checkout. Test fixture payloads legitimately carry Windows paths
+# recorded from the source machine (for example a Herdr `cwd`), so this check
+# only reads `lib/`.
+FORBIDDEN_SUBSTRINGS = (
+    "package:cloudterminal/",
+    "package:cloudterminal\\",
+    "/example/source/cloudterminal",
+    "C:\\example\\source\\cloudterminal",
+    "apps/cloudterminal_windows/",
+)
+
+# Dart files that must not create a second application shell.
+SHELL_MARKERS = ("MaterialApp(", "CupertinoApp(", "WidgetsApp(")
+
+# Modules under `lib/` that the remote-control module must not import, because
+# importing them would make the module depend on unrelated Studio features.
+FORBIDDEN_IMPORTS = (
+    "vibe_coding/",
+    "session/agent_session.dart",
+    "store/project_store.dart",
+    "pages/tools_grid.dart",
+    "pages/home_page.dart",
+)
+
+CHECKS: List[Tuple[str, str]] = []
+
+
+def check(label: str, description: str):
+    def register(fn):
+        CHECKS.append((label, description))
+        fn.label = label
+        return fn
+
+    return register
+
+
+def fail(message: str, failures: List[str]) -> None:
+    failures.append(message)
+
+
+def read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8")
+
+
+def strip_comments(source: str) -> str:
+    """Drop line comments so prose about `MaterialApp` is not a code hit."""
+    out = []
+    for line in source.splitlines():
+        index = line.find("//")
+        out.append(line if index < 0 else line[:index])
+    return "\n".join(out)
+
+
+@check("module-layout", "every migrated layer file and the single entry exist")
+def module_layout(failures: List[str]) -> None:
+    for rel in REQUIRED_MODULE_FILES:
+        path = MODULE_DIR / rel
+        if not path.is_file():
+            fail(f"lib/remote_control/{rel}: missing", failures)
+    if not MODULE_README.is_file():
+        fail("lib/remote_control/README.md: missing", failures)
+    if not MODULE_ENTRY.is_file():
+        fail("lib/remote_control/remote_computer_page.dart: missing", failures)
+
+
+@check("single-entry", "the page exposes exactly one mount point plus the capability gate")
+def single_entry(failures: List[str]) -> None:
+    if not MODULE_ENTRY.is_file():
+        return
+    source = MODULE_ENTRY.read_text(encoding="utf-8")
+    for needle in (
+        "class RemoteComputerPage extends StatefulWidget",
+        "static bool get isSupported",
+        "static Future<void> open(BuildContext context)",
+    ):
+        if needle not in source:
+            fail(
+                f"remote_computer_page.dart: expected `{needle}` for the host entry",
+                failures,
+            )
+    if SOURCE_HEAD not in source:
+        fail(
+            "remote_computer_page.dart: provenance header lost the source HEAD "
+            f"{SOURCE_HEAD}",
+            failures,
+        )
+
+
+@check("no-second-shell", "no module file builds its own application shell")
+def no_second_shell(failures: List[str]) -> None:
+    for path in sorted(MODULE_DIR.rglob("*.dart")):
+        code = strip_comments(path.read_text(encoding="utf-8"))
+        for marker in SHELL_MARKERS:
+            if marker in code:
+                fail(
+                    f"{path.relative_to(ROOT).as_posix()}: creates `{marker}`; "
+                    "the module must inherit the host MaterialApp",
+                    failures,
+                )
+
+
+@check("no-source-deps", "no production file points at the CloudTerminal checkout")
+def no_source_deps(failures: List[str]) -> None:
+    targets = sorted(MODULE_DIR.rglob("*.dart"))
+    for path in targets:
+        text = path.read_text(encoding="utf-8")
+        for needle in FORBIDDEN_SUBSTRINGS:
+            if needle in text:
+                fail(
+                    f"{path.relative_to(ROOT).as_posix()}: contains `{needle}`",
+                    failures,
+                )
+
+
+@check("no-cross-feature-imports", "the module does not import unrelated Studio features")
+def no_cross_feature_imports(failures: List[str]) -> None:
+    pattern = re.compile(r"""^\s*(?:import|export)\s+['"]package:qfli_studio_core/([^'"]+)['"]""", re.M)
+    for path in sorted(MODULE_DIR.rglob("*.dart")):
+        for match in pattern.finditer(path.read_text(encoding="utf-8")):
+            target = match.group(1)
+            if target.startswith("remote_control/"):
+                continue
+            for forbidden in FORBIDDEN_IMPORTS:
+                if target.startswith(forbidden):
+                    fail(
+                        f"{path.relative_to(ROOT).as_posix()}: imports "
+                        f"`{target}`, which is outside this module",
+                        failures,
+                    )
+
+
+@check("xterm-vendor", "the patched xterm fork resolves inside this package")
+def xterm_vendor(failures: List[str]) -> None:
+    for rel in ("vendor/xterm/LICENSE", "vendor/xterm/PROVENANCE.md", "vendor/xterm/pubspec.yaml"):
+        if not (ROOT / rel).is_file():
+            fail(f"{rel}: missing; the patched renderer must ship with its licence", failures)
+    if not (ROOT / "vendor" / "xterm" / "lib").is_dir():
+        fail("vendor/xterm/lib: missing", failures)
+    pubspec = read("pubspec.yaml")
+    if "xterm:" not in pubspec:
+        fail("pubspec.yaml: no `xterm` dependency", failures)
+    if "path: vendor/xterm" not in pubspec:
+        fail(
+            "pubspec.yaml: `xterm` is not overridden to `path: vendor/xterm`; "
+            "a build would take the unpatched pub.dev package",
+            failures,
+        )
+    provenance = read("vendor/xterm/PROVENANCE.md")
+    if SOURCE_HEAD not in provenance:
+        fail(
+            f"vendor/xterm/PROVENANCE.md: does not pin the source HEAD {SOURCE_HEAD}",
+            failures,
+        )
+
+
+@check("fixtures", "recorded Herdr fixtures still match the source bytes")
+def fixtures(failures: List[str]) -> None:
+    for rel, expected in FIXTURE_MD5.items():
+        path = ROOT / rel
+        if not path.is_file():
+            fail(f"{rel}: missing", failures)
+            continue
+        digest = hashlib.md5(path.read_bytes()).hexdigest()
+        if digest != expected:
+            fail(f"{rel}: md5 {digest} != recorded {expected}", failures)
+
+
+@check("tests", "the ported suites and their helpers are present")
+def tests(failures: List[str]) -> None:
+    for rel in REQUIRED_TEST_FILES:
+        if not (ROOT / rel).is_file():
+            fail(f"{rel}: missing", failures)
+    suite = "\n".join(
+        p.read_text(encoding="utf-8") for p in sorted((ROOT / "test" / "remote_control").glob("*_test.dart"))
+    )
+    for needle in ("testWidgets(", "expect("):
+        if needle not in suite:
+            fail(f"test/remote_control: no `{needle}` found; the port lost assertions", failures)
+    if "package:cloudterminal/" in suite:
+        fail("test/remote_control: still imports package:cloudterminal", failures)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--list", action="store_true", help="print the check list and exit")
+    args = parser.parse_args()
+
+    if args.list:
+        for label, description in CHECKS:
+            print(f"{label:24} {description}")
+        return 0
+
+    failures: List[str] = []
+    for _label, _description in CHECKS:
+        # Registered functions are looked up by label below.
+        pass
+    for fn in _registered():
+        fn(failures)
+
+    if failures:
+        print(f"{len(failures)} structural problem(s):", file=sys.stderr)
+        for line in failures:
+            print(f"  {line}", file=sys.stderr)
+        return 1
+
+    print(f"{len(CHECKS)} structural checks passed")
+    return 0
+
+
+def _registered():
+    return [obj for obj in globals().values() if callable(obj) and hasattr(obj, "label")]
+
+
+if __name__ == "__main__":
+    sys.exit(main())
