+#!/usr/bin/env bash
+# Install the pinned Flutter OHOS SDK used by the remote-control workflows.
+#
+# Usage: bash tool/ci/setup_flutter.sh <target-directory>
+#
+# Copied from the release CI of qflistudio (`tool/ci/setup_flutter.sh`) so both
+# repositories install the same SDK from the same tag and verify the same
+# commit. Keep the three constants below identical in both copies.
+#
+# Why the fork and not upstream Flutter: this package references
+# `TargetPlatform.ohos` (for example `lib/config/client_platform.dart`), an enum
+# value that only exists in the HarmonyOS fork. An upstream SDK fails to
+# compile it, so "standard Flutter stable" is not a valid substitute here.
+set -euo pipefail
+
+FLUTTER_REPOSITORY="https://gitcode.com/openharmony-tpc/flutter_flutter.git"
+FLUTTER_TAG="3.27.5-ohos-1.0.1"
+FLUTTER_COMMIT="12587c79e88aacf3172a84e536f226457d037594"
+
+if [ "$#" -ne 1 ]; then
+  echo "::error::usage: setup_flutter.sh <target-directory>"
+  exit 2
+fi
+
+target="$1"
+if command -v cygpath >/dev/null 2>&1; then
+  target="$(cygpath -u "$target")"
+fi
+
+installed_commit() {
+  git -C "$target" rev-parse HEAD 2>/dev/null || true
+}
+
+if [ -x "$target/bin/flutter" ] && [ "$(installed_commit)" = "$FLUTTER_COMMIT" ]; then
+  echo "Flutter SDK already present at $FLUTTER_COMMIT"
+else
+  cloned=0
+  for attempt in 1 2 3; do
+    rm -rf "$target"
+    if git clone --depth 1 --branch "$FLUTTER_TAG" "$FLUTTER_REPOSITORY" "$target"; then
+      cloned=1
+      break
+    fi
+    echo "::warning::Flutter SDK clone attempt $attempt failed"
+    sleep $((attempt * 15))
+  done
+  if [ "$cloned" -ne 1 ]; then
+    echo "::error::Could not clone $FLUTTER_REPOSITORY at $FLUTTER_TAG"
+    exit 1
+  fi
+fi
+
+actual="$(installed_commit)"
+if [ "$actual" != "$FLUTTER_COMMIT" ]; then
+  echo "::error::Flutter SDK commit is '$actual', expected $FLUTTER_COMMIT"
+  exit 1
+fi
+
+# The flutter tool derives its version from the tag. A shallow clone must keep it.
+if ! git -C "$target" describe --tags --exact-match >/dev/null 2>&1; then
+  git -C "$target" fetch --depth 1 origin "refs/tags/$FLUTTER_TAG:refs/tags/$FLUTTER_TAG"
+fi
+
+echo "Flutter SDK $FLUTTER_TAG ($FLUTTER_COMMIT) ready in $target"
