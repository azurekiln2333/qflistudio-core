@@ -0,0 +1,253 @@
+# Cloud verification for the migrated remote-control module.
+#
+# The module lives on `remote/cloudterminal-core`, not on `main`, so every job
+# checks that ref out explicitly and refuses to run against `main`.
+#
+# Toolchain: the HarmonyOS fork of Flutter, pinned by tag and commit in
+# `tool/ci/setup_flutter.sh`. Upstream Flutter cannot analyse this package:
+# `lib/config/client_platform.dart` and the other hosts below reference
+# `TargetPlatform.ohos`, an enum value that only exists in the fork. A job that
+# installs upstream stable would fail at analysis, so do not substitute one.
+#
+# `flutter config --no-enable-ohos` keeps `flutter pub get` from preparing an
+# `ohos/` project, which needs the HarmonyOS SDK; this package has no `ohos/`
+# directory and no job here installs that SDK. The flag exists in the fork
+# (`packages/flutter_tools/lib/src/features.dart`, `configSetting: 'enable-ohos'`).
+#
+# Every `uses:` is pinned to a 40-character commit SHA. All three pinned actions
+# declare `runs.using: node24`, so no Node-20 deprecation warning is expected.
+
+name: Remote control module
+
+on:
+  push:
+    branches:
+      - remote/cloudterminal-core
+    paths:
+      - "lib/remote_control/**"
+      - "test/remote_control/**"
+      - "test/support/**"
+      - "test/fixtures/**"
+      - "vendor/xterm/**"
+      - "pubspec.yaml"
+      - "pubspec.lock"
+      - "analysis_options.yaml"
+      - "tool/ci/**"
+      - ".github/workflows/remote-control.yml"
+  pull_request:
+    paths:
+      - "lib/remote_control/**"
+      - "test/remote_control/**"
+      - "test/support/**"
+      - "test/fixtures/**"
+      - "vendor/xterm/**"
+      - "pubspec.yaml"
+      - "pubspec.lock"
+      - "analysis_options.yaml"
+      - "tool/ci/**"
+      - ".github/workflows/remote-control.yml"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: remote-control-core-${{ github.ref }}
+  cancel-in-progress: true
+
+defaults:
+  run:
+    shell: bash
+
+env:
+  FLUTTER_TAG: "3.27.5-ohos-1.0.1"
+  FLUTTER_COMMIT: "12587c79e88aacf3172a84e536f226457d037594"
+  # The reviewed migration commit on `remote/cloudterminal-core`. Update it in
+  # the same commit that amends the branch; a stale value here is a real failure,
+  # because the runner then verifies code that is not the reviewed code.
+  PAIRED_REF: "remote/cloudterminal-core"
+  PAIRED_COMMIT: "b8d08a6703afd480374807b11e0ff16d1276e246"
+
+jobs:
+  structure:
+    name: Structure and provenance
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - name: Check out the paired core revision
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ env.PAIRED_COMMIT }}
+          persist-credentials: false
+
+      - name: Verify the pairing
+        env:
+          EXPECTED: ${{ env.PAIRED_COMMIT }}
+        run: |
+          set -euo pipefail
+          # The module file is the marker: it does not exist on `main`.
+          test -f lib/remote_control/remote_computer_page.dart || {
+            echo "::error::checked-out tree has no lib/remote_control; the paired ref was not used"
+            exit 1
+          }
+          actual="$(git rev-parse HEAD)"
+          if [ "$actual" != "$EXPECTED" ]; then
+            echo "::error::checked out $actual, expected the reviewed pairing $EXPECTED"
+            exit 1
+          fi
+          {
+            echo "### Remote control module"
+            echo ""
+            echo "| Field | Value |"
+            echo "| --- | --- |"
+            echo "| ref | \`${PAIRED_REF}\` |"
+            echo "| commit | \`$actual\` |"
+            echo "| Flutter | \`$FLUTTER_TAG\` (\`$FLUTTER_COMMIT\`) |"
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Check module structure and vendored renderer
+        run: python3 tool/ci/check_remote_control.py
+
+      - name: Check the workflow pins
+        run: |
+          set -euo pipefail
+          workflow=.github/workflows/remote-control.yml
+          test -f "$workflow"
+          # Every action must be a full commit SHA; a moving tag is not reproducible.
+          while IFS= read -r ref; do
+            case "$ref" in
+              ./*) continue ;; # local composite actions are reviewed in-tree
+            esac
+            sha="${ref##*@}"
+            printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$' || {
+              echo "::error::unpinned action ref: $ref"
+              exit 1
+            }
+          done < <(sed -n 's/^[[:space:]]*uses:[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$workflow")
+          # The pairing must never silently fall back to a moving branch.
+          ! grep -Eq 'ref:[[:space:]]*(main|master)[[:space:]]*$' "$workflow"
+
+  analyze:
+    name: Analyze the package on the pinned SDK
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    steps:
+      - name: Check out the paired core revision
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ env.PAIRED_COMMIT }}
+          persist-credentials: false
+
+      - name: Restore the pinned Flutter SDK
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ${{ runner.temp }}/flutter
+          key: flutter-ohos-12587c79e88a-${{ runner.os }}-${{ runner.arch }}-core
+
+      - name: Install the pinned Flutter SDK
+        run: |
+          set -euo pipefail
+          bash tool/ci/setup_flutter.sh "$RUNNER_TEMP/flutter"
+          echo "$RUNNER_TEMP/flutter/bin" >> "$GITHUB_PATH"
+
+      - name: Resolve packages
+        run: |
+          set -euo pipefail
+          flutter config --no-analytics
+          flutter config --no-enable-ohos
+          flutter --version
+          flutter pub get
+          if ! git diff --quiet -- pubspec.lock; then
+            echo "::warning::flutter pub get rewrote pubspec.lock on the runner"
+            git --no-pager diff --stat -- pubspec.lock
+          fi
+
+      - name: Format check
+        run: |
+          set -euo pipefail
+          dart format --output=none --set-exit-if-changed \
+            lib/remote_control test/remote_control \
+            test/support/remote_control_app.dart test/support/fake_relay.dart \
+            test/support/codex_fixture.dart
+
+      - name: Analyze
+        run: flutter analyze --no-pub
+
+      - name: Lint the module documentation
+        run: python3 scripts/ste-lint-zh.py lib/remote_control/README.md
+
+  test:
+    name: Module regression suites
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    needs: analyze
+    steps:
+      - name: Check out the paired core revision
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ env.PAIRED_COMMIT }}
+          persist-credentials: false
+
+      - name: Restore the pinned Flutter SDK
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ${{ runner.temp }}/flutter
+          key: flutter-ohos-12587c79e88a-${{ runner.os }}-${{ runner.arch }}-core
+
+      - name: Install the pinned Flutter SDK
+        run: |
+          set -euo pipefail
+          bash tool/ci/setup_flutter.sh "$RUNNER_TEMP/flutter"
+          echo "$RUNNER_TEMP/flutter/bin" >> "$GITHUB_PATH"
+
+      - name: Resolve packages
+        run: |
+          set -euo pipefail
+          flutter config --no-analytics
+          flutter config --no-enable-ohos
+          flutter pub get
+
+      # `herdr_test.dart` reads `test/fixtures/<name>` through `File(...)`, so the
+      # suite must start from the package root.
+      - name: Run the remote-control suites
+        run: |
+          set -euo pipefail
+          flutter test test/remote_control --reporter expanded
+
+  test-package:
+    name: Whole-package suites
+    runs-on: ubuntu-24.04
+    timeout-minutes: 90
+    needs: analyze
+    steps:
+      - name: Check out the paired core revision
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ env.PAIRED_COMMIT }}
+          persist-credentials: false
+
+      - name: Restore the pinned Flutter SDK
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ${{ runner.temp }}/flutter
+          key: flutter-ohos-12587c79e88a-${{ runner.os }}-${{ runner.arch }}-core
+
+      - name: Install the pinned Flutter SDK
+        run: |
+          set -euo pipefail
+          bash tool/ci/setup_flutter.sh "$RUNNER_TEMP/flutter"
+          echo "$RUNNER_TEMP/flutter/bin" >> "$GITHUB_PATH"
+
+      - name: Resolve packages
+        run: |
+          set -euo pipefail
+          flutter config --no-analytics
+          flutter config --no-enable-ohos
+          flutter pub get
+
+      # Adding a dependency to the module can break a host suite even when the
+      # module suite passes, so the whole package runs too.
+      - name: Run every suite in the package
+        run: |
+          set -euo pipefail
+          flutter test --reporter expanded
