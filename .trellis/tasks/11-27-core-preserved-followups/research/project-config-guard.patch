diff --git a/lib/services/project_config_guard.dart b/lib/services/project_config_guard.dart
new file mode 100644
--- /dev/null
+++ b/lib/services/project_config_guard.dart
@@ -0,0 +1,154 @@
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+/// Protects project configuration from managed deletion or relocation.
+/// Reading and editing configuration are outside this policy.
+abstract final class ProjectConfigGuard {
+  static const Set<String> protectedNames = {
+    '.git',
+    '.gitignore',
+    '.gitattributes',
+    '.gitmodules',
+    '.editorconfig',
+    '.trellis',
+    '.agents',
+    '.codex',
+    '.claude',
+    '.qfli',
+    '.vscode',
+    '.idea',
+    'agents.md',
+    'claude.md',
+  };
+
+  static const String protectedMessage = '项目配置受保护，不能删除或移动';
+  static const String invalidPathMessage = '删除路径不在项目目录内';
+  static const String inspectionMessage = '无法确认项目配置，已取消删除';
+
+  static bool _isProtectedName(String name) {
+    var folded = name.toLowerCase();
+    if (Platform.isWindows) {
+      // Win32 aliases and alternate data streams must not bypass the name.
+      folded = folded.split(':').first.replaceFirst(RegExp(r'[. ]+$'), '');
+    }
+    return protectedNames.contains(folded);
+  }
+
+  static bool _containsConfiguration(String relativePath) =>
+      relativePath.replaceAll(r'\', '/').split('/').any(_isProtectedName);
+
+  /// Checks a portable project-relative target and known remote descendants.
+  static String? relativeDeletionError(
+    String relativePath, {
+    Iterable<String> descendants = const [],
+  }) {
+    final path = relativePath.replaceAll(r'\', '/');
+    if (path.isEmpty || path == '.') return protectedMessage;
+    final segments = path.split('/');
+    if (path.startsWith('/') ||
+        RegExp(r'^[A-Za-z]:').hasMatch(path) ||
+        path.contains('\u0000') ||
+        segments.any((part) => part.isEmpty || part == '.' || part == '..')) {
+      return invalidPathMessage;
+    }
+    if (_containsConfiguration(path)) return protectedMessage;
+    final prefix = '${path.toLowerCase()}/';
+    for (final descendant in descendants) {
+      final child = descendant.replaceAll(r'\', '/');
+      if (child.toLowerCase().startsWith(prefix) &&
+          _containsConfiguration(child)) {
+        return protectedMessage;
+      }
+    }
+    return null;
+  }
+
+  /// Checks both the displayed path and its resolved filesystem alias.
+  static String? pathError({
+    required String projectRoot,
+    required String absolutePath,
+  }) {
+    try {
+      if (projectRoot.contains('\u0000') || absolutePath.contains('\u0000')) {
+        return invalidPathMessage;
+      }
+      // Normalizing first could hide a link/.. traversal from the check while
+      // the filesystem mutation still receives the original spelling.
+      if (absolutePath
+          .replaceAll(r'\', '/')
+          .split('/')
+          .any((part) => part == '.' || part == '..')) {
+        return invalidPathMessage;
+      }
+      final root = p.normalize(p.absolute(projectRoot));
+      final target = p.normalize(p.absolute(absolutePath));
+      if (p.equals(root, target)) return protectedMessage;
+      if (!p.isWithin(root, target)) return invalidPathMessage;
+      final lexicalError = relativeDeletionError(
+        p.relative(target, from: root),
+      );
+      if (lexicalError != null) return lexicalError;
+      final realRoot = Directory(root).resolveSymbolicLinksSync();
+      final realTarget = _resolvedPath(target);
+      if (p.equals(realRoot, realTarget)) return protectedMessage;
+      if (!p.isWithin(realRoot, realTarget)) return invalidPathMessage;
+      return relativeDeletionError(p.relative(realTarget, from: realRoot));
+    } on FileSystemException {
+      return inspectionMessage;
+    } on ArgumentError {
+      return invalidPathMessage;
+    }
+  }
+
+  /// Also refuses a directory that contains protected configuration.
+  /// Scan without following child links, then recheck the selected alias.
+  static Future<String?> deletionError({
+    required String projectRoot,
+    required String absolutePath,
+  }) async {
+    final initialError = pathError(
+      projectRoot: projectRoot,
+      absolutePath: absolutePath,
+    );
+    if (initialError != null) return initialError;
+    try {
+      final directory = Directory(absolutePath);
+      if (directory.existsSync()) {
+        await for (final entry in directory.list(
+          recursive: true,
+          followLinks: false,
+        )) {
+          if (_isProtectedName(p.basename(entry.path))) return protectedMessage;
+          if (entry is Link) {
+            final aliasError = pathError(
+              projectRoot: projectRoot,
+              absolutePath: entry.path,
+            );
+            if (aliasError != null) return aliasError;
+          }
+        }
+      }
+    } on FileSystemException {
+      return inspectionMessage;
+    }
+    return pathError(projectRoot: projectRoot, absolutePath: absolutePath);
+  }
+
+  /// Missing leaves still inherit the canonical path of an existing ancestor.
+  static String _resolvedPath(String path) {
+    var ancestor = path;
+    final missing = <String>[];
+    while (FileSystemEntity.typeSync(ancestor, followLinks: false) ==
+        FileSystemEntityType.notFound) {
+      final parent = p.dirname(ancestor);
+      if (p.equals(parent, ancestor)) {
+        throw FileSystemException(inspectionMessage, path);
+      }
+      missing.insert(0, p.basename(ancestor));
+      ancestor = parent;
+    }
+    final resolved = File(ancestor).resolveSymbolicLinksSync();
+    return p.normalize(p.joinAll([resolved, ...missing]));
+  }
+}
