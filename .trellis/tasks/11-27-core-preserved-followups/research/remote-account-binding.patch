+              : '授权后，这个账号绑定的电脑会出现在这里。',
+          tone: _NoticeTone.info,
+        ),
+        const SizedBox(height: 12),
+        FilledButton.icon(
+          onPressed: _account.endpoint == null ? null : _authorize,
+          icon: const Icon(Icons.verified_user_outlined),
+          label: const Text('授权账号访问'),
