new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/remote_account_controller.dart
@@ -0,0 +1,900 @@
+// Account-side state for remote computers: which computer belongs to the
+// signed-in QFLI user, whether it is online, and whether this phone may connect.
+//
+// Scope discipline: this controller never touches the agent protocol. It hands
+// the remote controller a token provider and a device to dial; sessions,
+// terminals, Herdr, Codex and approvals stay exactly as they are.
+//
+// Identity rules:
+//   * the account is the QFLI user in [AuthStore] — no second login;
+//   * signing out, switching user, or a rejected token clears the relay tokens;
+//   * every await is fenced on the identity that started it, so a slow response
+//     for the previous account can never overwrite the current one.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../../store/auth_store.dart';
+import '../models/pairing_uri.dart';
+import '../state/remote_store.dart';
+import 'account_api.dart';
+import 'account_models.dart';
+import 'relay_credentials.dart';
+import 'relay_endpoint.dart';
+
+/// Where the account side stands.
+enum AccountPhase {
+  /// No QFLI user is signed in.
+  signedOut,
+
+  /// Signed in, but this phone holds no relay tokens yet.
+  needsAuthorization,
+
+  /// Grant → exchange in flight.
+  authorizing,
+
+  /// Relay tokens are held; [RemoteAccountController.devices] is authoritative.
+  ready,
+
+  /// The QFLI session itself was rejected (expired or revoked server-side).
+  signInExpired,
+
+  /// The account service could not be reached.
+  unavailable,
+}
+
+/// Store key for the account-scoped device memo.
+const String accountDeviceCacheKey = 'accountDevices';
+
+/// Owns the relay account session and the bound-device list.
+///
+/// One instance per signed-in identity inside one remote-computer page; the page
+/// recreates it when the scope hands over a different [AuthStore].
+class RemoteAccountController extends ChangeNotifier {
+  RemoteAccountController({
+    required AuthStore auth,
+    required QfliGrantApi grants,
+    required RelayAccountApi relay,
+    RemoteStore? store,
+    RelayCredentialStore? credentials,
+    RelayEndpoint? endpoint,
+    this.refreshSkew = const Duration(seconds: 45),
+    this.onIdentityLost,
+  }) : _auth = auth,
+       _grants = grants,
+       _relay = relay,
+       _store = store,
+       _credentials = credentials ?? RelayCredentialStore(),
+       _endpoint =
+           endpoint ?? RelayEndpoint.tryParse(store?.lastRelayUrl ?? '') {
+    _identity = _identityOf(auth);
+    _phase = auth.isLoggedIn
+        ? AccountPhase.needsAuthorization
+        : AccountPhase.signedOut;
+    auth.addListener(_onAuthChanged);
+    unawaited(_restore());
+  }
+
+  final AuthStore _auth;
+  final QfliGrantApi _grants;
+  final RelayAccountApi _relay;
+  final RemoteStore? _store;
+  final RelayCredentialStore _credentials;
+
+  /// Refresh the access token this long before it expires, so a dial does not
+  /// race the relay's clock.
+  final Duration refreshSkew;
+
+  /// Invoked when the signed-in identity disappears or changes.
+  ///
+  /// The page uses it to close an account-bound link: the token that authorised
+  /// that socket is gone, so keeping the socket open would be a lie.
+  final VoidCallback? onIdentityLost;
+
+  AccountPhase _phase = AccountPhase.signedOut;
+  List<RelayDevice> _devices = const <RelayDevice>[];
+  RelayEndpoint? _endpoint;
+  String? _accountId;
+  String? _error;
+  String? _identity;
+  String? _relayInput;
+  bool _busy = false;
+  bool _disposed = false;
+  int _epoch = 0;
+
+  /// Bumped by every [refreshDevices] so the newest list answer wins.
+  int _devicesEpoch = 0;
+  Future<String?>? _refreshing;
+
+  AccountPhase get phase => _phase;
+
+  List<RelayDevice> get devices => List<RelayDevice>.unmodifiable(_devices);
+
+  RelayEndpoint? get endpoint => _endpoint;
+
+  /// Relay account id from the verified grant. `null` before authorization.
+  String? get accountId => _accountId;
+
+  String? get errorMessage => _error;
+
+  bool get isBusy => _busy;
+
+  /// True when a refresh or a request is in flight.
+  bool get isLoading => _busy || _phase == AccountPhase.authorizing;
+
+  /// True when the platform backend keeps tokens between launches.
+  bool get persistsCredentials => _credentials.isPersistent;
+
+  bool get hasAuthorization => _credentials.credentials != null;
+
+  /// Host shown for the selected relay, or an empty string when none is set.
+  String get relayHost => _endpoint?.origin.host ?? '';
+
+  /// Relay address for the editable field, preferring what the user typed.
+  String get relayInput => _relayInput ?? _endpoint?.webSocket.toString() ?? '';
+
+  bool get isEmpty => _devices.isEmpty;
+
+  // -------------------------------------------------------------------------
+  // Identity
+  // -------------------------------------------------------------------------
+
+  static String? _identityOf(AuthStore auth) {
+    final user = auth.user;
+    if (user == null) return null;
+    // The QFLI user id is stable per account and differs between users, which
+    // is exactly what is needed to detect a switch. It is not a credential.
+    return user.id;
+  }
+
+  void _onAuthChanged() {
+    if (_disposed) return;
+    final identity = _identityOf(_auth);
+    if (identity == _identity) {
+      // Profile refreshes (nickname, points) do not change the account.
+      return;
+    }
+    // Everything below is synchronous on purpose: the old identity's socket must
+    // die in the same turn the identity changed, not after an awaited store call.
+    final previous = _credentials.credentials;
+    final hadIdentity = _identity != null;
+    _identity = identity;
+    _invalidateInFlight();
+    _devices = const <RelayDevice>[];
+    _accountId = null;
+    _error = null;
+    _relayInput = null;
+    _busy = false;
+    _phase = identity == null
+        ? AccountPhase.signedOut
+        : AccountPhase.needsAuthorization;
+    if (hadIdentity) onIdentityLost?.call();
+    _notify();
+    // The store clear is fenced: `clearIf` only drops the value that belonged to
+    // the identity that just left, so a slow clear cannot erase the next account.
+    unawaited(_credentials.clearIf(previous));
+  }
+
+  String? get identity => _identity;
+
+  Future<void> _restore() async {
+    final fence = _fence();
+    final identity = _identity;
+    if (identity == null) {
+      _phase = AccountPhase.signedOut;
+      _notify();
+      return;
+    }
+    final loaded = await _credentials.load();
+    // A slow backend read must not reinstate tokens after a sign-out, an account
+    // switch, or a relay switch.
+    if (!fence.isCurrent(this)) return;
+    final endpoint = _endpoint;
+    if (loaded == null || endpoint == null) {
+      _phase = AccountPhase.needsAuthorization;
+      _notify();
+      return;
+    }
+    if (!loaded.isOwnedBy(identity) || !loaded.belongsTo(endpoint.key)) {
+      // Tokens issued to another QFLI user, or to another relay, are not ours.
+      await _credentials.clearIf(loaded);
+      if (!fence.isCurrent(this)) return;
+      _phase = AccountPhase.needsAuthorization;
+      _notify();
+      return;
+    }
+    _accountId = loaded.accountId;
+    _loadCachedDevices();
+    _phase = AccountPhase.ready;
+    _notify();
+    unawaited(refreshDevices());
+  }
+
+  // -------------------------------------------------------------------------
+  // Relay selection
+  // -------------------------------------------------------------------------
+
+  /// Validates and applies the relay address typed by the user.
+  ///
+  /// Tokens issued for a different relay stay in memory but are refused by
+  /// [accessToken], so switching relays never connects with the wrong account.
+  Future<void> setRelayAddress(String input) async {
+    if (_disposed) return;
+    _relayInput = input;
+    final endpoint = RelayEndpoint.tryParse(input);
+    if (endpoint == null) {
+      _error = '服务器地址格式不正确';
+      _notify();
+      return;
+    }
+    _error = null;
+    if (_endpoint?.key == endpoint.key) {
+      _notify();
+      await refreshDevices();
+      return;
+    }
+    // A different server invalidates every in-flight answer: they were asked of,
+    // or authorized for, the previous relay.
+    _invalidateInFlight();
+    _endpoint = endpoint;
+    _devices = const <RelayDevice>[];
+    _busy = false;
+    final tokens = _credentials.credentials;
+    if (tokens == null || !tokens.belongsTo(endpoint.key)) {
+      _accountId = null;
+      _phase = _auth.isLoggedIn
+          ? AccountPhase.needsAuthorization
+          : AccountPhase.signedOut;
+      _notify();
+      return;
+    }
+    _accountId = tokens.accountId;
+    _loadCachedDevices();
+    _phase = AccountPhase.ready;
+    _notify();
+    await refreshDevices();
+  }
+
+  // -------------------------------------------------------------------------
+  // Authorization
+  // -------------------------------------------------------------------------
+
+  /// Exchanges the QFLI session for relay tokens.
+  ///
+  /// Two separate calls, two separate failure meanings: a rejected QFLI token
+  /// means "sign in again", a rejected exchange means "the relay did not accept
+  /// this grant". Collapsing them would tell the user to re-enter a password for
+  /// a server-side problem.
+  Future<void> authorize() async {
+    if (_disposed || _phase == AccountPhase.authorizing) return;
+    final identity = _identity;
+    if (identity == null) {
+      _phase = AccountPhase.signedOut;
+      _error = '请先登录 QFLI 账号';
+      _notify();
+      return;
+    }
+    final sessionToken = _auth.token;
+    if (sessionToken == null || sessionToken.isEmpty) {
+      _phase = AccountPhase.signInExpired;
+      _error = '登录状态已失效，请重新登录';
+      _notify();
+      return;
+    }
+    final endpoint = _endpoint;
+    if (endpoint == null) {
+      _error = '请先填写电脑所连接的服务器地址';
+      _notify();
+      return;
+    }
+
+    _phase = AccountPhase.authorizing;
+    _error = null;
+    _notify();
+    // Everything below is fenced on (identity, epoch, relay). Comparing only the
+    // identity would let an A → B → A sequence accept the first A's exchange, and
+    // a relay switch would keep the identity unchanged entirely.
+    final fence = _fence();
+
+    final RelayGrant grant;
+    try {
+      grant = await _grants.request(sessionToken: sessionToken);
+    } on AccountApiException catch (e) {
+      if (!fence.isCurrent(this)) return;
+      _phase = e.code == 'unauthorized'
+          ? AccountPhase.signInExpired
+          : AccountPhase.unavailable;
+      _error = e.message;
+      _notify();
+      return;
+    }
+    if (!fence.isCurrent(this)) return;
+
+    try {
+      final tokens = await _relay.exchange(relay: endpoint, grant: grant.grant);
+      if (!fence.isCurrent(this)) return;
+      final saved = RelayCredentials(
+        ownerId: identity,
+        accountId: tokens.accountId,
+        relayUrl: endpoint.key,
+        accessToken: tokens.accessToken,
+        refreshToken: tokens.refreshToken,
+        accessExpiresAt: tokens.accessExpiresAt,
+        refreshExpiresAt: tokens.refreshExpiresAt,
+      );
+      await _credentials.save(saved);
+      if (!fence.isCurrent(this)) {
+        // The save landed after the fence moved. Drop exactly this value: a plain
+        // `clear()` here would also erase tokens a newer identity just stored.
+        await _credentials.clearIf(saved);
+        return;
+      }
+      _accountId = saved.accountId;
+      _loadCachedDevices();
+      _phase = AccountPhase.ready;
+      _error = null;
+      _notify();
+    } on AccountApiException catch (e) {
+      if (!fence.isCurrent(this)) return;
+      _phase = e.isTransient
+          ? AccountPhase.unavailable
+          : AccountPhase.needsAuthorization;
+      _error = e.message;
+      _notify();
+      return;
+    }
+
+    await refreshDevices();
+  }
+
+  // -------------------------------------------------------------------------
+  // Devices
+  // -------------------------------------------------------------------------
+
+  /// Fetches the account's devices.
+  ///
+  /// Returns the list this call produced, or an empty list when it was skipped or
+  /// superseded. Callers that need the freshly read rows (the bind flow) use the
+  /// return value instead of re-reading `devices`, which a later call may already
+  /// have replaced.
+  Future<List<RelayDevice>> refreshDevices() async {
+    if (_disposed) return const <RelayDevice>[];
+    final endpoint = _endpoint;
+    final tokens = _credentials.credentials;
+    if (endpoint == null || tokens == null || !tokens.belongsTo(endpoint.key)) {
+      return const <RelayDevice>[];
+    }
+    final fence = _fence();
+    final listEpoch = ++_devicesEpoch;
+    // Declared outside `try` so the 401 path can name exactly which authorization
+    // the rejected request carried.
+    RelayCredentials? access;
+    _busy = true;
+    _notify();
+    try {
+      access = await _usableCredentials(tokens);
+      if (!_deviceListIsCurrent(fence, listEpoch)) {
+        return const <RelayDevice>[];
+      }
+      if (access == null) {
+        _phase = AccountPhase.needsAuthorization;
+        _error ??= '账号授权已失效，请重新授权';
+        return const <RelayDevice>[];
+      }
+      final list = await _relay.devices(relay: endpoint, credentials: access);
+      if (!_deviceListIsCurrent(fence, listEpoch)) {
+        return const <RelayDevice>[];
+      }
+      _devices = list;
+      _error = null;
+      _phase = AccountPhase.ready;
+      await _saveCache(fence, list);
+      return list;
+    } on AccountApiException catch (e) {
+      if (!_deviceListIsCurrent(fence, listEpoch)) {
+        return const <RelayDevice>[];
+      }
+      await _handleFailure(fence, e, failedWith: access);
+      return const <RelayDevice>[];
+    } finally {
+      // `_busy` belongs to the newest request only: an abandoned answer must not
+      // clear the spinner of the one that replaced it.
+      if (_deviceListIsCurrent(fence, listEpoch)) {
+        _busy = false;
+        _notify();
+      }
+    }
+  }
+
+  /// Binds a computer with the one-time code shown on its desktop.
+  ///
+  /// The code alone is enough: the relay resolves it to a device and answers with
+  /// the device row, which is also why the account flow must not connect with the
+  /// same code first — a code is single use, so `pairWithCode` followed by a bind
+  /// would spend it twice and fail on the second call.
+  ///
+  /// Returns the bound device so the caller can refresh and connect immediately.
+  ///
+  /// [deviceId] is optional: the code-only route is the default, and the known-id
+  /// route is used only when the caller already learned the id without spending
+  /// the code.
+  Future<RelayDevice> bindDevice({
+    required String pairCode,
+    String? deviceId,
+  }) async {
+    final endpoint = _endpoint;
+    final tokens = _credentials.credentials;
+    final owner = _identity;
+    if (endpoint == null || tokens == null) {
+      throw const AccountApiException('账号授权已失效，请重新授权', code: 'unauthorized');
+    }
+    if (!tokens.belongsTo(endpoint.key) ||
+        owner == null ||
+        !tokens.isOwnedBy(owner)) {
+      throw const AccountApiException('账号授权已失效，请重新授权', code: 'unauthorized');
+    }
+    final code = PairingUri.normalizePairCode(pairCode);
+    if (code == null) {
+      throw const AccountApiException('配对码应为 8 位字母或数字', code: 'protocol');
+    }
+    final fence = _fence();
+    final access = await _usableCredentials(tokens);
+    if (!fence.isCurrent(this)) {
+      throw const AccountApiException('账号已切换，绑定已取消', code: 'cancelled');
+    }
+    if (access == null) {
+      throw const AccountApiException('账号授权已失效，请重新授权', code: 'unauthorized');
+    }
+    final RelayDevice bound;
+    try {
+      bound = await _relay.bind(
+        relay: endpoint,
+        credentials: access,
+        pairCode: code,
+        deviceId: deviceId,
+      );
+    } on AccountApiException catch (e) {
+      if (fence.isCurrent(this)) {
+        await _handleFailure(fence, e, failedWith: access);
+        if (fence.isCurrent(this)) _notify();
+      }
+      rethrow;
+    }
+    if (!fence.isCurrent(this)) {
+      throw const AccountApiException('账号已切换，绑定结果已丢弃', code: 'cancelled');
+    }
+    final refreshed = await refreshDevices();
+    // The refresh awaited above can finish after an account switch, and the
+    // caller connects in the next statement: re-check before handing it a device
+    // that belongs to the previous account.
+    if (!fence.isCurrent(this)) {
+      throw const AccountApiException('账号已切换，绑定结果已丢弃', code: 'cancelled');
+    }
+    if (_credentials.credentials == null) return bound;
+    if (!_credentialsMatches(bound)) {
+      throw const AccountApiException('账号已切换，绑定结果已丢弃', code: 'cancelled');
+    }
+    // The bind response only proves the binding exists (`ok` / `device_id` /
+    // `role`), so its row carries no presence. Presence comes from the list this
+    // refresh returned: answering with the bind row would report every online
+    // computer as offline and skip the connect the user asked for.
+    final known = _deviceById(refreshed, bound.deviceId);
+    if (known == null) {
+      // Bound, but the fresh list does not show it yet. Keep the bind row, which
+      // has no presence and is therefore treated as offline.
+      return bound;
+    }
+    // Presence, label and platform come from the list; the bind row confirmed the
+    // id and fills any field the list left blank.
+    return RelayDevice(
+      deviceId: known.deviceId,
+      label: known.label.isEmpty ? bound.label : known.label,
+      platform: known.platform.isEmpty ? bound.platform : known.platform,
+      role: known.role.isEmpty ? bound.role : known.role,
+      state: known.state,
+      lastSeenAt: known.lastSeenAt,
+      boundAt: known.boundAt ?? bound.boundAt,
+    );
+  }
+
+  /// The row with [deviceId] in [list].
+  static RelayDevice? _deviceById(List<RelayDevice> list, String deviceId) {
+    for (final device in list) {
+      if (device.deviceId == deviceId) return device;
+    }
+    return null;
+  }
+
+  /// True when the current authorization still covers the device's relay.
+  bool _credentialsMatches(RelayDevice device) {
+    final endpoint = _endpoint;
+    final current = _credentials.credentials;
+    if (endpoint == null || current == null) return false;
+    if (current.ownerId != _identity) return false;
+    return current.belongsTo(endpoint.key);
+  }
+
+  /// Revokes this account's binding on [deviceId].
+  ///
+  /// Returns `true` only when the revocation still belongs to the account and
+  /// relay that started it. A revocation that resolves after a sign-out or an
+  /// account switch returns `false` and touches no state: otherwise a late answer
+  /// for account A could mark a row revoked in account B's list, or the page's
+  /// caller could tear down B's live connection on behalf of A.
+  Future<bool> revokeDevice(String deviceId) async {
+    final endpoint = _endpoint;
+    final tokens = _credentials.credentials;
+    if (endpoint == null || tokens == null || !tokens.belongsTo(endpoint.key)) {
+      throw const AccountApiException('账号授权已失效，请重新授权', code: 'unauthorized');
+    }
+    final fence = _fence();
+    final access = await _usableCredentials(tokens);
+    if (!fence.isCurrent(this)) return false;
+    if (access == null) {
+      throw const AccountApiException('账号授权已失效，请重新授权', code: 'unauthorized');
+    }
+    try {
+      await _relay.revoke(
+        relay: endpoint,
+        credentials: access,
+        deviceId: deviceId,
+        targetAccountId: tokens.accountId,
+      );
+    } on AccountApiException catch (e) {
+      if (fence.isCurrent(this)) {
+        await _handleFailure(fence, e, failedWith: access);
+        if (fence.isCurrent(this)) _notify();
+      }
+      rethrow;
+    }
+    if (!fence.isCurrent(this)) return false;
+    _devices = <RelayDevice>[
+      for (final device in _devices)
+        if (device.deviceId == deviceId && !device.isRevoked)
+          device.copyWith(state: RelayDeviceState.revoked)
+        else
+          device,
+    ];
+    _notify();
+    unawaited(refreshDevices());
+    return true;
+  }
+
+  // -------------------------------------------------------------------------
+  // Tokens for the socket layer
+  // -------------------------------------------------------------------------
+
+  /// Current credentials for one pairing, refreshed first when near expiry.
+  ///
+  /// Returns a **complete** snapshot, never a token re-attached to the previous
+  /// expiry: mixing a fresh access token with a stale `accessExpiresAt` made the
+  /// very next `devices` / `bind` / `revoke` call fail its own expiry check.
+  ///
+  /// [accountId] and [relayUrl] come from the pairing being dialled. A request for
+  /// another account, or for a relay this phone holds no tokens for, answers `null`
+  /// instead of lending out the currently selected server's token.
+  Future<RelayCredentials?> credentialsFor({
+    required String accountId,
+    required String relayUrl,
+  }) async {
+    if (_disposed) return null;
+    final endpoint = RelayEndpoint.tryParse(relayUrl);
+    if (endpoint == null) return null;
+    final fence = _fence();
+    final current = _credentials.credentials;
+    if (current == null) return null;
+    if (!current.belongsTo(endpoint.key)) return null;
+    if (current.accountId != accountId) return null;
+    if (!current.isOwnedBy(_identity ?? '')) return null;
+    if (!current.needsRefresh(refreshSkew)) return current;
+
+    final pending = _refreshing;
+    if (pending != null) {
+      // Join the in-flight refresh instead of answering with credentials that
+      // were already too old to use.
+      await pending;
+    } else {
+      final future = _refreshTokens(endpoint);
+      _refreshing = future;
+      try {
+        await future;
+      } finally {
+        if (identical(_refreshing, future)) _refreshing = null;
+      }
+    }
+    // Epoch and relay are checked too: the identity can return to a previous
+    // value (A → B → A), and `_refreshTokens` may have lost the race entirely.
+    if (!fence.isCurrent(this)) return null;
+    final refreshed = _freshCredentials(endpoint, accountId);
+    if (refreshed == null) return null;
+    // A refresh that failed leaves the old credentials in place; hand them back
+    // only when they are genuinely still usable, never while expired.
+    if (refreshed.needsRefresh(Duration.zero)) return null;
+    return refreshed;
+  }
+
+  /// Current token for the socket layer.
+  ///
+  /// Kept for callers that only need the string; [credentialsFor] is the form the
+  /// account layer hands to the pairing.
+  Future<String?> accessToken() async {
+    final endpoint = _endpoint;
+    final current = _credentials.credentials;
+    if (endpoint == null || current == null) return null;
+    final fresh = await credentialsFor(
+      accountId: current.accountId,
+      relayUrl: endpoint.key,
+    );
+    return fresh?.accessToken;
+  }
+
+  /// Re-reads the stored credentials and checks they still belong to the pair
+  /// asked for.
+  RelayCredentials? _freshCredentials(
+    RelayEndpoint endpoint,
+    String accountId,
+  ) {
+    if (_disposed) return null;
+    final current = _credentials.credentials;
+    if (current == null) return null;
+    if (!current.belongsTo(endpoint.key)) return null;
+    if (current.accountId != accountId) return null;
+    if (!current.isOwnedBy(_identity ?? '')) return null;
+    return current;
+  }
+
+  /// Credentials for the currently selected relay, refreshed when needed.
+  Future<RelayCredentials?> _usableCredentials(RelayCredentials tokens) async {
+    final endpoint = _endpoint;
+    if (endpoint == null) return null;
