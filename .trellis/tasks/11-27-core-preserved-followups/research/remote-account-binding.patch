@@ -0,0 +1,998 @@
+// Account-layer tests: models, endpoint derivation, credential store fencing and
+// the controller's identity/relay fencing.
+//
+// These are written for the cloud CI runner. Nothing here touches the network,
+// the file system or a device: `MockClient` answers the HTTP calls, the store
+// backend is an in-test double whose latency the test controls, and the pairing
+// store uses the in-memory backend.
+//
+// The regressions they pin down are the ones a reviewer can no longer reach by
+// reading the code:
+//
+//   * a code-only bind must be one request, not "pair then bind" (a code is
+//     single use and the second call would fail);
+//   * a refresh must hand back the token **and** its own expiry;
+//   * slow storage, A → B → A, relay switches and a shared refresh must never
+//     let an older generation write over a newer one;
+//   * an account-bound failure must never fall back to a device secret;
+//   * manual pairing must keep working with no account layer at all.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:qfli_studio_core/community/models.dart';
+import 'package:qfli_studio_core/remote_control/account/account_api.dart';
+import 'package:qfli_studio_core/remote_control/account/account_models.dart';
+import 'package:qfli_studio_core/remote_control/account/relay_credentials.dart';
+import 'package:qfli_studio_core/remote_control/account/relay_endpoint.dart';
+import 'package:qfli_studio_core/remote_control/account/remote_account_controller.dart';
+import 'package:qfli_studio_core/remote_control/state/remote_controller.dart';
+import 'package:qfli_studio_core/remote_control/state/remote_store.dart';
+import 'package:qfli_studio_core/remote_control/state/remote_store_backend.dart';
+import 'package:qfli_studio_core/store/auth_store.dart';
+
+import '../support/fake_relay.dart';
+
+const String relayUrl = 'wss://relay.example.com/ws';
+const String otherRelayUrl = 'wss://relay2.example.com/ws';
+
+CommunityUser _user(String id) => CommunityUser(
+  id: id,
+  username: 'user-$id',
+  nickname: 'nick-$id',
+  bio: '',
+  avatarColor: '#2196F3',
+  points: 0,
+  checkinStreak: 0,
+  provider: 'local',
+);
+
+/// In-memory backend whose latency each test can stretch.
+class _SlowBackend implements RelayCredentialBackend {
+  _SlowBackend();
+
+  Completer<void>? gateLoad;
+  Completer<void>? gateWrite;
+  Completer<void>? gateClear;
+
+  RelayCredentials? stored;
+  int writes = 0;
+  int clears = 0;
+
+  @override
+  Future<RelayCredentials?> read() async {
+    await gateLoad?.future;
+    return stored;
+  }
+
+  @override
+  Future<void> write(RelayCredentials credentials) async {
+    await gateWrite?.future;
+    writes += 1;
+    stored = credentials;
+  }
+
+  @override
+  Future<void> clear() async {
+    await gateClear?.future;
+    clears += 1;
+    stored = null;
+  }
+}
+
+/// Scripted relay/QFLI server.
+class _Server {
+  static const String accountId = 'relay-account';
+
+  final List<http.Request> requests = <http.Request>[];
+  Completer<void>? gateExchange;
+  Completer<void>? gateDevices;
+  Completer<void>? gateRefresh;
+  Completer<void>? gateBind;
+  Completer<void>? gateRevoke;
+
+  /// Set to make the next exchange/devices call answer 401.
+  bool rejectDevices = false;
+
+  /// Device calls carrying this bearer answer 401, whatever their timing.
+  String? rejectAccessToken;
+
+  /// Device the code-only bind route resolves to.
+  String bindDeviceId = 'pc-new';
+
+  /// Rows returned by `GET /api/v1/devices`; null uses the default single row.
+  List<Map<String, dynamic>>? devicesOverride;
+
+  int accessSerial = 0;
+
+  http.Client get client => MockClient((request) async {
+    requests.add(request);
+    final path = request.url.path;
+    if (path == '/api/relay/grants') {
+      return http.Response(
+        jsonEncode(<String, dynamic>{
+          'grant': 'grant-${DateTime.now().microsecondsSinceEpoch}',
+          'expires_at': DateTime.now()
+              .toUtc()
+              .add(const Duration(seconds: 60))
+              .toIso8601String(),
+          'audience': 'cloudterminal-relay',
+        }),
+        200,
+      );
+    }
+    if (path == '/api/v1/auth/exchange') {
+      await gateExchange?.future;
+      return http.Response(jsonEncode(_tokens()), 200);
+    }
+    if (path == '/api/v1/auth/token/refresh') {
+      await gateRefresh?.future;
+      return http.Response(jsonEncode(_tokens()), 200);
+    }
+    if (path == '/api/v1/devices' && request.method == 'GET') {
+      // A single gate: whatever call is already waiting finishes when it opens,
+      // later calls proceed immediately.
+      final gate = gateDevices;
+      gateDevices = null;
+      await gate?.future;
+      final bearer = request.headers['authorization'];
+      if (rejectDevices ||
+          (rejectAccessToken != null &&
+              bearer == 'Bearer $rejectAccessToken')) {
+        return http.Response(jsonEncode(<String, dynamic>{'error': 'x'}), 401);
+      }
+      final rows =
+          devicesOverride ??
+          <Map<String, dynamic>>[
+            <String, dynamic>{
+              'device_id': 'pc-1',
+              'label': '办公室台式机',
+              'platform': 'win32',
+              'role': 'owner',
+              'online': true,
+              'last_seen_at': DateTime.now()
+                  .toUtc()
+                  .subtract(const Duration(minutes: 3))
+                  .toIso8601String(),
+            },
+          ];
+      return http.Response(
+        jsonEncode(<String, dynamic>{'ok': true, 'devices': rows}),
+        200,
+      );
+    }
+    if (path == '/api/v1/devices/bindings' && request.method == 'POST') {
+      await gateBind?.future;
+      // The real relay answers a bind with the binding, not the device: `ok`,
+      // `account_id`, `device_id` and `role`, and no presence at all.
+      return http.Response(
+        jsonEncode(<String, dynamic>{
+          'ok': true,
+          'account_id': accountId,
+          'device_id': bindDeviceId,
+          'role': 'owner',
+        }),
+        200,
+      );
+    }
+    if (path.startsWith('/api/v1/devices/') &&
+        request.method == 'POST' &&
+        path.endsWith('/bindings')) {
+      await gateBind?.future;
+      return http.Response(
+        jsonEncode(<String, dynamic>{'ok': true, 'device_id': 'pc-1'}),
+        200,
+      );
+    }
+    if (path.contains('/bindings/') && request.method == 'DELETE') {
+      await gateRevoke?.future;
+      return http.Response(jsonEncode(<String, dynamic>{'ok': true}), 200);
+    }
+    return http.Response(
+      jsonEncode(<String, dynamic>{'error': 'unexpected'}),
+      404,
+    );
+  });
+
+  Map<String, dynamic> _tokens() {
+    accessSerial += 1;
+    final now = DateTime.now().toUtc();
+    return <String, dynamic>{
+      'account_id': accountId,
+      'access_token': 'access-$accessSerial',
+      'refresh_token': 'refresh-$accessSerial',
+      'access_expires_at': now
+          .add(const Duration(minutes: 15))
+          .toIso8601String(),
+      'refresh_expires_at': now.add(const Duration(days: 30)).toIso8601String(),
+    };
+  }
+
+  List<String> get paths => requests.map((r) => r.url.path).toList();
+
+  int countPath(String path) => paths.where((p) => p == path).length;
+}
+
+/// A `RemoteStore` over an in-memory backend.
+Future<RemoteStore> _openStore() =>
+    RemoteStore.open(backend: MemoryRemoteStoreBackend());
+
+void main() {
+  group('RelayEndpoint', () {
+    test('derives the HTTP origin from the socket address', () {
+      final endpoint = RelayEndpoint.tryParse(relayUrl)!;
+      expect(endpoint.origin.toString(), 'https://relay.example.com');
+      expect(
+        endpoint.api('/api/v1/devices').toString(),
