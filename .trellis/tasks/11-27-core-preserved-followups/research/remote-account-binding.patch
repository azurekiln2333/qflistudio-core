+                  tooltip: '刷新',
+                  onPressed: _account.isLoading ? null : _refresh,
+                  icon: const Icon(Icons.refresh_rounded),
+                ),
+            ],
+          ),
+          body: RefreshIndicator(
+            onRefresh: _refresh,
+            child: ListView(
+              padding: const EdgeInsets.fromLTRB(16, 12, 16, 32),
+              children: <Widget>[
+                _RelayCard(
+                  controller: _relay,
+                  host: _account.relayHost,
+                  onApply: _account.phase == AccountPhase.authorizing
+                      ? null
+                      : _applyRelay,
+                ),
+                const SizedBox(height: 12),
+                ..._body(context),
+                const SizedBox(height: 20),
+                const Divider(),
+                const SizedBox(height: 8),
+                OutlinedButton.icon(
+                  onPressed: widget.onManualPair,
+                  icon: const Icon(Icons.key_rounded),
+                  label: const Text('改用配对码或密钥连接'),
+                ),
+                const SizedBox(height: 8),
