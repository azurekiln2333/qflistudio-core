+// Wire models for the relay account API and the device list.
+//
+// Every response shape is decoded in this one file so validation happens in a
+// single place: the UI never touches raw JSON, and a hostile or broken relay
+// cannot smuggle a malformed device id into the connection flow.
+
+/// A relay response that does not match the documented contract.
+///
+/// Carries a user-readable Chinese sentence and nothing else: no body, no
+/// header, no token.
+class AccountProtocolException implements Exception {
+  const AccountProtocolException(this.message);
+
+  final String message;
+
+  @override
+  String toString() => message;
+}
+
+/// What a bound device currently looks like to this account.
+enum RelayDeviceState {
+  /// The computer holds a live agent socket on the relay.
+  online,
+
+  /// The account is still bound, but the agent is not connected.
+  offline,
+
+  /// The device itself or this account's binding was revoked.
+  revoked,
+}
+
+/// One computer bound to the signed-in account.
+class RelayDevice {
+  const RelayDevice({
+    required this.deviceId,
+    this.label = '',
+    this.platform = '',
+    this.role = '',
+    this.state = RelayDeviceState.offline,
+    this.lastSeenAt,
+    this.boundAt,
+  });
+
+  /// Relay device id (the agent id). Never a secret; safe to persist and show.
+  final String deviceId;
+
+  /// User-visible name set on the desktop or by a previous binding.
+  final String label;
+
+  /// `win32` / `darwin` / `linux`, as reported by the agent.
+  final String platform;
+
+  /// `owner` or `member` for this account, when the relay reports it.
+  final String role;
+
+  final RelayDeviceState state;
+
+  /// Last time the relay saw the agent, when reported.
+  final DateTime? lastSeenAt;
+
+  /// When this account bound the device, when reported.
+  final DateTime? boundAt;
+
+  bool get isRevoked => state == RelayDeviceState.revoked;
+
+  bool get isOnline => state == RelayDeviceState.online;
+
+  bool get isOwner => role.toLowerCase() == 'owner';
+
+  /// Falls back to the id so a row is never blank.
+  String get displayName {
+    final trimmed = label.trim();
+    return trimmed.isEmpty ? deviceId : trimmed;
+  }
+
+  /// Platform shown in the list. Unknown values are passed through unchanged —
+  /// the relay already stores whatever the agent reported.
+  String get platformLabel =>
+      platform.trim().isEmpty ? '未知平台' : platform.trim();
+
+  RelayDevice copyWith({RelayDeviceState? state}) => RelayDevice(
+    deviceId: deviceId,
+    label: label,
+    platform: platform,
+    role: role,
+    state: state ?? this.state,
+    lastSeenAt: lastSeenAt,
+    boundAt: boundAt,
+  );
+
+  /// Central validation for one device record.
+  ///
+  /// Accepts the relay's snake_case envelope and camelCase spellings, because
+  /// the relay also has to serve older clients. Anything that is not a bounded,
+  /// printable id is rejected instead of being passed to the socket layer.
+  factory RelayDevice.fromJson(Object? json) {
+    if (json is! Map) {
+      throw const AccountProtocolException('设备记录格式无效');
+    }
+    final map = json is Map<String, dynamic>
+        ? json
+        : Map<String, dynamic>.from(json);
+
+    final rawId = _read(map, const <String>['device_id', 'deviceId', 'id']);
+    final deviceId = validateDeviceId(rawId);
+
+    final deviceRevoked =
+        _read(map, const <String>['device_revoked', 'deviceRevoked']) == true;
+    final online = _read(map, const <String>['online']) == true;
+    // `state` is written by [AccountDeviceCache.toJson], so the cache round-trips:
+    // without it every restored row would read as offline because the memo carries
+    // no `online` / `device_revoked` flags.
+    final stateText = (_readString(map, const <String>['state']) ?? '')
+        .toLowerCase();
+
+    return RelayDevice(
+      deviceId: deviceId,
+      label:
+          _readString(map, const <String>[
+            'label',
+            'name',
+            'display_name',
+            'displayName',
+          ]) ??
+          '',
+      platform: _readString(map, const <String>['platform', 'os']) ?? '',
+      role: _readString(map, const <String>['role', 'binding_role']) ?? '',
+      state: deviceRevoked || stateText == RelayDeviceState.revoked.name
+          ? RelayDeviceState.revoked
+          : online || stateText == RelayDeviceState.online.name
+          ? RelayDeviceState.online
+          : RelayDeviceState.offline,
+      lastSeenAt: parseAccountTime(
+        _read(map, const <String>['last_seen_at', 'lastSeenAt']),
+      ),
+      boundAt: parseAccountTime(
+        _read(map, const <String>[
+          'bound_at',
+          'boundAt',
+          'created_at',
+          'createdAt',
+        ]),
+      ),
+    );
+  }
+
+  /// Never includes a credential; the device id is public metadata.
+  @override
+  String toString() => 'RelayDevice($deviceId, ${state.name})';
+}
+
+/// Validates a device id before it is used in a URL path or a socket frame.
+///
+/// The bound is intentionally conservative: ids come from the relay's own
+/// records, so a value with whitespace, control characters, slashes or an
+/// unexpected length is a protocol error rather than something to repair.
+String validateDeviceId(Object? raw) {
+  if (raw is! String) {
+    throw const AccountProtocolException('设备 ID 缺失或格式无效');
+  }
+  final value = raw.trim();
+  if (value.isEmpty || value.length > 128) {
+    throw const AccountProtocolException('设备 ID 长度无效');
+  }
+  if (!RegExp(r'^[A-Za-z0-9._:-]+$').hasMatch(value)) {
+    throw const AccountProtocolException('设备 ID 含有非法字符');
+  }
+  return value;
+}
+
+/// Decodes `GET /api/v1/devices`, tolerating both envelopes the relay may use.
+///
+/// Duplicate ids are collapsed: the list is rendered by device, and a repeated
+/// row would let a user revoke the same binding twice.
+List<RelayDevice> parseRelayDevices(Object? payload) {
+  final raw = switch (payload) {
+    List<dynamic>() => payload,
+    Map<dynamic, dynamic>() when payload['devices'] is List =>
+      payload['devices'] as List<dynamic>,
+    Map<dynamic, dynamic>() when payload['items'] is List =>
+      payload['items'] as List<dynamic>,
+    _ => throw const AccountProtocolException('设备列表响应格式无效'),
+  };
+
+  final devices = <RelayDevice>[];
+  final seen = <String>{};
+  for (final item in raw) {
+    final device = RelayDevice.fromJson(item);
+    if (!seen.add(device.deviceId)) continue;
+    devices.add(device);
+  }
+  return devices;
+}
+
+/// The short-lived QFLI grant the relay exchanges for its own tokens.
+///
+/// Deliberately has no accessor that prints it: [toString] reports the audience
+/// only, so an accidental interpolation cannot leak a usable authorization.
+class RelayGrant {
+  const RelayGrant({required this.grant, this.audience = '', this.expiresAt});
+
+  final String grant;
+  final String audience;
+  final DateTime? expiresAt;
+
+  bool get isExpired {
+    final expiry = expiresAt;
+    return expiry != null && !DateTime.now().toUtc().isBefore(expiry);
+  }
+
+  /// Central validation of `POST /api/relay/grants`.
+  factory RelayGrant.fromJson(Object? payload) {
+    if (payload is! Map) {
+      throw const AccountProtocolException('授权票据响应格式无效');
+    }
+    final map = payload is Map<String, dynamic>
+        ? payload
+        : Map<String, dynamic>.from(payload);
+    final value = _readString(map, const <String>['grant', 'token']);
+    if (value == null || value.length < 16 || value.length > 4096) {
+      throw const AccountProtocolException('授权票据缺失或长度无效');
+    }
+    final audience = _readString(map, const <String>['audience', 'aud']) ?? '';
+    if (audience.isNotEmpty && audience != relayGrantAudience) {
+      throw const AccountProtocolException('授权票据的 audience 与预期不符');
+    }
+    return RelayGrant(
+      grant: value,
+      audience: audience,
+      expiresAt: parseAccountTime(
+        _read(map, const <String>['expires_at', 'expiresAt', 'exp']),
+      ),
+    );
+  }
+
+  @override
+  String toString() =>
+      'RelayGrant(audience: ${audience.isEmpty ? 'unspecified' : audience})';
+}
+
+/// The only audience this client asks for or accepts.
+const String relayGrantAudience = 'cloudterminal-relay';
+
+/// The only scope this client asks for.
+const String relayGrantScope = 'relay.connect';
+
+/// Device list memo scoped to one account on one relay.
+///
+/// Contains selection metadata only — never a token, never a grant. The cache is
+/// only consulted after a successful exchange has proved which relay account the
+/// signed-in QFLI user maps to, so a second user on the same phone can never see
+/// the previous account's list.
+class AccountDeviceCache {
+  const AccountDeviceCache({
+    required this.accountId,
+    required this.relayUrl,
+    required this.devices,
+    required this.fetchedAt,
+  });
+
+  final String accountId;
+  final String relayUrl;
+  final List<RelayDevice> devices;
+  final DateTime fetchedAt;
+
+  bool matches({required String accountId, required String relayUrl}) =>
+      this.accountId == accountId && this.relayUrl == relayUrl;
+
+  factory AccountDeviceCache.fromJson(Object? json) {
+    if (json is! Map) {
+      throw const AccountProtocolException('设备缓存格式无效');
+    }
+    final map = json is Map<String, dynamic>
+        ? json
+        : Map<String, dynamic>.from(json);
+    final accountId = _readString(map, const <String>['accountId']);
+    final relayUrl = _readString(map, const <String>['relayUrl']);
+    if (accountId == null || accountId.isEmpty) {
+      throw const AccountProtocolException('设备缓存缺少账号');
+    }
+    if (relayUrl == null || relayUrl.isEmpty) {
+      throw const AccountProtocolException('设备缓存缺少服务器地址');
+    }
+    return AccountDeviceCache(
+      accountId: accountId,
+      relayUrl: relayUrl,
+      devices: parseRelayDevices(map['devices']),
+      fetchedAt:
+          parseAccountTime(_read(map, const <String>['fetchedAt'])) ??
+          DateTime.fromMillisecondsSinceEpoch(0, isUtc: true),
+    );
+  }
+
+  Map<String, dynamic> toJson() => <String, dynamic>{
+    'accountId': accountId,
+    'relayUrl': relayUrl,
+    'fetchedAt': fetchedAt.toUtc().toIso8601String(),
+    'devices': <Map<String, dynamic>>[
+      for (final device in devices) _deviceToJson(device),
+    ],
+  };
+}
+
+Map<String, dynamic> _deviceToJson(RelayDevice device) => <String, dynamic>{
+  'deviceId': device.deviceId,
+  'label': device.label,
+  'platform': device.platform,
+  'role': device.role,
+  'state': device.state.name,
+  'lastSeenAt': device.lastSeenAt?.toUtc().toIso8601String(),
+  'boundAt': device.boundAt?.toUtc().toIso8601String(),
+};
+
+/// Parses an ISO-8601 string or UNIX seconds.
+///
+/// Contract: QFLI grants and relay exchanges answer ISO-8601, while the relay's
+/// introspection `exp` is UNIX seconds. Accepting both here keeps the client
+/// honest if a relay echoes either form; milliseconds are tolerated because
+/// older relays answered them.
+DateTime? parseAccountTime(Object? value) {
+  if (value is String) {
+    final text = value.trim();
+    if (text.isEmpty) return null;
+    final iso = DateTime.tryParse(text);
+    if (iso != null) return iso.toUtc();
+    final seconds = int.tryParse(text);
+    if (seconds == null) return null;
+    return _fromEpoch(seconds);
+  }
+  if (value is num) return _fromEpoch(value.toInt());
+  return null;
+}
+
+DateTime? _fromEpoch(int value) {
+  if (value <= 0) return null;
+  final milliseconds = value > 100000000000 ? value : value * 1000;
+  return DateTime.fromMillisecondsSinceEpoch(milliseconds, isUtc: true);
+}
+
+/// First non-null value among [keys].
+Object? _read(Map<String, dynamic> map, List<String> keys) {
+  for (final key in keys) {
+    final value = map[key];
+    if (value != null) return value;
+  }
+  return null;
+}
+
+String? _readString(Map<String, dynamic> map, List<String> keys) {
+  final value = _read(map, keys);
+  return value is String ? value : null;
+}
diff --git a/lib/remote_control/account/account_scope.dart b/lib/remote_control/account/account_scope.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/account_scope.dart
@@ -0,0 +1,42 @@
+// Narrow account scope for the remote-computer module.
+//
+// The module is mounted from a product tools tab whose builder signature is
+// `Widget Function(ProjectStore, VoidCallback)` — no BuildContext, no AuthStore.
+// Rather than inventing a second account store, [QfliApp] installs this scope
+// over the real [AuthStore] it was handed at startup, and the module reads it
+// from the context. Login gating keeps using the existing `LoginGateScope`
+// primitive; this class only answers "which account is signed in".
+
+import 'package:flutter/material.dart';
+
+import '../../store/auth_store.dart';
+
+/// Provides the app's real [AuthStore] to the remote-computer module.
+///
+/// Deliberately tiny: no token copying, no caching, no second persistence. Every
+/// caller that needs the session token reads `auth.token` at the moment of the
+/// request, which is also what keeps a sign-out race honest.
+class RemoteAccountScope extends InheritedWidget {
+  const RemoteAccountScope({
+    super.key,
+    required this.auth,
+    required super.child,
+  });
+
+  final AuthStore auth;
+
+  static AuthStore? maybeAuthOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<RemoteAccountScope>()?.auth;
+
+  /// Throws in debug builds when the scope was not installed, which is a wiring
+  /// error rather than a runtime condition.
+  static AuthStore authOf(BuildContext context) {
+    final auth = maybeAuthOf(context);
+    assert(auth != null, '缺少 RemoteAccountScope 祖先');
+    return auth!;
+  }
+
+  @override
+  bool updateShouldNotify(RemoteAccountScope oldWidget) =>
+      !identical(auth, oldWidget.auth) || !identical(child, oldWidget.child);
+}
diff --git a/lib/remote_control/account/relay_credentials.dart b/lib/remote_control/account/relay_credentials.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/relay_credentials.dart
@@ -0,0 +1,252 @@
+/// Storage boundary for relay account tokens.
+///
+/// Relay tokens are **not** credentials the user typed: they are machine-issued,
+/// revocable and short-lived (15 minutes for access). The task contract therefore
+/// says they must live apart from `auth.json` and `qfli_remote_control.json`, and
+/// must never be written to plaintext storage.
+///
+/// This file ships the interface plus an in-memory default. No file backend is
+/// provided on purpose: writing a bearer token into the app-private JSON the
+/// pairing secret already uses would widen the plaintext surface for no gain. A
+/// host with platform secure storage can plug a backend in; until then the UI
+/// says that authorization does not survive a restart.
+///
+/// ## Versioning
+///
+/// A backend may be slow (Keystore, HUKS, a test double). Every mutation bumps a
+/// version, and each async step compares the version it started with against the
+/// current one. A completion that lost the race is discarded instead of being
+/// applied, so:
+///
+///   * a slow `load()` cannot reinstate tokens after a sign-out;
+///   * a slow `save()` cannot overwrite a newer account's tokens;
+///   * a slow `clear()` cannot erase tokens a newer account just stored.
+library;
+
+/// A credential backend, e.g. Keychain / Keystore / HarmonyOS HUKS.
+///
+/// Implementations must never log the values they read or write.
+abstract interface class RelayCredentialBackend {
+  Future<RelayCredentials?> read();
+
+  Future<void> write(RelayCredentials credentials);
+
+  Future<void> clear();
+}
+
+/// Relay tokens for one account on one relay, issued to one QFLI identity.
+///
+/// [ownerId] is the QFLI user id that authorized the exchange. It is stored with
+/// the tokens so a backend cannot hand account A's tokens to a phone signed in
+/// as B — the relay's `account_id` alone cannot prove that, because the mapping
+/// lives on the server.
+class RelayCredentials {
+  const RelayCredentials({
+    required this.ownerId,
+    required this.accountId,
+    required this.relayUrl,
+    required this.accessToken,
+    required this.refreshToken,
+    this.accessExpiresAt,
+    this.refreshExpiresAt,
+  });
+
+  /// QFLI user id this authorization belongs to. Never rendered.
+  final String ownerId;
+
+  /// Relay account id returned by the exchange.
+  final String accountId;
+
+  /// Exact socket address these tokens were issued for. Prevents replaying an
+  /// account token against a different relay instance.
+  final String relayUrl;
+
+  final String accessToken;
+  final String refreshToken;
+  final DateTime? accessExpiresAt;
+  final DateTime? refreshExpiresAt;
+
+  bool belongsTo(String relayUrl) => this.relayUrl == relayUrl;
+
+  bool isOwnedBy(String ownerId) => this.ownerId == ownerId;
+
+  /// True when the access token is close enough to expiry that a refresh should
+  /// happen before dialling (the relay rejects stale access tokens).
+  bool needsRefresh(Duration skew) {
+    final expiry = accessExpiresAt;
+    if (expiry == null) return false;
+    return !DateTime.now().toUtc().add(skew).isBefore(expiry);
+  }
+
+  /// Metadata only — used by `clearIf` to recognise its own value.
+  bool sameAuthorization(RelayCredentials other) =>
+      ownerId == other.ownerId &&
+      accountId == other.accountId &&
+      relayUrl == other.relayUrl &&
+      accessToken == other.accessToken;
+
+  /// Persistence shape for a platform backend.
+  ///
+  /// Contains tokens by necessity — that is what a credential backend stores —
+  /// but never reaches the app's JSON documents.
+  Map<String, dynamic> toJson() => <String, dynamic>{
+    'ownerId': ownerId,
+    'accountId': accountId,
+    'relayUrl': relayUrl,
+    'accessToken': accessToken,
+    'refreshToken': refreshToken,
+    'accessExpiresAt': accessExpiresAt?.toUtc().toIso8601String(),
+    'refreshExpiresAt': refreshExpiresAt?.toUtc().toIso8601String(),
+  };
+
+  factory RelayCredentials.fromJson(Map<String, dynamic> json) =>
+      RelayCredentials(
+        ownerId: json['ownerId'] as String? ?? '',
+        accountId: json['accountId'] as String? ?? '',
+        relayUrl: json['relayUrl'] as String? ?? '',
+        accessToken: json['accessToken'] as String? ?? '',
+        refreshToken: json['refreshToken'] as String? ?? '',
+        accessExpiresAt: DateTime.tryParse(
+          json['accessExpiresAt'] as String? ?? '',
+        )?.toUtc(),
+        refreshExpiresAt: DateTime.tryParse(
+          json['refreshExpiresAt'] as String? ?? '',
+        )?.toUtc(),
+      );
+
+  @override
+  String toString() =>
+      'RelayCredentials(owner: $ownerId, account: $accountId, '
+      'relay: ${Uri.tryParse(relayUrl)?.host ?? '-'}, '
+      'accessExpires: ${accessExpiresAt?.toIso8601String() ?? 'unknown'})';
+}
+
+/// Holds the current relay tokens for the app session.
+///
+/// Without a [backend] the store is memory-only: closing the app forgets the
+/// tokens and the user re-authorizes. That is the honest fallback when no
+/// supported secure-storage plugin exists, and it is visible to the UI through
+/// [isPersistent] so the screen can say so.
+class RelayCredentialStore {
+  RelayCredentialStore({RelayCredentialBackend? backend}) : _backend = backend;
+
+  final RelayCredentialBackend? _backend;
+
+  RelayCredentials? _credentials;
+
+  /// Bumped by every operation that changes what should be stored.
+  int _version = 0;
+
+  /// Set when the owner is gone. Memory is dropped and the backend is left
+  /// alone: a closed store must not delete tokens another owner may hold.
+  bool _closed = false;
+
+  /// Whether tokens survive an app restart.
+  bool get isPersistent => _backend != null;
+
+  RelayCredentials? get credentials => _credentials;
+
+  /// Current version, for diagnostics and tests.
+  int get version => _version;
+
+  bool get isClosed => _closed;
+
+  /// Loads persisted tokens once.
+  ///
+  /// A load that completes after a save or a clear is discarded: the newer
+  /// operation already decided what the store should hold.
+  Future<RelayCredentials?> load() async {
+    final backend = _backend;
+    if (_closed) return null;
+    if (backend == null) return _credentials;
+    if (_credentials != null) return _credentials;
+    final start = _version;
+    RelayCredentials? loaded;
+    try {
+      loaded = await backend.read();
+    } catch (_) {
+      // A broken keystore must not break the feature: the user re-authorizes.
+      loaded = null;
+    }
+    if (_closed) return null;
+    if (_version != start) return _credentials;
+    _credentials = loaded;
+    return _credentials;
+  }
+
+  /// Stores tokens and mirrors them into the backend.
+  ///
+  /// The in-memory copy is updated synchronously so the caller can dial the
+  /// socket immediately; the backend write is awaited but a write that lost a
+  /// race is followed by a re-assert of the current value.
+  Future<void> save(RelayCredentials credentials) async {
+    if (_closed) return;
+    final version = ++_version;
+    _credentials = credentials;
+    await _writeThrough(version, () => _backend!.write(credentials));
+  }
+
+  /// Drops tokens.
+  ///
+  /// [expected] limits the effect to the value the caller still owns: on sign-out
+  /// and account switch the controller passes the credentials it is dropping, so
+  /// a clear that lands late cannot erase the next account's fresh tokens.
+  ///
+  /// Returns whether anything was dropped, which lets a late `401` tell "my token
+  /// is gone" from "someone already replaced it".
+  Future<bool> clearIf(RelayCredentials? expected) async {
+    if (_closed) return false;
+    if (expected != null) {
+      final current = _credentials;
+      if (current == null || !current.sameAuthorization(expected)) return false;
+    }
+    await clear();
+    return true;
+  }
+
+  /// Drops whatever the store currently holds.
+  Future<void> clear() async {
+    if (_closed) return;
+    final version = ++_version;
+    _credentials = null;
+    await _writeThrough(version, () => _backend!.clear());
+  }
+
+  /// Forgets everything in memory without touching the backend.
+  ///
+  /// Called by `dispose()`: releasing one owner must not delete tokens that
+  /// another live owner on the same store still uses, nor the persisted copy the
+  /// next launch is supposed to find.
+  void close() {
+    _closed = true;
+    _credentials = null;
+    _version++;
+  }
+
+  Future<void> _writeThrough(
+    int version,
+    Future<void> Function() operation,
+  ) async {
+    final backend = _backend;
+    if (backend == null) return;
+    try {
+      await operation();
+    } catch (_) {
+      // Persisting is best effort; memory still serves this session.
+      return;
+    }
+    if (_closed || _version == version) return;
+    // A newer save/clear landed while this write was in flight, so the backend
+    // may now hold the older value. Re-assert the current one.
+    final current = _credentials;
+    try {
+      if (current == null) {
+        await backend.clear();
+      } else {
+        await backend.write(current);
+      }
+    } catch (_) {
+      // Nothing else to do: the next save will reconcile again.
+    }
+  }
+}
diff --git a/lib/remote_control/account/relay_endpoint.dart b/lib/remote_control/account/relay_endpoint.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/relay_endpoint.dart
@@ -0,0 +1,74 @@
+// Account-binding support for the remote-control module.
+//
+// Everything in this directory is about *who may connect*, never about how the
+// agent protocol works: pairing, sessions, terminals, Herdr and Codex keep using
+// the unchanged wire contract in `../state/remote_controller.dart`.
+//
+// Credential rules (task 11-21, contract §"不能改变"):
+//   * the QFLI session token only ever travels to the QFLI origin;
+//   * the relay only receives a short-lived grant and its own tokens;
+//   * relay tokens live in memory here and are never written to `auth.json` or
+//     `qfli_remote_control.json`;
+//   * no `toString`, exception or log line in this directory contains a token,
+//     a grant or a device secret.
+
+import '../transport/relay_socket.dart';
+
+/// A relay server expressed as both the WebSocket URL the agent link dials and
+/// the HTTP origin the account API lives on.
+///
+/// The HTTP origin is *derived* from the WebSocket address instead of being
+/// typed separately. That is deliberate: it makes it impossible to send the
+/// account token to a different host than the socket the user selected, which
+/// is exactly the credential-forwarding mistake this task must avoid.
+class RelayEndpoint {
+  RelayEndpoint._({required this.webSocket, required this.origin});
+
+  /// Normalized `ws` / `wss` URL, including its path (`/ws` by default).
+  final Uri webSocket;
+
+  /// `http` / `https` origin with no path, query or fragment.
+  final Uri origin;
+
+  /// Parses user input the same way the manual pairing form does.
+  ///
+  /// Returns `null` for anything that is not a plain `ws`/`wss` address with a
+  /// host. User info, queries and fragments are rejected rather than tidied:
+  /// they would either end up inside a request URL or hide the real host.
+  static RelayEndpoint? tryParse(String? input) {
+    final socket = normalizeRelayUrl(input ?? '');
+    if (socket == null) return null;
+    if (socket.host.isEmpty) return null;
+    if (socket.userInfo.isNotEmpty) return null;
+    if (socket.hasQuery || socket.hasFragment) return null;
+    return RelayEndpoint._(
+      webSocket: socket,
+      origin: Uri(
+        scheme: socket.scheme == 'wss' ? 'https' : 'http',
+        host: socket.host,
+        port: socket.hasPort ? socket.port : null,
+      ),
+    );
+  }
+
+  /// Absolute account-API URL on this relay.
+  ///
+  /// Only `/api/...` paths are accepted, so a caller cannot accidentally build
+  /// a request against another origin or a scheme-relative URL.
+  Uri api(String path, [Map<String, String>? query]) {
+    if (!path.startsWith('/api/') || path.contains('://')) {
+      throw ArgumentError.value(path, 'path', '需要 /api/ 开头的账号接口路径');
+    }
+    return origin.replace(
+      path: path,
+      queryParameters: (query == null || query.isEmpty) ? null : query,
+    );
+  }
+
+  /// Stable key for account-scoped caches: the exact address the user picked.
+  String get key => webSocket.toString();
+
+  /// Diagnostic label. Host only — no path, no credentials.
+  @override
+  String toString() => 'RelayEndpoint(${origin.host})';
+}
