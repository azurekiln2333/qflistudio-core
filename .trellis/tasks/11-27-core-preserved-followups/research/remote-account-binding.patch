diff --git a/lib/remote_control/account/account_api.dart b/lib/remote_control/account/account_api.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/account_api.dart
@@ -0,0 +1,516 @@
+// The relay-only halves of the account flow.
+//
+// Two different servers, two different credentials, one rule: a token only ever
+// leaves the code that owns it, and only towards the origin it was issued for.
+//
+//   QFLI  POST /api/relay/grants   ← QFLI session token (QFLI origin only)
+//   relay POST /api/v1/auth/exchange          ← grant
+//   relay POST /api/v1/auth/token/refresh     ← refresh token + fresh grant
+//   relay GET  /api/v1/devices                ← relay access token
+//   relay POST /api/v1/devices/:id/bindings   ← relay access token + pair code
+//   relay DELETE /api/v1/devices/:id/bindings/:accountId
+//
+// The QFLI session token never reaches [RelayAccountApi], and the relay token
+// never reaches [QfliGrantApi]. The two clients are separate classes precisely
+// so that no refactor can wire them into one request by accident.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:http/http.dart' as http;
+
+import '../../config/api_config.dart';
+import '../../config/client_platform.dart';
+import '../models/pairing_uri.dart';
+import 'account_models.dart';
+import 'relay_credentials.dart';
+import 'relay_endpoint.dart';
+
+/// A relay-issued token pair.
+///
+/// Opaque to everything above [RelayAccountApi]. [toString] reports expiry only,
+/// so the value can sit in a debugger watch or an error path safely.
+class RelayTokenSet {
+  const RelayTokenSet({
+    required this.accountId,
+    required this.accessToken,
+    required this.refreshToken,
+    this.accessExpiresAt,
+    this.refreshExpiresAt,
+  });
+
+  /// The relay's account id. Comes from the verified grant, never from input.
+  final String accountId;
+
+  final String accessToken;
+  final String refreshToken;
+  final DateTime? accessExpiresAt;
+  final DateTime? refreshExpiresAt;
+
+  /// Treats a token without a known expiry as usable; the relay is the
+  /// authority and will answer `401`, which the caller handles.
+  bool isAccessExpired({Duration skew = const Duration(seconds: 30)}) {
+    final expiry = accessExpiresAt;
+    if (expiry == null) return false;
+    return !DateTime.now().toUtc().add(skew).isBefore(expiry);
+  }
+
+  bool get isRefreshExpired {
+    final expiry = refreshExpiresAt;
+    if (expiry == null) return false;
+    return !DateTime.now().toUtc().isBefore(expiry);
+  }
+
+  @override
+  String toString() =>
+      'RelayTokenSet(account: $accountId, accessExpires: '
+      '${accessExpiresAt?.toIso8601String() ?? 'unknown'})';
+}
+
+/// Failure of an account request, with the HTTP status kept for the caller.
+///
+/// [message] is always safe to show: server bodies are clipped and re-rendered
+/// as transport text, never echoed verbatim, because a misbehaving server could
+/// reflect a token back in its error field.
+class AccountApiException implements Exception {
+  const AccountApiException(
+    this.message, {
+    this.statusCode,
+    this.code = '',
+    this.retryAfter,
+  });
+
+  final String message;
+  final int? statusCode;
+
+  /// Machine-readable reason: `unauthorized`, `forbidden`, `expired`,
+  /// `rate_limited`, `unavailable`, `network`, `protocol`, `cancelled`.
+  final String code;
+
+  /// Set for `429`, so a caller can back off instead of hammering.
+  final Duration? retryAfter;
+
+  /// Whether the user's sign-in still looks valid (the relay, not QFLI, failed).
+  bool get isTransient =>
+      code == 'unavailable' || code == 'network' || code == 'rate_limited';
+
+  @override
+  String toString() => message;
+}
+
+/// A QFLI-issued short-lived relay grant.
+///
+/// [QfliGrantApi.request] is the only way to obtain one. The grant is
+/// single-use: after a successful exchange it must be dropped, and a refresh
+/// always asks for a fresh one.
+class QfliGrantApi {
+  QfliGrantApi({http.Client? transport, String? baseUrl})
+    : _transport = transport,
+      _baseUrl = baseUrl ?? ApiConfig.baseUrl;
+
+  final http.Client? _transport;
+  final String _baseUrl;
+  late final http.Client _http = _transport ?? http.Client();
+
+  /// Owns the transport only when it created it; an injected client belongs to
+  /// the caller (tests reuse a mock across calls).
+  void close() {
+    if (_transport == null) _http.close();
+  }
+
+  /// Requests `{audience: relayGrantAudience, scope: relayGrantScope}`.
+  ///
+  /// The QFLI token is sent to [_baseUrl] and to nothing else. The base URL is
+  /// fixed at construction and compared to [ApiConfig.origin] so a caller
+  /// cannot point this client at a relay by mistake.
+  Future<RelayGrant> request({
+    required String sessionToken,
+    Future<void>? abortTrigger,
+  }) async {
+    if (sessionToken.isEmpty) {
+      throw const AccountApiException('需要先登录 QFLI 账号', code: 'unauthorized');
+    }
+    final uri = Uri.parse('$_baseUrl/api/relay/grants');
+    if (uri.origin != Uri.parse(ApiConfig.baseUrl).origin) {
+      throw const AccountApiException('账号服务地址无效', code: 'protocol');
+    }
+    final body = await _send(
+      uri,
+      method: 'POST',
+      body: <String, Object>{
+        'audience': relayGrantAudience,
+        'scope': relayGrantScope,
+      },
+      headers: <String, String>{
+        'content-type': 'application/json',
+        'x-client-platform': ClientPlatform.header,
+        'authorization': 'Bearer $sessionToken',
+      },
+      abortTrigger: abortTrigger,
+    );
+    try {
+      return RelayGrant.fromJson(body);
+    } on AccountProtocolException catch (e) {
+      throw AccountApiException(e.message, code: 'protocol');
+    }
+  }
+
+  Future<Object?> _send(
+    Uri uri, {
+    required String method,
+    required Map<String, String> headers,
+    Map<String, Object>? body,
+    Future<void>? abortTrigger,
+  }) {
+    return sendAccountRequest(
+      _http,
+      uri,
+      method: method,
+      headers: headers,
+      body: body,
+      abortTrigger: abortTrigger,
+    );
+  }
+}
+
+/// The relay's account API: exchange, refresh, devices, bindings.
+///
+/// Holds no QFLI token and never asks for one. Every method takes the relay URL
+/// explicitly so a single instance can serve several relays without keeping a
+/// "last relay" that could be used for the wrong account.
+class RelayAccountApi {
+  RelayAccountApi({
+    http.Client? transport,
+    this.requestTimeout = const Duration(seconds: 25),
+  }) : _transport = transport;
+
+  final http.Client? _transport;
+  final Duration requestTimeout;
+  late final http.Client _http = _transport ?? http.Client();
+
+  /// See [QfliGrantApi.close].
+  void close() {
+    if (_transport == null) _http.close();
+  }
+
+  /// `POST /api/v1/auth/exchange`.
+  ///
+  /// [relayToken] is required: an account-bound connection must never silently
+  /// fall back to a device secret, so the caller has to have one first.
+  Future<RelayTokenSet> exchange({
+    required RelayEndpoint relay,
+    required String grant,
+    Future<void>? abortTrigger,
+  }) async {
+    if (grant.trim().isEmpty) {
+      throw const AccountApiException('授权票据为空', code: 'protocol');
+    }
+    final body = await _json(
+      relay,
+      method: 'POST',
+      path: '/api/v1/auth/exchange',
+      body: <String, Object>{'grant': grant},
+      abortTrigger: abortTrigger,
+    );
+    return _tokenSet(body, 'exchanged');
+  }
+
+  /// `POST /api/v1/auth/token/refresh`.
+  ///
+  /// Always takes a **fresh** grant: the relay checks that the introspected
+  /// subject still matches the refresh token's account, which is what makes
+  /// "sign out of QFLI" and "account switched" take effect.
+  Future<RelayTokenSet> refresh({
+    required RelayEndpoint relay,
+    required RelayTokenSet current,
+    required String grant,
+    Future<void>? abortTrigger,
+  }) async {
+    final body = await _json(
+      relay,
+      method: 'POST',
+      path: '/api/v1/auth/token/refresh',
+      body: <String, Object>{
+        'refresh_token': current.refreshToken,
+        'grant': grant,
+      },
+      abortTrigger: abortTrigger,
+    );
+    final refreshed = _tokenSet(body, 'refreshed');
+    if (refreshed.accountId != current.accountId) {
+      // A relay that answers with another account would silently re-point the
+      // client at someone else's devices. Treat it as a protocol failure.
+      throw const AccountApiException('刷新后的账号与当前账号不一致', code: 'protocol');
+    }
+    return refreshed;
+  }
+
+  /// `GET /api/v1/devices` for one access token.
+  Future<List<RelayDevice>> devices({
+    required RelayEndpoint relay,
+    required RelayCredentials credentials,
+    Future<void>? abortTrigger,
+  }) async {
+    final body = await _json(
+      relay,
+      method: 'GET',
+      path: '/api/v1/devices',
+      credentials: credentials,
+      abortTrigger: abortTrigger,
+    );
+    try {
+      return parseRelayDevices(body);
+    } on AccountProtocolException catch (e) {
+      throw AccountApiException(e.message, code: 'protocol');
+    }
+  }
+
+  /// Binds a computer with the desktop's one-time code.
+  ///
+  /// The code alone identifies the device: the relay resolves it and answers with
+  /// the `device_id` it bound. That is the only correct flow, since a pair code is
+  /// single use — connecting with it first (the legacy manual path) and then
+  /// binding with the same code would spend it twice and fail.
+  ///
+  /// [deviceId] is optional and only for a caller that already learned the id
+  /// without spending the code; it selects the older known-id route. Both routes
+  /// send the same body, and the code-only route requires a `device_id` back.
+  Future<RelayDevice> bind({
+    required RelayEndpoint relay,
+    required RelayCredentials credentials,
+    required String pairCode,
+    String? deviceId,
+    Future<void>? abortTrigger,
+  }) async {
+    final code = PairingUri.normalizePairCode(pairCode);
+    if (code == null) {
+      throw const AccountApiException('配对码应为 8 位字母或数字', code: 'protocol');
+    }
+    final knownId = deviceId == null ? null : _validDeviceId(deviceId);
+    final body = await _json(
+      relay,
+      method: 'POST',
+      path: knownId == null
+          ? '/api/v1/devices/bindings'
+          : '/api/v1/devices/${Uri.encodeComponent(knownId)}/bindings',
+      credentials: credentials,
+      body: <String, Object>{'pair_code': code},
+      abortTrigger: abortTrigger,
+    );
+    return _deviceFromResponse(body, knownId);
+  }
+
+  /// `DELETE /api/v1/devices/:deviceId/bindings/:accountId`.
+  ///
+  /// The URL account id is the *target*; the caller is authenticated by the
+  /// access token, so a member cannot revoke someone else's binding by editing
+  /// the path.
+  Future<void> revoke({
+    required RelayEndpoint relay,
+    required RelayCredentials credentials,
+    required String deviceId,
+    String? targetAccountId,
+    Future<void>? abortTrigger,
+  }) async {
+    final id = _validDeviceId(deviceId);
+    final account = (targetAccountId ?? credentials.accountId).trim();
+    if (account.isEmpty) {
+      throw const AccountApiException('缺少要撤销的账号', code: 'protocol');
+    }
+    await _json(
+      relay,
+      method: 'DELETE',
+      path:
+          '/api/v1/devices/${Uri.encodeComponent(id)}/bindings/'
+          '${Uri.encodeComponent(account)}',
+      credentials: credentials,
+      abortTrigger: abortTrigger,
+    );
+  }
+
+  // -------------------------------------------------------------------------
+
+  String _validDeviceId(String deviceId) {
+    try {
+      return validateDeviceId(deviceId);
+    } on AccountProtocolException catch (e) {
+      throw AccountApiException(e.message, code: 'protocol');
+    }
+  }
+
+  /// Extracts the bound device from a bind response.
+  ///
+  /// The relay's account envelope nests the row, so `{device: {...}}`,
+  /// `{binding: {...}}` and a bare row are all accepted. [expectedId] is null for
+  /// the code-only route, where the id is known only from the response — and in
+  /// that case a response without a usable id is an error, because the caller
+  /// needs the id to connect.
+  RelayDevice _deviceFromResponse(Object? body, String? expectedId) {
+    if (body is Map) {
+      final map = body is Map<String, dynamic>
+          ? body
+          : Map<String, dynamic>.from(body);
+      final candidate = map['device'] ?? map['binding'] ?? map;
+      try {
+        final device = RelayDevice.fromJson(candidate);
+        if (expectedId != null && device.deviceId != expectedId) {
+          throw const AccountApiException('绑定响应的设备与请求不一致', code: 'protocol');
+        }
+        return device;
+      } on AccountProtocolException {
+        // A `{ok: true}` answer is only usable when the caller knew the id
+        // already; the code-only route cannot fall back to anything.
+      }
+    }
+    if (expectedId == null) {
+      throw const AccountApiException('绑定成功但服务器没有返回设备 ID', code: 'protocol');
+    }
+    return RelayDevice(deviceId: expectedId);
+  }
+
+  RelayTokenSet _tokenSet(Object? body, String action) {
+    if (body is! Map) {
+      throw AccountApiException('$action 响应格式无效', code: 'protocol');
+    }
+    final map = body is Map<String, dynamic>
+        ? body
+        : Map<String, dynamic>.from(body);
+    final accountId = map['account_id'] ?? map['accountId'];
+    final access = map['access_token'] ?? map['accessToken'];
+    final refresh = map['refresh_token'] ?? map['refreshToken'];
+    if (accountId is! String || accountId.trim().isEmpty) {
+      throw AccountApiException('$action 响应缺少账号', code: 'protocol');
+    }
+    if (access is! String || access.length < 8) {
+      throw AccountApiException('$action 响应缺少访问令牌', code: 'protocol');
+    }
+    if (refresh is! String || refresh.length < 8) {
+      throw AccountApiException('$action 响应缺少刷新令牌', code: 'protocol');
+    }
+    return RelayTokenSet(
+      accountId: accountId.trim(),
+      accessToken: access,
+      refreshToken: refresh,
+      accessExpiresAt: parseAccountTime(
+        map['access_expires_at'] ?? map['accessExpiresAt'],
+      ),
+      refreshExpiresAt: parseAccountTime(
+        map['refresh_expires_at'] ?? map['refreshExpiresAt'],
+      ),
+    );
+  }
+
+  Future<Object?> _json(
+    RelayEndpoint relay, {
+    required String method,
+    required String path,
+    RelayCredentials? credentials,
+    Map<String, Object>? body,
+    Future<void>? abortTrigger,
+  }) async {
+    if (credentials != null && credentials.needsRefresh(Duration.zero)) {
+      throw const AccountApiException('访问令牌已过期', code: 'expired');
+    }
+    return sendAccountRequest(
+      _http,
+      relay.api(path),
+      method: method,
+      headers: <String, String>{
+        'content-type': 'application/json',
+        'x-client-platform': ClientPlatform.header,
+        if (credentials != null)
+          'authorization': 'Bearer ${credentials.accessToken}',
+      },
+      body: body,
+      abortTrigger: abortTrigger,
+    );
+  }
+}
+
+/// One HTTP call with the account client's shared safety rules.
+///
+/// * redirects are not followed, so a `30x` can never re-post a token to another
+///   origin;
+/// * the parsed body is required to be a JSON object or array;
+/// * error bodies are turned into a short status sentence and the status is kept,
+///   never the body itself.
+@visibleForTesting
+Future<Object?> sendAccountRequest(
+  http.Client client,
+  Uri uri, {
+  required String method,
+  required Map<String, String> headers,
+  Map<String, Object>? body,
+  Duration timeout = const Duration(seconds: 25),
+  Future<void>? abortTrigger,
+}) async {
+  try {
+    final request =
+        (abortTrigger == null
+              ? http.Request(method, uri)
+              : http.AbortableRequest(method, uri, abortTrigger: abortTrigger))
+          ..followRedirects = false
+          ..headers.addAll(headers);
+    if (body != null) request.body = jsonEncode(body);
+    final response = await client
+        .send(request)
+        .then(http.Response.fromStream)
+        .timeout(timeout);
+    final text = utf8.decode(response.bodyBytes, allowMalformed: true);
+    Object? decoded;
+    if (text.isNotEmpty) {
+      try {
+        decoded = jsonDecode(text);
+      } on FormatException {
+        decoded = null;
+      }
+    }
+    if (response.statusCode >= 300) {
+      throw _errorFor(response.statusCode, decoded);
+    }
+    if (decoded != null && decoded is! Map && decoded is! List) {
+      throw const AccountApiException('账号服务响应格式无效', code: 'protocol');
+    }
+    return decoded;
+  } on http.RequestAbortedException {
+    throw const AccountApiException('请求已取消', code: 'cancelled');
+  } on TimeoutException {
+    throw const AccountApiException('账号服务响应超时', code: 'network');
+  } on AccountApiException {
+    rethrow;
+  } catch (_) {
+    throw const AccountApiException('无法连接账号服务', code: 'network');
+  }
+}
+
+AccountApiException _errorFor(int status, Object? decoded) {
+  final code = switch (status) {
+    400 => 'protocol',
+    401 => 'unauthorized',
+    403 => 'forbidden',
+    404 => 'not_found',
+    409 => 'conflict',
+    410 => 'expired',
+    429 => 'rate_limited',
+    >= 500 => 'unavailable',
+    _ => 'protocol',
+  };
+  final message = switch (code) {
+    'protocol' => '请求被拒绝，请检查填写内容',
+    'unauthorized' => '登录已过期，请重新登录',
+    'forbidden' => '该账号无权访问这台电脑',
+    'not_found' => '找不到这台电脑的绑定',
+    'conflict' => '电脑已绑定到其他账号',
+    'expired' => '配对码无效或已过期，请在电脑上生成新的配对码',
+    'rate_limited' => '尝试次数过多，请稍后再试',
+    'unavailable' => '账号服务暂时不可用，请稍后重试',
+    _ => '账号服务返回了错误',
+  };
+  return AccountApiException(
+    message,
+    statusCode: status,
+    code: code,
+    retryAfter: status == 429 ? const Duration(seconds: 30) : null,
+  );
+}
diff --git a/lib/remote_control/account/account_devices_page.dart b/lib/remote_control/account/account_devices_page.dart
new file mode 100644
--- /dev/null
+++ b/lib/remote_control/account/account_devices_page.dart
@@ -0,0 +1,769 @@
+// "我的电脑": the account's bound computers, and the account itself.
+//
+// Two jobs, deliberately in one screen:
+//
+//   1. show which computers this QFLI account may drive, with live presence;
+//   2. keep the manual pairing routes visible, because the account layer is an
+//      addition and never a requirement. If the server has no account API, or
+//      the user is offline, or they signed in on another phone, the module must
+//      still work exactly as before.
+//
+// Rendered as a pushed route from `RemoteComputerPage`, so the pair screen and
+// the dashboard are untouched when the account is unused.
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../models/pairing_uri.dart';
+import '../state/remote_controller.dart';
+import '../theme/remote_theme.dart';
+import 'account_models.dart';
+import 'remote_account_controller.dart';
+
+/// Exposes the page-owned account controller to pushed account routes.
+///
+/// `RemoteComputerPage` installs this so the devices route shares one
+/// controller: a second one would dial the relay again and race the dashboard's
+/// token refreshes.
+class AccountOwnerScope extends InheritedWidget {
+  const AccountOwnerScope({
+    super.key,
+    required this.account,
+    required super.child,
+  });
+
+  final RemoteAccountController account;
+
+  static RemoteAccountController? maybeOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<AccountOwnerScope>()?.account;
+
+  @override
+  bool updateShouldNotify(AccountOwnerScope oldWidget) =>
+      !identical(account, oldWidget.account);
+}
+
+/// Hook the host installs to open its login screen.
+///
+/// A callback instead of an import keeps this module independent of the host's
+/// login UI, which lives outside the remote-control package. Absent hook is a
+/// supported state: the notice stays visible and manual pairing still works.
+class AccountSignInHook extends InheritedWidget {
+  const AccountSignInHook({
+    super.key,
+    required this.onSignIn,
+    required super.child,
+  });
+
+  final Future<void> Function() onSignIn;
+
+  static Future<void> Function()? maybeOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<AccountSignInHook>()?.onSignIn;
+
+  @override
+  bool updateShouldNotify(AccountSignInHook oldWidget) =>
+      onSignIn != oldWidget.onSignIn;
+}
+
+/// The devices screen.
+///
+/// [account] and [controller] are injectable so a test or the desktop shell can
+/// mount the screen with instances it already owns.
+class AccountDevicesPage extends StatelessWidget {
+  const AccountDevicesPage({
+    super.key,
+    this.account,
+    this.controller,
+    this.onManualPair,
+  });
+
+  final RemoteAccountController? account;
+  final RemoteController? controller;
+
+  /// Escape hatch into manual pairing. Defaults to popping back, which is the
+  /// pair screen the route was opened from.
+  final VoidCallback? onManualPair;
+
+  @override
+  Widget build(BuildContext context) {
+    final account = this.account ?? AccountOwnerScope.maybeOf(context);
+    if (account == null) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('我的电脑')),
+        body: const _Notice(
+          message: '账号功能在当前环境中不可用，可以直接用配对码连接。',
+          tone: _NoticeTone.info,
+        ),
+      );
+    }
+    return _DevicesView(
+      account: account,
+      controller: controller,
+      onManualPair:
+          onManualPair ??
+          () {
+            final navigator = Navigator.maybeOf(context);
+            if (navigator != null && navigator.canPop()) navigator.pop();
+          },
+    );
+  }
+}
+
+class _DevicesView extends StatefulWidget {
+  const _DevicesView({
+    required this.account,
+    required this.onManualPair,
+    this.controller,
+  });
+
+  final RemoteAccountController account;
+  final VoidCallback onManualPair;
+  final RemoteController? controller;
+
+  @override
+  State<_DevicesView> createState() => _DevicesViewState();
+}
+
+class _DevicesViewState extends State<_DevicesView> {
+  final TextEditingController _relay = TextEditingController();
+  final TextEditingController _code = TextEditingController();
+  bool _relaySeeded = false;
+  bool _binding = false;
+  String? _actionError;
+
+  RemoteAccountController get _account => widget.account;
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    if (_relaySeeded) return;
+    _relaySeeded = true;
+    // Prefill with the server already in use so the user rarely has to type it.
+    _relay.text = _account.relayInput;
+  }
+
+  @override
+  void dispose() {
+    _relay.dispose();
+    _code.dispose();
+    super.dispose();
+  }
+
+  // -------------------------------------------------------------------------
+  // Actions
+  // -------------------------------------------------------------------------
+
+  Future<void> _applyRelay() async {
+    FocusScope.of(context).unfocus();
+    setState(() => _actionError = null);
+    await _account.setRelayAddress(_relay.text.trim());
+  }
+
+  Future<void> _authorize() async {
+    FocusScope.of(context).unfocus();
+    setState(() => _actionError = null);
+    await _account.authorize();
+  }
+
+  /// Binds with the code alone, then refreshes and connects.
+  ///
+  /// The code is what the desktop shows; asking for a device id here would
+  /// contradict the flow the desktop actually offers, and the legacy
+  /// "pair first, bind later" path would spend the single-use code twice.
+  Future<void> _bindAndConnect() async {
+    final code = PairingUri.normalizePairCode(_code.text);
+    if (code == null) {
+      setState(() => _actionError = '配对码应为 8 位字母或数字');
+      return;
+    }
+    setState(() {
+      _actionError = null;
+      _binding = true;
+    });
+    try {
+      final device = await _account.bindDevice(pairCode: code);
+      if (!mounted) return;
+      _code.clear();
+      if (device.isRevoked) {
+        setState(() => _actionError = '这台电脑的绑定已被解除');
+        return;
+      }
+      if (widget.controller == null) {
+        ScaffoldMessenger.of(
+          context,
+        ).showSnackBar(const SnackBar(content: Text('已绑定，这台电脑出现在列表中')));
+        return;
+      }
+      if (_account.phase != AccountPhase.ready) {
+        ScaffoldMessenger.of(
+          context,
+        ).showSnackBar(const SnackBar(content: Text('已绑定，请刷新设备列表确认连接状态')));
+        return;
+      }
+      if (!device.isOnline) {
+        // Bound, but the agent is not connected right now. Say so instead of
+        // opening a socket that can only report "电脑不在线".
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('已绑定「${device.displayName}」，等电脑上线后即可连接')),
+        );
+        return;
+      }
+      await _connect(device);
+    } catch (e) {
+      if (!mounted) return;
+      setState(() => _actionError = '$e');
+    } finally {
+      if (mounted) setState(() => _binding = false);
+    }
+  }
+
+  Future<void> _revoke(RelayDevice device) async {
+    setState(() => _actionError = null);
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        icon: const Icon(Icons.link_off_rounded),
+        title: Text('从「${device.displayName}」解除绑定？'),
+        content: const Text(
+          '解除后这个账号不能再连接这台电脑。已建立的连接会立即断开。'
+          '再次连接时，请在电脑上重新生成配对码。',
+        ),
+        actions: <Widget>[
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('取消'),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: const Text('解除绑定'),
+          ),
+        ],
+      ),
+    );
+    if (ok != true || !mounted) return;
+    try {
+      final applied = await _account.revokeDevice(device.deviceId);
+      if (!mounted) return;
+      if (!applied) {
+        // The account or relay changed while the request was in flight. Say so
+        // instead of reporting a revocation that no longer belongs to this list.
+        setState(() => _actionError = '账号已切换，本次解除未生效');
+        return;
+      }
+      // Drop the live link only for the computer just revoked, and only while it
+      // is still the linked one: another account's connection must survive.
+      final controller = widget.controller;
+      if (controller != null &&
+          controller.pairing?.agentId == device.deviceId) {
+        await controller.unpair();
+      }
+    } catch (e) {
+      if (!mounted) return;
+      setState(() => _actionError = '$e');
+    }
+  }
+
+  Future<void> _connect(RelayDevice device) async {
+    final controller = widget.controller;
+    final endpoint = _account.endpoint;
+    final accountId = _account.accountId;
+    if (controller == null || endpoint == null || accountId == null) {
+      setState(() => _actionError = '账号授权已失效，请重新授权');
+      return;
+    }
+    final navigator = Navigator.maybeOf(context);
+    try {
+      await controller.connectAccountDevice(
+        relayUrl: endpoint.key,
+        deviceId: device.deviceId,
+        accountId: accountId,
+        name: device.label,
+        tokens: ({required String accountId, required String relayUrl}) async {
+          final credentials = await _account.credentialsFor(
+            accountId: accountId,
+            relayUrl: relayUrl,
+          );
+          return credentials?.accessToken;
+        },
+      );
+    } on RemoteException catch (e) {
+      if (!mounted) return;
+      setState(() => _actionError = e.message);
+      return;
+    }
+    // The dashboard is behind this route; closing it shows the new connection.
+    if (navigator != null && navigator.canPop()) navigator.pop();
+  }
+
+  Future<void> _refresh() async {
+    setState(() => _actionError = null);
+    await _account.refreshDevices();
+  }
+
+  // -------------------------------------------------------------------------
+
+  @override
+  Widget build(BuildContext context) {
+    return ListenableBuilder(
+      listenable: _account,
+      builder: (context, _) {
+        final scheme = Theme.of(context).colorScheme;
+        return Scaffold(
+          appBar: AppBar(
+            title: const Text('我的电脑'),
+            actions: <Widget>[
+              if (_account.phase == AccountPhase.ready)
