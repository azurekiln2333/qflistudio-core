+          tone: _NoticeTone.error,
+          action: TextButton(
+            onPressed: () => _signIn(context),
+            child: const Text('重新登录'),
+          ),
+        ),
+      ],
+      AccountPhase.needsAuthorization => <Widget>[
+        ...header,
+        _Notice(
