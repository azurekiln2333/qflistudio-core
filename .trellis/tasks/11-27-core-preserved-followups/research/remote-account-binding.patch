+
+    return switch (_account.phase) {
+      AccountPhase.signedOut => <Widget>[
+        ...header,
+        _Notice(
+          message: '登录 QFLI 账号后，这里会列出绑定到账号的电脑。',
+          tone: _NoticeTone.info,
