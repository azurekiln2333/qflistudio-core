+  Future<void> _saveCache(
+    _AccountFence fence,
+    List<RelayDevice> devices,
+  ) async {
+    final store = _store;
+    final endpoint = fence.endpoint;
+    final accountId = _accountId;
+    if (store == null || endpoint == null || accountId == null) return;
+    final payload = AccountDeviceCache(
+      accountId: accountId,
+      relayUrl: endpoint.key,
+      devices: devices,
+      fetchedAt: DateTime.now().toUtc(),
