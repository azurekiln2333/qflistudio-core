+/// 一个场景：先建 widget，挂载后可以再操作一次界面。
+class EditorScene {
+  const EditorScene({required this.name, required this.build, this.prepare});
+
+  final String name;
+  final Future<Widget> Function() build;
+
+  /// 挂载后、出图前的交互，例如展开 Agent 面板或切到会话分段。
+  final Future<void> Function(WidgetTester tester, Size size)? prepare;
+}
+
+/// 场景共用的环境：临时项目目录、登录态、假运行时。
+class _SceneEnv {
+  _SceneEnv({
+    required this.directory,
+    required this.project,
+    required this.store,
+    required this.auth,
+    required this.settings,
+    required this.runtime,
+    required this.facade,
+    this.sessionId,
+  });
+
+  final Directory directory;
+  final Project project;
+  final ProjectStore store;
+  final AuthStore auth;
+  final SettingsStore settings;
+  final FakeAgentRuntime runtime;
+  final FakeAgentFacade facade;
+  final String? sessionId;
+}
+
+Future<_SceneEnv> _env({
+  bool loggedIn = true,
+  bool makeSession = true,
+  String projectName = '计算器练习',
+  List<AgentModelOption> models = _defaultModels,
+}) async {
+  final directory = await Directory.systemTemp.createTemp('qfli_editor_scene_');
+  Directory(p.join(directory.path, 'lib')).createSync(recursive: true);
+  Directory(p.join(directory.path, 'src')).createSync(recursive: true);
+  File(p.join(directory.path, 'lib', 'main.dart')).writeAsStringSync(
+    "import 'src/app.dart';\n\nvoid main() {\n  runApp(const App());\n}\n",
+  );
+  File(p.join(directory.path, 'src', 'app.dart')).writeAsStringSync(
+    'class App {\n  const App();\n}\n',
+  );
+  File(p.join(directory.path, 'README.md')).writeAsStringSync(
+    '# 计算器练习\n\n跟着教程做一个小计算器。\n',
+  );
+
+  final auth = AuthStore();
+  if (loggedIn) {
+    await auth.signIn(
+      'preview-only',
+      const CommunityUser(
+        id: '1',
+        username: 'preview-user',
+        nickname: 'Example',
+        bio: 'Synthetic preview user.',
+        avatarColor: '#4D6994',
+        points: 1280,
+        checkinStreak: 7,
+        provider: 'local',
+      ),
+    );
+  }
+
+  final store = ProjectStore();
+  final project = Project.create(name: projectName, path: directory.path);
+  final settings = SettingsStore();
+  final sessions = MemoryAgentSessionStore();
+  final sessionId = makeSession
+      ? (await sessions.create(project.id, title: '改标题并补一个求和函数')).id
+      : null;
+
+  final runtime = FakeAgentRuntime(
+    sessions: sessions,
+    modelOptions: models,
+    skillRefs: const <AgentSkillRef>[
+      AgentSkillRef(name: 'dart-format', description: '按项目规则格式化 Dart'),
+      AgentSkillRef(name: 'run-tests', description: '跑一遍测试并汇总失败'),
+    ],
+  );
+  final facade = FakeAgentFacade(sessionId: sessionId ?? 'preview-new');
+  facade.permission = AgentPermissionMode.askEveryWrite;
+  if (sessionId != null) runtime.facades[sessionId] = facade;
+  runtime.facade = facade;
+  EditorAgentHost.resetRuntimeResolutions();
+  return _SceneEnv(
+    directory: directory,
+    project: project,
+    store: store,
+    auth: auth,
+    settings: settings,
+    runtime: runtime,
+    facade: facade,
+    sessionId: sessionId,
+  );
+}
