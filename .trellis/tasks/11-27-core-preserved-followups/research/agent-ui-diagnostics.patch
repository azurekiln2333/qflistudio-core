+/// 展开 Agent 面板：宽屏点右侧轨道的展开按钮，窄屏点分段条的「Agent」。
+Future<void> _openAgent(WidgetTester tester, Size size) async {
+  if (size.width >= 1100) {
+    await tester.tap(find.byKey(const ValueKey('editor-agent-expand')));
+  } else {
+    await tester.tap(find.text('Agent').last);
+  }
+  await _frames(tester);
+}
+
+/// 打开侧边栏的「会话」分段。
+Future<void> _openSessions(WidgetTester tester, Size size) async {
+  await _openSidebar(tester, size);
+  final section = find.byKey(
+    const ValueKey('editor-sidebar-section-sessions'),
+  );
+  if (section.evaluate().isNotEmpty) {
+    await tester.tap(section, warnIfMissed: false);
+    await _frames(tester);
+  }
+}
+
+Future<void> _openSidebar(WidgetTester tester, Size size) async {
+  final section = find.byKey(
+    const ValueKey('editor-sidebar-section-sessions'),
+  );
+  if (_onScreen(tester, section, size)) return;
+  final open = find.byTooltip('打开文件树');
+  if (open.evaluate().isNotEmpty) {
+    await tester.tap(open.first, warnIfMissed: false);
+    await _frames(tester);
+    if (_onScreen(tester, section, size)) return;
+  }
+  final menu = find.byIcon(Icons.menu);
+  if (menu.evaluate().isNotEmpty) {
+    await tester.tap(menu.first, warnIfMissed: false);
+    await _frames(tester);
+  }
+}
+
+/// 分段开关是否真的在屏幕内（抽屉关着时它在屏幕外）。
+bool _onScreen(WidgetTester tester, Finder finder, Size size) {
+  if (finder.evaluate().isEmpty) return false;
+  try {
+    final rect = tester.getRect(finder);
+    return rect.width > 0 &&
+        rect.height > 0 &&
+        rect.left >= 0 &&
+        rect.right <= size.width &&
+        rect.top >= 0 &&
+        rect.bottom <= size.height;
+  } catch (_) {
+    return false;
+  }
+}
+
+/// 窄屏抽屉打开，停在「文件 | 会话」分段。
+Future<void> _openDrawer(WidgetTester tester, Size size) async {
+  await _openSidebar(tester, size);
+}
+
+/// 选中一个会话：直接驱动 [WorkbenchState]，不依赖点击会话行。
+///
+/// 会话行在侧边栏抽屉里，中屏与窄屏下点不到。宽屏从 [AgentEntryButton]、
+/// 中窄屏从分段条上的 [AgentSegmentIcon] 拿到宿主，直接设置会话与布局状态。
+Future<void> _selectSession(
+  WidgetTester tester,
+  Size size,
+  String? sessionId,
+) async {
+  if (sessionId == null) return;
+  final entry = find.byType(AgentEntryButton);
+  final EditorAgentHost host;
+  if (entry.evaluate().isNotEmpty) {
+    host = tester.widget<AgentEntryButton>(entry.first).host;
+  } else {
+    final seg = find.byType(AgentSegmentIcon);
+    if (seg.evaluate().isEmpty) {
+      throw StateError('找不到 AgentEntryButton 或 AgentSegmentIcon，无法选中会话 $sessionId');
+    }
+    host = tester.widget<AgentSegmentIcon>(seg.first).host;
+  }
+  host.activate();
+  host.state.selectSession(sessionId);
+  // 宽屏展开右栏；中屏与窄屏切到 Agent 分段。两个都设，与宽度无关。
+  host.state.setAgentPaneCollapsed(false);
+  host.state.showMainPane(MainPane.agent);
+  await _frames(tester);
+}
+
+Future<void> _frames(WidgetTester tester, [int frames = 24]) async {
+  for (var i = 0; i < frames; i++) {
+    await tester.pump(const Duration(milliseconds: 20));
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 2)),
+    );
+  }
+}
+
+/// 点开输入卡片上的一个下拉，选中指定文字。
+///
+/// [chipKey] 是筹码按钮的 key（`composer-model` / `composer-reasoning`）。
+Future<void> _pickMenuItem(
+  WidgetTester tester,
+  String chipKey,
+  String label,
+) async {
+  final chip = find.byKey(ValueKey(chipKey));
+  if (chip.evaluate().isEmpty) {
+    throw StateError('找不到 $chipKey，无法选择「$label」');
+  }
+  await tester.tap(chip.first, warnIfMissed: false);
+  await _frames(tester);
+  final item = find.text(label).last;
+  if (item.evaluate().isEmpty) {
+    throw StateError('下拉里没有「$label」');
+  }
+  await tester.tap(item, warnIfMissed: false);
+  await _frames(tester);
+}
